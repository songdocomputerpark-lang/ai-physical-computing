{
  "name": "ai-physical-computing",
  "version": "0.5.0",
  "private": true,
  "description": "AI 피지컬 컴퓨팅 오픈랩(가칭) — 설치 없이 브라우저만으로 인공지능과 피지컬 컴퓨팅(ESP32)을 배우는 무료 교육 사이트",
  "license": "MIT AND CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songdocomputerpark-lang/ai-physical-computing.git"
  },
  "homepage": "https://songdocomputerpark-lang.github.io/ai-physical-computing/",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/vendor-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/vendor-assets.mjs && node scripts/fetch-pyodide-fallback.mjs && node scripts/check-sources.mjs",
    "build": "astro build",
    "build:offline": "node scripts/build-offline.mjs",
    "test:offline": "node scripts/offline/verify-offline.mjs",
    "vendor": "node scripts/vendor-assets.mjs",
    "pyodide:fallback": "node scripts/fetch-pyodide-fallback.mjs",
    "sw": "node scripts/build-sw.mjs",
    "examples:import": "node scripts/import-examples.mjs",
    "examples:verify": "node scripts/import-examples.mjs --verify",
    "images:extract": "node scripts/extract-lesson-images.mjs",
    "images:show": "node scripts/extract-lesson-images.mjs --show",
    "images:check": "node scripts/extract-lesson-images.mjs --check",
    "handouts:build": "python scripts/redact-handouts.py build",
    "handouts:check": "python scripts/redact-handouts.py check",
    "handouts:preview": "python scripts/redact-handouts.py preview",
    "handouts:compare": "python scripts/redact-handouts.py compare",
    "postbuild": "node scripts/check-sources.mjs --bundle && node scripts/search-index.mjs && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:sources": "node scripts/check-sources.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "search:index": "node scripts/search-index.mjs",
    "test": "vitest run && vitest run --config tests/unit/firmware/vitest.container.config.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/run-e2e-group.mjs a11y",
    "perf:measure": "node scripts/run-e2e-group.mjs perf --project=desktop --workers=1",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "@mediapipe/tasks-vision": "0.10.35",
    "astro": "7.3.2",
    "blockly": "13.3.0",
    "esptool-js": "0.6.1",
    "lz-string": "1.5.0",
    "mqtt": "5.15.2",
    "pagefind": "1.5.2",
    "remark-directive": "4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/w3c-web-serial": "1.0.8",
    "esbuild": "0.28.2",
    "pretendard": "1.3.9",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "workbox-build": "7.4.1",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
