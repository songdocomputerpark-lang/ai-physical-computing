---
// 사이트 검색 페이지(PLAN §2.1 /search/, §8.1 P1-11). 화면과 동작은 src/components/search/SearchPage.astro에 있다.
// 머리글 검색 상자(src/components/search/HeaderSearch.astro)가 /search/?q=검색어 로 보낸다.
// 검색 페이지 자체는 검색 결과에 나올 필요가 없어 사이트 검색 색인에서 뺀다(searchIndex={false}).
import SearchPage from '../../components/search/SearchPage.astro';
import { getPage } from '../../config/nav.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = getPage('search');
---

<BaseLayout title={page.title} description={page.description} width="narrow" searchIndex={false}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">{page.description}</p>
  <SearchPage />
</BaseLayout>
