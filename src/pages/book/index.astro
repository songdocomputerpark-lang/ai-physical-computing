---
/**
 * 교과서 첫 화면(/book/) — 출판본 교과서의 표지와 차례(대단원 > 중단원 > 절). 판 1.4.0, DECISIONS C131.
 * 표지 그림은 public/images/book/cover.webp(원고 그림 도구 BOOK 원본, 그림 목록 content/book/front.images.yaml)가 있을 때만 보인다.
 * 홈의 큰 차례 그림·카드 흐름은 홈 구역이 따로 만든다 — 이 쪽은 글로 찾는 차례다(낭독기·좁은 화면·검색에서 오는 사람용).
 */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BookToc from '../../components/book/BookToc.astro';
import { bookPagesLabel, buildBookToc, publishedBooks } from '../../components/book/book-data.ts';
import { BOOK_MEDIA_INFO, BOOK_MEDIA_ORDER } from '../../components/book/book-media.ts';
import Icon from '../../components/common/Icon.astro';
import { publishedLessons } from '../../components/lesson/lesson-data.ts';
import { getPage } from '../../config/nav.ts';
import { readImageFileSize } from '../../lib/rehype-lesson-polish.mjs';
import { withBase } from '../../lib/url.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = getPage('book');
const books = publishedBooks(await getCollection('book'));
const lessons = publishedLessons(await getCollection('lessons'));
const toc = buildBookToc(books);
const first = books.find((book) => book.kind === 'section') ?? books[0];

const coverFile = path.resolve('public/images/book/cover.webp');
const coverSize = fs.existsSync(coverFile) ? readImageFileSize(coverFile) : null;
const sectionCount = books.filter((book) => book.kind === 'section').length;
---

<BaseLayout title={page.title} description={page.description}>
  <div class="book-home">
    {
      coverSize && (
        <img
          class="book-home__cover"
          src={withBase('images/book/cover.webp')}
          alt="교과서 「인공지능과 피지컬 컴퓨팅」의 표지"
          width={coverSize.width}
          height={coverSize.height}
        />
      )
    }
    <div class="book-home__text">
      <h1 class="page-title">{page.title}</h1>
      <p class="lead">{page.description}</p>
      <p class="book-home__count">
        {books.length > 0 ? `지금 ${sectionCount}개 절을 읽을 수 있어요.` : '교과서 쪽을 준비하고 있어요.'}
      </p>
      {
        first && (
          <p class="book-home__start">
            <a class="button button--primary" href={first.href}>
              <span>처음부터 읽기</span>
              <Icon name="arrow-right" size="sm" />
            </a>
            <span class="book-home__first">첫 쪽: {first.title}({bookPagesLabel(first.pages)})</span>
          </p>
        )
      }
      <ul class="book-home__legend" aria-label="매체 표시">
        {
          BOOK_MEDIA_ORDER.map((key) => (
            <li class="book-home__legend-item">
              <Icon name={BOOK_MEDIA_INFO[key].icon} size="sm" />
              <span>
                <strong>{BOOK_MEDIA_INFO[key].label}</strong> {BOOK_MEDIA_INFO[key].note}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <BookToc toc={toc} lessons={lessons} />
</BaseLayout>

<style>
  .book-home {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-8);
  }

  .book-home__cover {
    inline-size: min(100%, 15rem);
    block-size: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* 표지는 15rem 칸, 글은 나머지 칸 — 표지 그림의 원래 크기(폭 927px)가 칸 폭을 정하지 않게 칸 폭을 정해 둔다 */
  @media (min-width: 40rem) {
    .book-home {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-8);
    }

    .book-home__cover {
      inline-size: 100%;
    }
  }

  .book-home__start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .book-home__legend {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-4) 0 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    list-style: none;
  }

  .book-home__legend-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .book-home__first {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
