---
/**
 * 통신 실습실(SPEC §6.3 "통신 실습실(IoT Lab)", PLAN §2.1 /labs/iot/, §7·§8.4) — 2026-09-24 Phase 4 통합에서 자리 페이지를 실제 화면으로 바꿨다.
 *
 * 통신 실습은 **두 화면이 짝**을 이룬다: 컴퓨터 쪽 코드는 영상처리 실습실, 보드 쪽 코드는 ESP32 실습실(가상 보드)에서 돌고,
 * 둘 사이는 [보내기] 패널·블루투스 칸·MQTT 칸이 고른 통로(같은 컴퓨터 탭·USB 데이터 포트·블루투스·공개 중계 서버)로 잇는다.
 * 그래서 이 페이지는 코드를 직접 돌리지 않고, SPEC §6.3의 개념 계단(유선 → 블루투스 → 와이파이·MQTT → 대시보드)과
 * AI → 피지컬 브릿지 예제로 가는 길을 한 곳에 모은다. 아래 페이지는 대시보드(labs-iot-dashboard)다.
 *
 * 예제 링크는 빌드 때 examples/의 파일을 읽어 만든다 — 제목은 사이드카(<이름>.meta.yaml) → 파일 머리말 순서(실습실 목록과 같은 규칙),
 * 여는 실습실은 경로의 첫 칸(esp32/ → ESP32, vision/ → 영상처리 — lesson-data.ts labOfExampleFile). 파일이 없으면 빌드가 멈춘다.
 * 공개 중계 서버 경고(PD-29)는 브릿지의 문장(bridgeText.publicBrokerNotice)을 그대로 써서 실습실 화면과 같은 말을 한다.
 */
import fs from 'node:fs';
import path from 'node:path';
import Callout from '../../../components/common/Callout.astro';
import PageLinks from '../../../components/common/PageLinks.astro';
import { labLink, labOfExampleFile } from '../../../components/lesson/lesson-data.ts';
import { getPage } from '../../../config/nav.ts';
import { bridgeText } from '../../../lab/bridge/index.ts';
import { readExampleMeta } from '../../../lab/controls/example-meta.ts';
import { parseExampleSidecar } from '../../../lab/controls/example-sidecar.ts';
import { EXAMPLE_COMM_LABELS } from '../../../lab/gallery/facets.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const page = getPage('labs-iot');
const dashboard = getPage('labs-iot-dashboard');
const unit4 = getPage('labs-unit4');
const gallery = getPage('labs-gallery');
const esp32 = getPage('labs-esp32');
const check = getPage('start-check');
const board = getPage('start-board');
const errors = getPage('help-errors');

const EXAMPLES_DIR = path.resolve('examples');

interface ExampleLink {
  readonly role: string;
  readonly title: string;
  readonly href: string;
  readonly lab: string;
}

/** examples/ 뒤 경로 → 링크(제목은 사이드카 → 머리말, 실습실은 경로 첫 칸) */
function exampleLink(file: string, role: string): ExampleLink {
  const full = path.join(EXAMPLES_DIR, ...file.split('/'));
  if (!fs.existsSync(full)) {
    throw new Error(`통신 실습실(src/pages/labs/iot/index.astro): 예제 파일 examples/${file}이(가) 없어요. 파일 이름을 고쳤다면 이 페이지의 목록도 함께 고쳐요.`);
  }
  const sidecarPath = full.replace(/\.py$/u, '.meta.yaml');
  const sidecarTitle = fs.existsSync(sidecarPath) ? parseExampleSidecar(fs.readFileSync(sidecarPath, 'utf8')).title : null;
  const title = sidecarTitle ?? readExampleMeta(fs.readFileSync(full, 'utf8')).title ?? file;
  const lab = labOfExampleFile(file);
  if (lab === undefined) {
    throw new Error(`통신 실습실: examples/${file}을(를) 여는 실습실을 모르겠어요(esp32/·vision/ 아래에 두어요).`);
  }
  const link = labLink(lab, file);
  return { role, title, href: link.href, lab: link.label };
}

interface Step {
  readonly id: string;
  readonly title: string;
  readonly lead: string;
  readonly examples: readonly ExampleLink[];
  readonly how: readonly string[];
}

const steps: readonly Step[] = [
  {
    id: 'uart',
    title: '유선(시리얼, UART) — 교과서 3-1-2',
    lead: 'USB-UART 변환기라는 선 하나로 컴퓨터와 보드가 글자를 한 바이트씩 주고받아요. 가장 기본이 되는 통신이에요.',
    examples: [
      exampleLink('vision/u3/3-1-2-uart-key-send.py', '컴퓨터 쪽'),
      exampleLink('esp32/u3/3-1-2-uart-laser-site.py', '보드 쪽'),
      exampleLink('esp32/templates/uart-echo.py', '뼈대 코드'),
    ],
    how: [
      '컴퓨터 쪽 예제를 열고 아래 [보내기] 패널의 [한 화면에 가상 보드 열기]를 누르면, 짝이 되는 보드 쪽 예제가 같은 화면에 열려요.',
      '보드 쪽 [실행]을 먼저 누르고, 그다음 컴퓨터 쪽 [실행]을 눌러요. 보드가 꺼져 있을 때 보낸 글자는 실물처럼 사라져요.',
      '실제 USB-UART 변환기가 있으면 실습실의 [USB 데이터 포트] 칸에서 변환기 포트를 따로 열어요(보드 포트와 다른 두 번째 포트예요).',
    ],
  },
  {
    id: 'ble',
    title: '블루투스(BLE) — 교과서 3-1-3·4단원, 블루투스 교안',
    lead: '선 없이 전파로 짧은 글을 주고받아요. 보드가 자기 이름을 알리면(광고) 컴퓨터나 스마트폰이 골라서 연결해요. 한 번에 20바이트까지 보내요.',
    examples: [exampleLink('esp32/bt/b1-ble-receive-print.py', '보드 쪽 첫 실습'), exampleLink('esp32/templates/ble-notify.py', '뼈대 코드')],
    how: [
      '가상 보드 그림 아래 "블루투스(BLE) 조작" 칸이 상대 기기(스마트폰·컴퓨터) 노릇을 해요. [연결]을 누르고 글자를 보내 봐요.',
      `컴퓨터 쪽 블루투스 코드(3-1-3·4단원)와 보드를 한 화면에서 짝지어 돌리려면 ${unit4.title}을 열어요.`,
      '실제 보드는 ESP32 실습실의 블루투스 칸 [블루투스 보드 연결]로 이어요(컴퓨터용 Chrome·Edge). 보드 이름은 ESP32-07처럼 자리 번호로 붙여요.',
    ],
  },
  {
    id: 'mqtt',
    title: '와이파이와 MQTT — 보충 차시 C1',
    lead: '보드가 와이파이로 인터넷에 붙고, 중계 서버를 거쳐 짧은 메시지를 보내고(발행) 받아요(구독). 여러 기기가 같은 메시지를 함께 볼 수 있어요.',
    examples: [exampleLink('esp32/templates/mqtt-pub-sub.py', '뼈대 코드')],
    how: [
      'ESP32 실습실 아래 MQTT 칸에서 통로를 골라요. 기본은 인터넷 없이 되는 "같은 컴퓨터 탭"이라 학교망이 막아도 돼요.',
      '다른 탭에 대시보드나 친구 보드를 열고 통신 접두어(12글자)를 맞추면 서로의 메시지가 오가요.',
      '받는 코드는 허용한 명령(on·off·blink)과 20바이트까지만 받아 LED만 켜고 꺼요. 공개 중계 서버에서는 누가 보낼지 모르기 때문이에요.',
    ],
  },
];

const bridgeExamples: readonly ExampleLink[] = [
  exampleLink('vision/u4/c3-finger-count-send.py', '컴퓨터 쪽'),
  exampleLink('esp32/u4/c3-neopixel-count-rx.py', '보드 쪽'),
];

// 예제 갤러리의 통신 방식 거르기(주소 ?comm=… — src/lab/gallery/filters.ts FILTER_PARAMS)
const galleryLinks = (['uart', 'ble', 'wifi', 'mqtt', 'tab'] as const).map((kind) => ({
  label: EXAMPLE_COMM_LABELS[kind] ?? kind,
  href: `${gallery.href}?comm=${kind}`,
}));
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">{page.description}</p>

  <div class="prose iot-intro">
    <p>
      통신 실습은 <strong>두 화면이 짝</strong>을 이뤄요. 컴퓨터 쪽 코드는 영상처리 실습실에서, 보드 쪽 코드는 ESP32 실습실에서 돌리고, 둘
      사이를 아래 통로 가운데 하나로 이어요. 보드가 없어도 가상 보드와 같은 컴퓨터의 탭끼리 끝까지 해 볼 수 있고, 실제 보드와 변환기가 있으면 같은
      코드를 그대로 써요.
    </p>
    <Callout type="주의" title="공개 중계 서버에는 개인정보를 보내지 않아요">
      <p>
        {bridgeText.publicBrokerNotice()} 수업의 기본 통로는 인터넷을 쓰지 않는 <strong>같은 컴퓨터 탭</strong>이에요. 공개 중계 서버(MQTT)는 학생이
        고를 때만 써요.
      </p>
    </Callout>
  </div>

  <h2 class="iot-heading">통신 계단 — 이 차례로 해 봐요</h2>
  <ol class="iot-steps">
    {
      steps.map((step, index) => (
        <li class="iot-step" id={step.id}>
          <span class="iot-step__number" aria-hidden="true">
            {index + 1}
          </span>
          <div class="iot-step__body">
            <h3 class="iot-step__title">{step.title}</h3>
            <p>{step.lead}</p>
            <ul class="iot-examples">
              {step.examples.map((example) => (
                <li>
                  <span class="iot-examples__role">{example.role}</span>{' '}
                  <a href={example.href}>{example.title}</a> <span class="iot-examples__lab">({example.lab})</span>
                </li>
              ))}
            </ul>
            <ul class="iot-step__how">
              {step.how.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
    <li class="iot-step" id="dashboard">
      <span class="iot-step__number" aria-hidden="true">{steps.length + 1}</span>
      <div class="iot-step__body">
        <h3 class="iot-step__title">대시보드 — 보충 차시 C2</h3>
        <p>
          보드가 보낸 값을 그래프와 게이지로 보고, 스위치를 눌러 보드의 LED를 켜요. 위젯은 끌어서(또는 방향키로) 원하는 자리에 놓아요.
        </p>
        <p>
          <a class="button button--primary" href={dashboard.href}>{dashboard.title} 열기</a>
        </p>
      </div>
    </li>
  </ol>

  <h2 class="iot-heading" id="bridge">인공지능 → 보드(브릿지)</h2>
  <div class="prose">
    <p>영상처리 실습실이 알아낸 것(손가락 개수·좌표·윙크)을 보드로 보내 실제 장치를 움직여요. 인공지능이 알아낸 것으로 보드의 장치를 움직이는, 통신 실습의 마지막 단계예요.</p>
  </div>
  <ul class="iot-bridge">
    <li class="iot-bridge__item">
      <h3 class="iot-step__title">손가락 개수만큼 LED 켜기(보충 C3)</h3>
      <ul class="iot-examples">
        {
          bridgeExamples.map((example) => (
            <li>
              <span class="iot-examples__role">{example.role}</span> <a href={example.href}>{example.title}</a>{' '}
              <span class="iot-examples__lab">({example.lab})</span>
            </li>
          ))
        }
      </ul>
      <p class="iot-bridge__note">
        카메라가 없으면 입력 소스를 "재생 입력"으로 바꾸고 동작을 "손가락 0~5개 펴기"로 골라요. 보드 쪽은 컴퓨터 쪽 화면의 [한 화면에 가상 보드
        열기]로 열면 짝이 저절로 골라져요.
      </p>
    </li>
    <li class="iot-bridge__item">
      <h3 class="iot-step__title">얼굴로 움직인 마우스 좌표를 보드로(4단원)</h3>
      <p>
        카메라, 가상 모니터, 가상 보드를 한 화면에 두고 [함께 실행]을 눌러요. LCD, 서보모터, RGB LED, 레이저, 버저가 반응해요.
      </p>
      <p>
        <a class="button button--secondary" href={unit4.href}>{unit4.title} 열기</a>
      </p>
    </li>
  </ul>

  <h2 class="iot-heading" id="gallery">통신 예제 모아 보기</h2>
  <div class="prose">
    <p>
      <a href={gallery.href}>{gallery.title}</a>에서 통신 방식으로 골라 볼 수 있어요:{' '}
      {
        galleryLinks.map((link, index) => (
          <Fragment>
            <a href={link.href}>{link.label}</a>
            {index < galleryLinks.length - 1 ? ', ' : ''}
          </Fragment>
        ))
      }
      .
    </p>
  </div>

  <h2 class="iot-heading" id="help">잘 안 될 때</h2>
  <div class="prose">
    <ul>
      <li>
        "받을 쪽을 찾지 못했어요"처럼 통신 오류가 나면 <a href={`${errors.href}#comm`}>{errors.title}의 통신 묶음</a>에서 메시지를 찾아봐요.
      </li>
      <li>
        학교망이 공개 중계 서버를 막는지는 <a href={check.href}>{check.title}</a> 페이지의 [시험하기]로 확인해요. 막혀 있어도 같은 컴퓨터 탭 통로로
        실습은 끝까지 돼요.
      </li>
      <li>
        실제 보드를 처음 연결한다면 <a href={board.href}>{board.title}</a>부터 해요. 보드에 코드를 올리는 것은 <a href={esp32.href}>{esp32.title}</a>의
        [실제 보드] 탭이에요.
      </li>
    </ul>
  </div>

  <h2 class="iot-heading">이 실습실의 화면</h2>
  <PageLinks pages={[dashboard, unit4, gallery]} headingLevel={3} />
</BaseLayout>

<style>
  .iot-intro {
    margin-block-end: var(--space-6);
  }

  .iot-heading {
    margin-block: var(--space-10) var(--space-4);
    font-size: var(--text-2xl);
  }

  .iot-steps,
  .iot-bridge {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-prose);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 브릿지 설명 문단과 첫 카드 사이를 띄운다(문단의 아래 여백이 prose 끝에서 사라져 카드에 붙었음 — 2026-09-24 화면 확인) */
  .iot-bridge {
    margin-block-start: var(--space-4);
  }

  .iot-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    scroll-margin-block-start: var(--space-4);
  }

  .iot-step__number {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .iot-step__body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    line-height: var(--leading-body);
  }

  .iot-step__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .iot-examples,
  .iot-step__how {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .iot-examples__role {
    font-weight: var(--weight-semibold);
  }

  .iot-examples__lab {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .iot-step__how {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .iot-bridge__item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    line-height: var(--leading-body);
  }

  .iot-bridge__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
