---
/**
 * 파이썬 실행기·코드 에디터 시험 페이지(개발용, PLAN §8.2 P2-01·P2-02).
 *
 * 영상처리 실습실의 실제 화면은 P2-03이 만든다. 이 페이지는 실습실 공통 틀(src/components/lab/LabShell.astro)이 브라우저에서
 * 제대로 도는지 사람과 브라우저 테스트(tests/e2e/lab-runtime.spec.ts·lab-editor.spec.ts)가 확인하는 곳이다:
 * 코드 에디터(CodeMirror 6), [실행] [정지] [초기화] [예제 불러오기] [공유 링크] [.py 내려받기], 자동 저장, 콘솔, input() 입력줄,
 * [이 컴퓨터에서 내 기록 지우기]. 예제 목록은 시험용 코드 6개다(실습실 예제가 생기면 P2-03의 실습실 페이지가 examples/에서 읽는다).
 * - 사이트 지도(src/config/nav.ts)에 없고, 검색 엔진과 사이트 검색 색인에서 뺀다(noindex, searchIndex=false).
 * - 주소가 /labs/dev/runtime/인 이유: Astro는 이름이 _로 시작하는 파일·폴더를 페이지로 만들지 않아(create-manifest.js)
 *   PLAN에 적힌 src/pages/labs/_dev/ 자리에 두면 주소가 생기지 않는다.
 * - ?limited=1 을 붙이면 JSPI가 있어도 제한 모드(PLAN §4.5)로 동작해 안내와 오류 문구를 볼 수 있다.
 * 테스트가 읽는 값: LabShell 뿌리([data-lab])의 data-state·data-jspi·data-limited·data-outcome·data-stop-ms·data-run-count·
 * data-save-state·data-example·data-share-loaded와 이 페이지의 [data-dev-jspi]·[data-dev-engine].
 */
import BrowserNotice from '../../../../components/compat/BrowserNotice.astro';
import LabShell from '../../../../components/lab/LabShell.astro';
import { getPage } from '../../../../config/nav.ts';
import type { LabExample } from '../../../../lab/controls/examples.ts';
import { PYODIDE_CDN_INDEX_URL, PYODIDE_VERSION } from '../../../../lab/runtime/config.ts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { withBase } from '../../../../lib/url.ts';

const title = '파이썬 실행기 시험(개발용)';
const labs = getPage('labs');
const breadcrumb = [{ label: '홈', href: withBase('') }, { label: labs.label, href: labs.href }, { label: title }];

/** 시험용 예제. 첫 항목이 처음에 편집칸에 들어간다(저장된 마지막 예제가 있으면 그것). */
const examples: LabExample[] = [
  { id: 'hello', title: '인사 출력', code: "print('안녕')\n" },
  {
    id: 'sleep-loop',
    title: '기다리는 반복(정지 1단계)',
    code: "import time\n\ncount = 0\nwhile True:\n    count += 1\n    print('돌고 있어요', count)\n    time.sleep(0.5)\n",
  },
  { id: 'busy-loop', title: '계산만 하는 반복(정지 2단계)', code: 'while True:\n    pass\n' },
  { id: 'input', title: 'input()으로 한 줄 받기', code: "name = input('이름: ')\nprint('안녕, ' + name)\n" },
  { id: 'numpy', title: 'numpy 패키지 불러오기', code: 'import numpy as np\n\nprint(np.arange(3).sum())\n' },
  { id: 'error', title: '오류 내기(NameError)', code: 'print(undefined_name)\n' },
];
---

<BaseLayout
  title={title}
  description="파이썬 워커와 코드 에디터가 브라우저에서 도는지 확인하는 개발용 페이지"
  breadcrumb={breadcrumb}
  width="wide"
  noindex
  searchIndex={false}
>
  <BrowserNotice slot="notice" />
  <h1 class="page-title">{title}</h1>
  <p class="lead">
    영상처리 실습실을 만들기 전에 파이썬 실행기(워커)와 코드 에디터가 이 브라우저에서 도는지 확인하는 페이지예요. 사이트
    메뉴에는 없어요.
  </p>

  <LabShell labId="dev" examples={examples}>
    <section slot="after" class="dev-facts" aria-labelledby="dev-facts-heading">
      <h2 id="dev-facts-heading" class="dev-facts__heading">실행기 정보(개발용)</h2>
      <dl class="dev-facts__list">
        <div>
          <dt>JSPI(파이썬 기다리기 기능)</dt>
          <dd data-dev-jspi>확인 중이에요.</dd>
        </div>
        <div>
          <dt>파이썬 엔진</dt>
          <dd data-dev-engine>Pyodide {PYODIDE_VERSION} — {PYODIDE_CDN_INDEX_URL}</dd>
        </div>
      </dl>
      <div class="prose">
        <h3>이 페이지가 확인하는 것</h3>
        <ul>
          <li>파이썬 엔진(Pyodide)을 jsDelivr에서 받아 워커에서 띄우고 <code>print()</code> 결과가 콘솔에 나오는지.</li>
          <li>[정지] 1단계: <code>time.sleep</code>이나 <code>input()</code>에서 기다리던 코드가 바로 멈추는지(KeyboardInterrupt).</li>
          <li>[정지] 2단계: 계산만 하는 반복문이 파이썬을 다시 시작하는 방식으로 멈추고, 그 뒤에 다시 실행되는지.</li>
          <li>코드 에디터: 새로고침해도 코드가 남는지, 공유 링크를 새 탭에서 열면 같은 코드인지, 기록 지우기 뒤 남는 값이 없는지.</li>
          <li>JSPI가 없는 브라우저의 제한 모드 안내(주소 뒤에 <code>?limited=1</code>).</li>
        </ul>
      </div>
    </section>
  </LabShell>
</BaseLayout>

<script>
  import { getLabController } from '../../../../lab/controls/lab-shell.ts';
  import { envFromWindow, hasJspiApi } from '../../../../lib/capabilities.ts';

  const jspiText = document.querySelector<HTMLElement>('[data-dev-jspi]');
  const engineText = document.querySelector<HTMLElement>('[data-dev-engine]');
  const pageJspi = hasJspiApi(envFromWindow(window).WebAssembly);

  function describe(info: { jspi: boolean; limited: boolean } | null): string {
    const worker = info ? (info.jspi ? '있음' : '없음') : '확인 중';
    const limited = info?.limited ? ' — 제한 모드' : '';
    return `화면 쪽: ${pageJspi ? '있음' : '없음'} · 워커 쪽(can_run_sync): ${worker}${limited}`;
  }

  if (jspiText) {
    jspiText.textContent = describe(null);
  }
  getLabController(document.querySelector<HTMLElement>('[data-lab]'))
    .then((lab) => {
      lab.runtime.on('ready', (info) => {
        if (jspiText) {
          jspiText.textContent = describe(info);
        }
        if (engineText) {
          engineText.textContent = `Pyodide ${info.pyodideVersion} · Python ${info.pythonVersion} — ${info.indexUrl}`;
        }
      });
      if (lab.runtime.info) {
        if (jspiText) {
          jspiText.textContent = describe(lab.runtime.info);
        }
      }
    })
    .catch(() => {
      // 실습실 틀이 없으면 이 정보도 보이지 않는다.
    });
</script>

<style>
  .dev-facts {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .dev-facts__heading {
    margin-block-end: var(--space-3);
    font-size: var(--text-xl);
  }

  .dev-facts__list {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    font-size: var(--text-sm);
  }

  .dev-facts__list > div {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .dev-facts__list dt {
    font-weight: var(--weight-semibold);
  }

  .dev-facts__list dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 39.99rem) {
    .dev-facts__list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
