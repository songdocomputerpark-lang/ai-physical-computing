---
/**
 * 실습실 개요(PLAN §2.1 /labs/). 사이트 지도의 실습실 아래 페이지(영상처리·ESP32·통신·4단원 통합 실습실과 예제 갤러리 — 2026-09-24 Phase 4 통합)를
 * 카드로 보이고, 아직 열리지 않은 것은 언제(어느 Phase에) 열리는지 알린다. 모두 열렸으면 "모두 열렸어요"로 알린다.
 * 카드의 한 줄 설명은 사이트 지도(src/config/nav.ts), 열리는 시점은 ./_labs.ts에서 온다.
 * 할 수 있게 될 일 목록은 각 실습실 페이지에만 둔다(검색 결과에 같은 글이 두 번 나오지 않게).
 * 실습실이 하나씩 생기면 그 카드의 "준비 중" 표시를 떼고 바로 쓰는 안내로 바꾼다.
 *
 * 판 1.3.0(설명 없이 쓰는 사이트): 맨 위에 "무엇을 할까요?" 고르기 3개, 카드는 통째로 눌리고(.card--link) 큰 그림·"이럴 때 써요"·
 * "필요한 것" 칩이 붙는다. 그림·색·한 줄은 ./_lab-cards.ts, 카드 모양 틀(.card …)은 src/styles/global.css.
 */
import Icon from '../../components/common/Icon.astro';
import { getPage } from '../../config/nav.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withParticle } from '../../lib/korean.ts';
import { getLabPlan } from './_labs.ts';
import { LAB_CHOICES, koreanCountWord, labCardInfo } from './_lab-cards.ts';

const page = getPage('labs');
const checkPage = getPage('start-check');
const labs = page.children.map((lab) => ({
  lab,
  plan: getLabPlan(lab.id),
  info: labCardInfo(lab.id),
  subPages: lab.children.map((subPage) => ({ subPage, plan: getLabPlan(subPage.id) })),
}));
// 실제 화면이 열린 실습실(_labs.ts의 open)은 "준비 중" 대신 "열림"으로 보인다.
const openLabTitles = labs.filter(({ plan }) => plan.open).map(({ lab }) => lab.title);
// 아래 페이지(실물 점검 도우미·대시보드)까지 모두 열렸으면 "나머지는 만들고 있어요"·Phase 안내를 빼고 모두 열렸다고 알린다(2026-09-24 Phase 4 통합).
const allOpen = labs.every(({ plan, subPages }) => plan.open === true && subPages.every(({ plan: subPlan }) => subPlan.open === true));
const introLine =
  openLabTitles.length === 0
    ? '실습실은 지금 만들고 있어요. 카드마다 어떤 실습실인지와 언제 열리는지 적어 두었어요.'
    : allOpen
      ? `실습실 ${koreanCountWord(labs.length)} 곳을 모두 쓸 수 있어요. 카드를 눌러 들어가요.`
      : `${withParticle(openLabTitles.join(', '), '은/는')} 열렸어요. 나머지 실습실은 만들고 있고, 카드마다 언제 열리는지 적어 두었어요.`;

// "무엇을 할까요?" 고르기: 사이트 지도에서 제목·주소를 가져온다(없는 id면 빌드가 멈춘다 — getPage).
const choices = LAB_CHOICES.map((choice) => ({
  ...choice,
  targetPage: getPage(choice.target),
  alsoPage: choice.alsoTarget === undefined ? undefined : getPage(choice.alsoTarget),
}));
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">{page.description}</p>

  <div class="choose">
    <h2 class="choose__heading">무엇을 할까요?</h2>
    <ul class="choose__list">
      {
        choices.map((choice, index) => (
          <li class={`card card--link card--u${choice.unit} choose__item`}>
            <span class="card__icon card__icon--lg" aria-hidden="true">
              <Icon name={choice.icon} size="lg" />
            </span>
            <div class="choose__body">
              <a class="card__link choose__ask" href={choice.targetPage.href} aria-describedby={`choose-hint-${index}`}>
                {choice.ask}
              </a>
              <p class="choose__hint" id={`choose-hint-${index}`}>
                <span class="choose__where">{choice.targetPage.title}</span> · {choice.hint}
              </p>
              {choice.alsoPage !== undefined && (
                <p class="choose__also">
                  함께 보기: <a href={choice.alsoPage.href}>{choice.alsoPage.title}</a>
                </p>
              )}
            </div>
            <span class="choose__go" aria-hidden="true">
              <Icon name="arrow-right" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="labs-intro">
    <p>{introLine}</p>
    {!allOpen && <p>Phase는 사이트를 만드는 순서를 뜻해요. 번호가 작은 실습실부터 차례로 열려요.</p>}
    <p>
      실습실은 컴퓨터용 Chrome이나 Edge 최신판에서 가장 잘 돼요. 이 컴퓨터에서 쓸 수 있는지는{' '}
      <a href={checkPage.href}>{checkPage.title}</a> 페이지에서 확인해요.
    </p>
  </div>

  <ul class="lab-cards">
    {
      labs.map(({ lab, plan, info, subPages }) => (
        <li class={`card card--link lab-card${info?.unit === undefined ? '' : ` card--u${info.unit}`}`}>
          <div class="lab-card__head">
            <span class="card__icon card__icon--lg" aria-hidden="true">
              <Icon name={info?.icon ?? 'flask'} size="lg" />
            </span>
            <div class="lab-card__heading">
              <h2 class="lab-card__title">
                <a class="card__link" href={lab.href}>{lab.title}</a>
              </h2>
              {
                /* 열린 실습실은 아무 표시도 없다 — 다섯 장 모두에 "열림"이 붙어 정보가 아니었다(판 1.3.0 R1-103). 위 안내 글이 "모두 쓸 수 있어요"를 한 번 알린다. */
                !plan.open && (
                  <p class="lab-card__status" data-pagefind-ignore>
                    <span class="lab-card__badge">준비 중</span>
                    <span>{plan.when}에 열려요</span>
                  </p>
                )
              }
            </div>
          </div>
          {info !== undefined && (
            <p class="lab-card__use">
              <strong class="lab-card__use-label">이럴 때 써요</strong>
              <span>{info.useWhen}</span>
            </p>
          )}
          {info !== undefined && info.needs.length > 0 && (
            <ul class="lab-card__needs" aria-label="필요한 것">
              {info.needs.map((need) => (
                <li class={`lab-need lab-need--${need.tone}`}>
                  <Icon name={need.icon} size="sm" />
                  <span>{need.text}</span>
                </li>
              ))}
            </ul>
          )}
          <p class="lab-card__description">{lab.description}</p>
          {subPages.map(({ subPage, plan: subPlan }) => (
            <p class="lab-card__sub">
              <a href={subPage.href}>{subPage.title}</a>: {subPage.description}{' '}
              {!subPlan.open && <span data-pagefind-ignore>({subPlan.when}에 열려요)</span>}
            </p>
          ))}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  /* ── 무엇을 할까요? ── */
  .choose {
    margin-block-end: var(--space-8);
  }

  .choose__heading {
    margin-block-end: var(--space-4);
    font-size: var(--text-2xl);
  }

  .choose__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .choose__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .choose__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    /* 세 카드의 안쪽 줄 수가 달라도(셋째만 "함께 보기" 줄이 있다) 그림·질문이 같은 높이에서 시작하게 위쪽 정렬(R1-103) */
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-5);
    /* 왼쪽 단원 색 띠는 그대로 두고 나머지 테두리만 조금 진하게 */
    border-block-color: var(--color-border-strong);
    border-inline-end-color: var(--color-border-strong);
  }

  .choose__body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .choose__ask {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .choose__hint,
  .choose__also {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .choose__where {
    color: var(--card-unit);
    font-weight: var(--weight-semibold);
  }

  .choose__go {
    display: inline-grid;
    color: var(--card-unit);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  /* 눌러 볼 수 있다는 뜻의 화살표: 마우스를 올리거나 초점이 오면 조금 앞으로 */
  .choose__item:hover .choose__go,
  .choose__item:focus-within .choose__go {
    transform: translateX(0.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .choose__item:hover .choose__go,
    .choose__item:focus-within .choose__go {
      transform: none;
    }
  }

  :global(:root[data-motion='reduce']) .choose__item:hover .choose__go,
  :global(:root[data-motion='reduce']) .choose__item:focus-within .choose__go {
    transform: none;
  }

  /* 좁은 화면(휴대폰): 화살표는 빼고 글에 폭을 준다 */
  @media (max-width: 47.99rem) {
    .choose__item {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .choose__item > .choose__go {
      display: none;
    }
  }

  /* ── 안내 글 ── */
  .labs-intro {
    display: grid;
    gap: var(--space-2);
    max-width: var(--width-prose);
    margin-block-end: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .labs-intro p {
    margin: 0;
  }

  /* ── 실습실 카드 ── */
  .lab-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .lab-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .lab-card__heading {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .lab-card__title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .lab-card__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab-card__badge {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
  }

  .lab-card__use {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .lab-card__use-label {
    color: var(--card-unit, var(--color-accent));
    font-size: var(--text-sm);
  }

  /* 필요한 것 칩 */
  .lab-card__needs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-need {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    max-width: 100%;
    padding: 0.125rem var(--space-3) 0.125rem var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .lab-need--ok {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  .lab-card__description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab-card__sub {
    margin: 0;
    padding-block-start: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
