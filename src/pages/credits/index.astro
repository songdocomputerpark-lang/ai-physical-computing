---
// 출처와 라이선스 페이지(PLAN §2.1 /credits/, §8.1 P1-04 ④).
// 임시 껍데기다. P1-05에서 공통 레이아웃(머리글·바닥글)이 생기면 그 레이아웃으로 바꾸고, 본문 컴포넌트는 그대로 쓴다.
import CreditsBody from '../../components/credits/CreditsBody.astro';
import { siteConfig } from '../../config/site.ts';

const pageTitle = '출처와 라이선스';
const documentTitle = `${pageTitle} | ${siteConfig.name}`;
const description = `${siteConfig.name}에 쓰인 자료의 출처와 라이선스를 모아 둔 페이지`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <main class="page">
      <p><a href={import.meta.env.BASE_URL}>{siteConfig.name} 첫 화면으로</a></p>
      <h1>{pageTitle}</h1>
      <CreditsBody />
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    color: #1f2328;
    font-family: system-ui, -apple-system, 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
    line-height: 1.7;
  }
  h1 {
    margin: 0.5rem 0 1rem;
    font-size: 2rem;
    line-height: 1.3;
  }
  a:focus-visible {
    outline: 3px solid #0b57d0;
    outline-offset: 2px;
  }
</style>
