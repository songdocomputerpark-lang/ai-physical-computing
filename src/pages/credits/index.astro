// 출처와 라이선스 페이지(PLAN §2.1 /credits/, §8.1 P1-04 ④). 본문(CreditsBody)은 sources.yaml로 빌드할 때 자동으로 만든다.
import CreditsBody from '../../components/credits/CreditsBody.astro';
