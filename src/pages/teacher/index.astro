---
/**
 * 교사용 자료실 첫 화면(/teacher/)(PLAN §2.1, §8.5 P5-14).
 *
 * - 자료실의 아래 페이지(지도 요약 · 성취기준과 평가 · 원고 정정 · 진짜 PC에서 돌리기 · 자주 묻는 질문) 카드 — 목록은 teacher-pages.ts
 * - 가린 편집본 교안 PDF(PD-31): 파일 이름은 src/components/lesson/handouts.ts 한 곳. public/에 파일이 있으면 [편집본 열기],
 *   없으면 "준비 중". 어느 차시가 몇 쪽을 쓰는지는 차시 md의 handouts 칸에서 빌드 때 모은다(teacher-lessons.ts의 handoutUses).
 * - 판 1.3.0: 맨 위 "수업 준비" 단계 칩, 자료 카드는 통째로 눌리는 카드(.card--link)에 아이콘.
 *   처음 오신 선생님을 위한 "교사용 시작하기" 안내 줄이 단계 위에 있고, 3단계는 수업 화면을 직접 해 볼 첫 차시(1-1-1)로 간다(R1-034).
 * - 판 1.6.0(C175): 3단계 → **4단계**(점검 → 차시 지도 요약 → 수업 화면 → 평가·과제 받는 법). 4단계는 이 쪽의 "평가 자료" 상자로 가고, 그 상자는
 *   편집본 PDF 목록(열한 줄) 위로 올렸다(걷기 B-45: 평가로 가는 길이 쪽 한가운데라 머리 검색으로 찾았다). 상자 글의 "채점 기준이 있는 차시 수"는 빌드 때 센다.
 * - 판 1.7.0(Z3, 미해결 258·259·269): 평가 자료 상자 첫 줄이 "학생에게 나눠 줄 평가지(학습지·문항지)는 아직 없어요 — 대신 확인 퀴즈 정답표와 채점 기준 표"이고
 *   예시 차시(2-1-2)의 교사용 칸으로 가는 링크가 붙는다. 채점 기준 표는 교과서·보충 차시 모두에 있고(개수는 빌드 때 센다) 표만 인쇄·복사하는 단추가 있다(RubricTools.astro).
 *   2단계 "수업 화면 해 보기" 카드는 수업 화면이 바로 켜지는 주소(?view=slide, DECISIONS C133)로 간다.
 * - 편집본 PDF 목록이 가린 까닭 설명보다 앞에 오고, 까닭은 접어 둔다(R1-038). [그 쪽 열기]는 낭독기에서도 구분되는 이름(R1-039).
 * - 평가 자료 자리, 여러 사람이 쓰는 컴퓨터(공용 PC) 확인표(#shared-pc), 앞으로 올라올 자료
 * 원본 파일(PDF·PPTX)을 올리지 않는 방침은 PLAN §3.2·§9.3 6번(PD-31). 준비 중 상자(ComingSoon)는 사이트 검색에서 빠진다.
 */
import { getCollection } from 'astro:content';
import Icon from '../../components/common/Icon.astro';
import PageLinks from '../../components/common/PageLinks.astro';
import ClearRecordsButton from '../../components/lab/ClearRecordsButton.astro';
import { HANDOUT_DOCS, type HandoutDocId } from '../../components/lesson/handouts.ts';
import TeacherNav from '../../components/teacher/TeacherNav.astro';
import { handoutFileExists, handoutFileSize } from '../../components/teacher/handout-files.ts';
import { loadMarkdownDoc } from '../../components/teacher/markdown-docs.ts';
import { loadCorrections } from '../../components/teacher/teacher-data.ts';
import { TEACHER_PATHS, buildTeacherLessons, handoutUses, lessonHeading, rubricExpected, rubricSectionOf } from '../../components/teacher/teacher-lessons.ts';
import { TEACHER_PAGES } from '../../components/teacher/teacher-pages.ts';
import { getPage } from '../../config/nav.ts';
import { PROGRESS_PRIVACY_NOTE } from '../../config/privacy-text.ts';
import { STANDARDS } from '../../config/standards.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url.ts';

const page = getPage('teacher');
const related = ['start-teacher', 'start-check', 'labs-esp32-check', 'credits'].map((id) => getPage(id));
const lessons = buildTeacherLessons(await getCollection('lessons'));
const corrections = loadCorrections();
const faq = await loadMarkdownDoc('content/help/faq-teacher.md');
const correctionCount = corrections.parts.reduce((sum, part) => sum + part.items.length, 0);

/** 카드마다 보이는 숫자(빌드 때 센다) */
const counts: Record<string, string> = {
  guides: `차시 ${lessons.length}개`,
  standards: `성취기준 ${STANDARDS.length}개`,
  corrections: `원고 ${correctionCount}곳, 코드 파일 ${corrections.codeFiles.length}곳`,
  'real-pc': '파이썬 3.10~3.12, mediapipe 0.10.21',
  faq: `질문 ${faq.questions.length}개`,
};

const handoutDocs = (Object.keys(HANDOUT_DOCS) as HandoutDocId[]).map((doc) => ({
  doc,
  title: HANDOUT_DOCS[doc].title,
  exists: handoutFileExists(doc),
  size: handoutFileSize(doc),
  href: withBase(`/${HANDOUT_DOCS[doc].file}`),
}));
const uses = handoutUses(lessons, handoutFileExists);
const missingHandouts = handoutDocs.filter((doc) => !doc.exists);
const formatSize = (bytes: number | undefined): string =>
  bytes === undefined ? '' : bytes >= 1024 * 1024 ? `${(bytes / (1024 * 1024)).toFixed(1)}MB` : `${Math.max(1, Math.round(bytes / 1024))}KB`;
const settings = getPage('settings');
const esp32 = getPage('labs-esp32');
const vision = getPage('labs-vision');
const startTeacher = getPage('start-teacher');
const check = getPage('start-check');
/** 수업 화면을 직접 해 볼 차시: 기준 차시 1-1-1(없으면 첫 차시) */
const tryLesson = lessons.find((lesson) => lesson.summary.label === '1-1-1') ?? lessons[0];
/** 수업 화면이 바로 켜지는 주소(?view=slide — present.ts wantsSlideView, DECISIONS C133). 예전에는 그냥 차시 쪽이라 거기서 [수업 화면]을 또 찾아야 했다(판 1.7.0, 걷기 N3) */
const tryHref = tryLesson ? `${tryLesson.summary.href}?view=slide` : `${startTeacher.href}#presentation`;
/** "### 채점 기준" 표가 교사용 칸에 있는 차시 수(새 차시에 표를 더하면 저절로 늘어난다)와 표가 있어야 하는 차시 수(교과서·보충 차시) */
const rubricCount = lessons.filter((lesson) => rubricSectionOf(lesson) !== undefined).length;
const rubricTarget = lessons.filter(rubricExpected).length;
const rubricAll = rubricCount >= rubricTarget;
/** 평가 자료 상자가 보여 줄 예시 차시: 2-1-2(LCD) — 걷기에서 교사가 따라간 차시. 없으면 표가 있는 첫 차시 */
const exampleLesson = lessons.find((lesson) => lesson.summary.label === '2-1-2' && rubricSectionOf(lesson)) ?? lessons.find((lesson) => rubricSectionOf(lesson));

/** 자료 카드 아이콘(teacher-pages.ts의 id) */
const cardIcons: Record<string, 'list' | 'check-circle' | 'alert' | 'monitor' | 'lifebuoy'> = {
  guides: 'list',
  standards: 'check-circle',
  corrections: 'alert',
  'real-pc': 'monitor',
  faq: 'lifebuoy',
};

/** 수업 준비 4단계 — 단계 칩(판 1.6.0: 평가·과제 받는 법을 4단계로 더함) */
const prepSteps = [
  { id: 'check', title: '교실 컴퓨터 점검', note: '카메라·보드·학교 네트워크가 되는지 봐요', href: check.href },
  { id: 'guides', title: '차시 지도 요약 보기', note: '수업할 차시의 지도 포인트를 읽어요', href: withBase(TEACHER_PATHS.guides) },
  {
    id: 'present',
    title: '수업 화면 해 보기',
    note: `${tryLesson?.summary.label ?? '1-1-1'} 차시가 프로젝터용 큰 화면으로 바로 열려요(끝내기는 Esc). 다른 차시는 쪽 위쪽의 [수업 화면] 단추로 열어요`,
    href: tryHref,
  },
  {
    id: 'assess',
    title: '평가·과제 받는 법',
    note: '채점 기준 표와, 학생 과제를 받는 방법을 봐요',
    href: '#teacher-assessment',
  },
] as const;
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">{page.description}</p>
  <TeacherNav current="home" />

  <section class="teacher-section teacher-section--wide" aria-labelledby="teacher-prep" data-teacher-prep>
    <h2 id="teacher-prep">수업 준비 4단계</h2>
    <p class="teacher-prep__first" data-teacher-first>
      처음 오셨다면 먼저 <a href={startTeacher.href}>{startTeacher.title}</a>(약 5분)를 읽어 보세요. 수업 화면 쓰는 법도 거기 있어요.
    </p>
    <ol class="teacher-prep">
      {
        prepSteps.map((step) => (
          <li class="card card--link teacher-prep__item" data-teacher-prep-step={step.id}>
            <span class="teacher-prep__number" aria-hidden="true" />
            <div>
              <h3 class="teacher-prep__title">
                <a class="card__link" href={step.href}>
                  {step.title}
                </a>
              </h3>
              <p class="teacher-prep__note">{step.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="teacher-section teacher-section--wide" aria-labelledby="teacher-materials">
    <h2 id="teacher-materials">자료 한눈에</h2>
    <p class="teacher-section__intro">지도 요약, 성취기준 표, 원고 정정의 차시별 모음은 각 차시 페이지의 내용을 자동으로 모은 것이에요. 아래 숫자는 지금 사이트 기준이에요.</p>
    <ul class="teacher-cards">
      {
        TEACHER_PAGES.map((item) => (
          <li class="card card--link teacher-card" data-teacher-card={item.id}>
            <span class="card__icon">
              <Icon name={cardIcons[item.id] ?? 'book'} />
            </span>
            <h3 class="teacher-card__title">
              <a class="card__link teacher-card__link" href={item.href}>
                {item.title}
              </a>
            </h3>
            <p class="teacher-card__description">{item.description}</p>
            {counts[item.id] && <p class="teacher-card__count">{counts[item.id]}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="teacher-section" aria-labelledby="teacher-assessment" data-teacher-assessment>
    <h2 id="teacher-assessment">평가 자료</h2>
    <p class="teacher-assessment__first" data-teacher-assessment-first>
      <strong>학생에게 나눠 줄 평가지(학습지·문항지)는 아직 없어요.</strong> 그 대신 교과서 차시와 보충 차시마다 <strong>확인 퀴즈와 정답표</strong>, 그리고{' '}
      <strong>채점 기준 표</strong>(관찰 항목마다 잘함·보통·노력 요함)가 교사용 칸에 있어요.{' '}
      {exampleLesson && (
        <>
          예를 들어 <a href={`${exampleLesson.summary.href}#교사용`} data-teacher-assessment-example>{lessonHeading(exampleLesson)}의 선생님용 칸</a>을 열어 보세요.
        </>
      )}
    </p>
    <p>교과서 자료의 평가 계획서와 운영 계획서도 아직 없어요. 그 대신 아래 자료가 있어요.</p>
    <ul class="teacher-assessment__list">
      <li data-teacher-assessment-rubric>
        <strong>차시마다 채점 기준 표</strong>: {rubricAll ? `교과서·보충 차시 ${rubricTarget}개 모두에 있어요(대단원 마무리·읽기 자료·프로젝트 안내는 빼고요).` : `지금 ${rubricCount}개 차시에 있고, 나머지 차시는 차례로 더해 가요.`}{' '}
        차시 페이지 머리의 <strong>[선생님용]</strong>을 누르면 교사용 칸이 열리고, 맨 위 "한눈에 보기"에서 퀴즈 정답과 채점 기준으로 바로 가요. 평가 포인트(자기 평가 문항·관찰할 곳)도 같은 곳에 있어요.{' '}
        <a href={withBase(TEACHER_PATHS.guides)}>차시별 지도 요약</a>에는 대단원마다 모두 모아 두었어요.
      </li>
      <li data-teacher-assessment-tools>
        <strong>채점 기준 표만 인쇄하거나 복사하기</strong>: 교사용 칸 맨 위와 <a href={withBase(TEACHER_PATHS.guides)}>차시별 지도 요약</a>의 차시마다 <strong>[표 인쇄]</strong>와 <strong>[표 복사]</strong>{' '}
        단추가 있어요. [표 인쇄]는 그 표만 인쇄 창에 보내고, [표 복사]는 표를 탭으로 나눈 글로 복사해서 한글·엑셀·구글 시트에 붙여 넣으면 칸마다 들어가요. 모두 이 컴퓨터 안에서만
        하고 서버로 아무것도 보내지 않아요.
      </li>
      <li>
        <strong>학생 과제 받는 법</strong>: 실습실의 <strong>[공유 링크]</strong>는 편집칸의 코드만 주소에 담아서, 로그인 없이 학생이 보내 준 주소를 열어 과제를 볼 수 있어요. 주소가 너무 길면{' '}
        <strong>[.py 내려받기]</strong> 파일을 함께 내게 해요. 자세한 것은 <a href={`${withBase(TEACHER_PATHS.standards)}#methods`}>성취기준과 평가 방향의 평가 방법</a>에 있어요.
      </li>
      <li>
        <a href={withBase(TEACHER_PATHS.standards)}>성취기준과 평가 방향</a>: 성취기준 15개와 이어지는 차시, 과목 교육과정의 평가 방법(과정 중심 평가, 프로젝트 과정 30% 이상, 생성형 AI 도움 표시), 성취기준마다 평가할 때 볼 것.
        차시 {lessons.length}개를 3학점·4학점 한 학기에 나누는 <a href={`${withBase(TEACHER_PATHS.standards)}#semester`}>학기 배치 제안</a>(사이트 제안)도 있어요.
      </li>
    </ul>
  </section>

  <section class="teacher-section" aria-labelledby="teacher-redacted" data-teacher-handouts>
    <h2 id="teacher-redacted">원본 파일 대신 가린 편집본을 올려요</h2>
    <p>수업 교안은 개인정보를 가린 PDF로 열어요. 차시 페이지의 교사용 칸에서도 같은 파일의 필요한 쪽으로 바로 열 수 있어요.</p>
    <ul class="handout-list">
      {
        handoutDocs.map((doc) => {
          const lessonsUsing = uses.get(doc.doc) ?? [];
          return (
            <li class="handout" data-handout-doc={doc.doc} data-handout-state={doc.exists ? 'ready' : 'pending'}>
              <h3 class="handout__title">{doc.title}</h3>
              <p class="handout__status">
                {doc.exists ? (
                  <>
                    <a href={doc.href}>편집본 열기(PDF{doc.size ? `, ${formatSize(doc.size)}` : ''})</a>
                  </>
                ) : (
                  <span class="handout__pending">준비 중이에요. 파일이 올라오면 이 자리와 차시 교사용 칸의 링크가 함께 열려요.</span>
                )}
              </p>
              {lessonsUsing.length > 0 && (
                <>
                  <p class="handout__uses-title">이 자료를 쓰는 차시</p>
                  <ul class="handout__uses">
                    {lessonsUsing.map((use) => (
                      <li>
                        <a href={use.lesson.summary.href}>{lessonHeading(use.lesson)}</a>
                        {` — ${use.pages}쪽${use.note ? `(${use.note})` : ''}`}
                        {use.path && (
                          <>
                            {' '}
                            <a href={withBase(use.path)}>
                              PDF 열기<span class="visually-hidden">({lessonHeading(use.lesson)} {use.pages}쪽)</span>
                            </a>
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          );
        })
      }
    </ul>
    <details class="handout-why" data-handout-why>
      <summary>왜 원본 대신 가린 편집본을 올리나요?</summary>
      <div class="handout-why__body">
        <p>
          수업 자료의 원본 파일(PDF, PPTX)은 사이트에 올리지 않아요. 원본에는 컴퓨터 안 폴더 경로와 개인 파일 이름, 블루투스 기기 주소, 학급 게시물 화면,
          다른 곳에서 가져온 홍보 그림 속 사람 얼굴 같은 것이 들어 있기 때문이에요.
        </p>
        <p>
          대신 이런 부분을 회색 상자로 지운 편집본만 올려요. 상자 아래의 글자와 그림까지 지워서 복사하거나 검색해도 나오지 않고, 파일 속에 숨은 정보(작성자,
          만든 프로그램 같은 메타데이터)도 지웠어요. 쪽마다 무엇이 보이고 무엇을 가렸는지 확인한 기록도 남겼어요. 실행 화면 속 선생님 얼굴과 표지의 학교
          이름은 저자가 공개를 허락해 그대로 두었어요. 교과서 원고는 PDF 파일로 올리지 않고 내용을 차시 페이지로 옮겼어요.
        </p>
        <p>
          편집본은 저자(박상진, 김석전)의 자료로 CC BY-NC-SA 4.0 조건으로 나눠요. 다만 안에 든 다른 곳의 그림은 원래 조건을 따라요 — 블루투스 통신
          수업 교안 20, 26, 31쪽의 손 랜드마크 번호 그림은 MediaPipe 공식 문서 그림(The MediaPipe Authors, Apache-2.0)이고, 4쪽의 OpenCV 로고와 발표
          슬라이드 틀의 장식도 각 권리자의 것이에요. 자세한 목록은 <a href={withBase('credits/')}>출처와 라이선스</a>에 있어요.
        </p>
      </div>
    </details>
  </section>

  <section class="teacher-section" aria-labelledby="shared-pc">
    <h2 id="shared-pc">여러 사람이 쓰는 컴퓨터(공용 PC)에서</h2>
    <p>
      이 사이트에는 로그인이 없어서, 학생이 쓴 코드와 설정이 그 컴퓨터의 브라우저에 남아요. 다음 반 학생에게 기록이 보이지 않게 수업 전과 뒤에 아래를
      확인해 주세요.
    </p>
    <h3 class="checklist-title">수업이 끝날 때</h3>
    <ul class="checklist" data-shared-pc-checklist>
      <li>
        실습실 아래의 <strong>[이 컴퓨터에서 내 기록 지우기]</strong>를 누르게 해요. 이 사이트가 저장한 코드, 설정, 통신 실습의 무작위 이름이 지워지고 다른 사이트의
        기록은 그대로예요. 선생님 컴퓨터에서는 목록 아래 단추로 바로 지울 수 있어요.
      </li>
      <li>{PROGRESS_PRIVACY_NOTE}</li>
      <li>
        <strong>[.py 내려받기]</strong>나 파일 목록의 [내려받기]로 받은 파일(예: 그린 그림, 화면 캡처)은 컴퓨터의 다운로드 폴더에 남아요. 다음 반이 보지 않게 지워요.
      </li>
      <li>
        <a href={settings.href}>{settings.title}</a>에서 서버 음성 인식을 켰다면 수업 뒤에 꺼요. 이 설정은 그 브라우저에만 저장되고, 기록 지우기를 누르면 함께
        지워져요.
      </li>
      <li>
        실제 보드에 <strong>[보드에 저장]</strong>한 코드(main.py)나 교과서처럼 저장한 boot.py는 보드를 켤 때마다 저절로 돌아요. <a href={esp32.href}
          >{esp32.title}</a
        >의 [실제 보드] 탭으로 연결했을 때 저절로 도는 파일이 있으면 [main.py 끄기]나 [boot.py 끄기]가 보여요. 다음 반이 쓰기 전에 눌러서 끄고(코드는 지워지지
        않아요), 보드가 멈추지 않으면 [보드 되찾기]를 먼저 눌러요.
      </li>
    </ul>
    <ClearRecordsButton id="teacher-room-clear-records" hint={false} />
    <h3 class="checklist-title">수업을 시작할 때</h3>
    <ul class="checklist">
      <li>
        실습실은 처음 열 때 파이썬을 실행하는 파일을 받아요. 교실 컴퓨터마다 <a href={vision.href}>{vision.title}</a>을 한 번 열고 준비 칸의 <strong
          >[이 컴퓨터에 실습 파일 미리 받기]</strong
        >를 눌러 두면 수업 중에 바로 열려요.
      </li>
      <li>
        처음부터 <strong>시크릿 창</strong>(Chrome은 <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>N</kbd>)으로 열면 창을 모두 닫을 때 이 사이트의 저장 기록이 남지 않아요. 다만
        미리 받은 실습 파일도 남지 않아서 실습실이 처음처럼 천천히 열려요.
      </li>
      <li>
        코드, 통신 메시지, 블루투스 보드 이름에 학생 이름이나 학번을 넣지 않게 지도해요. 보드 이름은 <code>ESP32-07</code>처럼 자리 번호로 붙여요.
      </li>
      <li>
        카메라 영상은 이 컴퓨터 밖으로 나가지 않지만, 브라우저는 이 사이트에 준 카메라 허용을 기억해요. 수업 전 확인할 것 전체는 <a href={startTeacher.href}
          >{startTeacher.title}</a
        >에 있어요.
      </li>
    </ul>
  </section>

  <section class="teacher-section" aria-labelledby="teacher-planned">
    <h2 id="teacher-planned">앞으로 올라올 자료</h2>
    <ul class="planned-list">
      <li>학교 서식의 평가 계획서와 운영 계획서: 자료를 받으면 올려요.</li>
      {
        missingHandouts.map((doc) => (
          <li>{doc.title} PDF: 쪽마다 확인을 마치면 올려요.</li>
        ))
      }
      <li>인터넷이 없는 교실에서 쓰는 오프라인 배포판</li>
    </ul>
    <p class="planned-note">
      빠진 자료나 고칠 곳이 있으면 <a href={getPage('contribute').href}>{getPage('contribute').title}</a>의 방법으로 알려 주세요. 자주 묻는 것은 <a
        href={withBase(TEACHER_PATHS.faq)}>선생님이 자주 묻는 질문</a
      >에 있어요.
    </p>
  </section>

  <section class="teacher-section teacher-section--wide" aria-labelledby="teacher-related" data-pagefind-ignore>
    <h2 id="teacher-related">함께 보면 좋은 곳</h2>
    <PageLinks pages={related} headingLevel={3} />
  </section>
</BaseLayout>

<style>
  .teacher-section {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-prose);
    margin-block-start: var(--space-10);
  }

  .teacher-section--wide {
    max-width: none;
  }

  .teacher-section h2 {
    font-size: var(--text-2xl);
    scroll-margin-block-start: var(--space-4);
  }

  .teacher-section__intro {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
  }

  .teacher-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teacher-card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
  }

  .teacher-card__title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  /* 수업 준비 4단계(판 1.6.0): 번호 원(CSS 숫자 — 목록 번호는 낭독기가 알려 주므로 번호 글자는 읽히지 않게)과 한 줄 안내. 넓은 화면에서는 네 칸이 한 줄에 */
  .teacher-prep {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: prep;
  }

  .teacher-prep__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-4);
    counter-increment: prep;
  }

  .teacher-prep__number {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .teacher-prep__number::before {
    content: counter(prep);
    content: counter(prep) / '';
  }

  .teacher-prep__title {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .teacher-prep__note {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .teacher-prep__first {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
  }

  .handout-why {
    max-width: var(--width-prose);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .handout-why > summary {
    min-height: var(--target-min);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .handout-why__body {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  .teacher-card__description {
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }

  .teacher-card__count {
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .handout-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .handout {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
  }

  .handout__title {
    font-size: var(--text-base);
  }

  .handout__pending {
    color: var(--color-text-muted);
  }

  .handout__uses-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .handout__uses {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-inline-start: 1.25em;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .checklist-title {
    font-size: var(--text-lg);
  }

  .checklist,
  .planned-list,
  .teacher-assessment__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.5em;
  }

  .planned-note {
    color: var(--color-text-muted);
  }

  kbd {
    padding: 0.05em 0.35em;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
  }
</style>
