---
/**
 * 없는 주소로 들어왔을 때 보이는 페이지. GitHub Pages가 사이트의 404.html을 404 응답과 함께 보여 준다.
 * 어느 깊이의 주소에서도 열리므로 링크와 검색 상자 주소는 모두 base가 붙은 주소(getPage().href, searchConfig.pageHref)로 쓴다.
 * 검색 엔진·사이트 검색 색인에서 뺀다(noindex, searchIndex={false}).
 * 검색 상자는 자바스크립트 없이도 /search/?q=검색어 로 보낸다.
 *
 * 판 1.3.0: 길을 잃은 사람이 바로 다시 갈 수 있게 ① 큰 검색 상자(폼 이름 "사이트에서 찾아보기" 그대로) ② 주 경로 카드 넷
 * (시작하기·배우기·실습실·문제 해결 — 카드 전체가 눌린다) ③ 기존 링크 목록 순으로 둔다.
 * 검색 상자 폼의 data-suggest가 머리글과 같은 검색 자동 완성을 켠다(구역 B의 search-suggest.ts — 머리글 폼 스크립트가 쪽마다 불러 와 이 폼도 켠다).
 * data-not-found-search는 이 폼을 가리키는 표시다.
 */
import Icon from '../components/common/Icon.astro';
import { getPage } from '../config/nav.ts';
import { searchConfig } from '../config/search.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = getPage('home');
const search = getPage('search');
const help = getPage('help');
const contribute = getPage('contribute');
const routes = [getPage('start'), getPage('learn'), getPage('labs'), help];
---

<BaseLayout
  title="페이지를 찾을 수 없어요"
  description="주소가 바뀌었거나 없는 페이지예요."
  breadcrumb={false}
  noindex
  searchIndex={false}
>
  <h1 class="page-title">페이지를 찾을 수 없어요</h1>
  <p class="lead">주소가 바뀌었거나 아직 없는 페이지예요. 주소를 다시 확인하거나 아래에서 찾아보세요.</p>

  <section class="not-found" aria-labelledby="not-found-search-title">
    <h2 id="not-found-search-title">사이트에서 찾아보기</h2>
    <form
      class="not-found__form"
      role="search"
      aria-labelledby="not-found-search-title"
      action={searchConfig.pageHref}
      method="get"
      data-not-found-search
      data-suggest
    >
      <label class="not-found__label" for="not-found-search-input">검색어</label>
      <div class="not-found__row">
        <span class="not-found__field">
          <span class="not-found__field-icon"><Icon name="search" size="sm" /></span>
          <input
            id="not-found-search-input"
            class="not-found__input"
            type="search"
            name={searchConfig.queryParam}
            placeholder="예: 손 인식, LED"
            autocomplete="off"
            enterkeyhint="search"
          />
        </span>
        <button class="button button--primary button--large" type="submit">검색</button>
      </div>
    </form>
  </section>

  <section class="not-found not-found--routes" aria-labelledby="not-found-routes-title">
    <h2 id="not-found-routes-title">많이 가는 곳</h2>
    <ul class="not-found__routes">
      {
        routes.map((route) => (
          <li class="not-found__route card card--link">
            <span class="card__icon">
              <Icon name={route.icon} />
            </span>
            <h3 class="not-found__route-title">
              <a class="card__link" href={route.href}>
                {route.label}
              </a>
            </h3>
            <p class="not-found__route-description">{route.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="not-found" aria-labelledby="not-found-links-title">
    <h2 id="not-found-links-title">이런 곳으로 가 보세요</h2>
    <ul class="link-list">
      <li><a href={home.href}>첫 화면으로 가기</a></li>
      <li><a href={search.href}>{search.title}</a></li>
      <li><a href={help.href}>{help.title}</a></li>
      <li><a href={contribute.href}>고장 난 링크 알리기({contribute.title})</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* 칸 너비 minmax(0, 1fr)와 입력칸 width 100%: 입력칸 기본 너비가 좁은 화면에서 칸을 넓히지 않게(SearchPage.astro와 같은 이유). */
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    max-width: var(--width-prose);
    margin-block-start: var(--space-8);
  }

  .not-found--routes {
    max-width: none;
  }

  .not-found h2 {
    font-size: var(--text-xl);
  }

  .not-found__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .not-found__label {
    font-weight: var(--weight-semibold);
  }

  .not-found__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* 큰 검색 상자: 돋보기 아이콘이 입력칸 안쪽 왼쪽에 있다 */
  .not-found__field {
    position: relative;
    flex: 1 1 12rem;
    min-width: 0;
  }

  .not-found__field-icon {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--space-4);
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .not-found__input {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4) var(--space-3) 3rem;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-size: var(--text-lg);
  }

  .not-found__input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .not-found__row .button {
    border-radius: var(--radius-full);
  }

  .not-found__routes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .not-found__route {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
  }

  .not-found__route-title {
    font-size: var(--text-lg);
  }

  .not-found__route-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .not-found .link-list a {
    display: inline-block;
    padding-block: var(--space-1);
  }
</style>
