---
/**
 * 없는 주소로 들어왔을 때 보이는 페이지. GitHub Pages가 사이트의 404.html을 404 응답과 함께 보여 준다.
 * 어느 깊이의 주소에서도 열리므로 링크와 검색 상자 주소는 모두 base가 붙은 주소(getPage().href, searchConfig.pageHref)로 쓴다.
 * 검색 엔진·사이트 검색 색인에서 뺀다(noindex, searchIndex={false}).
 * 검색 상자는 자바스크립트 없이도 /search/?q=검색어 로 보낸다.
 *
 * 판 1.3.0: 길을 잃은 사람이 바로 다시 갈 수 있게 ① 큰 검색 상자(폼 이름 "사이트에서 찾아보기" 그대로) ② 주 경로 카드 넷
 * (시작하기·배우기·실습실·문제 해결 — 카드 전체가 눌린다) ③ 기존 링크 목록 순으로 둔다.
 * 검색 상자 폼의 data-suggest가 머리글과 같은 검색 자동 완성을 켠다(구역 B의 search-suggest.ts — 머리글 폼 스크립트가 쪽마다 불러 와 이 폼도 켠다).
 * data-not-found-search는 이 폼을 가리키는 표시다.
 *
 * 판 1.7.1(C224): 메신저·채팅이 한국어 문장 속 주소에 괄호·조사를 붙여 링크로 만들면("…/ai-physical-computing/)가") 여기로 온다.
 * 제목 아래 [data-not-found-suggest] 줄은 스크립트가 주소의 군더더기를 떼고(src/lib/address-cleanup.ts cleanPagePath) 그 쪽이 정말 있는지
 * 받아 본 뒤에만 "혹시 이 쪽을 찾으셨나요?" + 그 쪽 제목 링크로 보인다. 그냥 없는 쪽·인터넷이 끊긴 때는 그대로 숨는다.
 */
import Icon from '../components/common/Icon.astro';
import { getPage } from '../config/nav.ts';
import { searchConfig } from '../config/search.ts';
import { siteConfig } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = getPage('home');
const search = getPage('search');
const help = getPage('help');
const contribute = getPage('contribute');
const routes = [getPage('start'), getPage('learn'), getPage('labs'), help];
---

<BaseLayout
  title="페이지를 찾을 수 없어요"
  description="주소가 바뀌었거나 없는 페이지예요."
  breadcrumb={false}
  noindex
  searchIndex={false}
>
  <h1 class="page-title">페이지를 찾을 수 없어요</h1>
  <p class="lead">주소가 바뀌었거나 아직 없는 페이지예요. 주소를 다시 확인하거나 아래에서 찾아보세요.</p>
  <p class="not-found__suggest" data-not-found-suggest data-site-name={siteConfig.name} hidden>
    <span class="not-found__suggest-lead">혹시 이 쪽을 찾으셨나요?</span>
    <a class="not-found__suggest-link" href={home.href} data-not-found-suggest-link>{home.label}</a>
    <span class="not-found__suggest-note">주소 끝에 괄호나 글자가 붙어 있었어요. 위 링크를 눌러 주세요.</span>
  </p>

  <section class="not-found" aria-labelledby="not-found-search-title">
    <h2 id="not-found-search-title">사이트에서 찾아보기</h2>
    <form
      class="not-found__form"
      role="search"
      aria-labelledby="not-found-search-title"
      action={searchConfig.pageHref}
      method="get"
      data-not-found-search
      data-suggest
    >
      <label class="not-found__label" for="not-found-search-input">검색어</label>
      <div class="not-found__row">
        <span class="not-found__field">
          <span class="not-found__field-icon"><Icon name="search" size="sm" /></span>
          <input
            id="not-found-search-input"
            class="not-found__input"
            type="search"
            name={searchConfig.queryParam}
            placeholder="예: 초음파 센서, LED 배선, NameError"
            autocomplete="off"
            enterkeyhint="search"
          />
        </span>
        <button class="button button--primary button--large" type="submit">검색</button>
      </div>
    </form>
  </section>

  <section class="not-found not-found--routes" aria-labelledby="not-found-routes-title">
    <h2 id="not-found-routes-title">많이 가는 곳</h2>
    <ul class="not-found__routes">
      {
        routes.map((route) => (
          <li class="not-found__route card card--link">
            <span class="card__icon">
              <Icon name={route.icon} />
            </span>
            <h3 class="not-found__route-title">
              <a class="card__link" href={route.href}>
                {route.label}
              </a>
            </h3>
            <p class="not-found__route-description">{route.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="not-found" aria-labelledby="not-found-links-title">
    <h2 id="not-found-links-title">이런 곳으로 가 보세요</h2>
    <ul class="link-list">
      <li><a href={home.href}>{home.label}</a></li>
      <li><a href={search.href}>{search.title}</a></li>
      <li><a href={contribute.href}>고장 난 링크 알리기({contribute.title})</a></li>
    </ul>
  </section>
</BaseLayout>

<script>
  import { cleanPagePath, pageTitleFromHtml } from '../lib/address-cleanup.ts';

  // 주소 끝의 괄호·조사·마침표를 떼어 본 주소의 쪽이 정말 있을 때만 그 쪽을 알린다(받아 보기 전에는 숨김 — 틀린 안내를 하지 않게)
  const box = document.querySelector<HTMLElement>('[data-not-found-suggest]');
  const link = box?.querySelector<HTMLAnchorElement>('[data-not-found-suggest-link]');
  const target = cleanPagePath(window.location.pathname);
  if (box && link && target) {
    void (async () => {
      try {
        const response = await fetch(target, { credentials: 'same-origin' });
        if (!response.ok) {
          return;
        }
        const title = pageTitleFromHtml(await response.text(), box.dataset.siteName ?? '');
        link.href = `${target}${window.location.search}${window.location.hash}`;
        link.textContent = title ?? target;
        box.hidden = false;
      } catch {
        // 인터넷이 끊겼거나 받지 못하면 안내하지 않는다(아래 검색·카드는 그대로)
      }
    })();
  }
</script>

<style>
  /* 판 1.7.1(C224): 고친 주소 안내 — 제목 바로 아래 강조 상자, 링크는 크게(가장 먼저 누를 곳) */
  .not-found__suggest {
    display: grid;
    gap: var(--space-1);
    max-width: var(--width-prose);
    margin-block-start: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-accent-border);
    border-inline-start-width: 4px;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .not-found__suggest[hidden] {
    display: none;
  }

  .not-found__suggest-lead {
    font-weight: var(--weight-semibold);
  }

  .not-found__suggest-link {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }

  .not-found__suggest-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* 칸 너비 minmax(0, 1fr)와 입력칸 width 100%: 입력칸 기본 너비가 좁은 화면에서 칸을 넓히지 않게(SearchPage.astro와 같은 이유). */
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    max-width: var(--width-prose);
    margin-block-start: var(--space-8);
  }

  .not-found--routes {
    max-width: none;
  }

  .not-found h2 {
    font-size: var(--text-xl);
  }

  .not-found__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .not-found__label {
    font-weight: var(--weight-semibold);
  }

  .not-found__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* 큰 검색 상자: 돋보기 아이콘이 입력칸 안쪽 왼쪽에 있다 */
  .not-found__field {
    position: relative;
    flex: 1 1 12rem;
    min-width: 0;
  }

  .not-found__field-icon {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--space-4);
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .not-found__input {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4) var(--space-3) 3rem;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-size: var(--text-lg);
  }

  .not-found__input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .not-found__row .button {
    border-radius: var(--radius-full);
  }

  .not-found__routes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .not-found__route {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-2);
  }

  .not-found__route-title {
    font-size: var(--text-lg);
  }

  .not-found__route-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .not-found .link-list a {
    display: inline-block;
    padding-block: var(--space-1);
  }
</style>
