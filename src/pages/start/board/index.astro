---
/**
 * 보드 준비하기(PLAN §2.1, §8.1 P1-08 → §8.3 P3-10 완성). 시나리오 C(SPEC §13): 보드 준비 → 드라이버 안내 → [펌웨어 굽기] 원클릭 → 예제 [실행] → 실제 LED.
 *
 * 흐름(PLAN P3-10 "보드를 먼저 꽂고 [연결] → [포트 선택 창에 보드가 안 보여요] → ① 충전 전용 케이블 ② 장치 관리자 그림 ③ 드라이버 공식 링크")
 *   1단계 #kit-list      준비물 · #cable 데이터 케이블(그림)
 *   2단계 #connect       [보드 연결] — 포트 선택 창 → MicroPython 확인 → 내장 LED 세 번(ConnectCheck, 연결 코드는 구역 E의 src/lab/serial/)
 *         #port-not-found "포트 선택 창에 보드가 안 보여요"(PortHelp: 케이블 → 장치 관리자 그림 → 드라이버·자동 설치 근거·전산 담당 부탁 글 → Linux)
 *   3단계 #firmware      MicroPython 굽기(FirmwareFlasher, P3-09)
 *   4단계 #first-example 2-1-1 차시의 내장 LED 예제를 ESP32 실습실 [실제 보드]에서 실행
 *   참고  #kit-parts     키트 모듈명 ↔ 범용 부품 표(꽂는 예·표는 접힌 상자 안), #safety 안전
 *
 * 쪽 길이(판 1.7.0, 미해결 262 옛 #4 — 걷기 보고 walk-student-board: 쪽 높이 6,054px, 오른쪽 40%가 빈 칸):
 *   ① "순서 한눈에 보기"는 64rem 이상에서 오른쪽 빈 칸으로 옮겨 따라오고(sticky, 키가 낮은 화면은 따라오지 않음), 지금 보는 단계에 aria-current="step"을 단다.
 *      좁은 화면에서는 전처럼 쪽 맨 위에 한 번만 나온다(DOM 순서도 그대로 — 차례가 본문 앞).
 *   ② "키트에 부품을 꽂는 예"(회로 그림)와 "키트 부품 이름 표"는 지금 당장 필요하지 않은 참고라 하나의 접힌 상자(details[data-kit-parts-details]) 안으로.
 *      제목 #kit-parts는 상자 밖에 두어 다른 쪽의 링크(부품 사전·1단계)가 상자를 열지 않고도 닿고, 안쪽 #kit-example은 브라우저가 상자를 열어 준다.
 *   단계 순서(1→4)와 details#port-not-found(연결이 안 될 때 — PortHelp 안에는 details를 더 두지 않는다)는 그대로다.
 * 다른 곳이 쓰는 #위치: #port-not-found(실습실 실제 보드 패널·굽기 화면·도움말), #firmware(실습실 "펌웨어 굽기 안내"), #drivers·#linux.
 * 드라이버는 만든 회사의 공식 페이지 링크로만 안내하고 파일은 올리지 않는다(INVENTORY §2, SPEC 원칙 1의 허용 예외). 주소·근거는 src/components/start/board/links.ts.
 * 2-1-1 차시 md(P5)가 생기면 그 차시로, 없으면 II단원 차례로 잇는다(빌드할 때 content/lessons를 읽는다).
 * .astro는 줄바꿈이 든 글과 태그 사이 공백을 지우므로(CLAUDE.md) 글 속 링크·강조는 한 줄에 적는다.
 */
import { getCollection } from 'astro:content';
import Callout from '../../../components/common/Callout.astro';
import CircuitFigure from '../../../components/circuits/CircuitFigure.astro';
import BrowserNotice from '../../../components/compat/BrowserNotice.astro';
import FirmwareFlasher from '../../../components/lab/firmware/FirmwareFlasher.astro';
import { CURRICULUM } from '../../../components/lesson/curriculum.ts';
import { publishedLessons } from '../../../components/lesson/lesson-data.ts';
import CableFigure from '../../../components/start/CableFigure.astro';
import ConnectCheck from '../../../components/start/board/ConnectCheck.astro';
import KitPartsTable from '../../../components/start/board/KitPartsTable.astro';
import PortHelp from '../../../components/start/board/PortHelp.astro';
import { getLearnUnit, getPage } from '../../../config/nav.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/url.ts';

const page = getPage('start-board');
const esp32Lab = getPage('labs-esp32');
const kitPage = getPage('labs-esp32-kit');

/** 시나리오 C의 첫 예제: 교과서 2-1-1 "동작 테스트: 내장 LED 깜빡이기"(원본 f046, 사이드카 examples/esp32/u2/2-1-1-blink-check.meta.yaml) */
const FIRST_LESSON_LABEL = '2-1-1';
const FIRST_EXAMPLE_FILE = 'esp32/u2/2-1-1-blink-check.py';
const firstExampleHref = `${esp32Lab.href}?example=${encodeURIComponent(FIRST_EXAMPLE_FILE)}`;

const lessons = publishedLessons(await getCollection('lessons'));
const publishedFirst = lessons.find((lesson) => lesson.label.toLowerCase() === FIRST_LESSON_LABEL);
const plannedFirst = CURRICULUM.flatMap((unit) => unit.sections)
  .flatMap((section) => section.lessons)
  .find((lesson) => lesson.label === FIRST_LESSON_LABEL);
const unit2 = getLearnUnit(2);
const firstLesson = publishedFirst
  ? { href: publishedFirst.href, label: `${publishedFirst.label} ${publishedFirst.title}`, ready: true }
  : { href: unit2.href, label: `${FIRST_LESSON_LABEL} ${plannedFirst?.title ?? ''}`.trim(), ready: false };

const flow = [
  { href: '#kit-list', name: '준비물과 케이블 확인하기', hint: '데이터가 오가는 USB 케이블인지 봐요.' },
  { href: '#connect', name: '보드를 꽂고 [보드 연결] 누르기', hint: 'MicroPython이 있는지 알려 주고 내장 LED를 깜빡여요.' },
  { href: '#firmware', name: '보드에 MicroPython 굽기', hint: '보드에 프로그램을 넣는 일이에요. 처음 한 번, 단추 하나로 해요.' },
  { href: '#first-example', name: '첫 예제로 LED 깜빡이기', hint: 'ESP32 실습실에서 교과서 2-1-1 예제를 실행해요.' },
] as const;
---

<BaseLayout title={page.title} description={page.description}>
  <BrowserNotice slot="notice" />
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">ESP32 보드를 USB 케이블로 컴퓨터에 연결하고, 보드에 MicroPython을 넣은 뒤 첫 예제로 LED를 깜빡여요.</p>

  <div class="prose">
    <Callout type="참고" title="보드가 없어도 괜찮아요">
      <p>ESP32 실습실의 가상 보드는 실제 보드와 같은 코드로 움직여요. 보드가 없으면 <a href={esp32Lab.href}>{esp32Lab.title}</a>의 가상 보드로 실습하고, 보드가 생기면 이 페이지로 돌아와요.</p>
    </Callout>
  </div>

  <div class="board-layout" data-page-wide>
  <div class="board-layout__side">
  <nav class="board-flow" aria-labelledby="board-flow-title" data-board-flow>
    <h2 class="board-flow__title" id="board-flow-title">순서 한눈에 보기</h2>
    <p class="board-flow__note">처음 연결하는 보드 한 대에 15분쯤으로 잡아요(펌웨어 굽기 1~2분 포함). 실제 보드로 재 본 값은 아니에요.</p>
    <ol class="board-flow__list">
      {
        flow.map((step, index) => (
          <li class="board-flow__item">
            <a class="board-flow__link" href={step.href}>
              <span class="board-flow__number" aria-hidden="true">{index + 1}</span>
              <span class="board-flow__text">
                <span class="board-flow__name">{step.name}</span>
                <span class="board-flow__hint">{step.hint}</span>
              </span>
            </a>
            {index === 1 && (
              <p class="board-flow__branch">
                목록에 보드가 없으면 <a href="#port-not-found">케이블·장치 관리자·드라이버 확인</a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
    <p class="board-flow__more">맨 아래 참고: <a href="#kit-parts">키트 부품 이름</a> · <a href="#safety">안전하게 쓰기</a></p>
  </nav>
  </div>

  <div class="board-layout__main">
  <div class="prose">
    <h2 id="kit-list"><span class="board-step">1단계</span> 준비물과 케이블 확인하기</h2>
    <ul>
      <li>ESP32 개발 보드(교과서 키트는 확장 보드에 꽂아서 써요)</li>
      <li>데이터를 주고받을 수 있는 USB 케이블(교과서 키트의 보드는 USB-C 단자예요)</li>
      <li>컴퓨터와 컴퓨터용 Chrome이나 Edge 최신판(보드 연결과 펌웨어 굽기는 컴퓨터에서 해요)</li>
      <li>실습할 부품 모듈(차시마다 달라요 — 이름은 아래 <a href="#kit-parts">키트 부품 이름 맞춰 보기</a> 표에 있어요)</li>
    </ul>
    <p class="board-kit-link" data-board-kit-link>키트에 든 센서·부품을 하나씩 찾아보려면 <a href={kitPage.href}>{kitPage.title}</a>에서 사진, 배선, 예제 코드를 볼 수 있어요.</p>

    <h3 id="cable">USB 케이블 확인하기</h3>
    <Callout type="참고" title="충전 전용 케이블로는 연결되지 않아요">
      <p>보드에 불이 들어와도 컴퓨터가 보드를 못 알아보면 케이블부터 바꿔 봐요. 휴대폰과 컴퓨터 사이에 사진을 옮길 수 있었던 케이블처럼 데이터가 오가는 케이블이면 돼요.</p>
    </Callout>
  </div>
  <CableFigure />

  <div class="prose">
    <h2 id="connect"><span class="board-step">2단계</span> 보드를 꽂고 연결하기</h2>
    <ol>
      <li>보드를 USB 케이블로 컴퓨터에 <strong>먼저</strong> 꽂아요. USB 허브나 연장선 대신 컴퓨터의 USB 단자(노트북은 옆면)에 바로 꽂아요.</li>
      <li>아래 [보드 연결]을 누르면 브라우저가 포트 선택 창을 열어요. 포트는 컴퓨터가 보드와 신호를 주고받는 통로예요.</li>
      <li>목록에서 보드를 고르고 [연결]을 눌러요. Windows에서는 "USB-SERIAL CH340 (COM3)"처럼 USB와 COM 번호가 들어간 이름이에요. 맥·크롬북은 <a href="#mac-chromebook">아래 안내</a>를 봐요.</li>
      <li>보드에 MicroPython이 있으면 내장 LED가 세 번 깜빡여요. 없다고 나오면 3단계에서 구워요.</li>
    </ol>
  </div>
  <ConnectCheck />

  <section class="board-section" aria-labelledby="port-help-title">
    <h2 id="port-help-title">연결이 안 될 때</h2>
    <p class="board-section__lead">포트 선택 창의 목록에 보드가 없거나 연결이 자꾸 끊기면 아래 안내를 펼쳐 차례로 확인해요.</p>
    <PortHelp />
  </section>

  <div class="prose">
    <h2 id="firmware"><span class="board-step">3단계</span> 보드에 MicroPython 굽기</h2>
    <p>굽기는 보드에 프로그램을 넣는 일이에요. 아래 <strong>[펌웨어 굽기 시작]</strong> 단추를 한 번 누르면 1~2분 안에 끝나요. 2단계에서 "MicroPython이 있어요"가 나왔다면 건너뛰어도 돼요.</p>
    <p>펌웨어는 보드에 미리 들어 있어야 하는 기본 프로그램이에요. 이 사이트의 예제는 보드용 파이썬인 MicroPython 펌웨어가 있어야 실제 보드에서 돌아요.</p>
  </div>
  <FirmwareFlasher headingLevel={3} labHref={firstExampleHref} checkHref="#connect" />

  <div class="prose">
    <h2 id="first-example"><span class="board-step">4단계</span> 첫 예제로 LED 깜빡이기</h2>
    <p>교과서 2-1-1 차시의 "동작 테스트: 내장 LED 깜빡이기" 예제를 실제 보드에서 실행해요.</p>
    <ol class="first-example__steps">
      <li><a class="button button--primary" href={firstExampleHref}>ESP32 실습실에서 첫 예제 열기</a></li>
      <li>입력·출력 칸 위의 [실제 보드] 탭을 누르고 [보드 연결]로 이 보드를 골라요.</li>
      <li>[실행]을 눌러요. 보드의 초록색 내장 LED가 0.5초마다 깜빡이면 준비 끝이에요.</li>
      <li>[정지]를 누르면 멈춰요. 이 코드는 보드에 저장되지 않아서 USB를 뽑으면 사라져요.</li>
    </ol>
    {
      firstLesson.ready ? (
        <p class="first-example__lesson">
          차시: <a href={firstLesson.href} data-first-lesson="lesson">{firstLesson.label}</a>
        </p>
      ) : (
        <p class="first-example__lesson">
          차시: {firstLesson.label}(차시 글은 준비 중이에요 — <a href={firstLesson.href} data-first-lesson="unit">{unit2.title} 단원 차례</a>에서 자리를 볼 수 있어요)
        </p>
      )
    }
    <Callout type="참고" title="보드 없이 먼저 해 보기">
      <p>같은 예제를 [가상 보드] 탭에서 [실행]하면 화면 속 보드의 내장 LED가 똑같이 깜빡여요. 실제 보드에서 결과가 다르면 이 페이지의 2단계부터 다시 확인해요.</p>
    </Callout>

    <h2 id="kit-parts">키트 부품 이름 맞춰 보기</h2>
    <p>지금 당장 필요하지 않은 참고예요. 부품을 사거나 찾을 때 아래 상자를 펼쳐 봐요.</p>
  </div>
  <details class="board-details" data-kit-parts-details>
    <summary>키트에 부품을 꽂는 예와 부품 이름 표 펼치기(16줄)</summary>
    <div class="prose">
      <h3 id="kit-example">키트에 부품을 꽂는 예</h3>
      <p>부품 모듈의 선을 확장 보드의 줄에 꽂아요. 검정 선은 GND, 빨강 선은 VCC, 노란 선은 신호선이에요. 아래 그림은 LCD를 21번(SDA)·22번(SCL) 핀에 꽂은 예예요.</p>
      <p>배선이 있는 차시에는 차시 머리에 [실제 키트 배선 보기]가 있어요. 부품 모양은 <a href={withBase('start/parts/')}>부품 사전</a>에서 볼 수 있어요.</p>
      <CircuitFigure id="2-1-2-1" />
      <h3 id="kit-name-table">키트 부품 이름 표</h3>
      <p>교과서 키트의 부품 이름과, 다른 회사 부품을 살 때 찾아보는 범용 이름을 나란히 적었어요. 핀 번호는 차시마다 달라서, 실습할 때는 그 차시의 배선도(ESP32 실습실 보드 그림)를 따라요.</p>
    </div>
    <KitPartsTable />
    <div class="prose">
      <p class="board-note">표가 화면보다 넓으면 옆으로 밀어서 보세요. "실물 확인 전"은 원고 사진과 코드로만 확인해서, 실제 키트로 한 번 더 확인할 점이에요.</p>
      <p class="board-note">사진은 부품 사전의 예시 사진이에요. 키트에 따라 모양이 다를 수 있어요. <a href={withBase('start/parts/')}>부품 사전에서 모두 보기</a></p>
    </div>
  </details>
  <div class="prose">

    <h2 id="safety">안전하게 쓰기</h2>
    <Callout type="주의" title="부품을 다룰 때 지켜요">
      <ul>
        <li>레이저 빛을 눈이나 다른 사람 쪽으로 비추지 않아요.</li>
        <li>팬이 도는 동안 날개에 손대지 않아요.</li>
        <li>배선을 바꿀 때는 먼저 USB 케이블을 뽑아요.</li>
        <li>모터나 서보를 여러 개 쓰면 USB 전원이 모자랄 수 있어요. 확장 보드에 전원 스위치가 있다면 켜져 있는지 확인해요.</li>
      </ul>
    </Callout>
  </div>
  </div>
  </div>
</BaseLayout>

<script>
  // "순서 한눈에 보기"에서 지금 보는 단계에 aria-current="step"을 단다(스크롤할 때만 — 링크를 눌러 이동해도 같은 규칙이 맞춘다).
  // 기준선: 화면 위에서 30% 지점을 지난 마지막 단계 제목. 아직 1단계 제목에 닿기 전이면 아무 것도 달지 않는다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-board-flow] .board-flow__link')];
  const headings = links.map((link) => document.getElementById(decodeURIComponent(link.hash.replace(/^#/u, ''))));

  const update = (): void => {
    const line = window.innerHeight * 0.3;
    let current = -1;
    headings.forEach((heading, index) => {
      if (heading && heading.getBoundingClientRect().top <= line) {
        current = index;
      }
    });
    links.forEach((link, index) => {
      if (index === current) {
        link.setAttribute('aria-current', 'step');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  if (links.length > 0 && headings.every((heading) => heading !== null)) {
    let queued = false;
    const schedule = (): void => {
      if (queued) {
        return;
      }
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  /*
   * 두 칸 틀(판 1.7.0, 미해결 262): 좁은 화면은 한 칸(차례가 본문 앞에 한 번), 64rem 이상은 왼쪽 본문 + 오른쪽 "순서 한눈에 보기"(따라옴).
   * 본문 칸의 글 덩어리는 전처럼 글 읽기 폭(44rem)을 넘지 않고, 접힌 상자의 표만 칸 폭을 다 쓴다.
   */
  .board-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .board-layout__side,
  .board-layout__main {
    min-width: 0;
  }

  .board-layout__main > :global(*) {
    max-width: var(--width-prose);
  }

  .board-layout__main > :global(details) {
    max-width: none;
  }

  @media (min-width: 64rem) {
    .board-layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
      column-gap: var(--space-10);
      align-items: start;
    }

    .board-layout__side {
      grid-column: 2;
      grid-row: 1;
    }

    .board-layout__main {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* 키가 충분한 화면에서만 따라온다 — 낮은 화면에서 차례가 화면보다 길어 아래가 잘리는 일이 없게(스크롤 칸을 만들지 않는다) */
  @media (min-width: 64rem) and (min-height: 44rem) {
    .board-layout__side {
      position: sticky;
      inset-block-start: var(--space-4);
    }
  }

  .board-details {
    margin-block: var(--space-4);
  }

  .board-details > summary {
    min-height: var(--target-min);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .board-flow {
    max-width: var(--width-prose);
    margin-block: 0 var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .board-flow__title {
    margin-block-end: var(--space-2);
    font-size: var(--text-lg);
  }

  .board-flow__note {
    margin-block-end: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .board-flow__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .board-flow__item {
    display: grid;
    gap: var(--space-1);
  }

  .board-flow__link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }

  .board-flow__link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .board-flow__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .board-flow__number {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-bold);
  }

  .board-flow__text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .board-flow__name {
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .board-flow__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .board-flow__branch {
    margin: 0;
    padding-inline-start: calc(2.25rem + var(--space-3) + var(--space-3));
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .board-flow__branch::before {
    content: '↳ ';
    color: var(--color-text-muted);
  }

  .board-step {
    display: inline-block;
    margin-inline-end: var(--space-1);
    padding: 0.05em 0.5em;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: 0.8em;
    vertical-align: 0.1em;
  }

  .board-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .board-section {
    max-width: var(--width-prose);
    margin-block-start: var(--space-12);
  }

  .board-section > h2 {
    margin-block-end: var(--space-2);
    font-size: var(--text-2xl);
  }

  .board-section__lead {
    margin-block-end: var(--space-4);
  }

  .first-example__lesson {
    font-weight: var(--weight-semibold);
  }

  /* 지금 보는 단계(board-flow.ts 아래 스크립트가 aria-current="step"을 단다) — 색만이 아니라 테두리 두께와 번호 칸 모양으로도 구별한다 */
  .board-flow__link[aria-current='step'] {
    border-width: 2px;
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px);
  }

  .board-flow__link[aria-current='step'] .board-flow__number {
    border-radius: var(--radius-sm);
  }

  .board-flow__more {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .board-kit-link {
    font-size: var(--text-sm);
  }

  /* 옆 칸의 차례: 설명(hint)은 본문 제목 아래에 이미 있으니 이름만 보여 짧게 */
  @media (min-width: 64rem) {
    .board-flow {
      padding: var(--space-4);
    }

    .board-flow__hint {
      display: none;
    }

    .board-flow__title {
      font-size: var(--text-base);
    }

    .board-flow__branch {
      padding-inline-start: var(--space-3);
    }
  }

  @media (max-width: 30rem) {
    .board-flow {
      padding: var(--space-4);
    }

    .board-flow__branch {
      padding-inline-start: var(--space-3);
    }
  }
</style>
