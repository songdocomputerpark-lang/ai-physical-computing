<script>
  // 전산 담당 부탁 글 복사(클립보드를 쓸 수 없으면 글을 골라 두어 Ctrl+C로 복사하게 한다)
  const copyButton = document.querySelector<HTMLButtonElement>('[data-teacher-request-copy]');
  const requestText = document.querySelector<HTMLElement>('[data-teacher-request-text]');
  const copyStatus = document.querySelector<HTMLElement>('[data-teacher-request-status]');
  copyButton?.addEventListener('click', async () => {
    const text = requestText?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      if (copyStatus) {
        copyStatus.textContent = '복사했어요. 메신저나 메일에 붙여 넣어요.';
      }
    } catch {
      if (requestText) {
        const range = document.createRange();
        range.selectNodeContents(requestText);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      if (copyStatus) {
        copyStatus.textContent = '글을 골라 두었어요. Ctrl+C를 눌러 복사해요.';
      }
    }
  });
</script>

