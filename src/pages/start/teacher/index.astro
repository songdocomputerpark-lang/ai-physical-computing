---
/**
 * 교사용 시작하기(PLAN §2.1, §8.1 P1-08, §10).
 * - 성취기준·평가 방향 표는 영역 요약만 두고, 자세한 표(성취기준 15개·이어지는 차시·평가할 때 볼 것)는 교사용 자료실 /teacher/standards/(P5-14)로
 *   잇는다(2026-09-25 Phase 5 통합). 학교 네트워크 체크리스트와 통신 수업 안내는 Phase 2·4에서 채웠다
 *   (2026-09-24 Phase 4 통합 — 공개 중계 서버 안전 규칙 PLAN §7.4·PD-29 "교사용 안내에 실물 구동 장치는 공개 브로커에 연결하지 않기").
 * - 개인정보 처리 안내는 법률 자문이 아니다(맨 끝에 한 번만 밝힌다). 맨 위에 결론 세 줄을 두고 외부 연결 표는 접어 둔다(판 1.3.0 R1-045).
 *   외부 연결 표의 사실과 링크는 2026-09-16에 공식 문서로 확인했다:
 *   GitHub Pages 방문자 IP 기록(GitHub Docs "GitHub Pages란?"), jsDelivr 수집 항목(jsDelivr Privacy Policy, 2023-11-23 시행),
 *   test.mosquitto.org의 공개 발행·구독 안내, Chrome 음성 인식의 서버 처리(MDN SpeechRecognition).
 *   표의 데이터는 ./_connections.ts에 있고, 공개 중계 서버 줄은 실습실이 고를 수 있는 서버 목록(src/lab/mqtt/brokers.ts)에서 만든다
 *   (2026-09-30 최종 점검 — 판 1.1.0에 더한 HiveMQ가 이 표에서 빠져 있었다. HiveMQ 처리방침은 그날 확인).
 * - 성취기준 영역·코드는 INVENTORY §9.2(인천광역시교육청 게시 교육과정, hwp 원문 대조 전)를 따른다(DECISIONS C8).
 */
import Callout from '../../../components/common/Callout.astro';
import ClearRecordsButton from '../../../components/lab/ClearRecordsButton.astro';
import { getPage } from '../../../config/nav.ts';
import { PROGRESS_PRIVACY_NOTE } from '../../../config/privacy-text.ts';
import { siteConfig } from '../../../config/site.ts';
import { PYODIDE_CDN_INDEX_URL } from '../../../lab/runtime/config.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { connections, listedBrokers } from './_connections.ts';

const page = getPage('start-teacher');
const check = getPage('start-check');
const student = getPage('start-student');
const board = getPage('start-board');
const boardCheck = getPage('labs-esp32-check');
const teacherRoom = getPage('teacher');
const standardsHref = `${teacherRoom.href}standards/`;
const faqHref = `${teacherRoom.href}faq/`;
const learn = getPage('learn');
const settings = getPage('settings');
const visionLab = getPage('labs-vision');
const iotLab = getPage('labs-iot');
const unit4Lab = getPage('labs-unit4');
const help = getPage('help');

const toc = [
  { id: 'class-flow', title: '수업 운영' },
  { id: 'assessment', title: '평가: 성취기준·평가 방향 표' },
  { id: 'privacy', title: '개인정보 처리 안내' },
  { id: 'shared-pc', title: '여러 사람이 쓰는 컴퓨터' },
  { id: 'comm', title: '통신 수업(3·4단원)' },
  { id: 'network', title: '학교 네트워크 체크리스트' },
  { id: 'presentation', title: '발표 모드' },
] as const;

const lessonFlow = ['학습목표', '왜 배울까', '핵심 개념', '따라 하기', '바꿔 보기', '도전 과제', '확인 퀴즈', '교사용'];

const curriculumUrl = 'https://www.ice.go.kr/ice/na/ntt/selectNttInfo.do?mi=11997&bbsId=1999&nttSn=3299910';
const standardAreas = [
  { area: '(1) 인공지능 영상인식', codes: '[12인피01-01] ~ [12인피01-04]', unit: 'I. 영상 처리 인공지능', anchor: 'std-area-1' },
  { area: '(2) 피지컬컴퓨팅', codes: '[12인피02-01] ~ [12인피02-04]', unit: 'II. 피지컬 컴퓨팅', anchor: 'std-area-2' },
  { area: '(3) 인공지능과 피지컬컴퓨팅', codes: '[12인피03-01] ~ [12인피03-03]', unit: 'III. 인공지능과 피지컬 컴퓨팅', anchor: 'std-area-3' },
  { area: '(4) 문제해결프로젝트', codes: '[12인피04-01] ~ [12인피04-04]', unit: 'IV. 지능화 사물 개발 프로젝트', anchor: 'std-area-4' },
] as const;

const moeGuideUrl =
  'https://www.moe.go.kr/boardCnts/viewRenew.do?boardID=294&boardSeq=105007&lev=0&searchType=null&statusYN=W&page=1&s=moe&m=020402&opType=N';

interface NetworkItem {
  item: string;
  /** 확인하는 방법(안전한 고정 문장이라 링크를 넣을 수 있다) */
  how: string;
  /** 막혀 있을 때 할 일(같은 이유로 링크를 넣을 수 있다) */
  ifBlocked: string;
}

/** 내가 교실에서 바로 할 수 있는 확인 */
const myChecks: readonly NetworkItem[] = [
  {
    item: '사이트 주소(github.io)가 열리는지',
    how: '교실 컴퓨터에서 이 페이지가 열리면 통과예요.',
    ifBlocked: '학교 인터넷 담당 선생님께 사이트 주소를 알려 주고 문의해요.',
  },
  {
    item: '브라우저 기능(카메라·USB 보드·블루투스·파이썬 기다리기)',
    how: `<a href="${check.href}">${check.title}</a>에서 [결과 복사]를 눌러 모아 둬요.`,
    ifBlocked: '결과 표의 줄마다 붙은 한 줄 대처를 따라요.',
  },
  {
    item: '브라우저가 최신판인지',
    how: '내 컴퓨터 점검의 "파이썬 기다리기 기능(JSPI)" 줄이 "지원"인지 봐요.',
    ifBlocked: '교실 컴퓨터의 Chrome이나 Edge를 최신판으로 업데이트해요. 권한이 없으면 아래 부탁 글을 전산 담당 선생님께 보내요.',
  },
  {
    item: '교실 화면 공유 프로그램의 가상 카메라',
    how: '내 컴퓨터 점검의 [카메라 켜서 확인하기]를 눌러 카메라마다 영상이 들어오는지 봐요. 가상 카메라에는 "가상 카메라" 표시가 붙어요.',
    ifBlocked: `까만 화면만 오면 실습실이 안내를 띄워 줘요. 해결 방법은 <a href="${help.href}#camera-black">${help.title}</a>의 "카메라 화면이 까매요"에 있어요.`,
  },
];

/** 전산 담당 선생님께 부탁해야 하는 확인 */
const itChecks: readonly NetworkItem[] = [
  {
    item: '파이썬 실행 파일을 받는 곳(cdn.jsdelivr.net)이 열리는지',
    how: `<a href="${check.href}#network">${check.title}</a>의 네트워크 점검에서 [시험하기]를 눌러 봐요.`,
    ifBlocked: '막혀도 이 사이트에 함께 올린 예비 파일로 저절로 바꿔 받아요. 둘 다 막히면 아래 부탁 글을 전산 담당 선생님께 보내요.',
  },
  {
    item: '통신 실습의 공개 MQTT 중계 서버가 열리는지(선택)',
    how: '같은 네트워크 점검의 [시험하기]로 봐요. 연결만 해 보고 곧바로 닫아요.',
    ifBlocked: '통신 실습은 인터넷 없이 같은 컴퓨터의 탭끼리 주고받는 통로(기본값)로 끝까지 할 수 있어요. 공개 중계 서버가 꼭 필요할 때만 부탁해요.',
  },
  {
    item: '보드 드라이버를 설치할 권한',
    how: `보드를 꽂고 <a href="${board.href}">${board.title}</a>의 [보드 연결]을 눌러 봐요. 포트가 안 보이면 안내가 이어져요.`,
    ifBlocked: `<a href="${board.href}#it-request">${board.title}</a>의 "전산 담당 선생님께 부탁하기" 글을 [부탁 글 복사]로 복사해 보내요.`,
  },
];

/** 전산 담당 선생님께 보낼 부탁 글(열어 달라고 할 주소는 사이트가 쓰는 곳만, 빌드 때 만든다) */
const requestHosts = {
  site: new URL(siteConfig.origin).host,
  python: new URL(PYODIDE_CDN_INDEX_URL).host,
  brokers: listedBrokers().map((broker) => new URL(broker.url).host),
};
const itRequestText = [
  '안녕하세요. 정보 수업에서 "인공지능과 피지컬 컴퓨팅" 실습 사이트를 쓰려고 합니다.',
  '교실 컴퓨터에서 아래 주소에 접속할 수 있도록 학교 네트워크에서 허용해 주시기 바랍니다.',
  `- ${requestHosts.site} (수업 사이트)`,
  `- ${requestHosts.python} (파이썬 실행 파일)`,
  ...(requestHosts.brokers.length > 0 ? [`- ${requestHosts.brokers.join(', ')} (통신 실습의 공개 중계 서버, WebSocket 연결 - 선택)`] : []),
  '교실 컴퓨터의 Chrome 또는 Edge가 최신판인지도 확인해 주시기 바랍니다. 감사합니다.',
  '교실 컴퓨터의 점검 결과는 아래에 붙여 넣었습니다.',
].join('\n');
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">수업 전에 확인할 것, 평가와 개인정보 처리 안내, 교실 컴퓨터에서 주의할 점을 모았어요.</p>

  <nav class="teacher-toc" aria-labelledby="teacher-toc-title">
    <h2 id="teacher-toc-title" class="teacher-toc__title">이 페이지의 내용</h2>
    <ol>
      {
        toc.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.title}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="prose">
    <h2 id="class-flow">수업 운영</h2>
    <h3>권장 환경</h3>
    <ul>
      <li>학생 한 명에 컴퓨터 한 대, 컴퓨터용 Chrome이나 Edge 최신판</li>
      <li>브라우저 창 너비 1024 이상(실습실은 코드와 결과를 나란히 보여 줘요)</li>
      <li>웹캠: 없으면 샘플 영상이나 재생 입력(계산으로 만든 손·얼굴 좌표)으로 실습해요.</li>
      <li>ESP32 보드: 없으면 가상 보드로 끝까지 실습해요. 통신 실습도 같은 컴퓨터의 두 탭끼리 할 수 있어요.</li>
    </ul>

    <h3>수업 전 준비</h3>
    <ol>
      <li>교실 컴퓨터 한 대에서 <a href={check.href}>{check.title}</a> 페이지를 열고 결과를 확인해요.</li>
      <li>학생들이 <a href={student.href}>{student.title}</a>의 순서대로 카메라 허용을 한 번 연습하게 해요.</li>
      <li>보드 수업이라면 <a href={board.href}>{board.title}</a>의 안내대로 케이블과 드라이버를 미리 확인해요.</li>
      <li>
        <strong>키트를 처음 쓸 때 한 번:</strong> <a href={boardCheck.href}>{boardCheck.title}</a>에서 항목마다 [보드에 보내기]를 눌러
        가지고 있는 키트가 사이트 예제대로 움직이는지 확인해요(전체 예상 2시간쯤, 나눠서 해도 돼요). 다른 점이 있으면 [결과 복사]로
        알려 주면 사이트를 고쳐요.
      </li>
      <li>
        <strong>교실 컴퓨터마다 한 번:</strong> <a href={visionLab.href}>{visionLab.title}</a>을 열고 준비 패널의{' '}
        <strong>[이 컴퓨터에 실습 파일 미리 받기]</strong>를 눌러요. 이 단추로 미리 받는 파일은 약 26MB예요. 받아 두면 수업 중에 인터넷이 느리거나 끊겨도
        실습실이 바로 열려요.
      </li>
    </ol>

    <h3>차시 페이지의 흐름</h3>
    <p>
      <a href={learn.href}>배우기</a>의 차시 페이지는 모두 같은 순서로 만들어요. 교사용 칸은 접혀 있어서 학생 화면에서는 필요할 때만 펼쳐 봐요.
    </p>
  </div>
  <ol class="lesson-flow">
    {lessonFlow.map((step) => <li class="lesson-flow__step">{step}</li>)}
  </ol>

  <div class="prose">
    <h2 id="assessment">평가: 성취기준·평가 방향 표</h2>
    <p>
      이 과목은 2022 개정 교육과정의 교육감 승인 과목 "인공지능과 피지컬 컴퓨팅"이에요. 성취기준 코드는 <a href={curriculumUrl}
        >인천광역시교육청이 게시한 과목 교육과정</a
      >에서 가져왔고, 차시와의 연결은 사이트가 붙여요. 아래 표의 영역 이름은 교육청 원문 표기대로 적어서, 교과서 대단원 이름과 띄어쓰기가 조금 달라요.
    </p>
  </div>
  <div class="teacher-table" role="region" aria-labelledby="standards-caption" tabindex="0" data-scroll-shade>
    <table>
      <caption id="standards-caption">성취기준 영역과 평가 방향</caption>
      <thead>
        <tr>
          <th scope="col">영역</th>
          <th scope="col">성취기준 코드</th>
          <th scope="col">교과서 대단원</th>
          <th scope="col">차시별 평가 방향</th>
        </tr>
      </thead>
      <tbody>
        {
          standardAreas.map((row) => (
            <tr>
              <th scope="row">{row.area}</th>
              <td>{row.codes}</td>
              <td>{row.unit}</td>
              <td>
                <a href={`${standardsHref}#${row.anchor}`}>성취기준과 평가 방향</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="prose">
    <p>과목 교육과정의 평가 방법 요지(교육청 게시물의 문서 보기 기준, 원문 파일과 대조하기 전이에요):</p>
    <ul>
      <li>지필 평가를 줄이고 과정 중심으로 평가해요.</li>
      <li>프로젝트 수행 과정의 비중을 30% 이상으로 해요.</li>
      <li>생성형 인공지능의 도움을 받은 부분을 표시하고, 협력 과정의 자료를 함께 내요.</li>
    </ul>
  </div>
  <div class="prose">
    <p>
      성취기준 15개와 이어지는 차시, 평가할 때 볼 것과 모을 자료는 교사용 자료실의 <a href={standardsHref}>성취기준과 평가 방향</a>에 있어요.
    </p>
  </div>

  <div class="prose">
    <h2 id="privacy">개인정보 처리 안내</h2>
    <Callout type="참고" title="사이트 운영자는 개인정보를 모으거나 저장하지 않아요">
      <p>
        이 사이트에는 로그인·회원가입이 없고, 운영자가 방문 기록을 받는 서버도 없어요. 방문 통계 도구도 쓰지 않아요.
      </p>
    </Callout>
    <h3>한눈에 보기</h3>
    <ul data-privacy-summary>
      <li>로그인이 없어요.</li>
      <li>운영자는 학생의 개인정보를 받지 않아요. 학생이 쓴 코드와 설정은 그 컴퓨터의 브라우저에만 남아요.</li>
      <li>코드, 통신 메시지, 보드 이름에 학생 이름이나 학번을 쓰지 않게 지도해 주세요.</li>
    </ul>
    <p>
      다만 사이트를 열거나 일부 기능을 쓰면 브라우저가 아래 회사의 서버에 접속하고, 그 회사가 접속 정보를 처리해요. 사이트 운영자는 이
      기록을 받지 않아요. 어떤 곳에 무엇이 가는지는 아래 표에 있어요.
    </p>
  </div>

  <details class="teacher-details" data-connections-details>
    <summary>외부로 연결되는 곳과 보내지는 것 표 보기(4곳)</summary>
  <div class="teacher-table" role="region" aria-labelledby="connections-caption" tabindex="0" data-scroll-shade>
    <table class="connections">
      <caption id="connections-caption">외부로 연결되는 곳과 보내지는 것</caption>
      <thead>
        <tr>
          <th scope="col">연결되는 곳</th>
          <th scope="col">언제</th>
          <th scope="col">보내지는 것</th>
          <th scope="col">처리하는 곳</th>
          <th scope="col">처리방침·안내</th>
        </tr>
      </thead>
      <tbody>
        {
          connections.map((row) => (
            <tr>
              <th scope="row">{row.where}</th>
              <td>{row.when}</td>
              <td>{row.what}</td>
              <td>{row.who}</td>
              <td>
                <ul class="connections__links">
                  {row.links.map((link) => (
                    <li>
                      <a href={link.url} rel="noopener">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  </details>

  <div class="prose">
    <h3>사이트 안에서만 다루는 것</h3>
    <ul>
      <li>카메라 영상과 손·얼굴 좌표: 브라우저 안에서만 다루고 서버로 보내지 않게 만들어요.</li>
      <li>학생이 쓴 코드와 설정: 그 컴퓨터 브라우저의 저장 공간에만 남아요.</li>
      <li>사이트 검색: 사이트와 함께 올린 검색 파일로 그 컴퓨터에서 찾아요.</li>
      <li>글꼴: 사이트에 함께 올린 파일을 받아요. 다른 글꼴 서비스에 접속하지 않아요.</li>
    </ul>
    <Callout type="주의" title="서버 음성 인식은 켜기 전에 확인해요">
      <p>
        선택 차시의 서버 음성 인식은 기본으로 꺼져 있어요. 14세 미만 학생이 듣는 수업에서는 켜지 말아 주세요. 켜고 끄는 곳은{' '}
        <a href={settings.href}>{settings.title}</a>이고, 켠 값은 그 컴퓨터의 브라우저에만 저장돼요.
      </p>
    </Callout>
    <p>
      학교에서 학습지원 소프트웨어로 쓰려면 학교의 선정 절차가 필요할 수 있어요. <a href={moeGuideUrl}
        >교육부 안내(학습지원 소프트웨어 선정 기준, 2025-12-29)</a
      >를 참고해 학교 기준으로 확인해 주세요. 이 안내는 사이트가 확인한 사실을 정리한 것이고 법률 자문이 아니에요. 학교의 개인정보 담당 선생님과도 함께 확인해 주세요.
    </p>

    <h2 id="shared-pc">여러 사람이 쓰는 컴퓨터</h2>
    <ul>
      <li>로그인이 없는 대신, 학생이 쓴 코드와 설정이 그 컴퓨터의 브라우저에 남아요. {PROGRESS_PRIVACY_NOTE}</li>
      <li>
        수업이 끝나면 실습실 아래의 <strong>[이 컴퓨터에서 내 기록 지우기]</strong>를 누르게 해 주세요. 이 사이트가 저장한 것만 지우고 다른 사이트의 기록은
        그대로예요. 선생님 컴퓨터에서는 아래 단추로 바로 지울 수 있어요.
        <ClearRecordsButton id="teacher-clear-records" hint={false} />
      </li>
      <li>
        통신 실습에서 쓰는 무작위 이름(12글자)은 탭을 닫으면 사라져요. [이 컴퓨터에 고정]을 누르면 남지만, 기록 지우기를 누르면 함께 지워져요.
      </li>
      <li>보드 이름은 "ESP32-07"처럼 자리 번호로 붙이고, 학생 이름이나 학번은 넣지 않게 지도해 주세요.</li>
    </ul>

    <h2 id="comm">통신 수업(3·4단원)</h2>
    <p>
      통신 실습은 컴퓨터 쪽 코드(영상 처리 실습실)와 보드 쪽 코드(ESP32 실습실)가 짝을 이뤄요. 어떤 차례로 무엇을 여는지는{' '}
      <a href={iotLab.href}>{iotLab.title}</a>에 모아 두었어요.
    </p>
    <ul>
      <li>
        <strong>기본 통로는 "같은 컴퓨터 탭"이에요.</strong> 인터넷 없이 한 컴퓨터의 두 탭(또는 한 화면 안의 가상 보드)끼리 주고받아서, 학교망이
        막아도 수업이 끝까지 돼요.
      </li>
      <li>
        "공개 중계 서버(MQTT)"는 학생이 고를 때만 써요. 누구나 보고 누구나 보낼 수도 있는 서버라서 이름·연락처·사진 같은 개인정보를 보내지
        않게 지도해 주세요. 사이트 화면에도 이 경고가 늘 보여요.
      </li>
      <li>
        <strong>실제 레이저·모터·서보처럼 움직이는 장치는 공개 중계 서버에 연결하지 않아요.</strong> 사이트가 주는 실제 보드용 MQTT 템플릿은 허용한
        명령(on·off·blink)과 20바이트까지만 받아 LED만 켜고 끄고, 그 밖의 메시지는 무시하고 콘솔에 알려요.
      </li>
      <li>
        블루투스 보드 이름은 <code>ESP32-07</code>처럼 자리 번호로 붙여요. 모든 보드가 <code>ESP32</code>로 광고하면 선택 창에서 내 보드를 고를 수
        없어요.
      </li>
      <li>
        실제 보드와 블루투스로 잇는 기능은 기준 브라우저(컴퓨터용 Chrome·Edge)에서 돼요. 교실 기기에서 되는지는 <a href={check.href}>{check.title}</a>의
        "Web Bluetooth(블루투스)" 줄로 확인해요(아이폰·아이패드에는 없어요). 안 되면 가상 보드의 블루투스 칸으로 같은 실습을 해요.
      </li>
      <li>
        실제 USB-UART 변환기를 쓰면 USB 포트가 두 개(코드를 보내는 보드 포트, 글자가 오가는 변환기 포트)가 돼요. 실습실의 [USB 데이터 포트] 칸에서
        변환기 포트를 따로 열고 이름표를 붙여 두면 헷갈리지 않아요.
      </li>
      <li>
        <a href={unit4Lab.href}>{unit4Lab.title}</a>은 파이썬을 두 벌 띄우는 가장 무거운 화면이에요(브라우저 전체 약 1GB). 오래 켜 두면 메모리가
        늘어나므로, 느려지면 [함께 정지] 뒤 새로 고침을 안내해 주세요.
      </li>
    </ul>

    <h2 id="network">학교 네트워크 체크리스트</h2>
