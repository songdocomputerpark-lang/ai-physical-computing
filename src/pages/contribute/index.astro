---
// 자리 페이지(공통 기반 단계, 2026-09-16). 기여·문의 담당이 실제 화면으로 바꾼다(PLAN §8.1 P1-10).
import ComingSoon from '../../components/common/ComingSoon.astro';
import { getPage } from '../../config/nav.ts';
import { siteConfig } from '../../config/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = getPage('contribute');
---

<BaseLayout title={page.title} description={page.description}>
  <h1 class="page-title">{page.title}</h1>
  <p class="lead">{page.description}</p>
  <ComingSoon
    what="기여·문의 안내"
    when="사이트 뼈대를 만드는 지금 단계(Phase 1)"
    links={[{ label: '문제 알리기(GitHub Issues)', href: siteConfig.issuesUrl }]}
  >
    <p>그동안 틀린 곳이나 궁금한 점은 아래 링크로 알려 주세요.</p>
  </ComingSoon>
</BaseLayout>
