---
/**
 * 차시 페이지(/learn/u1/1-1-1/) — SPEC §7.2 차시 틀.
 *
 * 머리: 차시 번호·제목·한 줄 소개, 뱃지(성취기준·소요 시간·준비물·난이도·가상 보드·실습실·교과서 쪽)
 * 본문: 마크다운의 8칸(학습목표 → 왜 배울까 → 핵심 개념 → 따라하기 → 바꿔보기 → 도전 과제 → 확인 퀴즈 → 교사용)
 *       + 따라하기 예제(frontmatter examples) + 확인 퀴즈(frontmatter quiz)
 * 끝: 이전·다음 차시
 *
 * 새 차시는 content/lessons/u{대단원}/{파일 이름}.md 하나(와 예제 py 하나)를 넣으면 페이지가 생긴다. 코드는 고치지 않는다.
 * 쓰는 약속은 src/components/lesson/lesson-html.ts 머리말에 있다.
 * 본문의 :용어[…] 표시 자리는 GlossaryScope가 굵은 링크 + 풀이 툴팁으로 바꾼다. 용어사전은 빌드마다 새로 읽으므로
 * 용어사전만 고쳐도 차시 툴팁이 새 풀이로 바뀐다(src/components/glossary/GlossaryScope.astro, remark-glossary.mjs 머리말).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import GlossaryScope from '../../../components/glossary/GlossaryScope.astro';
import LessonBody from '../../../components/lesson/LessonBody.astro';
import LessonMeta from '../../../components/lesson/LessonMeta.astro';
import LessonPager from '../../../components/lesson/LessonPager.astro';
import LessonToc from '../../../components/lesson/LessonToc.astro';
import {
  checkLessons,
  findNeighbors,
  kindBadge,
  lessonBreadcrumb,
  lessonDocumentTitle,
  publishedLessons,
  type LessonSummary,
} from '../../../components/lesson/lesson-data.ts';
import { planLessonBody } from '../../../components/lesson/lesson-html.ts';
import { getLearnUnit } from '../../../config/nav.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  const issues = checkLessons(entries);
  for (const issue of issues) {
    if (issue.level === 'warning') {
      console.warn(`[배우기] ${issue.message}`);
    }
  }
  const errors = issues.filter((issue) => issue.level === 'error');
  if (errors.length > 0) {
    throw new Error(`[배우기] 차시 파일을 고쳐야 해요.\n${errors.map((issue) => `- ${issue.message}`).join('\n')}`);
  }

  const lessons = publishedLessons(entries);
  const entryById = new Map(entries.map((entry) => [entry.id, entry]));
  return lessons.flatMap((lesson) => {
    const entry = entryById.get(lesson.id);
    return entry ? [{ params: { unit: `u${lesson.unit}`, lesson: lesson.slug }, props: { entry, lesson, lessons } }] : [];
  });
}

interface Props {
  entry: CollectionEntry<'lessons'>;
  lesson: LessonSummary;
  lessons: LessonSummary[];
}

const { entry, lesson, lessons } = Astro.props;
const source = entry.filePath ?? `content/lessons/${entry.id}.md`;
const plan = planLessonBody(entry.rendered?.html ?? '', {
  exampleCount: entry.data.examples.length,
  quizCount: entry.data.quiz.length,
  checkTemplate: lesson.kind === 'textbook' || lesson.kind === 'supplement',
});
for (const warning of plan.warnings) {
  console.warn(`[차시 틀] ${source}: ${warning}`);
}

const unit = getLearnUnit(lesson.unit);
const kind = kindBadge(lesson.kind);
const tocSections = plan.sections.flatMap((section) => (section.id ? [{ id: section.id, title: section.title }] : []));
const { previous, next } = findNeighbors(lessons, lesson.id);
---

<BaseLayout
  title={lessonDocumentTitle(lesson)}
  description={lesson.description}
  width="narrow"
  breadcrumb={lessonBreadcrumb(lesson)}
  ogType="article"
>
  <article class="lesson" data-lesson-id={lesson.id}>
    <header class="lesson__header">
      <p class="lesson__unit">
        <a href={unit.href}>{unit.title}</a>
      </p>
      <h1 class="page-title lesson__title">
        <span class="lesson__label">{lesson.label}</span>{' '}
        {kind && <span class="lesson__kind">{kind}</span>}
        {kind && ' '}
        <span class="lesson__name">{lesson.title}</span>
      </h1>
      {lesson.description && <p class="lead lesson__lead">{lesson.description}</p>}
      <LessonMeta lesson={lesson} />
    </header>
    <LessonToc sections={tocSections} />
    <GlossaryScope id="lesson">
      <LessonBody
        plan={plan}
        examples={entry.data.examples}
        quiz={entry.data.quiz}
        lab={lesson.lab}
        lessonId={lesson.id}
        source={source}
      />
    </GlossaryScope>
    <LessonPager previous={previous} next={next} />
  </article>
</BaseLayout>

<style>
  .lesson__unit {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .lesson__unit a {
    color: var(--color-text-muted);
  }

  .lesson__title {
    margin-block-start: var(--space-1);
  }

  .lesson__label {
    color: var(--color-accent-hover);
  }

  .lesson__kind {
    display: inline-block;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: 0.6em;
    vertical-align: 0.25em;
  }

  .lesson__lead {
    margin-block-end: var(--space-5);
  }
</style>
