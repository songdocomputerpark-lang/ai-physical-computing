---
/**
 * 홈(PLAN §8.1 P1-05, SPEC §5 홈 화면 요구, 판 1.3.0 개편, 판 1.4.0 출판본 교과서 흐름 — DECISIONS C132)
 * 위에서부터
 *  1. 표지(스크롤 없이): 알약 "고등학교 · 교과서 32절 · 웹 차시 45편", 제목, 한 줄 소개, 큰 단추 3개(1단원부터 시작·차례 보기·실습실), 교과서 표지 그림 — HomeCover
 *  2. 이어서 하기 띠(저장된 진도가 있을 때만 보임) — HomeResume
 *  3. 교과서 차례 그림 위 투명 링크(좁은 화면은 절 목록이 먼저) — HomeToc, 주소 #toc
 *  4. 차시 목록: 단원 머리 → 중단원 → 카드(교과서 쪽으로) — HomeLessons, 주소 #lessons
 *  5. 큰 검색 "무엇을 찾나요?" — HomeFind(구역 B의 HomeSearch)
 *  6. 바로 가기 타일 9개 — HomeShortcuts
 *  7. 설치 없이 브라우저만으로(원칙 3가지) — HomePrinciples
 * 홈의 글과 링크는 src/components/home/home-content.ts, 차례·카드 자료는 home-lessons.ts(교과서 쪽 content/book + 웹 차시 content/lessons + 출판본 차례 src/config/book-outline.ts)에서 만든다.
 * 새 교과서 md나 새 웹 차시 md를 넣으면 코드를 고치지 않아도 카드가 늘거나 그 쪽으로 이어진다.
 *
 * 사이트 검색 색인에서는 뺀다(searchIndex={false}). 홈 글은 다른 페이지를 짧게 모은 소개라서,
 * 같은 낱말로 검색하면 실제 페이지와 겹쳐 나와 결과만 길어지기 때문이다.
 *
 * 진도(이어서 하기·단원 진도 막대·카드의 "다 했어요"·첫 번째 큰 단추 → 이어서 하기)는 브라우저에서만 그린다 — home-resume.ts·progress-paint.ts(아래 스크립트).
 */
import { getCollection } from 'astro:content';
import { publishedBooks } from '../components/book/book-data.ts';
import HomeCover from '../components/home/HomeCover.astro';
import HomeFind from '../components/home/HomeFind.astro';
import HomeLessons from '../components/home/HomeLessons.astro';
import HomePrinciples from '../components/home/HomePrinciples.astro';
import HomeResume from '../components/home/HomeResume.astro';
import HomeShortcuts from '../components/home/HomeShortcuts.astro';
import HomeToc from '../components/home/HomeToc.astro';
import { buildHomeUnits, buildTocFigures, buildTocList } from '../components/home/home-lessons.ts';
import { publishedLessons } from '../components/lesson/lesson-data.ts';
import { learnUnits } from '../config/nav.ts';
import { siteConfig } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const lessons = publishedLessons(await getCollection('lessons'));
const books = publishedBooks(await getCollection('book'));
const units = buildHomeUnits(learnUnits, books, lessons);
const figures = buildTocFigures(units);
const tocList = buildTocList(units);
---

<BaseLayout title={siteConfig.name} isHome searchIndex={false}>
  <HomeCover units={units} lessonCount={lessons.length} />
  <HomeResume />
  <HomeToc figures={figures} list={tocList} />
  <HomeLessons units={units} />
  <HomeFind />
  <HomeShortcuts />
  <HomePrinciples />
</BaseLayout>

<script>
  import { installHomeProgress } from '../components/home/home-resume.ts';

  installHomeProgress();
</script>
