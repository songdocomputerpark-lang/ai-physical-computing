---
// 임시 홈 화면(공통 기반 단계). 홈 담당(PLAN §8.1 P1-05: 큰 버튼 3개와 "보고 → 판단하고 → 움직인다" 흐름 그림)이 이 파일을 바꾼다.
import PageLinks from '../components/common/PageLinks.astro';
import { headerNav } from '../config/nav.ts';
import { siteConfig } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={siteConfig.name} isHome>
  <h1 class="page-title">{siteConfig.name}</h1>
  <p class="lead">{siteConfig.description}</p>
  <p class="home-note">사이트를 준비하고 있어요. 지금은 아래 메뉴를 둘러볼 수 있어요.</p>
  <PageLinks pages={headerNav} />
</BaseLayout>

<style>
  .home-note {
    margin-block-end: var(--space-6);
  }
</style>
