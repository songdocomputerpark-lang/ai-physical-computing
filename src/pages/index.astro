---
/**
 * 홈(PLAN §8.1 P1-05, SPEC §5 홈 화면 요구, 판 1.3.0 개편)
 * 위에서부터
 *  1. 첫 화면(스크롤 없이): 제목, 한 문장 소개, 큰 버튼 3개, "보고 → 판단하고 → 움직여요" 흐름 그림 — HomeHero
 *  2. 이어서 하기 띠(저장된 진도가 있을 때만 보임) — HomeResume
 *  3. 큰 검색 "무엇을 찾나요?" — HomeFind(구역 B의 HomeSearch)
 *  4. 배움 지도: 대단원 4장이 화살표로 이어진 길, 단원 색·진도 막대·[시작하기] — HomeMap
 *  5. 바로 가기 타일 9개 — HomeShortcuts
 *  6. 설치 없이 브라우저만으로(원칙 3가지) — HomePrinciples
 * 홈의 글과 링크는 src/components/home/home-content.ts 한 곳에서 고친다.
 *
 * 사이트 검색 색인에서는 뺀다(searchIndex={false}). 홈 글은 다른 페이지를 짧게 모은 소개라서,
 * 같은 낱말로 검색하면 실제 페이지와 겹쳐 나와 결과만 길어지기 때문이다.
 *
 * 진도(이어서 하기·단원 진도 막대·시작하기 → 이어서 하기)는 브라우저에서만 그린다 — home-resume.ts(아래 스크립트).
 */
import HomeFind from '../components/home/HomeFind.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeMap from '../components/home/HomeMap.astro';
import HomePrinciples from '../components/home/HomePrinciples.astro';
import HomeResume from '../components/home/HomeResume.astro';
import HomeShortcuts from '../components/home/HomeShortcuts.astro';
import { siteConfig } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={siteConfig.name} isHome searchIndex={false}>
  <HomeHero />
  <HomeResume />
  <HomeFind />
  <HomeMap />
  <HomeShortcuts />
  <HomePrinciples />
</BaseLayout>

<script>
  import { installHomeProgress } from '../components/home/home-resume.ts';

  installHomeProgress();
</script>
