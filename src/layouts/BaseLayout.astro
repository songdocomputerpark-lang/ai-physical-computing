---
/**
 * 공통 레이아웃(PLAN §8.1 P1-05) — 모든 페이지를 이 틀로 감싼다.
 *
 * 쓰는 법
 *   ---
 *   import BaseLayout from '../layouts/BaseLayout.astro';
 *   ---
 *   <BaseLayout title="용어사전" description="처음 보는 낱말의 뜻을 풀어 둔 곳">
 *     <h1 class="page-title">용어사전</h1>
 *     …
 *   </BaseLayout>
 *
 * props
 *   title        (필수) 페이지 제목. 브라우저 탭에는 "제목 | 사이트 이름"으로 보인다(isHome이면 사이트 이름만).
 *   description  검색 결과·공유 미리보기 설명. 없으면 사이트 설명(src/config/site.ts).
 *   width        본문 폭: 'default'(기본 76rem) · 'narrow'(글 읽기 44rem) · 'wide'(화면 가득, 실습실).
 *   breadcrumb   현재 위치 표시. 기본은 사이트 지도(src/config/nav.ts)에서 자동으로 찾는다.
 *                false면 숨기고, 배열이면 그대로 쓴다(차시처럼 사이트 지도에 없는 페이지). 마지막 칸(href 없음)이 지금 페이지.
 *   isHome       홈이면 true(현재 위치를 숨기고 탭 제목을 사이트 이름만).
 *   noindex      검색 엔진에 올리지 않을 페이지(404 등).
 *   searchIndex  사이트 검색(Pagefind) 색인에 넣을지. 기본 true → <main>에 data-pagefind-body를 붙인다.
 *   ogType       공유 미리보기 종류: 'website'(기본) · 'article'(글).
 *
 * slots
 *   (기본)   본문. 페이지 제목 <h1>은 페이지가 직접 한 번 쓴다(class="page-title" 권장).
 *   head     <head> 끝에 넣을 것(페이지 전용 meta·스타일시트).
 *   notice   머리글 아래·본문 위 안내 자리. 실습실의 브라우저 권장 환경 안내(Chrome·Edge, SPEC §9) 컴포넌트를 여기에 넣는다.
 *            예: <BrowserNotice slot="notice" />
 */
import '../styles/global.css';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import type { BreadcrumbItem } from '../config/nav.ts';
import { siteConfig } from '../config/site.ts';
import { absoluteUrl, stripBase, withBase } from '../lib/url.ts';
import SiteFooter from './partials/SiteFooter.astro';
import SiteHeader from './partials/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  width?: 'default' | 'narrow' | 'wide';
  breadcrumb?: false | readonly BreadcrumbItem[];
  isHome?: boolean;
  noindex?: boolean;
  searchIndex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = siteConfig.description,
  width = 'default',
  breadcrumb,
  isHome = false,
  noindex = false,
  searchIndex = true,
  ogType = 'website',
} = Astro.props;

const documentTitle = isHome ? siteConfig.name : `${title} | ${siteConfig.name}`;
// 대표 주소는 늘 공개 사이트 주소다 — 오프라인 배포판(사이트 뿌리 base)에서 만들어도 공개 사이트의 같은 쪽을 가리킨다(src/lib/url.ts absoluteUrl).
const canonicalUrl = absoluteUrl(stripBase(Astro.url.pathname));
const showBreadcrumb = breadcrumb !== false && !isHome;
const hasNotice = Astro.slots.has('notice');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="color-scheme" content="light" />
    <!-- 휴대폰 주소 표시줄 색: tokens.css의 --color-accent와 같은 값 -->
    <meta name="theme-color" content="#1f5bd6" />
    <link rel="icon" type="image/svg+xml" href={withBase('images/site/favicon.svg')} />
    <!-- Pretendard 가변 글꼴(공식 다이내믹 서브셋): 페이지에 쓰인 글자가 든 조각만 받는다. font-display: swap이라 받는 동안에도 글이 보이고,
         그동안은 src/styles/fonts.css의 'Pretendard Fallback'(폭·높이를 맞춘 맑은 고딕)으로 보여 조각이 도착해도 줄이 밀리지 않는다. -->
    <!-- 글꼴 CSS는 첫 그리기를 막지 않게 받는다(Phase 6 P6-02 — 느린 3G에서 왕복 한 번 2초, 구역 A 요청 A-2): media="print"로 받기 시작해 도착하면 all로 바꾼다.
         그동안은 위의 'Pretendard Fallback'(폭·높이를 맞춘 맑은 고딕)으로 보여 글이 먼저 읽힌다. 자바스크립트가 꺼져 있으면 noscript 쪽이 받는다. -->
    {
      /*
       * 느린 망에서는 글꼴 조각을 페이지가 다 온 뒤(window load)에 받는다(판 1.1.0, PROGRESS 미해결 194 — 이 설명은 중괄호 주석이라 쪽 HTML에 실리지 않는다).
       * 느린 망이면 글꼴 조각(쪽마다 290~675KB)이 퀴즈·용어 풀이 스크립트와 회선을 다투지 않게 media를 all로 바꾸기를 load 뒤로 미룬다.
       * 전에는 3G에서 스크립트가 글꼴 뒤에 줄을 서 DCL·load가 15~25초였다. 느린 망인지는 셋 가운데 하나로 본다(FONT_CSS_SLOW_MS = 0.5초):
       *  ① 글꼴 CSS 한 파일을 받는 데 0.5초 넘게 걸림 ② 이 쪽 HTML을 받는 데(요청 → 응답 끝) 0.5초 넘게 걸림
       *  ③ 브라우저가 알려 주는 망 종류(navigator.connection.effectiveType — Chromium만)가 2g·3g
       * ②는 1.1.0 검토 반영(2026-09-29): 실사이트(GitHub Pages — 글꼴 CSS에 Cache-Control max-age=600)에서는 홈 다음 쪽부터 글꼴 CSS가
       * 브라우저 캐시·서비스 워커에서 곧바로 와서 ①만으로는 느린 망을 몰랐다 → 둘째 쪽(실습실 포함)은 글꼴 조각이 DCL 전에 나가 실습실 DCL이
       * 24.3초였다(미리 보기 서버는 no-cache라 CSS를 다시 확인하느라 ①이 걸려 보이지 않았다). 쪽 HTML은 서비스 워커도 네트워크 먼저라 늘 망을 탄다.
       * HTML이 아직 오는 중이면(응답 끝을 모름) 구문 분석이 끝날 때(readystatechange) 다시 본다 — 그동안은 켜지 않는다.
       * 빠른 망·다시 보기는 전처럼 곧바로(또는 구문 분석이 끝나자마자) 켜서, 다시 올 때마다 글꼴이 늦게 바뀌지 않게 한다.
       * 잴 수 없으면(Timing이 없거나 오류 — 빈 catch) 전처럼 곧바로 켠다. 스크립트가 이 함수보다 먼저 불릴 일이 없게 link보다 앞에 둔다.
       * 쪽마다 HTML에 실리므로 스크립트 안에는 주석을 두지 않는다(gzip 약 0.25KB — 공용 청크에서 줄인 약 1KB 안).
       * 측정 근거는 .cache/v110-notes/zone-c-perf.md, 단위 테스트 tests/unit/perf/font-loading.test.ts, 브라우저 검사 tests/e2e/perf-timing.spec.ts.
       */
    }
    <script is:inline>
      window.__apcFontCss = function (link) {
        var FONT_CSS_SLOW_MS = 500;
        function on() {
          link.media = 'all';
        }
        function later() {
          window.addEventListener('load', on, { once: true });
        }
        function pageTime() {
          var nav = performance.getEntriesByType('navigation')[0];
          return nav && nav.responseEnd > 0 ? nav.responseEnd - nav.requestStart : -1;
        }
        try {
          if (document.readyState !== 'complete') {
            var entry = performance.getEntriesByName(link.href).pop();
            var net = navigator.connection;
            if ((entry && entry.duration >= FONT_CSS_SLOW_MS) || (net && /2g|3g/.test(net.effectiveType)) || pageTime() >= FONT_CSS_SLOW_MS) {
              later();
              return;
            }
            if (pageTime() < 0 && document.readyState === 'loading') {
              document.addEventListener(
                'readystatechange',
                function () {
                  if (document.readyState !== 'complete' && pageTime() >= FONT_CSS_SLOW_MS) {
                    later();
                  } else {
                    on();
                  }
                },
                { once: true },
              );
              return;
            }
          }
        } catch (error) {}
        on();
      };
    </script>
    <link
      rel="stylesheet"
      href={withBase('fonts/pretendard/pretendardvariable-dynamic-subset.css')}
      media="print"
      onload="window.__apcFontCss ? window.__apcFontCss(this) : this.setAttribute('media','all')"
    />
    <noscript><link rel="stylesheet" href={withBase('fonts/pretendard/pretendardvariable-dynamic-subset.css')} /></noscript>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={isHome ? siteConfig.name : title} />
    <meta property="og:description" content={description} />
    {/* 검색 엔진에 올리지 않는 페이지(404 등)는 주소가 정해져 있지 않아 대표 주소를 적지 않는다(npm run check:links가 찾아낸 문제). */}
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <!-- 자바스크립트가 되면 html에 js 클래스를 붙인다. 좁은 화면 메뉴를 처음부터 접어 두어 화면이 흔들리지 않게 한다. -->
    <!-- 주소에 ?embed=1이 있으면 차시 페이지 안(iframe)에 넣은 것이다 — 머리글·바닥글·소개 글을 숨긴다(P2-14, global.css의 html[data-embed]). -->
    <!-- 그때 이 문서의 main에 이름을 붙인다: 차시 페이지의 main과 이름이 같으면 화면 낭독기의 영역 목록에 "기본 영역"이 둘 들린다 -->
    <!-- (axe landmark-unique — 2026-09-26 Phase 6 검토 지적). -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (new URLSearchParams(location.search).get('embed') === '1') {
          document.documentElement.dataset.embed = '1';
          document.addEventListener('DOMContentLoaded', function () {
            var main = document.getElementById('main-content');
            if (main && !main.hasAttribute('aria-label')) {
              main.setAttribute('aria-label', '차시 안 실습실');
            }
          });
        }
      } catch {
        // 주소를 못 읽어도 페이지는 그대로 보인다.
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <SiteHeader />
    {
      hasNotice && (
        <div class="page-notice">
          <div class="page-notice__inner">
            <slot name="notice" />
          </div>
        </div>
      )
    }
    <div class:list={['page', `page--${width}`]}>
      <div class="page__inner">
        {showBreadcrumb && <Breadcrumb items={Array.isArray(breadcrumb) ? breadcrumb : undefined} />}
        <main id="main-content" class="page__main" tabindex="-1" data-pagefind-body={searchIndex ? true : undefined}>
          <slot />
        </main>
      </div>
    </div>
    <SiteFooter />
    {/* 오프라인 준비(PD-11, P2-05). 실패해도 사이트는 그대로 돈다. 주소에 ?sw=off를 붙이면 등록을 풀고 이 사이트 캐시를 지운다. */}
    {/* 넘치는 표·그림 칸을 키보드로도 밀어 보게(넘치는 동안만 Tab 차례에 — src/components/common/scroll-focus.ts, Phase 6 접근성 점검) */}
    <script>
      import { installScrollFocus } from '../components/common/scroll-focus.ts';
      import { registerServiceWorker } from '../lab/loader/sw-client.ts';

      installScrollFocus();
      void registerServiceWorker();
    </script>
  </body>
</html>
