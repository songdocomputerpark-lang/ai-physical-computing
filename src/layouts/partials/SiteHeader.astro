---
/**
 * 머리글(공통 레이아웃의 일부) — 사이트 이름, [메뉴] 단추, 검색 상자.
 *
 * 판 1.9.0(DECISIONS C238): 주 메뉴(사이트 지도의 링크)는 머리글에서 왼쪽 메뉴판(./SideMenu.astro, id site-menu)으로 옮겼다.
 * 예전 넓은 화면 머리글은 아이콘 위·낱말 아래의 작은 칸 일곱 개(15px)가 이름과 검색 사이에 끼어 있어 읽기 어려웠다(운영자 "가독성이 너무 떨어짐").
 * - 순서(DOM = 보이는 차례): 사이트 이름 → [메뉴] 단추 → 검색 상자. 메뉴판은 머리글 바로 뒤(BaseLayout)라 Tab 차례도 머리글 → 메뉴판 → 본문이다.
 * - [메뉴]는 모든 화면 폭에서 보인다(자바스크립트가 될 때): 넓은 화면(75rem 이상)에서는 왼쪽 메뉴판을 접고 펴고(이 브라우저에 기억),
 *   좁은 화면에서는 머리글 바로 아래에 메뉴판을 열고 닫는다. aria-expanded로 열림을 알리고, 열고 닫는 동작은 ./side-menu-client.ts 한 곳이다.
 * - 넓은 화면 머리글은 화면 폭 가득(이름이 메뉴판 위 왼쪽 끝, 검색 상자가 오른쪽 끝) 한 줄이다. 좁은 화면은 첫 줄에 이름과 [메뉴], 둘째 줄에 검색 상자.
 * - 자바스크립트가 꺼져 있으면 [메뉴]가 없고 메뉴판이 늘 보인다.
 * - 머리글은 화면에 붙어 있지 않는다(sticky 아님): 붙이면 좁은 화면에서 두 줄(약 7rem)이 화면을 먹고, 글자만 키운 화면에서는 여러 줄이 되어
 *   #위치 이동·초점을 가린다(WCAG 2.4.11). --header-height(tokens.css)는 넓은 화면 한 줄 머리글의 높이다.
 * - 검색 상자는 src/components/search/HeaderSearch.astro(검색 담당 파일)를 그대로 넣는다. 이 파일은 자리·폭만 정한다.
 */
import Icon from '../../components/common/Icon.astro';
import HeaderSearch from '../../components/search/HeaderSearch.astro';
import { siteConfig } from '../../config/site.ts';
import { normalizePagePath, withBase } from '../../lib/url.ts';

const pathname = Astro.url.pathname;
const isHome = normalizePagePath(pathname) === '/';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href={withBase('')} aria-current={isHome ? 'page' : undefined}>
      <svg class="site-header__logo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <rect class="site-header__logo-bg" width="64" height="64" rx="14"></rect>
        <circle class="site-header__logo-stroke" cx="22" cy="32" r="10"></circle>
        <circle class="site-header__logo-fill" cx="22" cy="32" r="3.5"></circle>
        <path class="site-header__logo-stroke" d="M34 32h8"></path>
        <rect class="site-header__logo-fill" x="43" y="22" width="11" height="20" rx="3"></rect>
      </svg>
      <span class="site-header__name">{siteConfig.name}</span>
    </a>

    <button class="site-header__menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
      <span class="site-header__menu-icon site-header__menu-icon--closed"><Icon name="menu" size="sm" /></span>
      <span class="site-header__menu-icon site-header__menu-icon--open"><Icon name="close" size="sm" /></span>
      <span class="site-header__menu-label">메뉴</span>
    </button>

    <div class="site-header__search">
      <HeaderSearch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    width: min(100% - 2 * var(--gutter), var(--width-page));
    margin-inline: auto;
    padding-block: var(--space-2);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    margin-inline-end: auto;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-accent-hover);
  }

  .site-header__logo {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .site-header__logo-bg {
    fill: var(--color-accent);
  }

  .site-header__logo-stroke {
    fill: none;
    stroke: var(--color-on-accent);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .site-header__logo-fill {
    fill: var(--color-on-accent);
  }

  /* 메뉴 버튼: 자바스크립트가 될 때만 보인다(아래 :global(.js) 규칙) */
  .site-header__menu-button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .site-header__menu-button[aria-expanded='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .site-header__menu-icon {
    display: inline-flex;
  }

  /* 좁은 화면: 닫혀 있으면 ☰, 열려 있으면 ✕ (글자 "메뉴"는 그대로 — 열림 여부는 aria-expanded로도 알린다).
     넓은 화면은 메뉴판이 펴져 있는 것이 보통이라 늘 ☰(아래 75rem 규칙) — 펴짐은 단추 바탕색과 aria-expanded로 알린다. */
  .site-header__menu-icon--open,
  .site-header__menu-button[aria-expanded='true'] .site-header__menu-icon--closed {
    display: none;
  }

  .site-header__menu-button[aria-expanded='true'] .site-header__menu-icon--open {
    display: inline-flex;
  }

  .site-header__search {
    flex-basis: 100%;
    min-width: 0;
  }

  /* [메뉴] 단추: 자바스크립트가 되면 어느 화면 폭에서나 보인다(넓은 화면은 왼쪽 메뉴판 접기·펴기, 좁은 화면은 열기·닫기) */
  :global(.js) .site-header__menu-button {
    display: inline-flex;
  }

  @media (max-width: 74.99rem) {
    .site-header__search {
      padding-block-end: var(--space-1);
    }
  }

  /*
   * 아주 좁은 화면(22.5rem = 360px 미만, 예: 320px 휴대폰): 사이트 이름과 [메뉴] 버튼을 한 줄에 둔다.
   * 줄바꿈(flex-wrap)은 항목의 원래 너비로 정해져서, 이름 칸의 기준 너비를 0으로 두고(flex-basis 0, min-width 0)
   * 남은 자리를 채우게 한다. 이름이 길면 이름 안에서 줄을 바꿔 [메뉴] 버튼이 둘째 줄로 내려가지 않는다.
   */
  @media (max-width: 22.49rem) {
    .site-header__brand {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  @media (min-width: 30rem) {
    .site-header__brand {
      font-size: var(--text-lg);
    }
  }

  /*
   * 넓은 화면: 이름 · [메뉴] · 검색이 화면 폭 가득 한 줄(이름은 왼쪽 메뉴판 위). flex-wrap은 그대로 두어(nowrap 아님) 글자만 200%로 키운 브라우저처럼
   * 한 줄에 다 들어가지 않으면 검색 상자가 다음 줄로 내려간다(2026-09-16 검토 반영: nowrap이던 때 글자 200%에서 277px 넘쳐 검색 상자가 화면 밖으로 나갔다).
   */
  @media (min-width: 75rem) {
    .site-header__inner {
      width: 100%;
      min-height: var(--header-height);
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-1);
      padding-inline: var(--space-5);
    }

    .site-header__brand {
      flex: none;
      margin-inline-end: 0;
    }

    .site-header__menu-button[aria-expanded='true'] .site-header__menu-icon--closed {
      display: inline-flex;
    }

    .site-header__menu-button[aria-expanded='true'] .site-header__menu-icon--open {
      display: none;
    }

    /*
     * 메뉴판을 접은 넓은 화면(실습실은 처음부터)은 예전처럼 머리글 칸을 본문 칸(76rem)에 맞춘다 — 사이트 이름이 빵부스러기·쪽 제목과 같은 왼쪽 선에서
     * 시작한다(R1-102, tests/e2e/labs-ui.spec.ts 1920 폭). 메뉴판이 펴져 있으면 이름은 메뉴판 위 왼쪽 끝이다.
     */
    :global(:root[data-side-menu='closed']) .site-header__inner {
      width: min(100% - 2 * var(--gutter), var(--width-page));
      padding-inline: 0;
    }

    /* 검색 칸: 오른쪽 끝, 22rem까지 자라는 상자. 안의 검색 폼(HeaderSearch.astro)이 flex 항목으로 자라 이 칸을 채운다. */
    .site-header__search {
      display: flex;
      flex: 0 1 22rem;
      min-width: 12rem;
      margin-inline-start: auto;
      padding-block: 0;
    }
  }
</style>
