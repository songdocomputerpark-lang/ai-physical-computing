---
/**
 * 준비 진행률·1분 개념 카드·오프라인 준비의 화면 조각(PLAN §5.4, src/lab/README.md 4절).
 * LabShell이 [data-lab-module-panel="loading"] 안에 그려 두고(hidden), index.ts의 mount가 showPanel()로 연다.
 * 이 파일은 HTML·CSS만 그리고, 글자·단계 줄·카드 내용은 index.ts가 data-loading-* 표시를 찾아 채운다
 * (카드 글은 src/lab/loader/cards.ts 한 곳에 있다).
 * 겉과 카드 칸은 영역(section)이 아니라 이름 붙은 묶음(role="group")이다 — 영역 이름은 LabShell의 모듈 칸("준비 — 컴퓨터 칸" 등)이 맡아,
 * 한 쪽에 실습실 틀이 둘인 4단원 화면에서 같은 이름의 영역이 겹치지 않게 한다(axe landmark-unique, 2026-09-26 Phase 6 통합).
 */
---

<div class="loading" data-loading-panel data-collapsed="false" role="group" aria-labelledby="lab-loading-title">
  <div class="loading__head">
    <h3 class="loading__title" id="lab-loading-title" data-loading-title>파이썬을 준비하고 있어요</h3>
    <p class="loading__line" role="status" aria-live="polite" data-loading-text></p>
    <button type="button" class="lab-button lab-button--small loading__toggle" data-loading-toggle aria-expanded="true">접기</button>
  </div>

  <div class="loading__body" data-loading-body>
    <div class="loading__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="준비 진행률" data-loading-bar>
      <div class="loading__bar-fill" data-loading-fill></div>
    </div>

    <ol class="loading__stages" data-loading-stages></ol>

    <p class="loading__source" data-loading-source-text></p>

    <div class="loading__cards" data-loading-cards role="group" aria-label="기다리는 동안 읽는 1분 개념">
      <article class="loading__card" data-loading-card>
        <h4 class="loading__card-title" data-loading-card-title></h4>
        <div class="loading__card-body" data-loading-card-body></div>
        <p class="loading__card-code"><code data-loading-card-code></code></p>
        <p class="loading__card-link"><a href="#" data-loading-card-link></a></p>
      </article>
      <div class="loading__card-nav">
        <button type="button" class="lab-button lab-button--small" data-loading-prev aria-label="이전 개념 카드">← 이전</button>
        <span class="loading__card-counter" data-loading-counter aria-live="off"></span>
        <button type="button" class="lab-button lab-button--small" data-loading-next aria-label="다음 개념 카드">다음 →</button>
      </div>
    </div>

    <div class="loading__actions">
      <button type="button" class="lab-button" data-loading-prefetch>이 컴퓨터에 실습 파일 미리 받기</button>
      <p class="loading__status" role="status" aria-live="polite" data-loading-prefetch-status></p>
    </div>

    <p class="loading__note" data-loading-note></p>
  </div>
</div>

<style>
  .loading {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  /* 제목과 [접기]는 한 줄, 진행 글은 그 아래 한 줄 전부 — 좁은 화면에서 단추가 잘리지 않게 자리를 나눈다. */
  .loading__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .loading__title {
    grid-column: 1;
    margin: 0;
    font-size: var(--text-lg);
  }

  .loading__line {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .loading__toggle {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .loading__body {
    display: grid;
    gap: var(--space-3);
  }

  .loading[data-collapsed='true'] .loading__body {
    display: none;
  }

  .loading__bar {
    position: relative;
    height: 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-bg);
    overflow: hidden;
  }

  .loading__bar-fill {
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width 200ms linear;
  }

  /* 전체 크기를 모를 때(첫 방문, 서비스 워커가 아직 페이지를 맡지 않음)는 움직이는 줄무늬로 "받는 중"만 보여 준다. */
  .loading__bar[data-indeterminate='true'] .loading__bar-fill {
    width: 100%;
    background: repeating-linear-gradient(
      135deg,
      var(--color-accent) 0 0.75rem,
      var(--color-accent-soft) 0.75rem 1.5rem
    );
    background-size: 2.13rem 100%;
    animation: loading-stripes 1.2s linear infinite;
  }

  @keyframes loading-stripes {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 2.13rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading__bar-fill {
      transition: none;
    }

    .loading__bar[data-indeterminate='true'] .loading__bar-fill {
      animation: none;
    }
  }

  .loading__stages {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  /*
   * 단계 줄은 index.ts가 만들어 넣는다. Astro의 스코프 스타일은 이 파일에 적힌 요소에만 붙으므로,
   * 자바스크립트가 만든 자식에게는 :global()로 규칙을 준다(뿌리 .loading__stages는 이 파일 것이라 다른 곳에 새지 않는다).
   */
  .loading__stages :global(.loading__stage) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .loading__stages :global(.loading__stage-mark) {
    width: 1.25rem;
    text-align: center;
  }

  .loading__stages :global(.loading__stage-bytes) {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .loading__stages :global(.loading__stage[data-state='done'] .loading__stage-name) {
    color: var(--color-text-muted);
  }

  .loading__stages :global(.loading__stage[data-state='active'] .loading__stage-name) {
    font-weight: var(--weight-semibold);
  }

  .loading__stages :global(.loading__stage[data-state='failed'] .loading__stage-name) {
    color: var(--color-danger-text);
    font-weight: var(--weight-semibold);
  }

  .loading__source,
  .loading__note,
  .loading__status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .loading__source:empty,
  .loading__note:empty,
  .loading__status:empty,
  .loading__card-code:empty {
    display: none;
  }

  .loading__cards {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .loading__card-title {
    margin: 0;
    font-size: var(--text-base);
  }

  .loading__card-body {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* 카드 문장도 index.ts가 만들어 넣는다(위 단계 줄과 같은 이유로 :global). */
  .loading__card-body :global(p) {
    margin: 0;
  }

  .loading__card-code {
    margin: 0;
  }

  .loading__card-code code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    /* 좁은 화면에서는 줄을 바꿔 보여 준다(가로 스크롤 대신). */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .loading__card-link {
    margin: 0;
    font-size: var(--text-sm);
  }

  .loading__card-link[hidden] {
    display: none;
  }

  .loading__card-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .loading__card-counter {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .loading__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
</style>
