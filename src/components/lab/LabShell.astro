---
/**
 * 실습실 공통 화면 틀(PLAN §8.2 P2-02, SPEC §6.1 화면 구성).
 *
 * 배치(데스크톱 64rem 이상): 위 조작 줄 → (첫 준비 동안만) 준비 칸 자리 [data-lab-intro] → 왼쪽 코드 에디터 / 오른쪽 위 입력·출력(io 슬롯) /
 * 오른쪽 아래 조절 패널(panel 슬롯) → 넓은 모듈 줄 → 아래 콘솔(input() 입력줄 포함) → [이 컴퓨터에서 내 기록 지우기].
 * 좁은 화면에서는 같은 순서로 세로로 쌓인다. 보이는 차례 = DOM 차례(= Tab 차례)다 — 칸을 CSS로만 옮겨 보이게 하지 않는다(WCAG 2.4.3).
 * 화면 논리(에디터·실행기·자동 저장·공유 링크·내려받기)는 src/lab/controls/lab-shell.ts가 맡는다. 이 파일은 HTML·CSS만 그린다.
 *
 * 조작 줄 묶음(.lab__bar = 조작 줄 + 상태 줄 + 안내 줄): 넓고 높은 화면에서는 화면 위에 붙는다(sticky, 판 1.3.0 R1-096). 틀(.lab)은 폭 컨테이너라
 * 칸 배치·붙임이 화면 폭이 아니라 틀 폭(rem)을 따른다 — html 글자 크기를 키우면 같은 화면에서도 한 열로 쌓인다(R1-108).
 *
 * 쓰는 법
 *   <LabShell labId="vision" examples={examples}>
 *     <div slot="io">카메라 입력·출력 캔버스</div>       ← P2-03이 넣는다(없으면 자리 상자)
 *     <div slot="panel">다른 조절 패널</div>            ← (선택) 없으면 코드의 # @slider 규약으로 만드는 조절 패널(ParamPanel, P2-04)
 *     <section slot="after">실습실 아래에 둘 것</section> ← (선택) 개발용 정보 등
 *   </LabShell>
 *
 * props
 *   labId             실습실 이름(영문 소문자·숫자·하이픈). 자동 저장 이름 editor:<labId>:<예제 id>에 쓴다. 예: vision, esp32, iot, dev
 *   examples          예제 목록(src/lab/controls/examples.ts의 LabExample[]). 비어 있으면 [예제 불러오기]가 꺼진다.
 *   initialExampleId  (선택) 처음 고를 예제 id. 없으면 ?example=(examples/ 경로) → 저장된 마지막 예제 → 첫 예제.
 *   editorTitle       (선택) 편집칸 제목(기본 "코드")
 *   headingLevel      (선택) 칸 제목의 단계 2 또는 3(기본 2). 차시 안에 넣을 때 3.
 *   pyodidePackages   (선택) 이 실습실이 쓰는 Pyodide 패키지(예: ['opencv-python']). 준비 모듈(loading)의 [미리 받기]·캐시 채우기가
 *                     파이썬 엔진 + 이 패키지만 받는다 — ESP32 실습실은 []라서 OpenCV를 받지 않는다(PD-04, P3-01). 적지 않으면 예비본 전체.
 *                     실행 때 학생 코드의 import 문을 보고 받는 것은 이 값이 아니라 붙는 흉내 모듈의 manifest가 정한다(packagesFromImports —
 *                     가상 보드 모듈이 false라 ESP32 실습실은 실행 때도 받지 않는다, 판 1.1.3).
 *   contextLabel      (선택) 한 쪽에 실습실 틀이 둘 이상일 때 칸 이름 뒤에 붙일 짧은 이름(예: 4단원 통합 화면의 '컴퓨터 칸'·'보드 칸').
 *                     칸(코드·입력과 출력·조절 패널·콘솔·모듈 패널)은 이름 붙은 영역(region)이라 화면 낭독기의 영역 목록에 나오는데,
 *                     틀이 둘이면 "코드"가 두 번 나와 어느 쪽인지 모른다(axe landmark-unique — Phase 6 접근성 점검).
 *                     주면 칸 이름이 "코드 — 컴퓨터 칸"처럼 된다. 화면 글자는 그대로다.
 *   idSuffix          (선택) 한 쪽에 실습실 틀이 둘 이상일 때 이 칸의 id 꼬리(영문 소문자·숫자·하이픈, 예: 'pc'·'board' — 판 1.1.0,
 *                     PROGRESS 미해결 138). 두 칸에 함께 붙는 흉내 모듈 패널은 고정 id를 쓰므로 같은 id가 두 번 나오는데, 실습실 틀이
 *                     그런 id에 `--<꼬리>`를 붙이고 칸 안의 이름표(for)·aria 참조를 함께 고친다(lab-shell.ts scopeLabIds — 모듈이 붙기 전).
 *                     적지 않으면 labId를 꼬리로 쓴다. 칸이 하나인 쪽에서는 아무 일도 없다. contextLabel과 짝으로 준다.
 *   coach             (선택, 기본 true) 조작 줄 묶음(.lab__bar) 아래 "① 예제를 골라요 → ② [실행]을 눌러요 → ③ 결과를 봐요" 코치 줄(판 1.3.0)을 그릴지.
 *                     한 쪽에 틀이 둘이면(4단원 통합 화면) 한 번만 보이게 첫 틀에만 두고 둘째에는 coach={false}를 준다.
 *                     코치 줄은 Tab 정지점이 없는 목록이고 차시 안 임베드(?embed=1)에서는 숨는다. 지금 단계 강조는 data-run-count를
 *                     읽는 CSS뿐이다(새 JS 상태 없음).
 *
 * 한 쪽에 틀이 여럿이면 주소의 공유 링크(#code=…&lab=<labId>)·?example=도 틀이 맞는 칸에만 넣는다(lab-shell.ts 머리말) —
 * 페이지가 따로 우회할 것이 없다.
 *
 * 콘솔(<pre data-lab-console>)은 role="log" + aria-live="off": 이름("콘솔 출력")과 역할을 화면 낭독기에 알리되, 줄마다 읽지는 않는다
 * (결과는 "콘솔에 결과가 나왔어요"와 결과 줄이 실행마다 한 번 알린다 — lab-shell.ts). 역할 없는 <pre>에 aria-label만 두면 낭독기가
 * 이름을 읽지 않는다(axe aria-prohibited-attr, 2026-09-26 Phase 6 기준 측정에서 찾음).
 *
 * 페이지 스크립트가 실습실을 다루려면 src/lab/controls/lab-shell.ts의 getLabController(root)를 쓴다(컨트롤러 API는 그 파일 머리말).
 * 사이트 검색 색인에서는 뺀다(data-pagefind-ignore) — 실습실 안 글은 조작 안내뿐이라 결과만 늘린다.
 */
import Callout from '../common/Callout.astro';
import { assertValidExamples, type LabExample } from '../../lab/controls/examples.ts';
import { TAB_HINT } from '../../lab/editor/python-editor.ts';
import { folderNameOf, modulesForLab } from '../../lab/modules/manifests.ts';
import type { ModulePlacement } from '../../lab/modules/types.ts';
import { STOP_GRACE_MS } from '../../lab/runtime/config.ts';
import { studentExampleTitle } from '../../lab/controls/example-names.ts';
import ClearRecordsButton from './ClearRecordsButton.astro';
import LabPageFrame from './LabPageFrame.astro';
import ParamPanel from './ParamPanel.astro';

// Props는 import 바로 아래(첫 const 앞)에 둔다 — 앞에 const 선언이 있으면 Astro가 이 interface를 컴포넌트 props 형으로 잇지 않아
// 틀린 props를 타입 검사가 잡지 못했다(판 1.1.1 최종 점검 — astro check의 "'Props' is declared but never used" 힌트).
interface Props {
  labId: string;
  examples?: readonly LabExample[];
  initialExampleId?: string;
  editorTitle?: string;
  headingLevel?: 2 | 3;
  pyodidePackages?: readonly string[];
  contextLabel?: string;
  idSuffix?: string;
  coach?: boolean;
}

/**
 * 흉내 모듈 폴더의 화면 조각(src/lab/modules/<id>/panel.astro, 자동 발견 — src/lab/README.md 4절).
 * 이 실습실(labId)에 붙는 모듈의 것만 그려 두고(hidden), 모듈의 index.ts가 mount 때 showPanel()로 연다.
 * placement 'panel'은 조절 패널 아래(오른쪽 열), 'wide'는 입력·출력과 콘솔 사이 전체 폭.
 */
const panelComponents = import.meta.glob<{ default: (props: Record<string, never>) => unknown }>('../../lab/modules/*/panel.astro', { eager: true });
const modulePanelsById = new Map(Object.entries(panelComponents).map(([globPath, loaded]) => [folderNameOf(globPath), loaded.default]));

const { labId, examples = [], initialExampleId, editorTitle = '코드', headingLevel = 2, pyodidePackages, contextLabel, idSuffix, coach = true } = Astro.props;
if (!/^[a-z0-9][a-z0-9-]*$/u.test(labId)) {
  throw new Error(`LabShell: labId "${labId}"은(는) 영문 소문자·숫자·하이픈만 써요(예: vision).`);
}
if (idSuffix !== undefined && !/^[a-z0-9][a-z0-9-]*$/u.test(idSuffix)) {
  throw new Error(`LabShell: idSuffix "${idSuffix}"은(는) 영문 소문자·숫자·하이픈만 써요(예: board).`);
}
assertValidExamples(examples);
const context = contextLabel?.trim() || undefined;
/**
 * 칸 이름 속성. 보통은 칸 제목을 가리키고(aria-labelledby), 한 쪽에 틀이 여럿이면(contextLabel) "제목 — 칸 이름"을 aria-label로 준다.
 * 제목 글자와 같은 글로 시작하므로 음성 명령("코드 누르기")·화면 글자와도 어긋나지 않는다.
 */
const regionName = (headingId: string, headingText: string) =>
  context ? { 'aria-label': `${headingText} — ${context}` } : { 'aria-labelledby': headingId };
/** 흉내 모듈 패널 이름(패널은 자기 제목을 그리므로 이름만 준다) */
const moduleName = (title: string): string => (context ? `${title} — ${context}` : title);

const Heading = `h${headingLevel}` as 'h2' | 'h3';
const ids = {
  editorHeading: `lab-${labId}-editor-heading`,
  editorHint: `lab-${labId}-editor-hint`,
  ioHeading: `lab-${labId}-io-heading`,
  panelHeading: `lab-${labId}-panel-heading`,
  consoleHeading: `lab-${labId}-console-heading`,
  exampleSelect: `lab-${labId}-example`,
  input: `lab-${labId}-input`,
  shareTitle: `lab-${labId}-share-title`,
  shareUrl: `lab-${labId}-share-url`,
  resetTitle: `lab-${labId}-reset-title`,
};
const hasIo = Astro.slots.has('io');
const hasPanel = Astro.slots.has('panel');
// JSON 안의 <를 유니코드로 바꿔 </script>가 스크립트를 끊지 못하게 한다.
const examplesJson = JSON.stringify(examples).replace(/</gu, '\\u003c');

// [예제 불러오기] 선택 상자: group이 있는 예제는 같은 이름끼리 optgroup으로 묶는다(목록 순서 유지, 없는 것은 그대로).
const exampleGroups: { label: string | null; items: LabExample[] }[] = [];
for (const example of examples) {
  const label = example.group ?? null;
  const last = exampleGroups[exampleGroups.length - 1];
  if (last && last.label === label) {
    last.items.push(example);
  } else {
    exampleGroups.push({ label, items: [example] });
  }
}

// 이 실습실에 붙는 흉내 모듈의 panel.astro(있는 것만), 위치별로 나눈다.
const modulePanels = modulesForLab(labId)
  .filter((manifest) => modulePanelsById.has(manifest.id))
  .map((manifest) => ({ id: manifest.id, title: manifest.title, placement: (manifest.placement ?? 'panel') as ModulePlacement, Component: modulePanelsById.get(manifest.id)! }));
const sidePanels = modulePanels.filter((panel) => panel.placement === 'panel');
const widePanels = modulePanels.filter((panel) => panel.placement === 'wide');
---

{/* 넓은 쪽의 폭 규약(전역 CSS만 — 판 1.3.0 R1-102). 아무것도 그리지 않는다. */}
<LabPageFrame />
<div
  class="lab"
  data-lab
  data-lab-id={labId}
  data-lab-id-suffix={idSuffix}
  data-initial-example={initialExampleId}
  data-lab-packages={pyodidePackages ? pyodidePackages.join(' ') : undefined}
  data-state="unloaded"
  data-jspi="pending"
  data-limited="pending"
  data-outcome=""
  data-run-count="0"
  data-stop-ms=""
  data-save-state="idle"
  data-example=""
  data-loading-intro="yes"
  data-pagefind-ignore
>
  <script is:inline type="application/json" data-lab-examples set:html={examplesJson} />

  {/*
    조작 줄 + 상태 줄 + 안내 줄을 한 묶음(.lab__bar)으로 둔다 — 넓은 화면에서는 이 묶음이 화면 위에 붙어(sticky) [실행] 뒤 화면이 결과 칸으로 내려가도
    [정지]·상태 줄이 계속 보인다(판 1.3.0 검수 R1-096). 코치 줄은 묶음 밖(바로 아래)이라 붙지 않는다 — 붙는 높이를 줄이려는 것.
    좁은 화면·낮은 화면에서는 붙이지 않는다: 붙은 줄이 화면을 먹고, 휴대폰에서는 보드 조작 칸을 가린 전례가 있다(아래 .lab__io-output 주석).
  */}
  <div class="lab__bar" data-lab-bar>
    <div class="lab__toolbar" data-lab-toolbar>
      <div class="lab__actions">
        <button type="button" class="button button--primary" data-lab-run disabled>실행</button>
        <button type="button" class="button button--secondary" data-lab-stop disabled>정지</button>
        <button type="button" class="lab-button" data-lab-reset>초기화</button>
      </div>
      <div class="lab__examples">
        <label class="lab__examples-label" for={ids.exampleSelect}>예제</label>
        <select id={ids.exampleSelect} class="lab__select" data-lab-example-select disabled={examples.length === 0}>
          {examples.length === 0 && <option value="">예제가 아직 없어요</option>}
          {
            exampleGroups.map((group) =>
              group.label === null ? (
                group.items.map((example) => <option value={example.id}>{studentExampleTitle(example.title)}</option>)
              ) : (
                <optgroup label={studentExampleTitle(group.label)}>{group.items.map((example) => <option value={example.id}>{studentExampleTitle(example.title)}</option>)}</optgroup>
              ),
            )
          }
        </select>
      </div>
      <div class="lab__tools">
        <button type="button" class="lab-button" data-lab-example-load disabled={examples.length === 0}>예제 불러오기</button>
        <button type="button" class="lab-button lab-button--quiet" data-lab-share>공유 링크</button>
        <button type="button" class="lab-button lab-button--quiet" data-lab-download>.py 내려받기</button>
      </div>
    </div>

    <p class="lab__status">
      <span class="lab__status-main" role="status" aria-live="polite" data-lab-status>아직 시작하지 않았어요.</span>
      {/* 받은 양이 바뀔 때마다 바뀌어 낭독하지 않는다 — 준비 칸의 낭독 줄이 단계가 바뀔 때 알린다(loading/index.ts 머리말 6, 판 1.2.1) */}
      <span class="lab__status-progress" data-lab-progress aria-live="off"></span>
    </p>
    <p class="lab__message" role="status" aria-live="polite" data-lab-message></p>
  </div>

  {
    /* 처음 쓰는 방법 코치 줄(판 1.3.0). 조작 줄 묶음 바로 아래 — 조작 줄 위에는 역할 띠가 오고, 준비 칸 자리([data-lab-intro])에는 아무것도 넣지 않는다. */
    coach && (
      <ol class="lab__coach steps" aria-label="처음 쓰는 방법" data-lab-coach data-embed-hide>
        <li>예제를 골라요</li>
        <li>[실행]을 눌러요</li>
        <li>결과를 봐요</li>
      </ol>
    )
  }

  {/*
    지금 예제가 어느 차시에서 나오는지(예제 머리말 # @lesson / 사이드카 lesson). 차시에서 [실습실에서 열기]로 넘어온 학생이
    돌아갈 길이 화면에 하나도 없었다(2026-09-17 검토 반영). 차시 안 임베드에서는 같은 쪽이라 숨긴다.
  */}
  <p class="lab__lesson" data-lab-lesson data-embed-hide hidden>
    이 예제가 나오는 차시:{' '}
    <a class="lab__lesson-link" data-lab-lesson-link href="">차시</a>
  </p>

  {/*
    예제 한 줄 설명(사이드카 description). 이름만 다른 두 예제("…(원본 파일)"과 "…(사이트판)")를 학생이 구분할 길이 화면에
    하나도 없었다(2026-09-18 검토 반영 — 원본 파일 쪽은 일부러 틀린 결과가 나오는 예제라 자기 실수로 오해한다).
  */}
  <p class="lab__example-desc" data-lab-example-description hidden></p>

  <div data-lab-limited hidden>
    <Callout type="주의" title="제한 모드로 실행해요">
      <p>
        이 브라우저에는 JSPI(파이썬 기다리기 기능)가 없어서 입력이나 카메라를 기다리는 코드는 실행할 수 없어요. 한 번 실행되고
        끝나는 코드는 돌아요. [정지]를 누르면 파이썬을 다시 시작하는 방식으로만 멈춰요.
      </p>
    </Callout>
  </div>

  {/*
    첫 준비 동안 맨 위에 둘 칸 자리(판 1.2.0 — PROGRESS 미해결 218, WCAG 2.4.3 초점 차례). 준비 칸(loading 모듈)이 붙을 때
    data-loading-intro="yes"면 자기 칸을 DOM째 여기로 옮기고, 준비가 끝나 접히거나 [실행]을 누르면 제자리(.lab__modules)로 돌아간다
    (src/lab/modules/loading/intro.ts). 편집칸보다 DOM 앞이라 보이는 차례와 Tab 차례가 같다. 들어 있는 칸이 없거나 숨으면 자리도 없다.
  */}
  <div class="lab__intro" data-lab-intro></div>

  <div class="lab__grid">
    <section class="lab__editor" {...regionName(ids.editorHeading, editorTitle)}>
      <div class="lab__section-head">
        <Heading id={ids.editorHeading} class="lab__heading">{editorTitle}</Heading>
        <div class="lab__font" role="group" aria-label="글자 크기">
          <button type="button" class="lab-button lab-button--small" data-lab-font-smaller aria-label="글자 작게">A−</button>
          <span class="lab__font-size" data-lab-font-size aria-live="polite">15px</span>
          <button type="button" class="lab-button lab-button--small" data-lab-font-larger aria-label="글자 크게">A+</button>
        </div>
        <span class="lab__save" data-lab-save aria-live="polite"></span>
      </div>
      {/*
        Tab 안내는 편집칸 **위**에 둔다. 아래에 있으면 키보드만 쓰는 학생이 편집칸에 들어간 뒤에야 읽게 된다(2026-09-17 검토 반영).
        Tab으로 막 들어온 편집칸은 Tab 한 번으로 지나가고, 글을 쓰기 시작하면 Tab이 들여쓰기다(python-editor.ts 머리말).
      */}
      <p id={ids.editorHint} class="lab__hint lab__hint--before" data-lab-editor-hint>{TAB_HINT}</p>
      <div class="lab__editor-host" data-lab-editor data-label="파이썬 코드"></div>
    </section>

    <section class="lab__io" data-lab-io {...regionName(ids.ioHeading, '입력과 출력')}>
      <Heading id={ids.ioHeading} class="lab__heading">입력과 출력</Heading>
      {
        hasIo ? (
          <slot name="io" />
        ) : (
          <div class="lab__placeholder">
            <p>카메라 입력과 결과 화면이 들어올 자리예요. 지금은 콘솔 출력만 있어요.</p>
          </div>
        )
      }
      {/*
        결과가 print()뿐인 예제(보드 출력 테스트·값 읽기 등)에서 학생이 "아무 일도 일어나지 않았다"로 읽던 것을 고친다
        (2026-09-18 검토 반영 — 콘솔은 1366×768에서 결과 칸보다 688px, 375×812에서 696px 아래라 [실행] 뒤에도 화면에 없었다).
        콘솔이 화면 밖일 때만 여기에 마지막 몇 줄을 비춰 주고 [콘솔 보기]로 내려간다. 콘솔이 화면에 들어오면 저절로 사라진다.
      */}
      <div class="lab__io-output" data-lab-io-output hidden>
        <p class="lab__io-output-head">
          <span data-lab-io-output-head role="status" aria-live="polite"></span>
          <span class="lab__io-output-count" data-lab-io-output-count></span>
          <button type="button" class="lab-button lab-button--small" data-lab-console-jump>콘솔 보기 ↓</button>
        </p>
        <pre class="lab__io-output-text" data-lab-io-output-text></pre>
      </div>
    </section>

    <section class="lab__panel" {...regionName(ids.panelHeading, '조절 패널')}>
      <Heading id={ids.panelHeading} class="lab__heading">조절 패널</Heading>
      {hasPanel ? <slot name="panel" /> : <ParamPanel />}
      {
        sidePanels.map(({ id, title, Component }) => (
          <section class="lab__module" data-lab-module-panel={id} aria-label={moduleName(title)} hidden>
            <Component />
          </section>
        ))
      }
    </section>

    {
      widePanels.length > 0 && (
        <div class="lab__modules">
          {widePanels.map(({ id, title, Component }) => (
            <section class="lab__module lab__module--wide" data-lab-module-panel={id} aria-label={moduleName(title)} hidden>
              <Component />
            </section>
          ))}
        </div>
      )
    }

    <section class="lab__console" {...regionName(ids.consoleHeading, '콘솔')}>
      <div class="lab__section-head">
        <Heading id={ids.consoleHeading} class="lab__heading">콘솔</Heading>
        {/* 콘솔이 화면 밖에 있는 동안 쌓인 새 출력 줄 수(위 결과 칸의 알림과 짝) — 콘솔이 보이면 사라진다 */}
        <span class="lab__console-new" data-lab-console-new hidden></span>
        <button type="button" class="lab-button lab-button--small" data-lab-console-clear>콘솔 지우기</button>
      </div>
      {/* role="log" + aria-live="off": 이름·역할은 알리고 줄마다 읽지는 않는다(머리말). tabindex="0": 키보드로 콘솔을 스크롤한다. */}
      <pre class="lab-console" data-lab-console role="log" aria-live="off" aria-label={context ? `콘솔 출력 — ${context}` : '콘솔 출력'} tabindex="0"></pre>
      <form class="lab__input" data-lab-input-form hidden>
        <label class="lab__input-label" for={ids.input} data-lab-input-label>입력</label>
        <input id={ids.input} class="lab__input-field" type="text" data-lab-input autocomplete="off" />
        <button type="submit" class="button button--primary">입력</button>
      </form>
      <p class="lab__result" role="status" aria-live="polite" data-lab-result></p>
      <p class="lab__hint" data-lab-stop-hint="runtime">
        [정지]를 누르면 기다리는 곳(time.sleep, input, asyncio.sleep)에서 바로 멈춰요. {STOP_GRACE_MS / 1000}초 안에 멈추지 않으면 파이썬을 다시
        시작해요.
      </p>
      <p class="lab__hint" data-lab-stop-hint="target">
        [정지]를 누르면 연결한 보드에 멈춤 신호(Ctrl-C)를 보내요. 멈추지 않으면 입력·출력 칸의 [보드 되찾기]를 눌러요.
      </p>
    </section>
  </div>

  <div class="lab__records">
    <ClearRecordsButton id={`lab-${labId}-clear-records`} />
  </div>

  <slot name="after" />

  <dialog class="lab-dialog" data-lab-share-dialog aria-labelledby={ids.shareTitle}>
    <h2 id={ids.shareTitle} class="lab-dialog__title">공유 링크</h2>
    <label class="lab-dialog__label" for={ids.shareUrl}>주소</label>
    <input id={ids.shareUrl} class="lab-dialog__url" type="text" readonly data-lab-share-url />
    <p class="lab-dialog__note" data-lab-share-note></p>
    <p class="lab-dialog__note">코드만 담겨요. 카메라 영상이나 입력한 글자는 들어가지 않아요.</p>
    <p class="lab-dialog__note lab-dialog__note--warn">
      대신 <strong>코드에 적은 이름·학번·비밀번호는 링크를 받는 사람이 모두 볼 수 있어요.</strong> 지우고 공유해 주세요.
    </p>
    <div class="lab-dialog__actions">
      <button type="button" class="button button--primary" data-lab-share-copy>복사</button>
      <button type="button" class="button button--secondary" data-lab-dialog-close>닫기</button>
    </div>
    <p class="lab-dialog__status" role="status" aria-live="polite" data-lab-share-copied></p>
  </dialog>

  <dialog class="lab-dialog" data-lab-reset-dialog aria-labelledby={ids.resetTitle}>
    <h2 id={ids.resetTitle} class="lab-dialog__title">초기화</h2>
    <p>지금 코드를 지우고 예제 원래 코드로 되돌릴까요? 고친 내용은 사라져요(되돌리기 Ctrl+Z로는 돌아오지 않아요).</p>
    <div class="lab-dialog__actions">
      <button type="button" class="button button--primary" data-lab-reset-confirm>되돌리기</button>
      <button type="button" class="button button--secondary" data-lab-dialog-close>취소</button>
    </div>
  </dialog>
</div>

<script>
  import { mountLabShell } from '../../lab/controls/lab-shell.ts';
  import { mountLabModules } from '../../lab/modules/host.ts';
  import { mountParamPanel } from '../../lab/params/panel.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-lab]')) {
    const lab = mountLabShell(root);
    if (lab) {
      // 조절 패널(코드의 # @slider 규약, P2-04). panel 슬롯을 다른 것으로 채운 페이지에는 [data-lab-params]가 없어 null이다.
      mountParamPanel(root, lab);
      // 흉내 모듈 폴더(src/lab/modules/<id>/)의 화면 쪽 — 이 실습실에 붙는 모듈만 따로 받아 붙인다. 실패해도 실습실은 그대로 돈다.
      void mountLabModules(root, lab);
    }
  }
</script>

<style>
  /*
   * 세로로 쌓는 틀. 예전에는 한 열 grid였는데, grid 항목은 자기 칸(행) 안에서만 붙어(sticky) 조작 줄 묶음이 화면에 붙지 못했다(R1-096).
   * 세로 flex는 항목이 이 틀 전체 안에서 붙을 수 있다. 열 폭이 내용 폭으로 커지지 않게 항목에 min-width 0을 준다(예전 minmax(0, 1fr)와 같은 뜻 —
   * 긴 예제 제목의 선택 상자가 좁은 화면을 옆으로 넘치게 하던 것, 2026-09-16 P2-03 375px 확인).
   *
   * 틀 자체가 폭 컨테이너(lab)다 — 아래 칸 배치(@container)가 화면 폭(@media는 html 글자 크기를 모른다)이 아니라 이 틀의 폭을 rem으로 재서,
   * 글자를 키우면(html 글자 크기 200%) 같은 폭에서도 칸이 한 열로 쌓인다(R1-108). 틀 폭은 쪽 본문 폭이라 내용으로 정해지지 않는다.
   */
  .lab {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block-end: var(--space-10);
    container-name: lab;
    container-type: inline-size;
  }

  .lab > * {
    min-width: 0;
  }

  /*
   * 조작 줄 + 상태 줄 + 안내 줄 묶음. 평소에는 그냥 위쪽에 있고, 넓고 높은 화면(아래 @container)에서만 화면 위에 붙는다.
   * 상태 줄은 넓은 화면에서 조작 줄과 같은 줄에 앉아(남는 자리), 붙는 높이를 [실행] 한 줄만큼으로 줄인다.
   */
  .lab__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    min-width: 0;
  }

  .lab__bar > .lab__status {
    flex: 0 1 12rem;
    min-width: 0;
  }

  .lab__bar > .lab__message {
    flex: 1 1 100%;
  }

  /* 블록 모드(ESP32 실습실 — src/lab/blocks/mode-ui.ts가 data-block-mode를 적는다)에서는 "예제 고르기" 코치 줄이 맞지 않아 접는다(작업판이 위로 올라오게, R1-110) */
  .lab[data-block-mode='blocks'] .lab__coach {
    display: none;
  }

  .lab__toolbar {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    min-width: 0;
    max-width: 100%;
  }

  /* [실행]·[정지]·[초기화]: 늘 한 묶음(휴대폰에서도 한 줄 — 아래 좁은 화면 규칙) */
  .lab__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  /* 예제 제목이 길어도 좁은 화면에서 선택 상자가 줄어들게 한다(min-width 0이 없으면 플렉스 항목이 내용 폭만큼 커져 화면이 옆으로 넘친다 — 2026-09-16 P2-03 375px 확인). */
  .lab__examples {
    display: flex;
    flex: 1 1 12rem;
    align-items: center;
    gap: var(--space-2);
    min-width: 10rem;
    max-width: 26rem;
    padding-inline-start: var(--space-3);
    border-inline-start: 1px solid var(--color-border);
  }

  /*
   * 예제 선택 상자의 기본 폭은 가장 긴 예제 이름이라(약 500px), 좁은 틀의 세로 조작 줄(아래 @container)에서 그 폭이 줄 전체를 밀어
   * 375px 화면에서 [초기화]가 화면 밖으로 나갔다(통합 확인 — 문서 폭 557px). 폭을 100%로 두면 내용 폭으로 커지지 않고 칸에 맞춰 늘고 준다.
   */
  .lab__examples > :global(.lab__select) {
    width: 100%;
  }

  /* hidden은 display: flex에 지므로 따로 적는다(블록 모드는 예제 고르기 줄을 숨긴다 — src/lab/blocks/mode-ui.ts, R1-109) */
  .lab__examples[hidden],
  :global(.lab-button[hidden]) {
    display: none;
  }

  /* 라벨 높이를 선택 상자(--target-min)와 같게 해서, 두 줄로 나뉘어도 글자가 칸의 가운데에 선다 */
  .lab__examples-label {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  /* [예제 불러오기]와 보조 단추(공유 링크·.py 내려받기). 보조 단추는 테두리 없는 작은 단추라 [실행]·[정지]·[초기화]와 위계가 갈린다(R1-099). */
  .lab__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  /*
   * 좁은 틀(휴대폰 폭, 틀 폭 48rem 미만 — 글자를 키우면 더 넓은 화면에서도): 조작 줄을 세 줄로 정리한다(R1-099).
   *   ① [실행][정지][초기화] 한 줄(세 단추가 폭을 나눠 가짐, [실행]이 가장 넓다)  ② 예제 + 선택 상자 한 줄(전체 폭)  ③ [예제 불러오기]·공유·내려받기
   * 예전에는 선택 상자가 8rem(약 160px)까지 줄어 "첫 실습: 웹캠 영상…"에서 잘렸고, 단추 여섯 개가 모양이 같아 어느 것이 중요한지 알 수 없었다.
   */
  @container lab (max-width: 47.99rem) {
    .lab__toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
      width: 100%;
    }

    /* 세 단추를 같은 높이로 늘린다(가운데 맞춤이면 아이콘이 든 [실행]만 2px 높아 위 끝이 어긋났다 — 통합 확인 labs-ui 375px 시험) */
    .lab__actions {
      flex-wrap: nowrap;
      align-items: stretch;
      gap: var(--space-2);
    }

    .lab__actions > :global(.button),
    .lab__actions > :global(.lab-button) {
      flex: 1 1 auto;
      min-width: 0;
      padding-inline: var(--space-3);
    }

    .lab__actions > :global(.button[data-lab-run]) {
      flex-grow: 1.6;
    }

    .lab__examples {
      flex: none;
      max-width: none;
      padding-inline-start: 0;
      border-inline-start: 0;
    }

    .lab__tools {
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-2);
    }

    .lab__tools > :global(.lab-button:not(.lab-button--quiet)) {
      padding-inline: var(--space-3);
    }

    .lab__bar > .lab__status {
      flex: 1 1 100%;
    }
  }

  /*
   * 넓고 높은 화면에서 조작 줄 묶음을 화면 위에 붙인다(R1-096). [실행] 뒤 화면이 결과 칸으로 내려가면(reveal.ts) 예전에는 [정지]·상태 줄이 화면 밖이었다.
   * - 틀 폭 72rem 이상(화면 약 1,200px 이상)이고 화면 높이 40rem(640px) 이상일 때만: 조작 줄이 한 줄로 들어가 붙는 높이가 [실행] 줄 하나(약 4rem)다.
   *   그보다 좁거나(4단원 통합 화면의 반쪽 칸 포함) 낮은 화면은 붙이지 않는다 — 붙은 줄이 화면을 먹고, 글자를 키우면 줄이 여러 개가 된다.
   * - 차시 안 임베드(?embed=1)는 iframe이 낮아 붙이지 않는다.
   * - z-index: 아래 칸(.lab__grid)은 isolation으로 자기 안에 가둔다(CodeMirror 줄 번호 칸이 z-index 200이라 밑에서 올라와 줄을 덮는다).
   * 붙는 동안 키보드 초점이 이 줄 밑에 숨지 않게 scroll-padding-top을 준다(WCAG 2.4.11 — 4단원 떠 있는 줄과 같은 방식). 그만큼은 reveal.ts에도 알린다(lab-shell.ts).
   */
  @container lab (min-width: 72rem) {
    :global(:root:not([data-embed])) .lab__bar {
      position: sticky;
      inset-block-start: 0;
      z-index: 5;
      padding-block: var(--space-2);
      background: var(--color-bg);
      box-shadow: 0 1px 0 var(--color-border);
    }
  }

  /* 낮은 화면(예: 가로로 눕힌 태블릿·작은 노트북 창)은 붙이지 않는다 — 위 규칙을 되돌린다. 아래 규칙이 뒤에 있어 같은 무게로 이긴다. */
  @media (max-height: 39.99rem) {
    :global(:root:not([data-embed])) .lab__bar {
      position: static;
      padding-block: 0;
      background: transparent;
      box-shadow: none;
    }
  }

  /* 붙는 동안 Tab으로 옮겨 간 초점이 붙은 줄 밑(화면 맨 위)에 숨지 않게 그만큼 아래에서 멈춘다(WCAG 2.4.11). 틀 폭 72rem ≈ 화면 76rem. */
  @media (min-width: 76rem) and (min-height: 40rem) {
    :global(html:not([data-embed]):has(.lab__bar)) {
      scroll-padding-block-start: 6rem;
    }
  }

  .lab__grid {
    isolation: isolate;
  }

  /*
   * 실습실 부품 클래스(lab-button·lab__select)는 :global()로 적는다.
   * Astro 범위 스타일은 이 파일의 요소에만 붙는 표시(data-astro-cid-…)로 좁혀지는데,
   * 슬롯(VisionIo)과 흉내 모듈 패널(src/lab/modules/<id>/panel.astro)은 다른 파일이라 그 표시가 없어
   * 같은 클래스를 써도 모양을 못 받았다(2026-09-16 실측: 모듈 패널 버튼 28.5px vs 실습실 버튼 36px).
   * 이 규칙은 LabShell이 있는 페이지에만 실리므로 사이트 다른 곳에는 영향이 없다.
   */
  :global(.lab__select) {
    flex: 1 1 8rem;
    min-width: 0;
    min-height: var(--target-min);
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  :global(.lab-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    cursor: pointer;
  }

  :global(.lab-button:hover) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  :global(.lab-button--small) {
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  /* 보조 단추(공유 링크·.py 내려받기): 테두리 없는 작은 글자 단추. 가리키면(hover) 위 .lab-button:hover처럼 테두리가 생긴다. 높이 36px ≥ 24px(WCAG 2.5.8). */
  :global(.lab-button--quiet) {
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    border-color: transparent;
    background: transparent;
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
  }

  /*
   * 손가락으로 누르는 화면에서는 작은 단추도 44px로 키운다(WCAG 2.5.5 권장 44×44, 2.5.8 최소 24×24).
   * 휴대폰 학생이 예제를 끝내는 유일한 길인 출력 창 키 단추 [q][d][r][ESC]와 [입력 켜기]·[파일 넣기]·[← 이전]이 모두
   * 높이 36px이었다(2026-09-17 검토 실측). 접기 제목(<summary>)과 체크상자도 함께 키운다.
   */
  @media (max-width: 48rem) {
    :global(.lab-button--small) {
      min-height: var(--target-min);
    }

    .lab :global(summary) {
      padding-block: var(--space-2);
    }

    .lab :global(input[type='checkbox']) {
      inline-size: 1.5rem;
      block-size: 1.5rem;
    }
  }

  .button:disabled,
  :global(.lab-button:disabled),
  :global(.lab__select:disabled) {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /*
    끝에 닿아 꺼진 글자 크기 단추와 준비를 기다리는 [실행]("준비되면 실행돼요…")은 aria-disabled — 초점은 받는다(lab-shell.ts #applyFontSize·
    #paintRunButton, 판 1.2.1 검토 E15). 흐린 모양은 조작할 수 없다는 표시(대비 기준 예외)
  */
  .lab__font :global(.lab-button[aria-disabled='true']),
  .button[data-lab-run][aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /*
   * 코치 줄: 지금 어디까지 했는지를 data-run-count(실행한 횟수, lab-shell.ts가 이미 적는 값)로만 칠한다.
   * 0이면 ② [실행] 누르기가 지금 할 일, 1 이상이면 ①②는 한 일(초록)·③ 결과 보기가 지금 보는 곳.
   * 화면 낭독기에는 늘 같은 목록이다(상태를 알리는 일은 아래 상태 줄이 맡는다).
   */
  .lab__coach {
    gap: var(--space-2);
    margin: 0;
  }

  /* 휴대폰 폭(375px)에서도 세 칸이 한 줄에 들어오게 안쪽 여백을 줄인다 */
  .lab__coach > li {
    padding-inline-end: var(--space-3);
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .lab__coach > li {
      gap: var(--space-1);
      padding-block: 0.125rem;
      font-size: var(--text-xs);
    }

    .lab__coach > li::before {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (max-width: 22rem) {
    .lab__coach > li {
      white-space: normal;
    }
  }

  .lab[data-run-count='0'] .lab__coach > li:nth-child(2),
  .lab:not([data-run-count='0']) .lab__coach > li:nth-child(3) {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    font-weight: var(--weight-bold);
  }

  .lab:not([data-run-count='0']) .lab__coach > li:nth-child(-n + 2) {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  .lab:not([data-run-count='0']) .lab__coach > li:nth-child(-n + 2)::before {
    background: var(--color-success-text);
  }

  @media (forced-colors: active) {
    .lab[data-run-count='0'] .lab__coach > li:nth-child(2),
    .lab:not([data-run-count='0']) .lab__coach > li:nth-child(3) {
      outline: 2px solid SelectedItem;
      outline-offset: -2px;
    }
  }

  /*
   * [실행]·[정지] 단추: 글자 앞에 CSS로 그린 ▶·■(글자가 아니라 읽히지 않고, 접근 이름은 "실행"·"정지" 그대로).
   * [실행]은 이 화면의 하나뿐인 채운 단추라 조금 더 크게. [정지]는 나머지 보조 단추처럼 회색 테두리.
   */
  .button[data-lab-run] {
    min-height: 3rem;
    padding-inline: var(--space-6);
    font-size: var(--text-lg);
  }

  .button[data-lab-run]::before {
    content: '';
    flex: none;
    inline-size: 0;
    block-size: 0;
    border-style: solid;
    border-color: transparent;
    border-block-width: 0.45em;
    border-inline-width: 0.75em 0;
    border-inline-start-color: currentColor;
  }

  .button[data-lab-stop] {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button[data-lab-stop]:hover {
    border-color: var(--color-text);
    background: var(--color-bg-muted);
    color: var(--color-text);
  }

  .button[data-lab-stop]:disabled:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg);
  }

  .button[data-lab-stop]::before {
    content: '';
    flex: none;
    inline-size: 0.8em;
    block-size: 0.8em;
    border-radius: 0.1em;
    background: currentColor;
  }

  @media (forced-colors: active) {
    .button[data-lab-stop]::before {
      forced-color-adjust: none;
      background: ButtonText;
    }
  }

  .lab__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab__status-main {
    font-weight: var(--weight-semibold);
  }

  .lab__status-progress {
    color: var(--color-text-muted);
  }

  .lab__status-progress:empty {
    display: none;
  }

  .lab__message {
    margin: 0;
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .lab__message:empty {
    display: none;
  }

  .lab__lesson {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab__lesson[hidden] {
    display: none;
  }

  /* 예제 한 줄 설명 */
  .lab__example-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab__example-desc[hidden] {
    display: none;
  }

  .lab__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'editor'
      'io'
      'panel'
      'modules'
      'console';
    gap: var(--space-4);
  }

  @container lab (min-width: 60rem) {
    .lab__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
      grid-template-areas:
        'editor io'
        'editor panel'
        'modules modules'
        'console console';
    }
  }

  /*
   * 처음 파이썬을 받는 동안(data-loading-intro="yes")에는 준비 칸(진행률 막대·"1분 개념" 카드)이 편집칸 앞 자리(.lab__intro)에 있다.
   * 평소 자리(편집칸·입력/출력 아래)는 문서 y≈3,300px이라 기다리는 학생 화면에 한 번도 보이지 않았다(2026-09-17 검토 반영).
   * 예전에는 grid-template-areas로 넓은 모듈 줄 전체를 맨 위로 **보이게만** 올려, 준비 칸의 Tab 차례가 편집칸·입력/출력·조절 패널 뒤(약 32번째)였다
   * (WCAG 2.4.3 — 판 1.2.0에서 미해결 218을 고침). 이제 준비 칸이 DOM째 이 자리로 옮겨 오므로(src/lab/modules/loading/intro.ts) 보이는 차례와
   * Tab 차례가 같고, 첫 준비 동안 열린 가상 데스크톱·MQTT·[보내기] 칸은 제자리에 그대로 있다. 실행기 상태(data-state)가 아니라 따로 둔 표시를
   * 쓰는 까닭: OpenCV 같은 패키지는 실행기가 idle이 된 뒤에 받고, 정지 2단계로 워커를 다시 띄울 때도 state가 loading으로 돌아가기 때문이다.
   * 표시는 준비 패널이 접힐 때(loading 모듈)나 [실행]을 누를 때(lab-shell.ts) no가 되고 그 뒤로는 제자리다. 준비에 실패하면 yes로 남아 실패
   * 안내가 맨 위에 보인다.
   */
  .lab__intro {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .lab__intro:not(:has(.lab__module:not([hidden]))) {
    display: none;
  }

  /* 흉내 모듈의 화면 조각(src/lab/modules/<id>/panel.astro). placement 'wide'는 전체 폭 줄, 'panel'은 조절 패널 아래. hidden이면 자리도 없다. */
  .lab__modules {
    display: grid;
    grid-area: modules;
    gap: var(--space-4);
    min-width: 0;
  }

  .lab__modules:not(:has(.lab__module:not([hidden]))) {
    display: none;
  }

  .lab__module {
    min-width: 0;
  }

  .lab__panel > .lab__module {
    margin-block-start: var(--space-3);
  }

  .lab__module[hidden] {
    display: none;
  }

  .lab__editor {
    display: flex;
    flex-direction: column;
    grid-area: editor;
    min-width: 0;
  }

  /* 입력·출력 칸도 폭 컨테이너(lab-io) — 안의 두 칸 배치(VisionIo)가 칸 폭을 rem으로 재서 글자를 키우면 한 열로 쌓인다(R1-108) */
  .lab__io {
    grid-area: io;
    min-width: 0;
    container-name: lab-io;
    container-type: inline-size;
  }

  .lab__panel {
    grid-area: panel;
    min-width: 0;
  }

  .lab__console {
    grid-area: console;
    min-width: 0;
  }

  .lab__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-2);
  }

  .lab__heading {
    margin: 0;
    font-size: var(--text-lg);
  }

  .lab__font {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-inline-start: auto;
  }

  .lab__font-size {
    min-width: 3.2em;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .lab__save {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lab__save:empty {
    display: none;
  }

  .lab__editor-host {
    flex: 1 1 auto;
    height: clamp(18rem, 52vh, 40rem);
    min-height: 18rem;
  }

  /* CodeMirror 뿌리(.cm-editor)는 src/lab/editor/theme.ts가 꾸민다. 여기서는 자리 크기만 정한다. */
  .lab__editor-host :global(.cm-editor) {
    height: 100%;
  }

  .lab__hint {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /*
   * (P3-07·P3-08) [정지] 안내는 지금 실행 대상에 맞는 것만 보인다 — 실습실 뿌리의 data-run-target은 셸(lab-shell.ts)이 적는다.
   * 실제 보드는 Ctrl-C를 되풀이해 보내고 파이썬을 다시 시작하지 않으므로 파이썬 실행기 안내가 맞지 않다.
   */
  .lab[data-run-target]:not([data-run-target='']) [data-lab-stop-hint='runtime'],
  .lab:is(:not([data-run-target]), [data-run-target='']) [data-lab-stop-hint='target'] {
    display: none;
  }

  /* 편집칸 위에 두는 안내(Tab 키) — 아래 여백만 준다 */
  .lab__hint--before {
    margin: 0 0 var(--space-2);
  }

  /*
   * 콘솔이 화면 밖일 때 결과 칸에 뜨는 "결과가 나왔어요" 알림(2026-09-18 검토 반영).
   * 처음 뜰 때 실습실 틀이 io 슬롯의 `[data-lab-io-output-anchor]` 바로 뒤(보드 그림·출력 화면 바로 아래)로 옮긴다 — [실행] 뒤 화면을
   * 보드 그림에 맞춰도 알림이 함께 보이게(2026-09-25 Phase 4 검토 반영). 화면에 붙여 띄우지(sticky) 않는다: 보드 조작 칸을 덮는다.
   */
  .lab__io-output {
    margin-block-start: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-info-border);
    border-inline-start: 4px solid var(--color-info-border);
    border-radius: var(--radius-md);
    background: var(--color-info-bg);
  }

  .lab__io-output[hidden] {
    display: none;
  }

  /*
   * 흉내 모듈이 입력·출력 칸 아래에 띄우는 한 줄(스크립트가 만든다 — :global). 예: 컴퓨터 쪽 블루투스가 아직 이을 보드를 찾지 못함
   * (src/lab/modules/ble-pc/index.ts — 1.1.0 검토 반영). 주의 상자 색(대비 AA — 까만 화면 안내와 같은 토큰).
   */
  .lab :global(.lab__module-note) {
    margin-block: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-warning-border);
    border-inline-start-width: 4px;
    border-radius: var(--radius-md);
    background: var(--color-warning-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab :global(.lab__module-note[hidden]) {
    display: none;
  }

  .lab__io-output-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--color-info-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .lab__io-output-count {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
    font-variant-numeric: tabular-nums;
  }

  .lab__io-output-text {
    overflow-x: auto;
    max-width: 100%;
    /* 마지막 3줄(CONSOLE_TAIL_LINES) 높이를 처음부터 잡아 둔다 — 줄이 늘 때마다 아래 조작 칸(패드·단추)이 밀려 손가락이 빗나가지 않게 */
    min-block-size: calc(3lh + 2 * var(--space-2));
    margin: var(--space-2) 0 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .lab__io-output-text:empty {
    display: none;
  }

  /* 콘솔 제목 옆 "새 출력 N줄" 배지. 바탕은 info-border(#6b7a8f, 흰 글자 대비 4.37)가 아니라 info-text(#334155)로 — 작은 글자라 AA 4.5 이상이어야 한다 */
  .lab__console-new {
    padding: 0.1em 0.6em;
    border-radius: var(--radius-full);
    background: var(--color-info-text);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .lab__console-new[hidden] {
    display: none;
  }

  .lab__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-align: center;
  }

  .lab__placeholder p {
    margin: 0;
  }

  .lab__placeholder code {
    font-family: var(--font-mono);
  }

  .lab-console {
    min-height: 10rem;
    max-height: 22rem;
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    white-space: pre-wrap;
    overflow: auto;
    overflow-wrap: anywhere;
  }

  .lab-console :global(.lab-console__line--stderr) {
    color: var(--color-danger-text);
  }

  .lab-console :global(.lab-console__line--notice) {
    color: var(--color-text-muted);
  }

  .lab-console :global(.lab-console__line--input) {
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
  }

  .lab__input {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .lab__input-label {
    font-weight: var(--weight-semibold);
  }

  .lab__input-field {
    flex: 1 1 12rem;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    font-family: var(--font-mono);
  }

  .lab__result {
    min-height: 1.5em;
    margin: var(--space-3) 0 0;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .lab__records {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .lab-dialog {
    width: min(100% - 2rem, 34rem);
    padding: var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .lab-dialog::backdrop {
    background: rgb(23 25 28 / 0.45);
  }

  .lab-dialog__title {
    margin-block: 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .lab-dialog__label {
    display: block;
    margin-block-end: var(--space-1);
    font-weight: var(--weight-semibold);
  }

  .lab-dialog__url {
    width: 100%;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .lab-dialog__note {
    margin-block: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

