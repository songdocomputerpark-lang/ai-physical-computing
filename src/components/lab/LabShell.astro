---
/**
 * 실습실 공통 화면 틀(PLAN §8.2 P2-02, SPEC §6.1 화면 구성).
 *
 * 배치(데스크톱 64rem 이상): 위 조작 줄 → 왼쪽 코드 에디터 / 오른쪽 위 입력·출력(io 슬롯) / 오른쪽 아래 조절 패널(panel 슬롯)
 * → 아래 콘솔(input() 입력줄 포함) → [이 컴퓨터에서 내 기록 지우기]. 좁은 화면에서는 같은 순서로 세로로 쌓인다.
 * 화면 논리(에디터·실행기·자동 저장·공유 링크·내려받기)는 src/lab/controls/lab-shell.ts가 맡는다. 이 파일은 HTML·CSS만 그린다.
 *
 * 쓰는 법
 *   <LabShell labId="vision" examples={examples}>
 *     <div slot="io">카메라 입력·출력 캔버스</div>       ← P2-03이 넣는다(없으면 자리 상자)
 *     <div slot="panel">다른 조절 패널</div>            ← (선택) 없으면 코드의 # @slider 규약으로 만드는 조절 패널(ParamPanel, P2-04)
 *     <section slot="after">실습실 아래에 둘 것</section> ← (선택) 개발용 정보 등
 *   </LabShell>
 *
 * props
 *   labId             실습실 이름(영문 소문자·숫자·하이픈). 자동 저장 이름 editor:<labId>:<예제 id>에 쓴다. 예: vision, esp32, iot, dev
 *   examples          예제 목록(src/lab/controls/examples.ts의 LabExample[]). 비어 있으면 [예제 불러오기]가 꺼진다.
 *   initialExampleId  (선택) 처음 고를 예제 id. 없으면 ?example=(examples/ 경로) → 저장된 마지막 예제 → 첫 예제.
 *   editorTitle       (선택) 편집칸 제목(기본 "코드")
 *   headingLevel      (선택) 칸 제목의 단계 2 또는 3(기본 2). 차시 안에 넣을 때 3.
 *
 * 페이지 스크립트가 실습실을 다루려면 src/lab/controls/lab-shell.ts의 getLabController(root)를 쓴다(컨트롤러 API는 그 파일 머리말).
 * 사이트 검색 색인에서는 뺀다(data-pagefind-ignore) — 실습실 안 글은 조작 안내뿐이라 결과만 늘린다.
 */
import Callout from '../common/Callout.astro';
import { assertValidExamples, type LabExample } from '../../lab/controls/examples.ts';
import { TAB_HINT } from '../../lab/editor/python-editor.ts';
import { folderNameOf, modulesForLab } from '../../lab/modules/manifests.ts';
import type { ModulePlacement } from '../../lab/modules/types.ts';
import { STOP_GRACE_MS } from '../../lab/runtime/config.ts';
import ClearRecordsButton from './ClearRecordsButton.astro';
import ParamPanel from './ParamPanel.astro';

/**
 * 흉내 모듈 폴더의 화면 조각(src/lab/modules/<id>/panel.astro, 자동 발견 — src/lab/README.md 4절).
 * 이 실습실(labId)에 붙는 모듈의 것만 그려 두고(hidden), 모듈의 index.ts가 mount 때 showPanel()로 연다.
 * placement 'panel'은 조절 패널 아래(오른쪽 열), 'wide'는 입력·출력과 콘솔 사이 전체 폭.
 */
const panelComponents = import.meta.glob<{ default: (props: Record<string, never>) => unknown }>('../../lab/modules/*/panel.astro', { eager: true });
const modulePanelsById = new Map(Object.entries(panelComponents).map(([globPath, loaded]) => [folderNameOf(globPath), loaded.default]));

interface Props {
  labId: string;
  examples?: readonly LabExample[];
  initialExampleId?: string;
  editorTitle?: string;
  headingLevel?: 2 | 3;
}

const { labId, examples = [], initialExampleId, editorTitle = '코드', headingLevel = 2 } = Astro.props;
if (!/^[a-z0-9][a-z0-9-]*$/u.test(labId)) {
  throw new Error(`LabShell: labId "${labId}"은(는) 영문 소문자·숫자·하이픈만 써요(예: vision).`);
}
assertValidExamples(examples);

const Heading = `h${headingLevel}` as 'h2' | 'h3';
const ids = {
  editorHeading: `lab-${labId}-editor-heading`,
  editorHint: `lab-${labId}-editor-hint`,
  ioHeading: `lab-${labId}-io-heading`,
  panelHeading: `lab-${labId}-panel-heading`,
  consoleHeading: `lab-${labId}-console-heading`,
  exampleSelect: `lab-${labId}-example`,
  input: `lab-${labId}-input`,
  shareTitle: `lab-${labId}-share-title`,
  shareUrl: `lab-${labId}-share-url`,
  resetTitle: `lab-${labId}-reset-title`,
};
const hasIo = Astro.slots.has('io');
const hasPanel = Astro.slots.has('panel');
// JSON 안의 <를 유니코드로 바꿔 </script>가 스크립트를 끊지 못하게 한다.
const examplesJson = JSON.stringify(examples).replace(/</gu, '\\u003c');

// [예제 불러오기] 선택 상자: group이 있는 예제는 같은 이름끼리 optgroup으로 묶는다(목록 순서 유지, 없는 것은 그대로).
const exampleGroups: { label: string | null; items: LabExample[] }[] = [];
for (const example of examples) {
  const label = example.group ?? null;
  const last = exampleGroups[exampleGroups.length - 1];
  if (last && last.label === label) {
    last.items.push(example);
  } else {
    exampleGroups.push({ label, items: [example] });
  }
}

// 이 실습실에 붙는 흉내 모듈의 panel.astro(있는 것만), 위치별로 나눈다.
const modulePanels = modulesForLab(labId)
  .filter((manifest) => modulePanelsById.has(manifest.id))
  .map((manifest) => ({ id: manifest.id, title: manifest.title, placement: (manifest.placement ?? 'panel') as ModulePlacement, Component: modulePanelsById.get(manifest.id)! }));
const sidePanels = modulePanels.filter((panel) => panel.placement === 'panel');
const widePanels = modulePanels.filter((panel) => panel.placement === 'wide');
---

<div
  class="lab"
  data-lab
  data-lab-id={labId}
  data-initial-example={initialExampleId}
  data-state="unloaded"
  data-jspi="pending"
  data-limited="pending"
  data-outcome=""
  data-run-count="0"
  data-stop-ms=""
  data-save-state="idle"
  data-example=""
  data-pagefind-ignore
>
  <script is:inline type="application/json" data-lab-examples set:html={examplesJson} />

  <div class="lab__toolbar">
    <button type="button" class="button button--primary" data-lab-run disabled>실행</button>
    <button type="button" class="button button--secondary" data-lab-stop disabled>정지</button>
    <button type="button" class="lab-button" data-lab-reset>초기화</button>
    <div class="lab__examples">
      <label class="lab__examples-label" for={ids.exampleSelect}>예제</label>
      <select id={ids.exampleSelect} class="lab__select" data-lab-example-select disabled={examples.length === 0}>
        {examples.length === 0 && <option value="">예제가 아직 없어요</option>}
        {
          exampleGroups.map((group) =>
            group.label === null ? (
              group.items.map((example) => <option value={example.id}>{example.title}</option>)
            ) : (
              <optgroup label={group.label}>{group.items.map((example) => <option value={example.id}>{example.title}</option>)}</optgroup>
            ),
          )
        }
      </select>
      <button type="button" class="lab-button" data-lab-example-load disabled={examples.length === 0}>예제 불러오기</button>
    </div>
    <button type="button" class="lab-button" data-lab-share>공유 링크</button>
    <button type="button" class="lab-button" data-lab-download>.py 내려받기</button>
  </div>

  <p class="lab__status">
    <span class="lab__status-main" role="status" aria-live="polite" data-lab-status>아직 시작하지 않았어요.</span>
    <span class="lab__status-progress" data-lab-progress aria-live="polite"></span>
  </p>
  <p class="lab__message" role="status" aria-live="polite" data-lab-message></p>

  <div data-lab-limited hidden>
    <Callout type="주의" title="제한 모드로 실행해요">
      <p>
        이 브라우저에는 JSPI(파이썬 기다리기 기능)가 없어서 입력이나 카메라를 기다리는 코드는 실행할 수 없어요. 한 번 실행되고
        끝나는 코드는 돌아요. [정지]는 파이썬을 다시 시작하는 방식(정지 2단계)으로만 돼요.
      </p>
    </Callout>
  </div>

  <div class="lab__grid">
    <section class="lab__editor" aria-labelledby={ids.editorHeading}>
      <div class="lab__section-head">
        <Heading id={ids.editorHeading} class="lab__heading">{editorTitle}</Heading>
        <div class="lab__font" role="group" aria-label="글자 크기">
          <button type="button" class="lab-button lab-button--small" data-lab-font-smaller aria-label="글자 작게">A−</button>
          <span class="lab__font-size" data-lab-font-size aria-live="polite">15px</span>
          <button type="button" class="lab-button lab-button--small" data-lab-font-larger aria-label="글자 크게">A+</button>
        </div>
        <span class="lab__save" data-lab-save aria-live="polite"></span>
      </div>
      <div class="lab__editor-host" data-lab-editor data-label="파이썬 코드"></div>
      <p id={ids.editorHint} class="lab__hint" data-lab-editor-hint>{TAB_HINT}</p>
    </section>

    <section class="lab__io" aria-labelledby={ids.ioHeading}>
      <Heading id={ids.ioHeading} class="lab__heading">입력과 출력</Heading>
      {
        hasIo ? (
          <slot name="io" />
        ) : (
          <div class="lab__placeholder">
            <p>카메라 입력과 결과 화면이 들어올 자리예요. 지금은 콘솔 출력만 있어요.</p>
          </div>
        )
      }
    </section>

    <section class="lab__panel" aria-labelledby={ids.panelHeading}>
      <Heading id={ids.panelHeading} class="lab__heading">조절 패널</Heading>
      {hasPanel ? <slot name="panel" /> : <ParamPanel />}
      {
        sidePanels.map(({ id, title, Component }) => (
          <section class="lab__module" data-lab-module-panel={id} aria-label={title} hidden>
            <Component />
          </section>
        ))
      }
    </section>

    {
      widePanels.length > 0 && (
        <div class="lab__modules">
          {widePanels.map(({ id, title, Component }) => (
            <section class="lab__module lab__module--wide" data-lab-module-panel={id} aria-label={title} hidden>
              <Component />
            </section>
          ))}
        </div>
      )
    }

    <section class="lab__console" aria-labelledby={ids.consoleHeading}>
      <div class="lab__section-head">
        <Heading id={ids.consoleHeading} class="lab__heading">콘솔</Heading>
        <button type="button" class="lab-button lab-button--small" data-lab-console-clear>콘솔 지우기</button>
      </div>
      <pre class="lab-console" data-lab-console aria-label="콘솔 출력" tabindex="0"></pre>
      <form class="lab__input" data-lab-input-form hidden>
        <label class="lab__input-label" for={ids.input} data-lab-input-label>입력</label>
        <input id={ids.input} class="lab__input-field" type="text" data-lab-input autocomplete="off" />
        <button type="submit" class="button button--primary">입력</button>
      </form>
      <p class="lab__result" role="status" aria-live="polite" data-lab-result></p>
      <p class="lab__hint">
        [정지]를 누르면 기다리는 곳(time.sleep, input)에서 바로 멈춰요. {STOP_GRACE_MS / 1000}초 안에 멈추지 않으면 파이썬을 다시
        시작해요.
      </p>
    </section>
  </div>

  <div class="lab__records">
    <ClearRecordsButton id={`lab-${labId}-clear-records`} />
  </div>

  <slot name="after" />

  <dialog class="lab-dialog" data-lab-share-dialog aria-labelledby={ids.shareTitle}>
    <h2 id={ids.shareTitle} class="lab-dialog__title">공유 링크</h2>
    <label class="lab-dialog__label" for={ids.shareUrl}>주소</label>
    <input id={ids.shareUrl} class="lab-dialog__url" type="text" readonly data-lab-share-url />
    <p class="lab-dialog__note" data-lab-share-note></p>
    <p class="lab-dialog__note">코드만 담겨요. 카메라 영상이나 입력한 글자는 들어가지 않아요.</p>
    <div class="lab-dialog__actions">
      <button type="button" class="button button--primary" data-lab-share-copy>복사</button>
      <button type="button" class="button button--secondary" data-lab-dialog-close>닫기</button>
    </div>
    <p class="lab-dialog__status" role="status" aria-live="polite" data-lab-share-copied></p>
  </dialog>

  <dialog class="lab-dialog" data-lab-reset-dialog aria-labelledby={ids.resetTitle}>
    <h2 id={ids.resetTitle} class="lab-dialog__title">초기화</h2>
    <p>지금 코드를 지우고 예제 원래 코드로 되돌릴까요? 고친 내용은 사라져요(되돌리기 Ctrl+Z로는 돌아오지 않아요).</p>
    <div class="lab-dialog__actions">
      <button type="button" class="button button--primary" data-lab-reset-confirm>되돌리기</button>
      <button type="button" class="button button--secondary" data-lab-dialog-close>취소</button>
    </div>
  </dialog>
</div>

<script>
  import { mountLabShell } from '../../lab/controls/lab-shell.ts';
  import { mountLabModules } from '../../lab/modules/host.ts';
  import { mountParamPanel } from '../../lab/params/panel.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-lab]')) {
    const lab = mountLabShell(root);
    if (lab) {
      // 조절 패널(코드의 # @slider 규약, P2-04). panel 슬롯을 다른 것으로 채운 페이지에는 [data-lab-params]가 없어 null이다.
      mountParamPanel(root, lab);
      // 흉내 모듈 폴더(src/lab/modules/<id>/)의 화면 쪽 — 이 실습실에 붙는 모듈만 따로 받아 붙인다. 실패해도 실습실은 그대로 돈다.
      void mountLabModules(root, lab);
    }
  }
</script>

<style>
  .lab {
    display: grid;
    /* 열 폭을 화면 폭에 맞춘다. 기본값(auto)이면 조작 줄의 내용 폭(긴 예제 제목의 선택 상자)만큼 열이 커져 좁은 화면이 옆으로 넘친다(2026-09-16 P2-03 375px 확인). */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-block-end: var(--space-10);
  }

  .lab__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  /* 예제 제목이 길어도 좁은 화면에서 선택 상자가 줄어들게 한다(min-width 0이 없으면 플렉스 항목이 내용 폭만큼 커져 화면이 옆으로 넘친다 — 2026-09-16 P2-03 375px 확인). */
  .lab__examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    max-width: 100%;
    padding-inline-start: var(--space-2);
    border-inline-start: 1px solid var(--color-border);
  }

  .lab__examples-label {
    font-weight: var(--weight-semibold);
  }

  .lab__select {
    flex: 1 1 8rem;
    min-width: 0;
    min-height: var(--target-min);
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .lab-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    cursor: pointer;
  }

  .lab-button:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .lab-button--small {
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  .button:disabled,
  .lab-button:disabled,
  .lab__select:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .lab__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab__status-main {
    font-weight: var(--weight-semibold);
  }

  .lab__status-progress {
    color: var(--color-text-muted);
  }

  .lab__status-progress:empty {
    display: none;
  }

  .lab__message {
    margin: 0;
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .lab__message:empty {
    display: none;
  }

  .lab__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'editor'
      'io'
      'panel'
      'modules'
      'console';
    gap: var(--space-4);
  }

  @media (min-width: 64rem) {
    .lab__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
      grid-template-areas:
        'editor io'
        'editor panel'
        'modules modules'
        'console console';
    }
  }

  /* 흉내 모듈의 화면 조각(src/lab/modules/<id>/panel.astro). placement 'wide'는 전체 폭 줄, 'panel'은 조절 패널 아래. hidden이면 자리도 없다. */
  .lab__modules {
    display: grid;
    grid-area: modules;
    gap: var(--space-4);
    min-width: 0;
  }

  .lab__modules:not(:has(.lab__module:not([hidden]))) {
    display: none;
  }

  .lab__module {
    min-width: 0;
  }

  .lab__panel > .lab__module {
    margin-block-start: var(--space-3);
  }

  .lab__module[hidden] {
    display: none;
  }

  .lab__editor {
    display: flex;
    flex-direction: column;
    grid-area: editor;
    min-width: 0;
  }

  .lab__io {
    grid-area: io;
    min-width: 0;
  }

  .lab__panel {
    grid-area: panel;
    min-width: 0;
  }

  .lab__console {
    grid-area: console;
    min-width: 0;
  }

  .lab__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-end: var(--space-2);
  }

  .lab__heading {
    margin: 0;
    font-size: var(--text-lg);
  }

  .lab__font {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-inline-start: auto;
  }

  .lab__font-size {
    min-width: 3.2em;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .lab__save {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lab__save:empty {
    display: none;
  }

  .lab__editor-host {
    flex: 1 1 auto;
    height: clamp(18rem, 52vh, 40rem);
    min-height: 18rem;
  }

  /* CodeMirror 뿌리(.cm-editor)는 src/lab/editor/theme.ts가 꾸민다. 여기서는 자리 크기만 정한다. */
  .lab__editor-host :global(.cm-editor) {
    height: 100%;
  }

  .lab__hint {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lab__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-align: center;
  }

  .lab__placeholder p {
    margin: 0;
  }

  .lab__placeholder code {
