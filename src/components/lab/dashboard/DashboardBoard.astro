---
/**
 * 대시보드 화면(P4-07, 시나리오 D) — 연결 줄 + 위젯 판 + 가상 보드 자리.
 *
 * 이 파일은 **HTML과 CSS만** 그린다. 움직임은 `src/lab/dashboard/dashboard-page.ts`(`mountDashboard`)가
 * `data-dash-*` 표시를 찾아 잇는다. 위젯은 자바스크립트가 만들기 때문에 스타일은 `is:global`로 둔다
 * (범위 스타일은 스크립트가 만든 요소에 닿지 않는다 — 보드 그림 CSS를 공용 파일로 뺀 것과 같은 까닭, P3-11).
 *
 * 중계 서버 목록은 설정 한 곳(`src/lab/mqtt/brokers.ts`)에서 가져와 그린다.
 */
import { MQTT_BROKERS } from '../../../lab/mqtt/brokers.ts';
import { WIDGET_KINDS } from '../../../lab/dashboard/defaults.ts';
import { DASHBOARD_DEMO_FILE } from '../../../lab/dashboard/demo-code.ts';
import { getPage } from '../../../config/nav.ts';

// 두 탭 실습 링크의 뿌리 주소 — 스크립트가 ?example=과 지금 접두어(?prefix=)를 붙인다(dashboard-page.ts syncPrefix)
const esp32Href = getPage('labs-esp32').href;
const checkHref = getPage('start-check').href;
---

<section class="dash" data-dash-page data-dash-state="idle" data-dash-via="" data-dash-mode-value="tab" data-dash-ready="no">
  <div class="dash__step">
    <h2 class="dash__step-title">1. 통로를 고르고 연결해요</h2>

    <p class="dash__warning" data-dash-warning data-dash-level="info" aria-live="polite"></p>

    <div class="dash__row">
      <label class="dash__label" for="dash-mode">통로</label>
      <select id="dash-mode" class="dash__select" data-dash-mode>
        <option value="tab">같은 컴퓨터 탭(인터넷 없이)</option>
        <option value="broker">공개 중계 서버</option>
        <option value="auto">중계 서버 먼저, 안 되면 탭</option>
      </select>
    </div>

    <div class="dash__row">
      <label class="dash__label" for="dash-broker">중계 서버</label>
      <select id="dash-broker" class="dash__select" data-dash-broker>
        {MQTT_BROKERS.map((broker) => <option value={broker.id}>{broker.label}{broker.url === '' ? '' : ` — ${broker.url}`}</option>)}
      </select>
    </div>

    <div class="dash__row" data-dash-broker-url-row hidden>
      <label class="dash__label" for="dash-broker-url">서버 주소</label>
      <input
        id="dash-broker-url"
        class="dash__input dash__input--wide"
        type="text"
        data-dash-broker-url
        autocomplete="off"
        spellcheck="false"
        placeholder="wss://broker.example.org:8084/mqtt"
      />
    </div>

    <p class="dash__note" data-dash-broker-note></p>

    <div class="dash__row">
      <span class="dash__label" id="dash-prefix-label">통신 접두어</span>
      <code class="dash__prefix" data-dash-prefix aria-labelledby="dash-prefix-label"></code>
      <button type="button" class="button button--secondary dash__small" data-dash-copy-prefix>복사</button>
      <button type="button" class="button button--secondary dash__small" data-dash-new-prefix>새로 만들기</button>
      <button type="button" class="button button--secondary dash__small" data-dash-pin aria-pressed="false">이 접두어 고정</button>
    </div>

    <div class="dash__row">
      <label class="dash__label" for="dash-friend">친구 접두어</label>
      <input
        id="dash-friend"
        class="dash__input"
        type="text"
        data-dash-friend
        autocomplete="off"
        spellcheck="false"
        maxlength="12"
        placeholder="예: 7kq2m9xd4hpt"
      />
      <button type="button" class="button button--secondary dash__small" data-dash-friend-apply>맞추기</button>
    </div>

    <div class="dash__row">
      <button type="button" class="button button--primary dash__small" data-dash-connect aria-describedby="dash-connect-warning">연결</button>
      <button type="button" class="button button--secondary dash__small" data-dash-disconnect disabled>끊기</button>
      <span class="dash__state" data-dash-state-text aria-live="polite">아직 연결하지 않았어요</span>
      <span class="dash__state" data-dash-count></span>
    </div>
    {/* [연결] 바로 아래 경고(PLAN §7.4 "연결 버튼 옆에 늘 표시") — 공개 중계 서버를 골랐으면 늘 보인다(2026-09-25 Phase 4 검토 반영) */}
    <p class="dash__connect-warning" id="dash-connect-warning" data-dash-connect-warning hidden></p>

    <p class="dash__hint" data-dash-hint aria-live="polite" hidden></p>
    {/* 중계 서버에 못 붙었을 때만 보이는 점검 링크(학교망이 막았는지 확인하는 곳) */}
    <p class="dash__note" data-dash-check-note hidden>
      <a href={checkHref}>학교 네트워크 점검(시작하기 → 점검 페이지)</a>에서 공개 중계 서버가 열리는지 확인할 수 있어요.
    </p>
  </div>

  <div class="dash__step">
    <h2 class="dash__step-title">2. 위젯을 놓아요</h2>
    <div class="dash__row">
      <span class="dash__label" id="dash-add-label">위젯 추가</span>
      {
        WIDGET_KINDS.map((info) => (
          <button type="button" class="button button--secondary dash__small" data-dash-add={info.kind} title={info.description}>
            + {info.label}
          </button>
        ))
      }
      <button type="button" class="button button--secondary dash__small" data-dash-reset>배치 되돌리기</button>
    </div>
    <p class="dash__help" id="dash-keyboard-help" data-dash-help>
      <span class="dash__help-wide">
        위젯 제목(손잡이)을 끌어서 옮겨요. 키보드로는 손잡이에서 <kbd>방향키</kbd>로 옮기고,{' '}
        <kbd>Shift</kbd>+<kbd>방향키</kbd>로 크기를 바꿔요(크기 단추에서는 <kbd>방향키</kbd>만으로). 배치는 이 컴퓨터에만 저장돼요.
      </span>
      <span class="dash__help-narrow">
        좁은 화면에서는 위젯이 한 줄에 하나씩 쌓여요. 손잡이에서 <kbd>↑</kbd>·<kbd>↓</kbd>로 차례를 바꿔요. 배치는 이 컴퓨터에만 저장돼요.
      </span>
    </p>
    <p class="dash__announce" data-dash-announce role="status" aria-live="polite"></p>

    <noscript>
      <p class="dash__note">
        이 브라우저에서 자바스크립트가 꺼져 있어요. 대시보드 위젯은 자바스크립트로 그리기 때문에 아래 판이 비어 있어요.
        설정에서 자바스크립트를 켜고 새로 고쳐 주세요.
      </p>
    </noscript>

    <div class="dash__grid" data-dash-grid data-dash-count="0" role="group" aria-label="위젯 판"></div>
  </div>

  <div class="dash__step">
    <h2 class="dash__step-title">3. 값을 보내는 보드를 열어요</h2>
    <p class="dash__note">
      아래 단추를 누르면 이 자리에서 <strong>가상 ESP32 보드</strong>가 열려요(누르기 전에는 실습실 파일을 받지 않아요). 통로가 [같은 컴퓨터 탭]이면
      [연결]도 함께 해 줘요. 실습실에서 [실행]을 누르면 보드가 0~100 사이 값을 보내고, 위의 그래프·게이지에 바로 나타나요.
      스위치를 누르면 보드의 파란 LED가 켜져요.
    </p>
    <div class="dash__row">
      <button type="button" class="button button--secondary" data-dash-open-lab aria-expanded="false">이 자리에서 가상 보드 열기</button>
      {/* 두 탭으로: 새 탭의 ESP32 실습실이 같은 예제와 같은 접두어로 열린다(스크립트가 ?prefix=를 붙인다 — 2026-09-25 Phase 4 검토 반영) */}
      <a
        class="button button--secondary"
        href={`${esp32Href}?example=${encodeURIComponent(DASHBOARD_DEMO_FILE)}`}
        data-dash-lab-link
        data-dash-lab-base={esp32Href}
        target="_blank"
        rel="noopener">새 탭에서 ESP32 실습실 열기</a
      >
    </div>
    <p class="dash__note dash__lab-hint" data-dash-lab-hint role="status" hidden></p>
    <div class="dash__lab-slot" data-dash-lab-slot hidden></div>
  </div>
</section>

<style is:global>
  .dash {
    display: grid;
    gap: var(--space-6);
    margin-block: var(--space-6);
  }

  .dash__step {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  /* 격자 칸 기본값(min-width: auto)이면 안쪽 내용만큼 넓어져 휴대폰 화면 밖으로 삐져나간다. */
  .dash > *,
  .dash__step > * {
    min-width: 0;
  }

  .dash__step-title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .dash__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .dash__label {
    min-width: 6rem;
    font-weight: var(--weight-semibold);
  }

  .dash__select {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    font: inherit;
  }

  .dash__input {
    flex: 1 1 10rem;
    min-width: 0;
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    font-family: var(--font-mono);
  }

  .dash__input--wide {
    flex: 1 1 16rem;
  }

  .dash__small {
    min-height: var(--target-min);
    padding-block: var(--space-1);
    font-size: var(--text-sm);
  }

  .dash__prefix {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .dash__warning {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .dash__warning[data-dash-level='warn'] {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-weight: var(--weight-semibold);
  }

  /* [연결] 바로 아래 짧은 경고(공개 중계 서버 — 휴대폰에서도 연결하는 순간 보이게) */
  .dash__connect-warning {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-inline-start: 4px solid var(--color-warning-border);
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  /* 중계 서버에 못 붙었을 때의 안내 줄은 경고 모양으로(덮어쓰지 않고 남는다 — dashboard-page.ts) */
  .dash__hint[data-dash-level='warn'] {
    padding: var(--space-1) var(--space-3);
    border-inline-start: 4px solid var(--color-warning-border);
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-weight: var(--weight-semibold);
  }

  /* 키보드 도움말: 넓은 화면(격자)과 좁은 화면(한 줄에 하나씩 쌓임)의 글이 다르다 */
  .dash__help-narrow {
    display: none;
  }

  .dash__note,
  .dash__hint,
  .dash__help,
  .dash__announce,
  .dash__state {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .dash__note:empty,
  .dash__announce:empty {
    display: none;
  }

  .dash__help kbd {
    padding: 0 0.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg-muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* ── 위젯 판 ───────────────────────────────────────────────────────────── */
  .dash__grid {
    display: grid;
    grid-template-columns: repeat(var(--dash-cols, 12), minmax(0, 1fr));
    grid-auto-rows: var(--dash-row, 3.25rem);
    gap: var(--space-3);
    min-height: 12rem;
    padding: var(--space-2);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  /* 위젯을 모두 지웠을 때(판이 비었을 때) 무엇을 하면 되는지 알려 준다. */
  .dash__grid:empty::after {
    content: '위젯이 하나도 없어요. 위의 [위젯 추가]를 눌러 원하는 위젯을 놓아요.';
    align-self: center;
    justify-self: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .dash-widget {
    display: grid;
    grid-template-rows: auto 1fr auto;
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
  }

  .dash-widget[data-dash-dragging='true'] {
    box-shadow: var(--shadow-md);
    outline: 2px solid var(--color-accent);
  }

  .dash-widget__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-muted);
  }

  .dash-widget__grab {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1 1 auto;
    min-width: 0;
    min-height: 2rem;
    padding: 0.125rem var(--space-1);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: var(--weight-semibold);
    text-align: left;
    cursor: grab;
    touch-action: none;
  }

  .dash-widget__grab:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg);
  }

  .dash-widget__grab-icon {
    color: var(--color-text-muted);
  }

  .dash-widget__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dash-widget__kind {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .dash-widget__small {
    min-height: 2rem;
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .dash-widget__small:hover {
    background: var(--color-bg-muted);
  }

  .dash-widget__body {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-1);
    min-height: 0;
    padding: var(--space-2);
    overflow: hidden;
  }

  .dash-widget__canvas {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .dash-widget__last,
  .dash-widget__hint,
  .dash-widget__scale {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .dash-widget__last:empty {
    display: none;
  }

  .dash-widget__value {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .dash-widget__gauge {
    width: 100%;
    max-width: 11rem;
    min-height: 0;
  }

  .dash-gauge__track {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 10;
    stroke-linecap: round;
  }

  .dash-gauge__value {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 10;
    stroke-linecap: round;
    transition: d var(--duration-base) var(--ease-standard);
  }

  .dash-gauge__needle {
    stroke: var(--color-text);
    stroke-width: 2;
    stroke-linecap: round;
    transition:
      x2 var(--duration-base) var(--ease-standard),
      y2 var(--duration-base) var(--ease-standard);
  }

  .dash-switch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dash-switch__knob {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
    transition: background var(--duration-base) var(--ease-standard);
  }

  .dash-switch[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .dash-switch[aria-pressed='true'] .dash-switch__knob {
    background: var(--color-accent);
  }

  .dash-switch[aria-busy='true'] {
    cursor: progress;
  }

  /* 스위치가 보내지 못했을 때 위젯 안에 까닭을 적는 줄 */
  .dash-widget__problem {
    margin: 0;
    color: var(--color-warning-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-align: center;
  }

  .dash-widget__problem:empty {
    display: none;
  }

  /* 보드가 받았다는 되알림(아래 가상 보드의 LED 상태)은 경고가 아니라 안내 색 */
  .dash-widget__problem[data-level='info'] {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }

  .dash-widget__log {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: var(--space-1);
    overflow-y: auto;
    list-style: none;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .dash-widget__log:empty::after {
    content: '아직 온 메시지가 없어요.';
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .dash-widget__log-item {
    padding: 0.05rem 0;
    word-break: break-all;
  }

  .dash-widget__settings {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  .dash-field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  .dash-field__label {
    flex: 0 0 5.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .dash-field__input {
    flex: 1 1 6rem;
    min-width: 0;
    min-height: 2rem;
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .dash-field__hint {
    flex: 1 1 100%;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .dash-widget__resize {
