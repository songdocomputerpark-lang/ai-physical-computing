---
/**
 * 홈 큰 검색칸(판 1.3.0). Core가 뼈대를, 구역 B가 자동 완성과 추천 칩을 얹었다.
 *
 * 자바스크립트 없이도 되는 폼이다: 검색어를 /search/?q=검색어 로 보내고 검색 쪽(SearchPage.astro)이 결과를 보여 준다.
 * 자바스크립트가 되면 머리글과 같은 자동 완성이 켜진다(data-suggest — search-suggest.ts, 설정은 머리글 검색 폼의 속성에서 읽는다).
 * 폼 이름 "배울 것 찾기"는 머리글 검색 "사이트 검색"과 달라서 랜드마크 이름이 겹치지 않는다(홈에는 둘이 함께 있다).
 * 홈 구역은 위에 h2 "무엇을 찾나요?"를 두고 이 컴포넌트를 넣는다. 설정 값(검색 쪽 주소·검색어 이름·추천 낱말)은 src/config/search.ts.
 *
 * 추천 칩은 /search/?q= 링크라서 자바스크립트가 없어도 된다. 좁은 화면에서는 앞의 네 개만 보인다(홈 첫 화면이 길어지지 않게, 나머지는 칸에 초점을 주면 목록에 나온다).
 * 칩 사이에 줄바꿈이 든 글자와 태그가 이어지지 않게 낱말마다 <li>로 나눈다(CLAUDE.md .astro 줄바꿈 공백 함정).
 */
import { searchConfig } from '../../config/search.ts';
import { withBase } from '../../lib/url.ts';
import Icon from '../common/Icon.astro';

const chipHref = (word: string) => withBase(`search/?${searchConfig.queryParam}=${encodeURIComponent(word)}`);
---

<div class="home-search-block">
  <form class="home-search" role="search" aria-label="배울 것 찾기" action={searchConfig.pageHref} method="get" data-home-search data-suggest>
    <label class="visually-hidden" for="home-search-input">찾을 낱말</label>
    <div class="home-search__field">
      <span class="home-search__icon"><Icon name="search" /></span>
      <input
        id="home-search-input"
        class="home-search__input"
        type="search"
        name={searchConfig.queryParam}
        placeholder="예: 손 인식, LED"
        autocomplete="off"
        enterkeyhint="search"
      />
    </div>
    <button class="button button--secondary button--large home-search__button" type="submit">검색</button>
  </form>

  <div class="home-search__chips">
    <p class="home-search__chips-title" id="home-search-chips-title">많이 찾는 낱말</p>
    <ul class="home-search__chip-list" aria-labelledby="home-search-chips-title">
      {
        searchConfig.popularWords.map((word) => (
          <li class="home-search__chip-item">
            <a class="home-search__chip" href={chipHref(word)}>
              {word}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .home-search-block {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .home-search {
    display: flex;
    gap: var(--space-3);
    width: 100%;
  }

  .home-search__field {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .home-search__icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--space-4);
    display: flex;
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .home-search__input {
    /* 퍼센트 너비: 입력칸의 기본 너비가 좁은 화면을 넓히지 않게 한다(HeaderSearch.astro와 같은 이유) */
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + var(--icon-md) + var(--space-3));
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-lg);
  }

  .home-search__input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .home-search__input:hover {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-md);
  }

  .home-search__input:focus-visible {
    border-color: var(--color-focus);
  }

  .home-search__button {
    flex: none;
    border-radius: var(--radius-full);
  }

  .home-search__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .home-search__chips-title {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .home-search__chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-search__chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .home-search__chip:hover {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  @media (max-width: 30rem) {
    /* 좁은 화면: 입력칸 아래로 [찾기]가 내려가지 않게 한 줄에 두되 단추를 작게 */
    .home-search__button {
      padding-inline: var(--space-4);
    }
  }

  @media (max-width: 40rem) {
    /* 좁은 화면: 추천 칩은 네 개만(나머지는 칸에 초점을 주면 목록에 나온다) */
    .home-search__chip-item:nth-child(n + 5) {
      display: none;
    }
  }
</style>
