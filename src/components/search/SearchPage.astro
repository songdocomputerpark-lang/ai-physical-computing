---
/**
 * 사이트 검색 화면(PLAN §8.1 P1-11, 판 1.3.0 큰 검색칸·종류 거르기) — /search/ 페이지가 넣는다. 동작은 ./search-page.ts.
 *
 * - 자바스크립트가 되면: 입력을 멈추면 바로 찾고, 주소의 ?q=검색어(&type=종류)도 읽는다. 결과는 10개씩 보이고 [결과 더 보기]로 더 본다.
 *   결과 위의 종류 칩(전체·차시·실습실·용어사전·오류·예제·교사용)이 쪽 종류로 거른다 — 라디오 모임이라 Tab 정지점은 하나이고 화살표로 옮긴다.
 * - 자바스크립트가 없으면: 폼이 /search/?q=검색어 로 다시 열릴 뿐 결과는 못 보여 주므로 <noscript> 안내를 보인다.
 * - 설정 값(Pagefind 폴더·base·검색어 이름)은 src/config/search.ts에서 data- 속성으로 넘긴다.
 *   화면 코드에서 site.ts를 직접 불러오면 package.json 전체가 브라우저용 코드에 묶이기 때문이다.
 *
 * 사이트 검색 색인 규칙(P1-11 결정, 근거는 보고서·PROGRESS.md)
 * - 색인함: 모든 페이지의 <main> 본문(BaseLayout의 data-pagefind-body)
 * - 색인 안 함: 검색·404 페이지(searchIndex={false}), 준비 중 상자의 판에 박힌 문장(data-pagefind-ignore),
 *   교사용 접기와 정답 접기(학생 검색 결과 요약에 교사용 글·정답이 보이지 않게 — 적용은 공통 파일이라 통합 단계에 요청)
 *
 * 줄바꿈이 든 글자와 태그가 이어지는 곳이 없게 짰다(CLAUDE.md .astro 줄바꿈 공백 함정).
 */
import { flattenPages, learnUnits } from '../../config/nav.ts';
import { searchConfig } from '../../config/search.ts';
import { withBase } from '../../lib/url.ts';
import Icon from '../common/Icon.astro';
import { FILTER_KINDS, KIND_ICON, KIND_LABEL } from './search-core.ts';

const sections = [...flattenPages(), ...learnUnits].map((page) => ({ path: page.path, label: page.label }));
/** 처음 화면의 예시 낱말. 사이트에 실제로 있는 낱말만 둔다(차시가 생기면 차시 낱말로 바꾼다). */
const exampleWords = ['픽셀', '카메라', '라이선스'];
/** 처음 화면에는 예시 낱말 뒤에 많이 찾는 낱말을 잇는다(예시와 겹치는 것은 뺀다) */
const startWords = [...exampleWords, ...searchConfig.popularWords.filter((word) => !exampleWords.includes(word))];
const wordHref = (word: string) => withBase(`search/?${searchConfig.queryParam}=${encodeURIComponent(word)}`);
/** 결과 없음 화면의 추천 낱말 */
const emptyWords = searchConfig.popularWords.slice(0, 5);
/** 종류 칩: 전체 + 거를 수 있는 종류 */
const typeChips = [
  { value: 'all', label: '전체', icon: 'list' as const },
  ...FILTER_KINDS.map((kind) => ({ value: kind, label: KIND_LABEL[kind], icon: KIND_ICON[kind] })),
];
---

<div
  class="search-page"
  data-search-root
  data-state="idle"
  data-bundle-path={searchConfig.bundlePath}
  data-base-url={searchConfig.baseUrl}
  data-query-param={searchConfig.queryParam}
  data-sections={JSON.stringify(sections)}
  data-anchor-pages={JSON.stringify(searchConfig.anchorPages)}
>
  <form class="search-page__form" role="search" aria-label="검색어로 찾기" action={searchConfig.pageHref} method="get" data-search-form>
    <label class="search-page__label" for="search-page-input">검색어</label>
    <div class="search-page__row">
      <div class="search-page__field">
        <span class="search-page__icon"><Icon name="search" /></span>
        <input
          id="search-page-input"
          class="search-page__input"
          type="search"
          name={searchConfig.queryParam}
          autocomplete="off"
          enterkeyhint="search"
          spellcheck="false"
          aria-describedby="search-page-help"
          data-search-input
        />
      </div>
      <button class="button button--primary button--large search-page__button" type="submit">검색</button>
    </div>
    <p id="search-page-help" class="search-page__help">입력을 멈추면 바로 찾아요. 조사를 빼고 낱말만 짧게 넣으면 더 잘 찾아요.</p>
  </form>

  <p class="search-page__status" role="status" data-search-status></p>

  <div class="search-page__types" role="radiogroup" aria-label="결과 종류" data-search-types hidden>
    {
      typeChips.map((chip, index) => (
        <button
          class="search-type"
          type="button"
          role="radio"
          aria-checked={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-type={chip.value}
        >
          <Icon name={chip.icon} size="sm" />
          {chip.label}
        </button>
      ))
    }
  </div>

  <noscript>
    <p class="search-page__notice">
      검색은 브라우저의 자바스크립트가 켜져 있어야 동작해요. 머리글 메뉴나 바닥글의 사이트 지도에서 페이지를 찾아보세요.
    </p>
  </noscript>

  <div class="search-page__tips" data-search-empty hidden>
    <p>이렇게 바꿔 찾아보세요.</p>
    <ul>
      <li>조사를 빼고 낱말만 넣어요. 예: '카메라가' → '카메라'</li>
      <li>낱말의 앞부분만 넣어도 찾아요. 예: '서보모터' → '서보'</li>
      <li>비슷한 다른 낱말로 바꿔 봐요.</li>
    </ul>
    <p class="search-page__tips-title" id="search-empty-words-title">이런 낱말은 어때요?</p>
    <ul class="search-page__chips" aria-labelledby="search-empty-words-title">
      {
        emptyWords.map((word) => (
          <li>
            <a class="search-chip" href={wordHref(word)}>
              {word}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="search-page__results" aria-labelledby="search-results-title" data-search-results-section hidden>
    <h2 id="search-results-title" class="visually-hidden">검색 결과</h2>
    <ol class="search-results" data-search-results></ol>
    <button class="button button--secondary search-page__more" type="button" data-search-more hidden>결과 더 보기</button>
  </section>

  <div class="search-page__examples" data-search-suggestions>
    <p>이런 낱말로 찾아보세요.</p>
    <ul class="search-page__chips">
      {
        startWords.map((word) => (
          <li>
            <a class="search-chip" href={wordHref(word)}>
              {word}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import { setupSearchPage } from './search-page.ts';

  document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
    setupSearchPage(root);
  });
</script>

<style>
  /*
   * 칸 너비를 minmax(0, 1fr)로 두어 안의 요소가 칸을 넓히지 못하게 한다.
   * 입력칸은 기본 너비(글자 20자 × 글꼴의 평균 글자 폭)를 갖는데, 리눅스처럼 한글 대체 글꼴의 평균 글자 폭이 넓으면
   * 그 너비가 칸을 넓혀 375px 화면에서 가로로 넘쳤다(2026-09-16 CI에서 58px, 로컬에서 size를 키워 재현).
   */
  .search-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .search-page__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .search-page__label {
    font-weight: var(--weight-semibold);
  }

  .search-page__row {
    display: flex;
    gap: var(--space-3);
  }

  .search-page__field {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .search-page__icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--space-4);
    display: flex;
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-page__input {
    /* 퍼센트 너비를 주면 입력칸의 기본 너비가 줄바꿈 계산(최소 내용 너비)에 들어가지 않는다(CSS Sizing: 줄어들 수 있는 대체 요소). */
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4) var(--space-3) calc(var(--space-4) + var(--icon-md) + var(--space-3));
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-lg);
  }

  .search-page__input:hover {
    border-color: var(--color-accent-border);
  }

  .search-page__input:focus-visible {
    border-color: var(--color-focus);
  }

  .search-page__button {
    flex: none;
    border-radius: var(--radius-full);
  }

  .search-page__help,
  .search-page__tips,
  .search-page__examples {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .search-page__status:empty {
    display: none;
  }

  .search-page__status {
    font-weight: var(--weight-semibold);
  }

  .search-page__notice {
    padding: var(--space-3) var(--space-4);
    border-inline-start: 4px solid var(--color-warning-border);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
  }

  .search-page__tips ul {
    margin-block-start: var(--space-1);
    padding-inline-start: 1.5em;
  }

  .search-page__tips-title {
    margin-block-start: var(--space-4);
    font-weight: var(--weight-semibold);
  }

  /* 추천 낱말 칩(처음 화면·결과 없음) */
  .search-page__tips .search-page__chips,
  .search-page__examples .search-page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .search-chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .search-chip:hover {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  /* 종류 거르기 칩(라디오 모임) */
  .search-page__types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .search-page__types[hidden] {
    display: none;
  }

  .search-type {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-base);
    cursor: pointer;
  }

  .search-type:hover {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
  }

  /* 고른 칩: 바탕 + 굵은 글씨 + 테두리(색만으로 알리지 않는다) */
  .search-type[aria-checked='true'] {
    border: 2px solid var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: var(--weight-bold);
  }

  .search-results {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 결과 항목은 search-page.ts가 만들어 넣으므로 :global()로 스타일을 준다. 카드 바탕·테두리·덮개 링크는 공용 .card 규칙이 한다. */
  .search-results :global(.search-result) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .search-results :global(.search-result__icon .suggest-icon) {
    width: var(--icon-md, 1.5rem);
    height: var(--icon-md, 1.5rem);
  }

  .search-results :global(.search-result__body) {
    display: grid;
    flex: 1 1 auto;
    gap: var(--space-1);
    min-width: 0;
  }

  .search-results :global(.search-result__kind) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .search-results :global(.search-result__title) {
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  .search-results :global(.search-result__trail) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .search-results :global(.search-result__excerpt) {
    margin: 0;
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .search-results :global(mark) {
    padding: 0 0.1em;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: var(--weight-bold);
  }

  .search-page__more {
    justify-self: start;
    margin-block-start: var(--space-4);
  }

  @media (max-width: 30rem) {
    /* 좁은 화면: 결과 카드의 아이콘 원을 줄여 글 칸을 넓힌다 */
    .search-results :global(.search-result) {
      gap: var(--space-3);
      padding: var(--space-4);
    }

    .search-results :global(.search-result__icon) {
      width: 2.25rem;
      height: 2.25rem;
    }

    .search-page__button {
      padding-inline: var(--space-4);
    }
  }
</style>
