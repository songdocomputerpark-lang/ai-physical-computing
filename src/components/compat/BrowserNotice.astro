---
/**
 * 브라우저 권장 환경 안내(SPEC §9, PLAN §8.1 P1-08).
 *
 * - 컴퓨터용 Chrome·Edge이고 JSPI가 있으면 아무것도 보이지 않는다.
 * - 그 밖의 브라우저(Firefox·Safari·웨일·휴대폰·태블릿 등)면 "실습실은 컴퓨터의 Chrome이나 Edge에서" 안내를 보인다.
 * - Chrome·Edge인데 JSPI가 없으면(오래된 판) 업데이트 안내를 보인다. 버전 숫자로 짐작하지 않고 기능 유무로 가른다.
 * - [안내 닫기]를 누르면 이 브라우저의 저장 공간에 안내 종류를 기억해, 다른 페이지에서도 같은 안내를 다시 띄우지 않는다.
 * 판단은 src/lib/capabilities.ts의 decideBrowserNotice()가 한다(단위 테스트 tests/unit/start/).
 *
 * 쓰는 법: BaseLayout의 notice 슬롯에 넣는다.
 *   <BaseLayout title="…"><BrowserNotice slot="notice" /> … </BaseLayout>
 *
 * 처음 HTML에는 숨겨져 있다(hidden). 자바스크립트가 판단한 뒤에만 보이므로 권장 브라우저에서는 화면이 흔들리지 않는다.
 * 테스트·확인용으로 판단 결과를 data-variant(none·other-browser·update-browser)와
 * data-state(not-needed·dismissed·shown)에 적는다.
 */
import { withBase } from '../../lib/url.ts';

const checkHref = withBase('start/check/');
---

<aside class="browser-notice" aria-label="브라우저 안내" data-browser-notice data-pagefind-ignore hidden>
  <svg class="browser-notice__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7.5v6"></path>
    <path d="M12 16.75v.5"></path>
  </svg>
  <div class="browser-notice__body">
    <div class="browser-notice__text" data-notice-text="other-browser" hidden>
      <p class="browser-notice__title">실습실은 컴퓨터의 Chrome이나 Edge에서 열어 주세요</p>
      <p>
        지금 브라우저에서도 학습 페이지와 퀴즈는 볼 수 있어요. 코드를 실행하거나 보드를 연결하는 실습은 Chrome과 Edge
        최신판을 기준으로 만들어요.
      </p>
    </div>
    <div class="browser-notice__text" data-notice-text="update-browser" hidden>
      <p class="browser-notice__title">브라우저를 최신판으로 업데이트해 주세요</p>
      <p>
        이 브라우저에는 파이썬 실습에 필요한 기능(JSPI)이 없어요. 업데이트한 뒤 점검 페이지에서 다시 확인해 주세요. 학습
        페이지와 퀴즈는 지금도 볼 수 있어요.
      </p>
    </div>
    <p><a href={checkHref}>이 브라우저로 무엇이 되는지 점검하기</a></p>
  </div>
  <button type="button" class="browser-notice__close" data-browser-notice-close>
    <svg class="browser-notice__close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
    안내 닫기
  </button>
</aside>

<script>
  import {
    decideBrowserNotice,
    envFromWindow,
    isBrowserNoticeDismissed,
    rememberBrowserNoticeDismissed,
  } from '../../lib/capabilities.ts';

  const env = envFromWindow(window);
  const variant = decideBrowserNotice(env);

  for (const notice of document.querySelectorAll<HTMLElement>('[data-browser-notice]')) {
    notice.dataset.variant = variant;
    if (variant === 'none') {
      notice.dataset.state = 'not-needed';
      continue;
    }
    if (isBrowserNoticeDismissed(variant, env.getLocalStorage)) {
      notice.dataset.state = 'dismissed';
      continue;
    }
    for (const block of notice.querySelectorAll<HTMLElement>('[data-notice-text]')) {
      block.hidden = block.dataset.noticeText !== variant;
    }
    notice.hidden = false;
    notice.dataset.state = 'shown';

    notice.querySelector<HTMLButtonElement>('[data-browser-notice-close]')?.addEventListener('click', () => {
      // 저장하지 못해도(저장 공간이 막힌 브라우저) 이번 페이지에서는 닫는다.
      rememberBrowserNoticeDismissed(variant, env.getLocalStorage);
      notice.hidden = true;
      notice.dataset.state = 'dismissed';
      // 누른 버튼이 사라지므로 초점을 본문으로 옮긴다(BaseLayout의 건너뛰기 도착점).
      document.getElementById('main-content')?.focus();
    });
  }
</script>

<style>
  .browser-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-info-border);
    border-inline-start-width: 0.375rem;
    border-radius: var(--radius-md);
    background: var(--color-info-bg);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .browser-notice[data-variant='update-browser'] {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
  }

  .browser-notice__icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.1rem;
    fill: none;
    stroke: var(--color-info-text);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .browser-notice[data-variant='update-browser'] .browser-notice__icon {
    stroke: var(--color-warning-text);
  }

  .browser-notice__body {
    display: grid;
    flex: 1 1 16rem;
    gap: var(--space-2);
  }

  .browser-notice__text {
    display: grid;
    gap: var(--space-1);
  }

  .browser-notice__title {
    font-weight: var(--weight-bold);
  }

  .browser-notice__close {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .browser-notice__close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  .browser-notice__close-icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* 안내가 숨겨져 있을 때 안내 자리의 빈 여백은 src/styles/global.css의 .page-notice__inner 규칙이 없앤다. */
</style>
