---
/**
 * 브라우저 권장 환경 안내(SPEC §9, PLAN §8.1 P1-08).
 *
 * - 컴퓨터용 Chrome·Edge이고 JSPI가 있으면 아무것도 보이지 않는다.
 * - 그 밖의 브라우저(Firefox·Safari·웨일·휴대폰·태블릿 등)면 "실습실은 컴퓨터의 Chrome이나 Edge에서" 안내를 보인다.
 * - Chrome·Edge인데 JSPI가 없으면(오래된 판) 업데이트 안내를 보인다. 버전 숫자로 짐작하지 않고 기능 유무로 가른다.
 * - [안내 닫기]를 누르면 이 브라우저의 저장 공간에 안내 종류를 기억해, 다른 페이지에서도 같은 안내를 다시 띄우지 않는다.
 * 판단은 src/lib/capabilities.ts의 decideBrowserNotice()가 한다(단위 테스트 tests/unit/start/).
 *
 * 쓰는 법: BaseLayout의 notice 슬롯에 넣는다.
 *   <BaseLayout title="…"><BrowserNotice slot="notice" /> … </BaseLayout>
 *
 * 휴대폰(좁은 화면)에서는 제목 한 줄과 [자세히 보기]만 먼저 보이고 설명·점검 링크는 접혀 있다(판 1.3.0 검수 R1-098 — 예전에는 안내 상자가
 * 높이 약 380px로 첫 화면의 1/3 이상을 덮고 쪽 제목이 그 아래로 밀렸다). 넓은 화면에서는 펼쳐 둔 채라 예전 모양 그대로다(자바스크립트가 접을지 정한다).
 *
 * 처음 HTML에는 숨겨져 있다(hidden). 자바스크립트가 판단한 뒤에만 보이므로 권장 브라우저에서는 화면이 흔들리지 않는다.
 * 테스트·확인용으로 판단 결과를 data-variant(none·other-browser·update-browser)와
 * data-state(not-needed·dismissed·shown)에 적는다.
 */
import { withBase } from '../../lib/url.ts';

const checkHref = withBase('start/check/');
---

<aside class="browser-notice" aria-label="브라우저 안내" data-browser-notice data-pagefind-ignore hidden>
  <svg class="browser-notice__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 7.5v6"></path>
    <path d="M12 16.75v.5"></path>
  </svg>
  <div class="browser-notice__body">
    <p class="browser-notice__title" data-notice-text="other-browser" data-notice-device="computer" hidden>실습실은 컴퓨터의 Chrome이나 Edge에서 열어 주세요</p>
    <p class="browser-notice__title" data-notice-text="other-browser" data-notice-device="phone" hidden>휴대폰에서는 읽기가 가장 잘 돼요. 실습은 컴퓨터에서 해 주세요</p>
    <p class="browser-notice__title" data-notice-text="update-browser" hidden>브라우저를 최신판으로 업데이트해 주세요</p>
    <details class="browser-notice__more" open>
      <summary>자세히 보기</summary>
      <p data-notice-text="other-browser" data-notice-device="computer" hidden>
        지금 브라우저에서도 학습 페이지와 퀴즈는 볼 수 있어요. 코드를 실행하거나 보드를 연결하는 실습은 Chrome과 Edge
        최신판을 기준으로 만들어요.
      </p>
      <p data-notice-text="other-browser" data-notice-device="phone" hidden>
        휴대폰에서도 학습 페이지와 퀴즈는 볼 수 있어요. 코드 실행은 일부만 되거나 멈출 수 있고, 실제 보드 연결(USB·블루투스)은
        컴퓨터의 Chrome과 Edge 최신판을 기준으로 만들어요. 컴퓨터가 있으면 이 쪽 주소를 컴퓨터에서 열어 주세요.
      </p>
      <p data-notice-text="update-browser" hidden>
        이 브라우저에는 파이썬 실습에 필요한 기능(JSPI)이 없어요. 업데이트한 뒤 내 컴퓨터 점검에서 다시 확인해 주세요. 학습
        페이지와 퀴즈는 지금도 볼 수 있어요.
      </p>
      <p><a class="button button--secondary browser-notice__check" href={checkHref}>내 컴퓨터 점검 열기</a></p>
    </details>
  </div>
  <button type="button" class="browser-notice__close" data-browser-notice-close>
    <svg class="browser-notice__close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
    <span class="browser-notice__close-label">안내 닫기</span>
  </button>
</aside>

<script>
  import {
    decideBrowserNotice,
    detectBrowser,
    envFromWindow,
    isBrowserNoticeDismissed,
    rememberBrowserNoticeDismissed,
  } from '../../lib/capabilities.ts';

  const env = envFromWindow(window);
  const variant = decideBrowserNotice(env);
  // 휴대폰·태블릿이면 "컴퓨터의 Chrome·Edge" 한 가지 말만 하지 않고 이 기기 사정을 말한다(R2-002). 같은 안내 종류라 닫기 기억은 그대로 쓴다.
  const device = detectBrowser(env).mobile ? 'phone' : 'computer';

  for (const notice of document.querySelectorAll<HTMLElement>('[data-browser-notice]')) {
    notice.dataset.variant = variant;
    if (variant === 'none') {
      notice.dataset.state = 'not-needed';
      continue;
    }
    if (isBrowserNoticeDismissed(variant, env.getLocalStorage)) {
      notice.dataset.state = 'dismissed';
      continue;
    }
    notice.dataset.device = device;
    for (const block of notice.querySelectorAll<HTMLElement>('[data-notice-text]')) {
      const forDevice = block.dataset.noticeDevice;
      block.hidden = block.dataset.noticeText !== variant || (forDevice !== undefined && forDevice !== device);
    }
    notice.hidden = false;
    notice.dataset.state = 'shown';

    // 좁은 화면(휴대폰)에서는 설명을 접어 두고 제목만 보인다. 넓은 화면은 펼친 채(예전 모양). 화면 폭이 바뀌면 따라간다.
    const more = notice.querySelector<HTMLDetailsElement>('details.browser-notice__more');
    if (more !== null && typeof matchMedia === 'function') {
      const narrow = matchMedia('(max-width: 40rem)');
      more.open = !narrow.matches;
      narrow.addEventListener('change', (event) => {
        more.open = !event.matches;
      });
    }

    notice.querySelector<HTMLButtonElement>('[data-browser-notice-close]')?.addEventListener('click', () => {
      // 저장하지 못해도(저장 공간이 막힌 브라우저) 이번 페이지에서는 닫는다.
      rememberBrowserNoticeDismissed(variant, env.getLocalStorage);
      notice.hidden = true;
      notice.dataset.state = 'dismissed';
      // 누른 버튼이 사라지므로 초점을 본문으로 옮긴다(BaseLayout의 건너뛰기 도착점).
      document.getElementById('main-content')?.focus();
    });
  }
</script>

<style>
  .browser-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-info-border);
    border-inline-start-width: 0.375rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    background: var(--color-info-bg);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .browser-notice[data-variant='update-browser'] {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
  }

  .browser-notice__icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.1rem;
    fill: none;
    stroke: var(--color-info-text);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .browser-notice[data-variant='update-browser'] .browser-notice__icon {
    stroke: var(--color-warning-text);
  }

  .browser-notice__body {
    display: grid;
    flex: 1 1 16rem;
    gap: var(--space-2);
  }

  .browser-notice__more {
    display: grid;
    gap: var(--space-2);
  }

  .browser-notice__more > p {
    margin: 0;
  }

  /* 넓은 화면에서는 늘 펼쳐 있어 "자세히 보기" 줄이 필요 없다(자바스크립트가 열어 둔다). 휴대폰에서만 보이는 접기 단추다. */
  @media (min-width: 40.01rem) {
    .browser-notice__more > summary {
      display: none;
    }
  }

  .browser-notice__more > summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  .browser-notice__more > summary::-webkit-details-marker {
    display: none;
  }

  /* 세모 표시는 테두리로 그린다(C68 규약 — flex인 summary는 기본 표식이 사라진다). 열리면 90도 돌고 전환은 없다. */
  .browser-notice__more > summary::before {
    content: '';
    flex: none;
    inline-size: 0;
    block-size: 0;
    border-style: solid;
    border-color: transparent;
    border-block-width: 0.35em;
    border-inline-width: 0.55em 0;
    border-inline-start-color: currentColor;
  }

  .browser-notice__more[open] > summary::before {
    transform: rotate(90deg);
  }

  @media (forced-colors: active) {
    .browser-notice__more > summary {
      forced-color-adjust: auto;
      list-style: revert;
    }

    .browser-notice__more > summary::before {
      display: none;
    }
  }

  /*
   * 휴대폰: 제목 한 줄 + [자세히 보기] 한 줄 + 닫기만 먼저 보이게 안쪽 여백·글자를 줄이고, 닫기는 글자 없이 X만(이름 "안내 닫기"는 그대로 — 아래 sr-only).
   * 설명·점검 링크는 접힌 칸 안이라 자리를 차지하지 않는다(예전 높이 약 380px → 약 130px).
   */
  @media (max-width: 40rem) {
    .browser-notice {
      flex-wrap: nowrap;
      gap: var(--space-2) var(--space-3);
      padding: var(--space-2) var(--space-3);
      border-inline-start-width: 0.25rem;
    }

    .browser-notice__title {
      font-size: var(--text-base);
    }

    .browser-notice__close {
      padding: var(--space-2);
    }

    .browser-notice__close-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .browser-notice__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  /* 점검 링크는 눌러야 한다는 게 보이게 보조 단추 모양(.button--secondary — global.css)으로, 글에 묻히지 않게 한 줄 폭만 */
  .browser-notice__check {
    justify-self: start;
    max-width: 100%;
  }

  .browser-notice__close {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .browser-notice__close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  .browser-notice__close-icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* 안내가 숨겨져 있을 때 안내 자리의 빈 여백은 src/styles/global.css의 .page-notice__inner 규칙이 없앤다. */
</style>
