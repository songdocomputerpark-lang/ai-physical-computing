---
/**
 * 짧은 브라우저 확인(학생용 시작하기 ① 단계) — 브라우저·JSPI·카메라 기능 세 가지만 보여 준다.
 * 판단은 src/lib/capabilities.ts의 runChecks()가 하고, 전체 항목은 점검 페이지(/start/check/)에 있다.
 * 허락 창을 띄우지 않고 사이트 밖 서버에 접속하지 않는다. 테스트용으로 data-state(running·done)와 줄마다 data-status를 적는다.
 */
import { CHECK_ITEMS, type CheckId } from '../../lib/capabilities.ts';
import { withBase } from '../../lib/url.ts';

const QUICK_IDS: readonly CheckId[] = ['browser', 'jspi', 'camera-api'];
const items = CHECK_ITEMS.filter((item) => QUICK_IDS.includes(item.id));
const checkHref = withBase('start/check/');
---

<div class="quick-check" data-quick-check data-state="waiting" data-ids={QUICK_IDS.join(' ')}>
  <ul class="quick-check__list">
    {
      items.map((item) => (
        <li class="quick-check__item" data-quick-row={item.id} data-status="pending">
          <span class="quick-check__badge" data-pagefind-ignore>
            <span aria-hidden="true" data-quick-icon>
              …
            </span>
            <span data-quick-status>확인 중</span>
          </span>
          <span class="quick-check__text">
            <strong class="quick-check__label">{item.label}</strong>
            <span class="quick-check__summary" data-quick-summary data-pagefind-ignore>
              점검하는 중이에요.
            </span>
            <span class="quick-check__advice" data-quick-advice data-pagefind-ignore hidden />
          </span>
        </li>
      ))
    }
  </ul>
  <p class="quick-check__verdict" role="status" data-quick-verdict data-pagefind-ignore></p>
  <p class="quick-check__more">
    <a href={checkHref}>전체 점검 보기(보드 연결·블루투스·화면 크기까지)</a>
  </p>
  <noscript>
    <p class="quick-check__noscript">자바스크립트가 꺼져 있어서 확인할 수 없어요. 브라우저 설정에서 자바스크립트를 켜 주세요.</p>
  </noscript>
</div>

<script>
  import {
    CHECK_IDS,
    STATUS_LABELS,
    envFromWindow,
    runChecks,
    type CheckId,
    type CheckStatus,
  } from '../../lib/capabilities.ts';

  const ICONS: Record<CheckStatus, string> = { supported: '✓', unsupported: '✕', unknown: '!' };

  for (const root of document.querySelectorAll<HTMLElement>('[data-quick-check]')) {
    const ids = (root.dataset.ids ?? '')
      .split(' ')
      .filter((id): id is CheckId => (CHECK_IDS as readonly string[]).includes(id));
    root.dataset.state = 'running';

    void runChecks(envFromWindow(window), ids).then((report) => {
      for (const result of report.results) {
        const row = root.querySelector<HTMLElement>(`[data-quick-row="${result.id}"]`);
        if (!row) continue;
        row.dataset.status = result.status;
        const icon = row.querySelector<HTMLElement>('[data-quick-icon]');
        const status = row.querySelector<HTMLElement>('[data-quick-status]');
        const summary = row.querySelector<HTMLElement>('[data-quick-summary]');
        const advice = row.querySelector<HTMLElement>('[data-quick-advice]');
        if (icon) icon.textContent = ICONS[result.status];
        if (status) status.textContent = STATUS_LABELS[result.status];
        if (summary) summary.textContent = result.summary;
        if (advice) {
          advice.textContent = result.status === 'supported' ? '' : result.advice;
          advice.hidden = advice.textContent === '';
        }
      }

      const verdict = root.querySelector<HTMLElement>('[data-quick-verdict]');
      if (verdict) {
        const jspi = report.results.find((result) => result.id === 'jspi');
        if (report.results.every((result) => result.status === 'supported')) {
          verdict.textContent = '좋아요. 이 브라우저는 실습할 준비가 됐어요.';
        } else if (jspi && jspi.status !== 'supported') {
          verdict.textContent = '이 브라우저로는 코드를 실행하는 실습이 어려워요. 컴퓨터의 Chrome이나 Edge로 열어 주세요.';
        } else {
          verdict.textContent = '"확인 필요"나 "미지원" 줄의 안내를 먼저 확인해 주세요.';
        }
      }
      root.dataset.state = 'done';
    });
  }
</script>

<style>
  .quick-check {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-prose);
    margin-block: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .quick-check__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick-check__item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    line-height: var(--leading-snug);
  }

  .quick-check__badge {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-info-border);
    border-radius: var(--radius-full);
    background: var(--color-info-bg);
    color: var(--color-info-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  [data-status='supported'] > .quick-check__badge {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  [data-status='unsupported'] > .quick-check__badge {
    border-color: var(--color-danger-border);
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
  }

  [data-status='unknown'] > .quick-check__badge {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
  }

  .quick-check__text {
    display: grid;
    gap: var(--space-1);
  }

  .quick-check__summary,
  .quick-check__advice {
    font-size: var(--text-sm);
  }

  .quick-check__advice {
    color: var(--color-text-muted);
  }

  .quick-check__verdict {
    font-weight: var(--weight-bold);
  }

  .quick-check__verdict:empty {
    display: none;
  }

  .quick-check__noscript {
    color: var(--color-danger-text);
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 29.99rem) {
    .quick-check__item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
