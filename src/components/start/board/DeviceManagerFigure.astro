---
/**
 * Windows 장치 관리자에서 포트 목록을 확인하는 그림(직접 그린 SVG — PLAN §8.3 P3-10 "② 장치 관리자(포트 목록) 확인 그림").
 * 보드 준비 페이지의 "연결이 안 될 때" 안내에서 쓴다.
 *
 * 세 장면: ① 꽂기 전(보드 이름 없음) ② 꽂은 뒤 컴퓨터가 알아봄(포트(COM & LPT) 아래 "USB-SERIAL CH340 (COM3)"이 새로 생김)
 * ③ 꽂은 뒤 드라이버가 없음(기타 장치 아래 느낌표가 붙은 장치). 운영체제 화면을 옮겨 그리지 않고 목록의 뜻만 단순한 모양으로 그렸다
 * (회사 아이콘·로고 없음). 장치 이름은 예다 — 드라이버를 설치한 CH340은 "USB-SERIAL CH340 (COM##)"(SparkFun CH340 안내),
 * 드라이버가 없을 때 이름은 보드마다 달라 흔한 예("USB2.0-Serial")를 적고 그림 밖 글에도 "예"라고 밝힌다.
 * 뜻은 색만이 아니라 ✓·! 기호와 글자로도 전한다. 각 장면은 role="img"와 제목·설명을 가진다.
 */

interface Row {
  /** 들여쓰기(0 = 컴퓨터, 1 = 분류, 2 = 장치) */
  readonly level: 0 | 1 | 2;
  readonly text: string;
  /** 분류가 펼쳐졌는지(장치에는 없음) */
  readonly expanded?: boolean;
  /** 강조 모양 */
  readonly mark?: 'ok' | 'warn';
}

interface Scene {
  readonly id: string;
  readonly title: string;
  readonly desc: string;
  readonly caption: string;
  readonly rows: readonly Row[];
  readonly badge: { readonly text: string; readonly tone: 'ok' | 'bad' | 'muted' };
}

const SCENES: readonly Scene[] = [
  {
    id: 'dm-before',
    title: '장치 관리자: 보드를 꽂기 전',
    desc: '목록에 디스크 드라이브, 디스플레이 어댑터, 범용 직렬 버스 컨트롤러, 키보드가 있고 보드 이름은 없어요.',
    caption: '① 꽂기 전: 보드 이름이 없어요. 포트(COM & LPT) 항목이 아예 없을 수도 있어요.',
    rows: [
      { level: 0, text: '내 컴퓨터', expanded: true },
      { level: 1, text: '디스크 드라이브' },
      { level: 1, text: '디스플레이 어댑터' },
      { level: 1, text: '범용 직렬 버스 컨트롤러' },
      { level: 1, text: '키보드' },
    ],
    badge: { text: '보드 이름이 아직 없어요', tone: 'muted' },
  },
  {
    id: 'dm-found',
    title: '장치 관리자: 보드를 알아본 경우',
    desc: '보드를 꽂은 뒤 포트(COM & LPT) 아래에 USB-SERIAL CH340 (COM3)이 새로 생겼어요.',
    caption: '② 꽂은 뒤 새 이름이 생기면 컴퓨터가 보드를 알아본 거예요. 포트 선택 창에서 같은 COM 번호를 골라요.',
    rows: [
      { level: 0, text: '내 컴퓨터', expanded: true },
      { level: 1, text: '디스크 드라이브' },
      { level: 1, text: '키보드' },
      { level: 1, text: '포트(COM & LPT)', expanded: true },
      { level: 2, text: 'USB-SERIAL CH340 (COM3)', mark: 'ok' },
    ],
    badge: { text: '✓ 새로 생겼어요', tone: 'ok' },
  },
  {
    id: 'dm-no-driver',
    title: '장치 관리자: 드라이버가 없는 경우',
    desc: '보드를 꽂은 뒤 기타 장치 아래에 느낌표가 붙은 USB2.0-Serial 장치가 생겼어요.',
    caption: '③ 기타 장치 아래에 느낌표(!)가 붙은 장치가 생기면 드라이버가 없는 거예요. 아래 드라이버 안내로 가요.',
    rows: [
      { level: 0, text: '내 컴퓨터', expanded: true },
      { level: 1, text: '기타 장치', expanded: true },
      { level: 2, text: 'USB2.0-Serial', mark: 'warn' },
      { level: 1, text: '디스크 드라이브' },
      { level: 1, text: '키보드' },
    ],
    badge: { text: '! 드라이버가 필요해요', tone: 'bad' },
  },
];

const ROW_TOP = 58;
const ROW_GAP = 26;
const INDENT = 18;

function arrowPath(x: number, y: number, expanded: boolean): string {
  // 펼침 ▾ / 접힘 ▸ (글자 기준선 y에 맞춤)
  return expanded ? `M${x} ${y - 9}h9l-4.5 6z` : `M${x + 2} ${y - 11}v9l6-4.5z`;
}
---

<figure class="dm-figure">
  <ol class="dm-scenes">
    {
      SCENES.map((scene) => (
        <li class="dm-scene">
          <svg class="dm-svg" viewBox="0 0 320 214" role="img" aria-labelledby={`${scene.id}-title ${scene.id}-desc`}>
            <title id={`${scene.id}-title`}>{scene.title}</title>
            <desc id={`${scene.id}-desc`}>{scene.desc}</desc>
            <rect class="dm-window" x="3" y="3" width="314" height="208" rx="8" />
            <path class="dm-titlebar" d="M3 11a8 8 0 0 1 8-8h298a8 8 0 0 1 8 8v24H3z" />
            <text class="dm-title" x="16" y="25">
              장치 관리자
            </text>
            {scene.rows.map((row, index) => {
              const y = ROW_TOP + index * ROW_GAP;
              const x = 14 + row.level * INDENT;
              const iconX = x + 14;
              const textX = iconX + 20;
              return (
                <g>
                  {row.mark === 'ok' && <rect class="dm-highlight dm-highlight--ok" x={iconX - 6} y={y - 17} width={306 - iconX} height="24" rx="4" />}
                  {row.mark === 'warn' && <rect class="dm-highlight dm-highlight--warn" x={iconX - 6} y={y - 17} width={306 - iconX} height="24" rx="4" />}
                  {row.level < 2 && <path class="dm-arrow" d={arrowPath(x, y, row.expanded === true)} />}
                  {row.level === 0 && <rect class="dm-icon" x={iconX} y={y - 12} width="15" height="10" rx="1.5" />}
                  {row.level === 1 && <rect class="dm-icon" x={iconX} y={y - 12} width="13" height="11" rx="2.5" />}
                  {row.mark === 'ok' && (
                    <g class="dm-port-icon">
                      <rect x={iconX} y={y - 11} width="14" height="8" rx="1.5" />
                      <path d={`M${iconX + 3} ${y - 3}v3M${iconX + 7} ${y - 3}v3M${iconX + 11} ${y - 3}v3`} />
                    </g>
                  )}
                  {row.mark === 'warn' && (
                    <g>
                      <path class="dm-warn-icon" d={`M${iconX + 7} ${y - 13}l7.5 13h-15z`} />
                      <text class="dm-warn-mark" x={iconX + 7} y={y - 1.5} text-anchor="middle">
                        !
                      </text>
                    </g>
                  )}
                  <text class={row.level === 2 ? 'dm-text dm-text--device' : 'dm-text'} x={textX} y={y}>
                    {row.text}
                  </text>
                </g>
              );
            })}
            <text class={`dm-badge dm-badge--${scene.badge.tone}`} x="16" y="198">
              {scene.badge.text}
            </text>
          </svg>
          <p class="dm-caption">{scene.caption}</p>
        </li>
      ))
    }
  </ol>
  <figcaption class="dm-figcaption">
    그림 속 장치 이름과 COM 번호는 예예요. 보드의 USB 칩과 컴퓨터에 따라 이름과 번호가 달라요.
  </figcaption>
</figure>

<style>
  .dm-figure {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-4);
  }

  .dm-scenes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dm-scene {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
  }

  .dm-svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    font-family: var(--font-sans);
  }

  .dm-caption,
  .dm-figcaption {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .dm-figcaption {
    color: var(--color-text-muted);
  }

  .dm-window {
    fill: var(--color-bg);
    stroke: var(--color-border-strong);
    stroke-width: 2;
  }

  .dm-titlebar {
    fill: var(--color-bg-muted);
  }

  .dm-title {
    fill: var(--color-text);
    font-size: 14px;
    font-weight: 700;
  }

  .dm-text {
    fill: var(--color-text);
    font-size: 14px;
  }

  .dm-text--device {
    font-weight: 600;
  }

  .dm-arrow {
    fill: var(--color-text-muted);
  }

  .dm-icon {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent-border);
    stroke-width: 1.5;
  }

  .dm-port-icon rect {
    fill: var(--color-success-bg);
    stroke: var(--color-success-text);
    stroke-width: 1.5;
  }

  .dm-port-icon path {
    fill: none;
    stroke: var(--color-success-text);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .dm-highlight {
    stroke-width: 2;
  }

  .dm-highlight--ok {
    fill: var(--color-success-bg);
    stroke: var(--color-success-border);
  }

  .dm-highlight--warn {
    fill: var(--color-warning-bg);
    stroke: var(--color-warning-border);
  }

  .dm-warn-icon {
    fill: var(--color-warning-text);
  }

  .dm-warn-mark {
    fill: var(--color-bg);
    font-size: 11px;
    font-weight: 700;
  }

  .dm-badge {
    font-size: 14px;
    font-weight: 700;
  }

  .dm-badge--ok {
    fill: var(--color-success-text);
  }

  .dm-badge--bad {
    fill: var(--color-danger-text);
  }

  .dm-badge--muted {
    fill: var(--color-text-muted);
  }
</style>
