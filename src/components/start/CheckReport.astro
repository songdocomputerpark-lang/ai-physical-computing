---
/**
 * 브라우저 점검 결과 표와 [결과 복사]·[다시 점검] 버튼(PLAN §8.1 P1-08, §5.5).
 *
 * 점검 판단은 src/lib/capabilities.ts가 한다. 이 컴포넌트는 결과를 표에 채우고 복사할 글을 만든다.
 * - 페이지를 열면 바로 점검한다. 사이트 밖 서버에 접속하지 않고, 허락 창(카메라·포트 선택)을 띄우지 않는다.
 * - 표는 넓은 화면에서 3칸(항목·결과·설명과 대처), 좁은 화면(48rem 미만)에서는 항목마다 한 덩어리로 쌓인다.
 *   쌓을 때 표의 뜻이 사라지지 않게 role(table·row·cell)을 직접 적었다.
 * - 결과는 글자(지원·미지원·확인 필요)와 기호로도 보여 색만으로 알리지 않는다.
 * 테스트·확인용: 루트에 data-state(running·done)와 data-level(ready·partial·blocked), 줄마다 data-status를 적는다.
 * 판 1.1.0(미해결 121): 표 아래에 "카메라 영상 확인"(camera-check/CameraCheck.astro — 누를 때만 카메라를 켬)을 두고, 그 결과 글을
 * [결과 복사] 글 끝에 붙인다(apc:camera-check-result). 누르지 않았으면 복사 글은 전과 같다.
 * 1.1.0 검토 반영(2026-09-29): 카메라 확인이 "주의"·"안 됨"이면 요약 칸(초록 "모두 지원")과 복사 글 첫머리에도 그 한 줄을 넣고 요약 칸 색을
 * "확인 필요"로 바꾼다 — 카메라가 까만데 요약만 초록이라 복사 글 안에서 앞뒤가 달랐다. 복사 글에는 카메라 이름이 없다(번호·종류만).
 */
import { siteConfig } from '../../config/site.ts';
import { CHECK_ITEMS } from '../../lib/capabilities.ts';
import CameraCheck from './camera-check/CameraCheck.astro';
import { checkDisplay } from './check-labels.ts';
---

<div class="check-report" data-check-report data-state="waiting" data-site-name={siteConfig.name} data-site-version={siteConfig.version}>
  <div class="check-report__summary" role="status" data-pagefind-ignore>
    <p class="check-report__verdict" data-check-verdict>점검을 준비하고 있어요.</p>
    <p class="check-report__counts" data-check-counts></p>
    <p class="check-report__camera" data-check-camera hidden></p>
  </div>

  <div class="check-report__actions">
    <button type="button" class="button button--primary" data-check-copy disabled>결과 복사</button>
    <button type="button" class="button button--secondary" data-check-rerun disabled>다시 점검</button>
    <p class="check-report__copy-status" role="status" data-check-copy-status data-pagefind-ignore></p>
  </div>

  <table class="check-table" role="table">
    <caption class="visually-hidden">항목별 점검 결과</caption>
    <thead class="check-table__head" role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">항목</th>
        <th scope="col" role="columnheader">결과</th>
        <th scope="col" role="columnheader">설명과 대처</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        CHECK_ITEMS.map((item) => {
          const display = checkDisplay(item.id, item.label);
          return (
          <tr class="check-table__row" role="row" data-check-row={item.id} data-status="pending">
            <th class="check-table__item" scope="row" role="rowheader">
              <span class="check-table__label">{display.name}</span>
              {display.tech && <span class="check-table__tech">{display.tech}</span>}
              <span class="check-table__needed">{item.neededFor}</span>
            </th>
            <td class="check-table__status" role="cell" data-pagefind-ignore>
              <span class="status-badge">
                <span class="status-badge__icon" aria-hidden="true" data-check-icon>
                  …
                </span>
                <span data-check-status>확인 중</span>
              </span>
            </td>
            <td class="check-table__text" role="cell" data-pagefind-ignore>
              <p data-check-summary>점검하는 중이에요.</p>
              <p class="check-table__quick" data-check-quick hidden />
              <p class="check-table__advice" data-check-advice hidden />
              <p class="check-table__detail" data-check-detail hidden />
            </td>
          </tr>
          );
        })
      }
    </tbody>
  </table>

  <CameraCheck />

  <details class="check-report__raw" data-check-raw data-pagefind-ignore>
    <summary>복사될 내용 보기</summary>
    <label class="visually-hidden" for="check-report-text">복사될 점검 결과</label>
    <textarea id="check-report-text" class="check-report__textarea" rows="14" readonly data-check-text></textarea>
  </details>

  <noscript>
    <p class="check-report__noscript">
      자바스크립트가 꺼져 있어서 점검할 수 없어요. 브라우저 설정에서 자바스크립트를 켠 뒤 새로고침해 주세요.
    </p>
  </noscript>
</div>

<script>
  import {
    STATUS_LABELS,
    envFromWindow,
    formatReport,
    runChecks,
    summarizeReport,
    type CheckStatus,
  } from '../../lib/capabilities.ts';
  import { CAMERA_CHECK_RESULT_EVENT, type CameraCheckResultDetail } from './camera-check/camera-check-report.ts';
  import { quickFixLine } from './check-labels.ts';

  const ICONS: Record<CheckStatus, string> = { supported: '✓', unsupported: '✕', unknown: '!' };

  /** 클립보드에 글을 복사한다. 새 방법이 안 되면 보이지 않는 글상자를 잠깐 만들어 옛 방법으로 복사한다. */
  async function copyText(text: string): Promise<boolean> {
    try {
      if (window.isSecureContext && navigator.clipboard) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      // 아래 방법으로 한 번 더 시도한다.
    }
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.insetInlineStart = '-9999px';
    document.body.append(field);
    try {
      field.select();
      return document.execCommand('copy');
    } catch {
      return false;
    } finally {
      field.remove();
    }
  }

  function setup(root: HTMLElement) {
    const verdict = root.querySelector<HTMLElement>('[data-check-verdict]');
    const counts = root.querySelector<HTMLElement>('[data-check-counts]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-check-copy]');
    const rerunButton = root.querySelector<HTMLButtonElement>('[data-check-rerun]');
    const copyStatus = root.querySelector<HTMLElement>('[data-check-copy-status]');
    const raw = root.querySelector<HTMLDetailsElement>('[data-check-raw]');
    const textField = root.querySelector<HTMLTextAreaElement>('[data-check-text]');
    const cameraLine = root.querySelector<HTMLElement>('[data-check-camera]');
    if (!verdict || !counts || !copyButton || !rerunButton || !copyStatus || !raw || !textField) {
      return;
    }
    let reportText = '';
    /** 점검 표 글(자동 점검) */
    let baseText = '';
    /** 자동 점검의 요약 수준(ready·partial·blocked — 카메라 결과로 바꾸기 전 값) */
    let baseLevel = '';
    /** "카메라 영상 확인"을 눌렀으면 그 결과(없으면 null) */
    let camera: CameraCheckResultDetail | null = null;
    /** 카메라 결과가 "주의"·"안 됨"인지 — 요약 칸과 복사 글 첫머리에 한 줄을 넣는다(머리말 1.1.0 검토 반영) */
    const cameraNeedsLook = () => camera !== null && camera.level !== 'ok';
    const renderText = () => {
      if (camera === null) {
        reportText = baseText;
      } else {
        const head = cameraNeedsLook() ? `\n${camera.headline} — 아래 "카메라 영상 확인" 참고` : '';
        reportText = `${baseText}${head}\n\n${camera.text}`;
      }
      textField.value = reportText;
    };
    /** 요약 칸: 카메라 결과가 "주의"·"안 됨"이면 한 줄을 보이고, 자동 점검이 모두 "지원"(초록)이어도 "확인 필요" 색으로 */
    const renderCameraSummary = () => {
      const show = cameraNeedsLook() && root.dataset.state === 'done';
      if (cameraLine) {
        cameraLine.textContent = show && camera ? `${camera.headline} — 표 아래 "카메라 영상 확인" 칸의 판정과 대처를 봐요.` : '';
        cameraLine.hidden = !show;
      }
      if (baseLevel !== '') {
        root.dataset.level = show && baseLevel === 'ready' ? 'partial' : baseLevel;
      }
    };
    document.addEventListener(CAMERA_CHECK_RESULT_EVENT, (event) => {
      const detail = (event as CustomEvent<Partial<CameraCheckResultDetail> | undefined>).detail;
      camera =
        typeof detail?.text === 'string'
          ? { text: detail.text, level: detail.level ?? 'ok', headline: typeof detail.headline === 'string' ? detail.headline : '카메라 영상 확인' }
          : null;
      if (root.dataset.state === 'done') {
        renderText();
        renderCameraSummary();
      }
    });

    const run = async () => {
      copyButton.disabled = true;
      rerunButton.disabled = true;
      root.dataset.state = 'running';
      delete root.dataset.level;
      verdict.textContent = '점검하는 중이에요.';
      counts.textContent = '';
      for (const row of root.querySelectorAll<HTMLElement>('[data-check-row]')) {
        row.dataset.status = 'pending';
      }

      const env = envFromWindow(window);
      const report = await runChecks(env);

      for (const result of report.results) {
        const row = root.querySelector<HTMLElement>(`[data-check-row="${result.id}"]`);
        if (!row) continue;
        row.dataset.status = result.status;
        const icon = row.querySelector<HTMLElement>('[data-check-icon]');
        const status = row.querySelector<HTMLElement>('[data-check-status]');
        const summary = row.querySelector<HTMLElement>('[data-check-summary]');
        const advice = row.querySelector<HTMLElement>('[data-check-advice]');
        const detail = row.querySelector<HTMLElement>('[data-check-detail]');
        const quick = row.querySelector<HTMLElement>('[data-check-quick]');
        if (icon) icon.textContent = ICONS[result.status];
        if (status) status.textContent = STATUS_LABELS[result.status];
        if (summary) summary.textContent = result.summary;
        if (advice) {
          advice.textContent = result.advice;
          advice.hidden = result.advice === '';
        }
        if (detail) {
          detail.textContent = result.detail ?? '';
          detail.hidden = !result.detail;
        }
        if (quick) {
          // 미지원이면 누가 무엇을 하면 되는지 한 줄을 먼저(긴 안내는 그 아래에 그대로)
          quick.textContent = result.status === 'unsupported' ? quickFixLine(result.id) : '';
          quick.hidden = quick.textContent === '';
        }
      }

      const summary = summarizeReport(report);
      root.dataset.level = summary.level;
      baseLevel = summary.level;
      // 모두 지원이면 "수업해도 된다"를 먼저 한 줄로(복사 글의 요약은 라이브러리 문구 그대로)
      verdict.textContent = summary.level === 'ready' ? `이 정도면 수업할 수 있어요. ${summary.message}` : summary.message;
      counts.textContent = `지원 ${summary.counts.supported}개 · 미지원 ${summary.counts.unsupported}개 · 확인 필요 ${summary.counts.unknown}개`;
      baseText = formatReport(report, {
        siteName: root.dataset.siteName ?? '',
        siteVersion: root.dataset.siteVersion,
        pageUrl: `${location.origin}${location.pathname}`,
        userAgent: navigator.userAgent,
      });
      renderText();
      root.dataset.state = 'done';
      renderCameraSummary();
      copyButton.disabled = false;
      rerunButton.disabled = false;
    };

    copyButton.addEventListener('click', async () => {
      const copied = await copyText(reportText);
      if (copied) {
        copyStatus.textContent = '복사했어요. 메신저나 메일, 문제 알리기 글에 붙여 넣어 보내 주세요.';
      } else {
        copyStatus.textContent = '자동으로 복사하지 못했어요. 펼쳐진 글상자의 글을 모두 선택해 직접 복사해 주세요.';
        raw.open = true;
        textField.focus();
        textField.select();
      }
    });

    rerunButton.addEventListener('click', () => {
      copyStatus.textContent = '';
      void run();
    });

    void run();
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-check-report]')) {
    setup(root);
  }
</script>

<style>
  .check-report {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-4) var(--space-10);
  }

  .check-report__summary {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-info-border);
    border-inline-start-width: 0.375rem;
    border-radius: var(--radius-md);
    background: var(--color-info-bg);
    line-height: var(--leading-snug);
  }

  .check-report[data-level='ready'] .check-report__summary {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
  }

  .check-report[data-level='partial'] .check-report__summary {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
  }

  .check-report[data-level='blocked'] .check-report__summary {
    border-color: var(--color-danger-border);
    background: var(--color-danger-bg);
  }

  .check-report__verdict {
    font-weight: var(--weight-bold);
  }

  .check-report__counts {
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  /* 카메라 영상 확인이 "주의"·"안 됨"일 때만 보이는 한 줄(1.1.0 검토 반영) */
  .check-report__camera {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .check-report__camera[hidden] {
    display: none;
  }

  .check-report__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .check-report__actions .button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .check-report__copy-status {
    flex: 1 1 14rem;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .check-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .check-table th,
  .check-table td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  .check-table__head th {
    background: var(--color-bg-muted);
    font-weight: var(--weight-semibold);
  }

  .check-table__item {
    width: 32%;
  }

  .check-table__status {
    width: 8.5rem;
  }

  .check-table__label {
    display: block;
    font-weight: var(--weight-semibold);
  }

  /* 영어 기술 이름: 하는 일 이름 아래의 작은 보조 글씨(R1-041) */
  .check-table__tech {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .check-table__quick {
    margin-block-start: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .check-table__needed {
    display: block;
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .check-table__advice {
    margin-block-start: var(--space-2);
  }

  .check-table__detail {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-info-border);
    border-radius: var(--radius-full);
    background: var(--color-info-bg);
    color: var(--color-info-text);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .status-badge__icon {
    font-weight: var(--weight-bold);
  }

  [data-status='supported'] .status-badge {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
    color: var(--color-success-text);
  }

  [data-status='unsupported'] .status-badge {
    border-color: var(--color-danger-border);
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
  }

  [data-status='unknown'] .status-badge {
    border-color: var(--color-warning-border);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
  }

  .check-report__raw summary {
    min-height: var(--target-min);
    padding-block: var(--space-2);
    cursor: pointer;
    font-weight: var(--weight-semibold);
  }

  .check-report__textarea {
    width: 100%;
    margin-block-start: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    resize: vertical;
  }

  .check-report__noscript {
    padding: var(--space-4);
    border: 1px solid var(--color-danger-border);
    border-radius: var(--radius-md);
    background: var(--color-danger-bg);
    color: var(--color-danger-text);
    font-weight: var(--weight-semibold);
  }

  /* 좁은 화면: 항목마다 한 덩어리로 쌓는다(role을 적어 두어 표의 뜻은 그대로다). */
  @media (max-width: 47.99rem) {
    .check-table__head {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .check-table,
    .check-table tbody,
    .check-table th,
    .check-table td {
      display: block;
    }

    .check-table__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }

    .check-table th,
    .check-table td {
      width: auto;
      padding: 0;
      border: 0;
    }

    .check-table__text {
      grid-column: 1 / -1;
    }
  }
</style>
