---
/**
 * 이 차시의 차례 — 본문 ## 제목(차시 틀 8칸)으로 가는 링크 목록. 칸이 두 개보다 적으면 그리지 않는다.
 */
interface Props {
  sections: readonly { id: string; title: string }[];
}

const { sections } = Astro.props;
---

{
  sections.length >= 2 && (
    <nav class="lesson-toc" aria-labelledby="lesson-toc-title" data-pagefind-ignore>
      <p class="lesson-toc__title" id="lesson-toc-title">
        이 차시의 차례
      </p>
      <ol class="lesson-toc__list">
        {sections.map((section) => (
          <li>
            <a href={`#${section.id}`}>{section.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .lesson-toc {
    margin-block-end: var(--space-8);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .lesson-toc__title {
    margin-block-end: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .lesson-toc__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    font-size: var(--text-sm);
  }

  .lesson-toc__list li {
    counter-increment: toc;
  }

  .lesson-toc__list li::before {
    margin-inline-end: var(--space-1);
    color: var(--color-text-muted);
    content: counter(toc) '.';
  }

  .lesson-toc__list a {
    display: inline-block;
    padding-block: var(--space-2);
  }
</style>
