---
/**
 * 확인 퀴즈(SPEC §7.2 7번) — frontmatter quiz를 객관식 문항으로 그린다. 채점·피드백 동작은 quiz.ts가 붙인다.
 *
 * - 문항마다 fieldset(질문 = legend)과 라디오 단추 보기. 방향키로 고르고 [답 확인하기](Enter·Space)로 확인한다.
 * - 피드백 칸은 role="status"라서 화면 낭독기가 결과를 읽는다. 맞힌 표시는 색과 함께 "정답" 글자로도 보인다.
 * - 자바스크립트가 꺼져 있으면 버튼 대신 "정답과 풀이 보기" 접기 상자가 보인다.
 * - 정답·풀이는 사이트 검색 색인에서 뺀다(data-pagefind-ignore).
 * - 발표 모드(present.ts)는 문항마다 한 단계로 보여 준다(data-present-split·data-present-item).
 */
import type { LessonData } from '../../config/content-schemas.ts';
import { answerText, choiceMark } from './quiz.ts';

interface Props {
  items: LessonData['quiz'];
  /** 페이지 안에서 라디오 단추 이름이 겹치지 않게 붙이는 앞머리 */
  idPrefix: string;
}

const { items, idPrefix } = Astro.props;
---

<div class="quiz" data-quiz data-present-split>
  <p class="quiz__guide">보기를 고르고 [답 확인하기]를 눌러요. 키보드로는 방향키로 보기를 고르고 Tab으로 단추에 가요.</p>
  <ol class="quiz__list">
    {
      items.map((item, index) => {
        const name = `${idPrefix}-q${index + 1}`;
        return (
          <li class="quiz__item" data-quiz-item data-present-item data-answer={item.answer}>
            <fieldset class="quiz__fieldset">
              <legend class="quiz__question">
                <span class="quiz__number">문제 {index + 1}.</span> {item.q}
              </legend>
              <ul class="quiz__choices">
                {item.choices.map((choice, choiceIndex) => (
                  <li>
                    <label class="quiz__choice">
                      <input class="quiz__radio" type="radio" name={name} value={choiceIndex} data-choice-text={choice} />
                      <span class="quiz__mark" aria-hidden="true">
                        {choiceMark(choiceIndex)}
                      </span>
                      <span class="quiz__choice-text">{choice}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>
            <div class="quiz__actions">
              <button type="button" class="button button--primary" data-quiz-check>
                답 확인하기
              </button>
              <button type="button" class="button button--secondary" data-quiz-reveal hidden>
                정답과 풀이 보기
              </button>
            </div>
            <div class="quiz__feedback" role="status" data-quiz-feedback />
            <div class="quiz__explain" data-quiz-explain hidden tabindex="-1" data-pagefind-ignore>
              <p class="quiz__answer">{answerText(item)}</p>
              {item.explain && <p data-quiz-explain-text>{item.explain}</p>}
            </div>
            <details class="quiz__fallback box box--answer" data-pagefind-ignore>
              <summary class="box__title">정답과 풀이 보기</summary>
              <p>{answerText(item)}</p>
              {item.explain && <p>{item.explain}</p>}
            </details>
          </li>
        );
      })
    }
  </ol>
  <p class="quiz__summary" data-quiz-summary></p>
</div>

<script>
  import { enhanceQuizzes } from './quiz.ts';

  enhanceQuizzes();
</script>

<style>
  .quiz {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  .quiz__guide {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .quiz .quiz__list,
  .quiz .quiz__choices {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quiz .quiz__list {
    gap: var(--space-5);
  }

  .quiz .quiz__choices {
    gap: var(--space-2);
  }

  .quiz .quiz__list > li,
  .quiz .quiz__choices > li {
    margin: 0;
  }

  .quiz__item {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .quiz__fieldset {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .quiz__question {
    padding: 0;
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .quiz__number {
    color: var(--color-accent-hover);
    font-weight: var(--weight-bold);
  }

  .quiz__choice {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    line-height: var(--leading-snug);
    cursor: pointer;
  }

  .quiz__choice:hover {
    border-color: var(--color-accent);
  }

  .quiz__choice:has(.quiz__radio:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .quiz__choice:has(.quiz__radio:focus-visible) {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .quiz__radio {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .quiz__radio:focus-visible {
    outline: none;
  }

  .quiz__mark {
    flex: none;
    color: var(--color-text-muted);
  }

  /* 채점 표시: 색과 함께 글자("정답"·"고른 답")로도 알린다. 글자는 피드백 칸이 이미 읽어 주므로 화면 낭독기에서는 뺀다. */
  .quiz__choice[data-result='correct'] {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
  }

  .quiz__choice[data-result='wrong'] {
    border-color: var(--color-danger-border);
    background: var(--color-danger-bg);
  }

  .quiz__choice[data-result]::after {
    margin-inline-start: auto;
    padding-inline-start: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  .quiz__choice[data-result='correct']::after {
    color: var(--color-success-text);
    content: '정답';
    content: '정답' / '';
  }

  .quiz__choice[data-result='wrong']::after {
    color: var(--color-danger-text);
    content: '고른 답';
    content: '고른 답' / '';
  }

  .quiz__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* 피드백 칸은 비어 있을 때도 숨기지 않는다(display: none이면 화면 낭독기가 알림 칸으로 기억하지 못해 결과를 읽지 않을 수 있다).
     비어 있는 동안에는 테두리·여백이 없어 보이지 않고, 글이 들어오면 상자 모양이 된다. */
  .quiz__feedback:not(:empty) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-info-border);
    border-inline-start-width: 0.375rem;
    border-radius: var(--radius-md);
    background: var(--color-info-bg);
    line-height: var(--leading-snug);
  }

  .quiz__feedback[data-state='correct'] {
    border-color: var(--color-success-border);
    background: var(--color-success-bg);
  }

  .quiz__feedback[data-state='wrong'] {
    border-color: var(--color-danger-border);
    background: var(--color-danger-bg);
  }

  .quiz__feedback :global(.quiz__feedback-title) {
    font-weight: var(--weight-bold);
  }

  .quiz__feedback[data-state='correct'] :global(.quiz__feedback-title) {
    color: var(--color-success-text);
  }

  .quiz__feedback[data-state='wrong'] :global(.quiz__feedback-title) {
    color: var(--color-danger-text);
  }

  .quiz__feedback :global(p + p) {
    margin-block-start: var(--space-1);
  }

  .quiz__explain {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    line-height: var(--leading-snug);
  }

  .quiz__answer {
    color: var(--color-accent-hover);
    font-weight: var(--weight-bold);
  }

  .quiz__summary:empty {
    display: none;
  }

  .quiz__summary {
    font-weight: var(--weight-semibold);
  }

  /* 자바스크립트가 되면 접기 상자 대신 버튼을, 꺼져 있으면 버튼 대신 접기 상자를 보인다. */
  :global(html.js) .quiz__fallback {
    display: none;
  }

  :global(html:not(.js)) .quiz__actions,
  :global(html:not(.js)) .quiz__guide {
    display: none;
  }

  .quiz .quiz__fallback {
    margin: 0;
  }
</style>
