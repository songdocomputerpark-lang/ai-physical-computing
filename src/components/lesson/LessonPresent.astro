---
/**
 * 수업 화면 막대(옛 이름 "발표 모드" — 판 1.6.0 C173; SPEC §7.3, PLAN §8.5 P5-02) — 수업 중 프로젝터로 차시를 크게, 한 단계씩 보여 준다.
 * 동작·키는 present.ts 머리말. 여는 단추([수업 화면])는 차시·교과서 쪽 머리에 있고(PresentButton.astro — 자바스크립트가 되면 보인다),
 * 이 컴포넌트는 수업 화면 중에만 보이는 아래쪽 막대와 수업 화면 스타일을 맡는다.
 *
 * 수업 화면: 머리글·바닥글·현재 위치·차례·이전/다음 차시·차시 정보 뱃지·교사용 칸을 숨기고 글자를 크게(뿌리 글자 크기를 화면 폭에 맞춰) 한다.
 * 막대 높이는 단계마다 같다(상태 글 2줄 높이를 늘 잡아 둔다 — R1-076).
 * 막대 가운데 첫 줄은 단계 이름(20글자 안 — 막대가 좁으면 더 줄인다)이고, 누르면 절 이름으로 고르는 단계 목록이 열린다(판 1.7.0, 미해결 271).
 * 낭독기는 줄이지 않은 이름을 따로 듣는다(data-present-announce, aria-live).
 * 둘째 줄은 단계가 화면보다 길면 "▼ 아래에 더 있어요"(판 1.7.0 — 예전에는 막대 위에 뜬 알약이 막대 바로 위 글줄을 덮었다, 미해결 260),
 * 마지막 단계면 "마지막 단계예요 · Esc로 끝내기"(터치 화면은 [끝내기]) — [다음 단계]는 aria-disabled라 초점이 남는다.
 * 휴대폰(막대 가운데가 한 줄)에서는 "아래에 더 있어요"가 예전처럼 막대 위 오른쪽 알약이다.
 * 수업 화면 중에는 맨 위 [본문으로 건너뛰기]를 숨겨 Tab이 슬라이드 밖으로 새지 않게 한다(R1-078 — 막대의 단추를 돌고 끝난다).
 * 모든 크기가 rem이라 뿌리 글자 크기 하나로 본문·표·코드·퀴즈가 함께 커진다. 움직임은 쓰지 않는다(움직임 줄이기와 상관없이 바로 바뀜).
 */
import Icon from '../common/Icon.astro';
---

<div class="lesson-present" data-lesson-present hidden data-pagefind-ignore>
  {/*
    단계 목록(판 1.7.0, 미해결 271 — 종합 §4-5 ③): 막대의 단계 이름을 누르면 열린다. 칸(##) 이름마다 그 칸의 첫 단계로 간다 — 수업 중 "확인 퀴즈로" 같은 건너뛰기.
    목록은 present.ts가 단계를 나눈 뒤 채운다. Esc는 목록만 닫는다(수업 화면은 그대로).
  */}
  <nav class="lesson-present__list" id="lesson-present-list" data-present-list aria-labelledby="lesson-present-list-title" hidden>
    <p class="lesson-present__list-title" id="lesson-present-list-title">단계 목록 · 누르면 그 단계로 가요</p>
    <ol class="lesson-present__list-items" data-present-list-items></ol>
  </nav>
  <div class="lesson-present__bar" role="toolbar" aria-label="수업 화면 조작">
    {/* 접근 이름은 "앞 단계"·"다음 단계"(보이는 글 "앞"·"다음"이 이름 안에 들어 있다 — 2.5.3). 화살표 기호는 장식이라 숨긴다: 낭독기가 기호 이름을 읽지 않게(R2-023). */}
    <button type="button" class="button button--secondary" data-present-previous aria-label="앞 단계"><span aria-hidden="true">◀</span> 앞</button>
    <div class="lesson-present__where">
      {/*
        단계 이름 = 단계 목록 여는 단추. 이름은 보이는 글("3 / 18 · 단계 이름") 뒤에 "단계 목록 열기"를 붙인 것(보이는 글이 이름 안에 — 2.5.3).
        단추는 inline-flex라 안쪽 줄바꿈 공백은 그려지지 않는다(글과 아이콘 사이는 gap).
      */}
      <button type="button" class="lesson-present__status" data-present-list-open aria-expanded="false" aria-controls="lesson-present-list">
        <span class="lesson-present__status-text" data-present-status></span>
        <span class="visually-hidden">— 단계 목록 열기</span>
        <Icon name="list" size="sm" class="lesson-present__status-icon" />
      </button>
      {/* 수업 화면 속 실습실 안에 초점이 있을 때(판 1.7.0 교사 다시 걷기 M1 — 키가 실습실로 가 →·Esc가 멎은 것처럼 보였다). present.ts가 켜고 끈다 */}
      <p class="lesson-present__inlab" data-present-inlab hidden aria-hidden="true">실습실 안에서는 키가 실습실로 가요 · Esc로 슬라이드</p>
      <p class="lesson-present__more" data-present-more hidden aria-hidden="true">
        ▼ 아래에 더 있어요{' '}<span class="lesson-present__more-keys">(아래 화살표 키 · Space · 마우스 휠)</span>
      </p>
      <p class="lesson-present__end" data-present-end hidden aria-hidden="true">
        <span class="lesson-present__end-keys">마지막 단계예요 · Esc로 끝내기</span><span class="lesson-present__end-touch">마지막 단계예요 · [끝내기]를 눌러요</span>
      </p>
    </div>
    <p class="visually-hidden" aria-live="polite" data-present-announce></p>
    <button type="button" class="button button--primary" data-present-next aria-label="다음 단계">다음 <span aria-hidden="true">▶</span></button>
    <button type="button" class="button button--secondary lesson-present__fullscreen" data-present-fullscreen aria-pressed="false">
      전체 화면
    </button>
    <button type="button" class="button button--secondary" data-present-exit>끝내기(Esc)</button>
  </div>
</div>

<script>
  import { installLessonPresentation } from './present.ts';

  installLessonPresentation();
</script>

<style is:global>
  /*
   * 발표 중(html[data-presenting]) — 보이지 않을 요소는 present.ts가 data-present-off를 붙인다.
   * !important: 요소마다 display를 grid·flex로 정한 스타일(.quiz 등)보다 앞서야 해서다(발표 중에만 걸린다).
   */
  html[data-presenting] {
    /* 1366px 화면에서 약 26px, 1920px 이상은 28px, 휴대폰은 16px(본문 17px → 발표 중 약 28px) */
    font-size: clamp(16px, 0.75rem + 1vw, 28px);
  }

  html[data-presenting] [data-present-off],
  html[data-presenting] .site-header,
  html[data-presenting] .site-footer,
  html[data-presenting] .page-notice,
  html[data-presenting] .breadcrumb,
  html[data-presenting] .lesson-toc,
  html[data-presenting] .lesson-pager,
  html[data-presenting] .lesson-nav,
  html[data-presenting] .lesson-done,
  html[data-presenting] .skip-link,
  html[data-presenting] [data-present-hide] {
    display: none !important;
  }

  html[data-presenting] body {
    /* 아래쪽 막대에 가리지 않게 — 막대 높이만큼(present.ts가 --present-bar-h에 잰 값을 쓴다) + 여유 */
    padding-block-end: calc(var(--present-bar-h, 5rem) + 1.5rem);
  }

  /* 키보드로 옮겨 간 초점(퀴즈 보기·예제 단추)도 아래쪽 막대 밑에 숨지 않게 그만큼 위에서 멈춘다(WCAG 2.4.11, Phase 6 접근성 점검) */
  html[data-presenting] {
    scroll-padding-block-end: calc(var(--present-bar-h, 5rem) + 1.5rem);
  }

  html[data-presenting] .page__main {
    padding-block-start: var(--space-2);
  }

  /* 칸 제목 위의 구분 막대·빈자리는 발표 화면에서 줄인다(한 화면에 더 많이) */
  html[data-presenting] .lesson-body .lesson-section > h2 {
    margin-block-start: 0;
    padding-block-start: 0;
    border-top: 0;
  }

  html[data-presenting] .lesson-body .lesson-section > :first-child {
    margin-block-start: 0;
  }

  /* 단계를 넘기면 초점이 새 단계 제목으로 간다(판 1.7.0, present.ts) — 제목 윗변의 초점 테두리가 화면 맨 위에 붙어 잘리지 않게 */
  html[data-presenting] .lesson-body h2,
  html[data-presenting] .lesson-body h3,
  html[data-presenting] .lesson__header h1 {
    scroll-margin-block-start: var(--space-2);
  }

  /*
   * 핵심 개념의 접힌 상자(details[data-concepts-fold], 판 1.6.0 C174)는 발표 중 펼친 채 모양만 없앤다 — 안의 블록은 present.ts가 바깥 블록처럼
   * 한 단계씩 나눈다. 제목 줄(summary)은 숨기고, 상자의 테두리·배경·안쪽 여백(.more)도 없앤다.
   */
  html[data-presenting] .lesson-body details[data-concepts-fold] {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
  }

  html[data-presenting] .lesson-body details[data-concepts-fold] > summary {
    display: none;
  }

  html[data-presenting] .lesson-body details[data-concepts-fold] > :not(summary) {
    margin-inline: 0;
  }

  /* 설명 그림은 화면 폭을 채우되 한 화면 높이를 넘지 않게(비율은 그대로) */
  html[data-presenting] .lesson-body figure img,
  html[data-presenting] .lesson-body p > img {
    width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: contain;
  }

  /*
   * 표 칸 속 그림(교과서 쪽 "인공지능 구현 예시" 표 등)은 화면 높이의 22%까지만 — 큰 글씨에서 그림 한 줄이 한 화면을 다 써
   * 150%에서 표를 나누고도 그림 설명이 혼자 다음 단계로 밀렸다(판 1.7.0 통합 시험). 그림 칸 크기는 폭(100%, 9rem 안)과 width·height 속성의
   * 비율로 받기 전에도 정해져야 단계 나누기가 맞으므로 width는 그대로 두고 높이만 막아 그림을 칸 안에 맞춘다(object-fit — 비율 그대로).
   */
  html[data-presenting] .lesson-body td img {
    max-height: 22vh;
    object-fit: contain;
  }

  /* 학생 한 명이 쓰는 안내(키보드 조작법·실습실 여는 법·파일 경로)는 프로젝터에 필요 없다 */
  html[data-presenting] .quiz__guide,
  html[data-presenting] .lesson-example__note,
  html[data-presenting] .lesson-example__guide-note,
  html[data-presenting] .lesson-example__file {
    display: none;
  }

  /*
   * 수업 화면 안에서 연 실습실(판 1.6.0 C175): 틀 한 장이 화면 한 쪽 — 윗선은 화면 맨 위(여백 space-2)에 맞추고(LessonExamples.astro가 틀을 열 때,
   * present.ts가 그 단계를 그릴 때·틀을 다 읽었을 때), 높이는 화면에서 아래 막대와 그 여백·여유를 뺀 만큼이라 틀 아래 끝이 막대 위에서 끝난다
   * (판 1.7.0, 미해결 259 — 예전에는 단계를 다시 그리면 틀 윗선이 예제 제목 아래로 내려가 틀 아래가 막대에 가렸다).
   * 틀 안의 compact 모양은 global.css·LabShell.astro의 ":root[data-embed-compact]".
   * "처음 한 번은 시간이 걸려요" 안내는 틀 안의 상태 줄이 같은 말을 하므로 수업 화면에서는 뺀다.
   */
  html[data-presenting] .lesson-example__lab {
    margin-block-start: var(--space-2);
    scroll-margin-block-start: var(--space-2);
  }

  html[data-presenting] .lesson-example__lab .lesson-example__wait {
    display: none;
  }

  html[data-presenting] .lesson-example__lab .lesson-example__frame {
    height: calc(100vh - var(--present-bar-h, 5rem) - 1rem);
    min-height: 360px;
  }

  /*
   * 코드 상자는 한 화면 안에서 스스로 스크롤한다 — 긴 예제 하나가 한 단계를 여러 화면으로 늘이지 않게(2026-09-25 Phase 5 검토 중요 5).
   * 높이에서 아래 막대도 뺀다(판 1.7.0 — 예전 식 "화면 − 12rem"은 막대를 빼지 않아 1366×768에서 예제 단계가 막대 밑으로 80px쯤 들어갔다).
   * 그래도 넘치면 present.ts가 그 예제의 코드 칸만 더 낮춘다(fit.codeMax).
   */
  html[data-presenting] .lesson-example .lesson-code {
    max-height: calc(100vh - var(--present-bar-h, 5rem) - 12rem);
    overflow-y: auto;
  }

  html[data-presenting] .lesson__header {
    display: grid;
    align-content: center;
    min-height: 60vh;
  }

  /* 제목 장에 학습 목표가 함께 있을 때(판 1.6.0 — 제목만 있는 빈 첫 장 금지): 제목을 위쪽에 두고 그 아래 학습 목표가 한 화면에 들어오게 */
  html[data-presenting][data-present-title='goals'] .lesson__header {
    min-height: 0;
    padding-block-start: 6vh;
  }

  html[data-presenting][data-present-title='goals'] .lesson__header .page-title {
    margin-block-end: var(--space-3);
  }

  /* 퀴즈 보기·단추에 키보드 초점이 가도 문제 줄이 위로 밀려나지 않게(walk-a11y-keyboard 6 — present.ts가 문제 글부터 보이게 맞추고, 이 여백이 테두리 잘림을 막는다) */
  html[data-presenting] .quiz__radio,
  html[data-presenting] .quiz__actions .button {
    scroll-margin-block-start: 5rem;
  }

  .lesson-present[hidden] {
    display: none;
  }

  .lesson-present__bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-header, 100);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--gutter);
    border-top: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    /* 막대 글자는 발표 중에도 적당한 크기로(뿌리 크기를 따라 너무 커지지 않게) */
    font-size: clamp(0.8rem, 0.7rem + 0.3vw, 1rem);
  }

  .lesson-present__bar .button {
    min-height: var(--target-min);
    font-size: inherit;
  }

  /*
   * 가운데 두 줄: 윗줄 "3 / 18 · 단계 이름(20글자 안)" 단추(누르면 단계 목록), 아랫줄은 "▼ 아래에 더 있어요"(이 단계가 화면보다 길 때) 또는
   * 마지막 단계의 "마지막 단계예요 · Esc로 끝내기". 두 줄 높이를 늘 잡아 둔다 — 막대 높이가 단계마다 84~137px로 달라져 한 화면에 맞춘 계산이
   * 어긋나고 글이 흔들렸다(R1-076). 낭독기는 data-present-announce(줄이지 않은 이름)를 듣는다. 한 줄 높이는 단추 테두리 2px까지 같게 잡는다.
   */
  .lesson-present__where {
    /* 한 줄 높이 — 단계 이름 단추가 누르는 칸 24px(WCAG 2.5.8)보다 작아지지 않게(휴대폰 막대 글자 약 13px) */
    --present-line: max(24px, calc(var(--leading-snug) * 1em + 2px));

    display: grid;
    flex: 1 1 12rem;
    align-content: center;
    justify-items: center;
    min-inline-size: 0;
    min-block-size: calc(2 * var(--present-line));
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    text-align: center;
  }

  .lesson-present__status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    max-inline-size: 100%;
    min-inline-size: 0;
    min-block-size: var(--present-line);
    margin: 0;
    padding: 0 var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: none;
    color: inherit;
    font: inherit;
    line-height: var(--leading-snug);
    cursor: pointer;
  }

  .lesson-present__status:hover,
  .lesson-present__status[aria-expanded='true'] {
    border-color: var(--color-accent-border);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .lesson-present__status-text {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lesson-present__status-icon {
    flex: none;
  }

  .lesson-present__end,
  .lesson-present__more,
  .lesson-present__inlab {
    max-inline-size: 100%;
    min-block-size: var(--present-line);
    margin: 0;
    padding-block: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lesson-present__end {
    color: var(--color-accent-hover);
  }

  .lesson-present__end[hidden],
  .lesson-present__more[hidden],
  .lesson-present__inlab[hidden] {
    display: none;
  }

  /* 실습실 안 안내: 강조색 — 이 줄이 보이는 동안 둘째 줄의 다른 안내는 숨긴다(넓은 화면) */
  .lesson-present__inlab {
    color: var(--color-accent-hover);
  }

  /* 막대 안 "아래에 더 있어요": 눌리지 않는 안내(강조색), 키 안내는 작게 — 좁으면 키 안내부터 말줄임 */
  .lesson-present__more {
    color: var(--color-accent-hover);
    pointer-events: none;
  }

  .lesson-present__more-keys {
    color: var(--color-text-muted);
    font-size: 0.9em;
    font-weight: var(--weight-regular);
  }

  /* 넓은 화면: 둘째 줄은 하나만 — 아래에 더 있으면 그 안내가 먼저, 끝까지 내리면 "마지막 단계예요" */
  @media (min-width: 40.01rem) {
    .lesson-present__where:has(.lesson-present__more:not([hidden])) .lesson-present__end,
    .lesson-present__where:has(.lesson-present__inlab:not([hidden])) :is(.lesson-present__more, .lesson-present__end) {
      display: none;
    }
  }

