  }

  .lesson-example__excerpt-note {
    border-bottom: 1px solid var(--color-border);
  }

  .lesson-example__comment-note {
    border-top: 1px solid var(--color-border);
  }

  .lesson-code-full {
    border-top: 1px solid var(--color-border);
  }

  .lesson-code-full > summary {
    min-height: var(--target-min);
