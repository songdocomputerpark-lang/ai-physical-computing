---
/**
 * 따라하기 예제(SPEC §7.2 4번) — frontmatter examples의 파일을 빌드할 때 읽어 코드와 [실습실에서 열기]를 보여 준다.
 *
 * 지금(Phase 1)은 실습실 임베드 자리다. 실습실이 생기면(Phase 2 영상처리, Phase 3 ESP32, Phase 4 통신)
 * data-lab·data-example-file을 읽어 이 자리에 실습실을 띄운다. 링크는 실습실 주소 뒤에 ?example=파일 경로를 붙인다.
 *
 * - 파일 위치: 저장소 뿌리의 examples/ 아래(frontmatter에는 examples/ 뒤의 경로만 적는다, content-schemas.ts)
 * - 줄 번호는 원본 파일과 같게 보인다(PLAN §2.6: 본문이 "7번째 줄"을 가리킬 수 있게). 복사할 때 줄 번호는 따라가지 않는다.
 * - 코드 색 강조는 쓰지 않는다: 줄 전체가 주석(#)인 줄만 흐린 색으로 구분해 글자 대비를 4.5:1 넘게 지킨다.
 * - 파일이 없으면 "준비 중" 문장을 보이고 빌드 로그에 경고를 남긴다(빌드는 멈추지 않음, PD-35).
 */
import fs from 'node:fs';
import path from 'node:path';
import type { LessonData } from '../../config/content-schemas.ts';
import { labLink, type LabId } from './lesson-data.ts';

interface Props {
  examples: LessonData['examples'];
  lab?: LabId;
  /** 경고에 적을 차시 파일 이름 */
  source: string;
}

const { examples, lab, source } = Astro.props;
const EXAMPLES_DIR = path.resolve('examples');

function escapeHtml(text: string): string {
  return text.replace(/&/gu, '&amp;').replace(/</gu, '&lt;').replace(/>/gu, '&gt;');
}

function codeToHtml(code: string): { html: string; lineCount: number } {
  const lines = code.replace(/\r\n?/gu, '\n').replace(/\n$/u, '').split('\n');
  const html = lines
    .map((line) => {
      const comment = /^\s*#/u.test(line) ? ' lesson-code__line--comment' : '';
      return `<span class="lesson-code__line${comment}">${escapeHtml(line)}</span>`;
    })
    .join('\n');
  return { html, lineCount: lines.length };
}

const panels = examples.map((example, index) => {
  const filePath = path.join(EXAMPLES_DIR, ...example.file.split('/'));
  let code: string | undefined;
  try {
    code = fs.readFileSync(filePath, 'utf8');
  } catch {
    console.warn(`[차시 틀] ${source}: 예제 파일 examples/${example.file}이(가) 없어요. 파일을 넣거나 frontmatter examples를 고쳐요.`);
  }
  return {
    key: `example-${index + 1}`,
    file: example.file,
    title: example.title ?? `예제 ${index + 1}`,
    rendered: code === undefined ? undefined : codeToHtml(code),
    link: lab ? labLink(lab, example.file) : undefined,
  };
});
---

{
  panels.map((panel) => (
    <figure class="lesson-example" data-lab={lab} data-example-file={panel.file} aria-labelledby={`${panel.key}-title`}>
      <figcaption class="lesson-example__caption">
        <span class="lesson-example__eyebrow">따라하기 예제</span>
        <span class="lesson-example__title" id={`${panel.key}-title`}>
          {panel.title}
        </span>
        <span class="lesson-example__file">examples/{panel.file}</span>
      </figcaption>
      {/* <pre> 안의 공백은 그대로 보이므로 <pre>와 <code> 사이에 줄바꿈·들여쓰기를 두지 않는다. */}
      {panel.rendered ? (
        <pre class="lesson-code" tabindex="0" aria-label={`${panel.title} 코드, ${panel.rendered.lineCount}줄`}><code set:html={panel.rendered.html} /></pre>
      ) : (
        <p class="lesson-example__missing">예제 파일을 준비하고 있어요.</p>
      )}
      <div class="lesson-example__actions">
        {panel.link && (
          <a class="button button--primary" href={panel.link.href}>
            실습실에서 열기
          </a>
        )}
        <p class="lesson-example__note">
          실습실은 아직 만들고 있어요. 지금은 코드를 한 줄씩 읽어 보고, 실습실이 생기면 이 자리에서 바로 실행해요.
        </p>
      </div>
    </figure>
  ))
}

<style>
  .lesson-example {
    margin-block: var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    overflow: hidden;
  }

  .lesson-example__caption {
    display: grid;
    gap: 0.125rem;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-accent-soft);
    line-height: var(--leading-snug);
  }

  .lesson-example__eyebrow {
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }

  .lesson-example__title {
    font-weight: var(--weight-bold);
  }

  .lesson-example__file {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .lesson-example .lesson-code {
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-radius: 0;
    background: var(--color-bg-subtle);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.6;
    overflow-x: auto;
    counter-reset: code-line;
    tab-size: 4;
  }

  .lesson-example .lesson-code:focus-visible {
    outline-offset: calc(-1 * var(--focus-ring-width));
  }

  .lesson-code :global(.lesson-code__line) {
    counter-increment: code-line;
  }

  .lesson-code :global(.lesson-code__line)::before {
    display: inline-block;
    width: 3.25em;
    padding-inline-end: 1em;
    color: var(--color-text-muted);
    text-align: right;
    content: counter(code-line);
    user-select: none;
  }

  .lesson-code :global(.lesson-code__line--comment) {
    color: var(--color-text-muted);
  }

  .lesson-example__missing {
    padding: var(--space-4);
    color: var(--color-text-muted);
  }

  .lesson-example__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .lesson-example__note {
    flex: 1 1 16rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
