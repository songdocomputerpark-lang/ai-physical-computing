  .lesson-example__note {
    flex: 1 1 16rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* 실습실 자리: 글 읽기 폭 밖으로 넓게 편다(가운데 정렬된 칸에서 좌우로 나오는 방법). */
  .lesson-example__lab {
    --lab-embed-width: min(var(--width-page), calc(100vw - 2 * var(--gutter)));

    width: var(--lab-embed-width);
    margin-block-start: var(--space-4);
    margin-inline: calc((100% - var(--lab-embed-width)) / 2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    overflow: hidden;
  }

