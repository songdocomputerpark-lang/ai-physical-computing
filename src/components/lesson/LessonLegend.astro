---
/**
 * 차시 카드 표시 풀이(배우기·대단원 목록 위). 카드의 딱지가 무슨 뜻인지 한 줄씩 알려 준다.
 *
 * props
 *   hasPlanned  목록에 "준비 중" 카드(차례표에는 있는데 md가 아직 없는 차시)가 있는지. 있을 때만 그 풀이 줄을 보인다 —
 *               차시 45편이 모두 공개된 뒤에는 어느 카드에도 없는 딱지를 풀이하고 있었다(2026-09-30 최종 점검 C-05).
 *               새 차시를 차례표(curriculum.ts)에 먼저 더하면 다시 보인다(lesson-data.ts status 'planned').
 */
import LessonTag from './LessonTag.astro';

interface Props {
  hasPlanned?: boolean;
}

const { hasPlanned = false } = Astro.props;
---

<details class="more lesson-legend">
  <summary class="lesson-legend__title">카드 표시 알아보기</summary>
  <dl class="lesson-legend__list">
    {
      hasPlanned && (
        <div class="lesson-legend__item" data-legend="planned">
          <dt>
            <LessonTag tone="planned">준비 중</LessonTag>
          </dt>
          <dd>아직 글을 쓰고 있는 차시예요. 누를 수 없어요.</dd>
        </div>
      )
    }
    <div class="lesson-legend__item" data-legend="no-manuscript">
      <dt><LessonTag tone="no-manuscript">원고 없음</LessonTag></dt>
      <dd>교과서 원고가 없어서 예제 코드를 바탕으로 사이트가 쓴 차시예요.</dd>
    </div>
    <div class="lesson-legend__item" data-legend="supplement">
      <dt><LessonTag tone="kind">보충</LessonTag></dt>
      <dd>교과서에는 없지만 이해를 돕도록 사이트가 보탠 차시예요.</dd>
    </div>
  </dl>
</details>

<style>
  /* 판 1.3.0: 풀이는 접어 두고(공용 .more), 카드의 딱지가 궁금할 때만 펼친다. 상자 모양은 global.css의 .more가 맡는다. */
  .lesson-legend {
    margin-block-end: var(--space-8);
  }

  .lesson-legend[open] {
    padding-block-end: var(--space-1);
  }

  .lesson-legend__list {
    display: grid;
    gap: var(--space-2);
    margin-block: 0;
  }

  .lesson-legend__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .lesson-legend__item dt {
    flex: none;
    min-width: 5.5rem;
  }

  .lesson-legend__item dd {
    flex: 1 1 14rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
