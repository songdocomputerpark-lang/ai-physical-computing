---
/**
 * 차시 본문 — lesson-html.ts의 planLessonBody 결과를 칸(section)마다 그리고, 예제·퀴즈·교사용 안내 자리에 컴포넌트를 넣는다.
 * 마크다운에서 나온 HTML에는 컴포넌트 스타일이 닿지 않으므로 본문용 스타일은 :global로 적는다(.lesson-body 안에서만).
 * 교사용 칸은 발표 모드(LessonPresent.astro)에서 빠진다 — data-section="teacher".
 * 교사용 칸의 제목(## 교사용)은 학생 흐름의 제목들보다 작고 흐리게 그린다 — 학생이 퀴즈를 마친 바로 아래에서 같은 무게로 눈에 띄지 않게(R1-071).
 * 제목 글자는 그대로 둔다(8칸 h2는 모두 보이게, 차례 #링크·e2e가 그 이름을 쓴다).
 */
import type { LessonData } from '../../config/content-schemas.ts';
import type { LessonSource } from './curriculum.ts';
import LessonExamples from './LessonExamples.astro';
import LessonQuiz from './LessonQuiz.astro';
import LessonTeacherInfo from './LessonTeacherInfo.astro';
import type { LabId } from './lesson-data.ts';
import type { LessonBodyPlan } from './lesson-html.ts';

interface Props {
  plan: LessonBodyPlan;
  examples: LessonData['examples'];
  quiz: LessonData['quiz'];
  lab?: LabId | undefined;
  /** 경고·id 앞머리에 쓰는 차시 id(예: u1/1-1-1) */
  lessonId: string;
  /** 경고에 적을 차시 파일 경로 */
  source: string;
  /** 교사용 접기 끝의 "이 차시의 원고와 자료"에 쓰는 값(plan에 teacher 자리가 있을 때만 쓰인다) */
  teacher?: { data: Pick<LessonData, 'kind' | 'pages' | 'standards' | 'handouts'> & Partial<Pick<LessonData, 'unit' | 'label'>>; source: LessonSource | undefined };
}

const { plan, examples, quiz, lab, lessonId, source, teacher } = Astro.props;
const idPrefix = lessonId.replace(/[^a-z\d-]/giu, '-');
const quizPrefix = `quiz-${idPrefix}`;
---

<div class="lesson-body prose">
  {
    plan.intro.map((part) =>
      part.type === 'html' ? (
        <Fragment set:html={part.html} />
      ) : part.slot === 'examples' ? (
        <LessonExamples examples={examples} lab={lab} source={source} indexes={part.examples} />
      ) : part.slot === 'quiz' ? (
        <LessonQuiz items={quiz} idPrefix={quizPrefix} />
      ) : (
        teacher && <LessonTeacherInfo data={teacher.data} source={teacher.source} idPrefix={idPrefix} />
      ),
    )
  }
  {
    plan.sections.map((section) => (
      <section class="lesson-section" data-section={section.key} aria-labelledby={section.id}>
        {section.parts.map((part) =>
          part.type === 'html' ? (
            <Fragment set:html={part.html} />
          ) : part.slot === 'examples' ? (
            <LessonExamples examples={examples} lab={lab} source={source} indexes={part.examples} />
          ) : part.slot === 'quiz' ? (
            <LessonQuiz items={quiz} idPrefix={quizPrefix} />
          ) : (
            teacher && <LessonTeacherInfo data={teacher.data} source={teacher.source} idPrefix={idPrefix} />
          ),
        )}
      </section>
    ))
  }
</div>

<script>
  import { installCollapsibleHelpers } from './details.ts';
  import { installFigureZoom } from './figure-zoom.ts';

  installCollapsibleHelpers();
  // 사이트가 그린 SVG 그림의 [그림 크게 보기]는 파일 대신 이 쪽 안의 크게 보기 창으로(figure-zoom.ts 머리말 — 1.1.0 검토 반영)
  installFigureZoom();
</script>

<style>
  /* 칸 안의 글 사이 간격(.prose > * + *와 같은 간격을 칸 안에도) */
  :global(.lesson-body .lesson-section > * + *) {
    margin-block-start: var(--space-4);
  }

  :global(.lesson-body .lesson-section > h2 + *) {
    margin-block-start: var(--space-3);
  }

  :global(.lesson-body .lesson-section > h3) {
    margin-block-start: var(--space-8);
  }

  /* 칸의 ## 제목 앞에 굵은 막대를 둬서 틀의 칸이 눈에 띄게 한다. */
  :global(.lesson-body .lesson-section > h2) {
    padding-block-start: var(--space-3);
    border-top: 3px solid var(--color-accent-soft);
  }

  /* 교사용 칸: 작고 흐리게(학생 흐름 아래에 조용히). 제목은 읽기 쉬운 크기(1.0625rem)·본문 글자 대비를 지킨다. */
  :global(.lesson-body .lesson-section[data-section='teacher'] > h2) {
    margin-block-start: var(--space-12);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  /* 쪽 안에서 제목으로 보내거나(발표를 끝내고 돌아올 때 포함) 초점이 가도 제목의 초점 테두리가 화면 위에 잘리지 않게 한다(R1-077) */
  :global(html:not([data-presenting]) .lesson-body .lesson-section > *) {
    scroll-margin-block-start: var(--space-4);
  }

  /* 표: 차시 본문 폭을 가득 채워 표끼리 너비를 가지런히 맞춘다. 넓으면 global.css의 규칙대로 표만 옆으로 밀어 본다. */
  :global(.lesson-body table) {
    width: 100%;
  }

  /*
   * 좁은 화면의 4칸 이상 표: 칸이 3~6글자 폭으로 눌려 한 줄씩 끊겨 읽기 어려웠다(2026-09-25 Phase 5 검토 사소 12 — 3-1-1 통신 방식 표 높이 1,041px).
   * 칸마다 최소 폭을 두어 표가 화면보다 넓어지면 표만 옆으로 밀어 본다(global.css의 .prose table이 가로 스크롤 상자).
   */
  @media (max-width: 40rem) {
    :global(.lesson-body table:has(tr > :nth-child(4)) th),
    :global(.lesson-body table:has(tr > :nth-child(4)) td) {
      min-width: 7.5em;
    }
  }

  /* [그림 크게 보기](lesson-html.ts addImageZoomLinks): 그림 속 글자가 작아지는 좁은 화면에서만 */
  :global(.lesson-body .figure-zoom) {
    display: none;
  }

  /*
   * 손가락으로 누르기 쉽게 단추 모양으로(높이 40px 이상, R1-070 — 예전에는 85×23px 글자 링크였다).
   * 글줄 사이에 끼는 링크가 아니라 그림 바로 아래의 독립된 줄이다.
   */
  @media (max-width: 48rem) {
    :global(.lesson-body .figure-zoom) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-block-size: 2.5rem;
      margin-block-start: var(--space-2);
      padding: var(--space-1) var(--space-4);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-md);
      background: var(--color-bg);
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      text-decoration: none;
    }

    :global(.lesson-body .figure-zoom:hover) {
      border-color: var(--color-accent-border);
      background: var(--color-accent-soft);
    }

    :global(.lesson-body p > .figure-zoom) {
      display: flex;
      inline-size: fit-content;
      margin-inline: auto;
    }
  }

  /* 본문 속 용어 링크의 눌리는 면적(R1-070)은 용어 부품(GlossaryScope.astro)이 모든 쪽에 같이 넓힌다. */

  :global(html[data-presenting] .lesson-body .figure-zoom) {
    display: none;
  }

  /* [그림 크게 보기]의 크게 보기 창(figure-zoom.ts가 body 끝에 만든다 — :global). 화면 가득, 그림 칸은 옆·아래로 밀어 본다. */
  :global(.figure-zoom-dialog) {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  :global(.figure-zoom-dialog[open]) {
    display: flex;
    flex-direction: column;
  }

  :global(.figure-zoom-dialog::backdrop) {
    background: rgb(0 0 0 / 0.55);
  }

  :global(.figure-zoom-dialog__bar) {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-block-end: 1px solid var(--color-border-strong);
  }

  :global(.figure-zoom-dialog__title) {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  :global(.figure-zoom-dialog__close) {
    flex: none;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  :global(.figure-zoom-dialog__scroll) {
    flex: 1 1 auto;
    overflow: auto;
    padding: var(--space-4);
    overscroll-behavior: contain;
  }

  :global(.figure-zoom-dialog__scroll img) {
    display: block;
    max-width: none;
    margin-inline: auto;
    background: #fff;
  }

  :global(.lesson-body td img) {
    display: block;
    width: 100%;
    max-width: 9rem;
    margin-block-end: var(--space-2);
  }

  :global(.lesson-body p > img) {
    display: block;
    margin-inline: auto;
  }

  :global(.lesson-body .box h3) {
    margin-block-start: var(--space-4);
    font-size: var(--text-base);
  }

  :global(.lesson-body .box > h3:first-of-type) {
    margin-block-start: var(--space-2);
  }

  :global(.lesson-body .box ul),
  :global(.lesson-body .box ol) {
    padding-inline-start: 1.25em;
  }
</style>
