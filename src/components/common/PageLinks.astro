---
/**
 * 페이지 링크 카드 목록 — 사이트 지도(src/config/nav.ts)의 페이지 묶음을 제목과 한 줄 설명으로 보여 준다.
 *
 * 쓰는 법
 *   <PageLinks pages={getPage('start').children} />
 *   <PageLinks pages={headerNav} headingLevel={3} />
 *
 * props
 *   pages         보여 줄 페이지(NavPage 목록)
 *   headingLevel  (선택) 카드 제목의 단계 2~4(기본 2)
 * 카드 전체를 눌러도 이동한다(링크는 제목 글자 하나라서 화면 낭독기에는 한 번만 읽힌다).
 * 판 1.3.0: 공용 카드(global.css의 .card .card--link .card__link)에 쪽마다 정한 아이콘(nav.ts의 icon)을 왼쪽에 둔다.
 */
import type { NavPage } from '../../config/nav.ts';
import Icon from './Icon.astro';

interface Props {
  pages: readonly NavPage[];
  headingLevel?: 2 | 3 | 4;
}

const { pages, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<ul class="page-links">
  {
    pages.map((page) => (
      <li class="page-links__item card card--link">
        <span class="card__icon page-links__icon">
          <Icon name={page.icon} />
        </span>
        <Heading class="page-links__title">
          <a class="page-links__link card__link" href={page.href}>
            {page.title}
          </a>
        </Heading>
        <p class="page-links__description">{page.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .page-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 카드 모양·통째로 눌림·마우스 올림은 공용 .card .card--link가 맡는다. 아이콘은 왼쪽 위, 글은 오른쪽. */
  .page-links__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  .page-links__icon {
    grid-row: 1;
    grid-column: 1;
  }

  .page-links__title {
    grid-row: 1;
    grid-column: 2;
    font-size: var(--text-lg);
  }

  .page-links__description {
    grid-column: 1 / -1;
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
