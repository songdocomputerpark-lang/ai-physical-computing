---
/**
 * 회로 그림 한 장(판 1.4.0 C5) — 키트 회로 구성 도구로 그린 배선 그림 + 캡션 + [그림 크게 보기].
 * 교과서 쪽(::회로[id] → book-html.ts)과 같은 HTML(circuit-html.ts)을 그리므로 어디서나 같은 모양이다.
 *
 * 쓰는 법: <CircuitFigure id="2-1-2-1" /> 또는 <CircuitFigure figure={figure} />(CircuitDetails.astro가 목록을 돌며 쓴다).
 * 모르는 번호는 빌드를 멈춘다(한국어 오류) — 그림이 없는 칸이 조용히 비는 것보다 낫다. 스타일은 전역 src/styles/circuits.css(마크다운 출력과 함께 쓰는 모양).
 * 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지운다(CLAUDE.md) — 그림 HTML은 한 덩어리 문자열로 만든다.
 */
import '../../styles/circuits.css';
import { withBase } from '../../lib/url.ts';
import { circuitFigureHtml } from './circuit-html.ts';
import { circuitById, circuitList } from './circuits-data.ts';
import { circuitImageUrl, type CircuitFigure } from './circuits-schema.ts';

interface Props {
  /** 회로 그림 번호(예: 2-1-2-1) — figure를 주면 필요 없다 */
  id?: string;
  /** 이미 읽은 그림 */
  figure?: CircuitFigure;
}

const { id, figure: given } = Astro.props;
const figure = given ?? (id === undefined ? undefined : circuitById(id));
if (!figure) {
  throw new Error(`회로 그림 ${id ?? '(번호 없음)'}을(를) scripts/circuits/circuits.yaml에서 찾지 못했어요.`);
}
const html = circuitFigureHtml(figure, circuitList.captionNote, withBase(circuitImageUrl(figure)));
---

<Fragment set:html={html} />
