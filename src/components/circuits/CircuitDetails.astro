---
/**
 * 웹 차시의 "실제 키트 배선 보기"(판 1.4.0 C5) — 그 차시(label)의 회로 그림들을 기본 닫힘 접기로 보여 준다.
 * 그림이 없는 차시(영상 처리 등)는 아무것도 그리지 않는다. 차시 머리의 준비물 사진 줄(PartPhotoStrip) 바로 뒤에 끼운다
 * (src/pages/learn/[unit]/[lesson].astro). 검색 색인에서는 뺀다(같은 글이 교과서 쪽에도 있고, 그림 설명이 차시 글 요약에 섞이지 않게).
 *
 * 쓰는 법: <CircuitDetails label={lesson.label} />
 */
import { circuitsOfLesson } from './circuits-data.ts';
import CircuitFigure from './CircuitFigure.astro';

interface Props {
  /** 차시 번호(label) — 예: 2-1-2 */
  label: string;
}

const { label } = Astro.props;
const figures = circuitsOfLesson(label);
---

{
  figures.length > 0 && (
    <details class="circuit-details" data-circuit-details data-pagefind-ignore>
      <summary>
        실제 키트 배선 보기<span class="circuit-details__count">({figures.length}장)</span>
      </summary>
      <div class="circuit-details__body">
        {figures.map((figure) => (
          <CircuitFigure figure={figure} />
        ))}
      </div>
    </details>
  )
}

<style>
  .circuit-details {
    margin-block: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .circuit-details > summary {
    min-block-size: var(--target-min);
    padding: var(--space-2) var(--space-4);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .circuit-details__count {
    margin-inline-start: var(--space-1);
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }

  .circuit-details__body {
    padding: 0 var(--space-4) var(--space-3);
  }
</style>
