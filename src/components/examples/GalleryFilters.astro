---
/**
 * 예제 갤러리의 거르기 칸(P4-11) — 낱말 찾기 + 태그 고르기.
 *
 * - 칸과 값은 빌드 때 카드에서 세어 만든다(`buildGallery`의 facetGroups). 값이 하나도 없는 칸은 아예 그리지 않으므로,
 *   사이드카·차시 md에 `comm`이나 `difficulty`를 적기 시작하면 **코드를 고치지 않아도** 그 칸이 생긴다.
 * - 조작은 모두 기본 HTML(검색칸·체크박스·단추)이라 키보드와 화면 낭독기가 바로 된다.
 * - 자바스크립트가 없으면 카드는 전부 보이고 이 칸만 숨는다(BaseLayout이 붙이는 html.js 규칙 — 거르기는 덤이지 필수가 아니다).
 * - **사이트 검색 색인에서 뺀다**(data-pagefind-ignore="all"). 이 칸은 글이 아니라 조작 장치라서, 색인에 넣으면
 *   딱지 글자("레이저 10개")가 페이지 본문으로 잡혀 부품 이름을 검색한 학생에게 카드 대신 이 칸이 요약으로 보인다.
 */
import type { GalleryFacetGroup } from '../../lab/gallery/cards.ts';

interface Props {
  groups: readonly GalleryFacetGroup[];
  /** 하드웨어 없이 끝까지 되는 예제 수(0이면 그 칸을 만들지 않는다) */
  virtualOkCount: number;
  total: number;
}

const { groups, virtualOkCount, total } = Astro.props;
---

<div class="gallery-filters" data-gallery-filters data-pagefind-ignore="all">
  <form class="gallery-filters__form" data-gallery-search-form role="search" aria-labelledby="gallery-filters-title">
    <h2 class="gallery-filters__title" id="gallery-filters-title">예제 찾기</h2>

    <div class="gallery-filters__search">
      <label class="gallery-filters__label" for="gallery-search">낱말로 찾기</label>
      <input
        class="gallery-filters__input"
        id="gallery-search"
        type="search"
        name="q"
        data-gallery-search
        autocomplete="off"
        placeholder="예: LCD, 손가락, 블루투스"
      />
      <p class="gallery-filters__hint">제목, 설명, 태그, 파일 이름에서 찾아요. 여러 낱말을 띄어 쓰면 모두 든 예제만 보여요.</p>
    </div>

    {
      groups.map((group) => (
        <fieldset class="gallery-filters__group">
          <legend class="gallery-filters__legend">{group.legend}</legend>
          <ul class="gallery-filters__options">
            {group.options.map((option) => (
              <li>
                <label class="gallery-chip">
                  <input type="checkbox" data-gallery-filter={group.key} value={option.value} />
                  <span class="gallery-chip__text">{option.label}</span>
                  <span class="gallery-chip__count" data-gallery-chip-count>{`${option.count}개`}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      ))
    }

    {
      /* 모든 예제가 하드웨어 없이 되면 거르기 단추 대신 그 사실을 한 줄로 알린다(거르는 것이 없는 단추는 헷갈린다) */
      virtualOkCount > 0 && virtualOkCount < total && (
        <div class="gallery-filters__virtual">
          <label class="gallery-chip">
            <input type="checkbox" data-gallery-virtual />
            <span class="gallery-chip__text">하드웨어 없이 되는 예제만</span>
            <span class="gallery-chip__count" data-gallery-chip-count>{`${virtualOkCount}개`}</span>
          </label>
        </div>
      )
    }
    {
      virtualOkCount > 0 && virtualOkCount === total && (
        <p class="gallery-filters__virtual-note" data-gallery-all-virtual>
          여기 있는 예제는 모두 하드웨어 없이 해 볼 수 있어요. 영상처리는 샘플 영상과 재생 입력으로, ESP32는 가상 보드로 끝까지 돌아가요.
          실제 보드가 있으면 같은 코드를 보드로 보내면 돼요.
        </p>
      )
    }

    <div class="gallery-filters__actions">
      <button class="gallery-filters__reset" type="button" data-gallery-reset hidden>고른 것 모두 지우기</button>
    </div>
  </form>

  {/*
    고른 결과 개수 — 거르기 칸이 길어(휴대폰 약 1,500px) 고른 뒤 결과가 화면 밖이면 아무 변화가 없는 것처럼 보였다. 칸을 보는 동안
    화면 아래에 붙어 떠 있고, [결과 보기]로 첫 카드로 건너뛴다(2026-09-25 Phase 4 검토 반영).
  */}
  <div class="gallery-filters__footer">
    <p class="gallery-filters__count" data-gallery-count role="status" aria-live="polite">{`예제 ${total}개가 모두 보여요.`}</p>
    <a class="gallery-filters__jump" href="#gallery-results" data-gallery-results-jump>결과 보기</a>
  </div>
</div>

<style>
  .gallery-filters {
    margin-block: var(--space-6);
  }

  /* 자바스크립트가 꺼져 있으면 거르기가 움직이지 않으므로 숨긴다(카드는 그대로 다 보인다). */
  :global(html:not(.js)) .gallery-filters {
    display: none;
  }

  .gallery-filters__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .gallery-filters__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .gallery-filters__search {
    display: grid;
    /* 칸 폭을 상자 폭에 묶는다 — 글 입력칸의 기본 폭(글자 20개)은 글꼴마다 달라, 리눅스 CI(한글 대체 글꼴이 넓음)에서 375px 화면을 10px 넘겼다(2026-09-24 통합 CI) */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    max-width: 32rem;
  }

  .gallery-filters__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__input {
    width: 100%;
    min-width: 0;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .gallery-filters__hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .gallery-filters__group {
    /* fieldset은 기본으로 내용보다 좁아지지 않는다(min-inline-size: min-content) — 좁은 화면에서 칸을 밀어내지 않게 푼다 */
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .gallery-filters__legend {
    padding: 0;
    padding-block-end: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-chip {
    max-width: 100%;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .gallery-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .gallery-chip:focus-within {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .gallery-chip:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
  }

  .gallery-chip input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .gallery-chip__count {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .gallery-filters__actions {
    display: flex;
    gap: var(--space-2);
  }

  .gallery-filters__reset {
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-accent-hover);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .gallery-filters__reset:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  /* 이 조건으로는 하나도 없는 값(고르면 결과가 0개) — 흐리게만 보이고 고를 수는 있다 */
  .gallery-chip[data-empty='yes'] {
    border-style: dashed;
    color: var(--color-text-muted);
  }

  .gallery-filters__virtual-note {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-inline-start: 4px solid var(--color-success-border);
    border-radius: var(--radius-sm);
    background: var(--color-success-bg);
    color: var(--color-success-text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /*
   * 화면 아래에 붙은 결과 개수 줄(아래)이 Tab으로 옮겨 간 보기를 가리지 않게, 초점을 따라 화면이 움직일 때 그 줄 높이만큼 위에서 멈춘다
   * (WCAG 2.4.11 초점이 가려지지 않음 — 2026-09-26 Phase 6 접근성 점검의 키보드 걷기에서 부품 칸 둘째 줄이 줄 밑에 숨었다).
   * 줄 높이: 넓은 화면 약 58px, 휴대폰 두 줄 약 90px.
   */
  :global(html:has(.gallery-filters__footer)) {
    scroll-padding-block-end: 7rem;
  }

  /* 고른 결과 개수 줄 — 거르기 칸을 보는 동안 화면 아래에 붙어 있다 */
  .gallery-filters__footer {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .gallery-filters__count {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__jump {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__jump:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }
</style>
