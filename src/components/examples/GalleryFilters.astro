---
/**
 * 예제 갤러리의 거르기 칸(P4-11) — 낱말 찾기 + 태그 고르기.
 *
 * - 칸과 값은 빌드 때 카드에서 세어 만든다(`buildGallery`의 facetGroups). 값이 하나도 없는 칸은 아예 그리지 않으므로,
 *   사이드카·차시 md에 `comm`이나 `difficulty`를 적기 시작하면 **코드를 고치지 않아도** 그 칸이 생긴다.
 * - 조작은 모두 기본 HTML(검색칸·체크박스·단추)이라 키보드와 화면 낭독기가 바로 된다.
 * - 자바스크립트가 없으면 카드는 전부 보이고 이 칸만 숨는다(BaseLayout이 붙이는 html.js 규칙 — 거르기는 덤이지 필수가 아니다).
 * - **사이트 검색 색인에서 뺀다**(data-pagefind-ignore="all"). 이 칸은 글이 아니라 조작 장치라서, 색인에 넣으면
 *   딱지 글자("레이저 10개")가 페이지 본문으로 잡혀 부품 이름을 검색한 학생에게 카드 대신 이 칸이 요약으로 보인다.
 */
import type { GalleryFacetGroup } from '../../lab/gallery/cards.ts';

interface Props {
  groups: readonly GalleryFacetGroup[];
  /** 하드웨어 없이 끝까지 되는 예제 수(0이면 그 칸을 만들지 않는다) */
  virtualOkCount: number;
  total: number;
}

const { groups, virtualOkCount, total } = Astro.props;
---

<div class="gallery-filters" data-gallery-filters data-pagefind-ignore="all">
  <form class="gallery-filters__form" data-gallery-search-form role="search" aria-labelledby="gallery-filters-title">
    <h2 class="gallery-filters__title" id="gallery-filters-title">예제 찾기</h2>

    <div class="gallery-filters__search">
      <label class="gallery-filters__label" for="gallery-search">낱말로 찾기</label>
      <input
        class="gallery-filters__input"
        id="gallery-search"
        type="search"
        name="q"
        data-gallery-search
        autocomplete="off"
        placeholder="예: LCD, 손가락, 블루투스"
      />
      <p class="gallery-filters__hint">제목, 설명, 태그, 파일 이름에서 찾아요. 여러 낱말을 띄어 쓰면 모두 든 예제만 보여요.</p>
    </div>

    {
      groups.map((group) => (
        <fieldset class="gallery-filters__group">
          <legend class="gallery-filters__legend">{group.legend}</legend>
          <ul class="gallery-filters__options">
            {group.options.map((option) => (
              <li>
                <label class="gallery-chip">
                  <input type="checkbox" data-gallery-filter={group.key} value={option.value} />
                  <span class="gallery-chip__text">{option.label}</span>
                  <span class="gallery-chip__count">{`${option.count}개`}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      ))
    }

    {
      virtualOkCount > 0 && (
        <div class="gallery-filters__virtual">
          <label class="gallery-chip">
            <input type="checkbox" data-gallery-virtual />
            <span class="gallery-chip__text">하드웨어 없이 되는 예제만</span>
            <span class="gallery-chip__count">{`${virtualOkCount}개`}</span>
          </label>
        </div>
      )
    }

    <div class="gallery-filters__actions">
      <button class="gallery-filters__reset" type="button" data-gallery-reset hidden>고른 것 모두 지우기</button>
    </div>
  </form>

  <p class="gallery-filters__count" data-gallery-count role="status" aria-live="polite">{`예제 ${total}개가 모두 보여요.`}</p>
</div>

<style>
  .gallery-filters {
    margin-block: var(--space-6);
  }

  /* 자바스크립트가 꺼져 있으면 거르기가 움직이지 않으므로 숨긴다(카드는 그대로 다 보인다). */
  :global(html:not(.js)) .gallery-filters {
    display: none;
  }

  .gallery-filters__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .gallery-filters__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .gallery-filters__search {
    display: grid;
    gap: var(--space-1);
    max-width: 32rem;
  }

  .gallery-filters__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__input {
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .gallery-filters__hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .gallery-filters__group {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .gallery-filters__legend {
    padding: 0;
    padding-block-end: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery-filters__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-chip {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .gallery-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .gallery-chip:focus-within {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .gallery-chip:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: var(--weight-semibold);
  }

  .gallery-chip input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .gallery-chip__count {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  .gallery-filters__actions {
    display: flex;
    gap: var(--space-2);
  }

  .gallery-filters__reset {
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-accent-hover);
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .gallery-filters__reset:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .gallery-filters__count {
    margin: 0;
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
