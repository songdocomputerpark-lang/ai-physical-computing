---
/**
 * 예제 갤러리 화면 전체(PLAN §8.4 P4-11, §2.5) — 사이트의 모든 예제를 카드로 모아 태그·낱말로 찾고, 카드에서 실습실로 바로 연다.
 *
 * **새 예제 = .py 파일 하나**(원칙 6). 이 화면은 실습실이 쓰는 목록 만들기(src/lab/vision/examples.ts·src/lab/esp32/examples.ts)를
 * 그대로 불러 쓰므로, 예제를 폴더에 넣으면 실습실 [예제 불러오기]와 이 갤러리에 **함께** 나타난다.
 * 차시 md를 새로 만들면 그 차시가 싣는 예제 카드에 차시 링크와 차시가 적은 태그(단원·난이도·가상 보드·통신 방식)가 붙는다.
 *
 * 태그를 정하는 차례는 src/lab/gallery/cards.ts 머리말에 적었다(차시 md → 사이드카 → 사이트 규칙).
 * 거르기는 화면에서만 하고(src/lab/gallery/gallery-page.ts), 카드는 빌드 때 이미 HTML로 다 그려져 있다 —
 * 자바스크립트가 없어도 전부 읽을 수 있고, 사이트 검색(Pagefind)도 카드 하나하나를 항목으로 색인한다.
 *
 * 화면에 없는 것: examples/esp32/lib/(보드에 올리는 라이브러리)와 examples/vision/lib/(진짜 PC에서 돌릴 때만 쓰는 원본)는
 * 실습실에서 열 수 있는 예제가 아니라서 실습실 목록과 마찬가지로 넣지 않는다.
 */
import { getCollection } from 'astro:content';
import Callout from '../common/Callout.astro';
import { KIND_LABELS, publishedLessons } from '../lesson/lesson-data.ts';
import { readExampleSidecars, type ExampleSidecar } from '../../lab/controls/example-sidecar.ts';
import { esp32ExamplesFromFiles } from '../../lab/esp32/examples.ts';
import { buildGallery, type GalleryExampleInput, type GalleryLessonInfo } from '../../lab/gallery/cards.ts';
import { EXAMPLE_COMM_LABELS, EXAMPLE_DIFFICULTY_LABELS } from '../../lab/gallery/facets.ts';
import type { WiringEntry } from '../../lab/modules/board/part-types.ts';
import { PART_DEFINITIONS } from '../../lab/modules/board/parts.ts';
import { normalizeWiringSpecs } from '../../lab/modules/board/wiring-spec.ts';
import { visionExamplesFromFiles } from '../../lab/vision/examples.ts';
import ExampleCard from './ExampleCard.astro';
import GalleryFilters from './GalleryFilters.astro';

// ── 1. 예제 파일과 사이드카(빌드 때 글자로 읽는다) ─────────────────────────────
const visionFiles = import.meta.glob<string>(['/examples/vision/**/*.py', '/examples/desktop/**/*.py'], {
  query: '?raw',
  eager: true,
  import: 'default',
});
const visionSidecarFiles = import.meta.glob<string>(['/examples/vision/**/*.meta.yaml', '/examples/desktop/**/*.meta.yaml'], {
  query: '?raw',
  eager: true,
  import: 'default',
});
const esp32Files = import.meta.glob<string>('/examples/esp32/**/*.py', { query: '?raw', eager: true, import: 'default' });
const esp32SidecarFiles = import.meta.glob<string>('/examples/esp32/**/*.meta.yaml', {
  query: '?raw',
  eager: true,
  import: 'default',
});

const visionSidecars = readExampleSidecars(visionSidecarFiles);
const esp32Sidecars = readExampleSidecars(esp32SidecarFiles);

/** glob 경로(/examples/vision/u1/a.py) → examples/ 뒤 경로(vision/u1/a.py) */
function exampleFileOf(globPath: string): string {
  return globPath.replace(/\\/gu, '/').replace(/^.*\/examples\//u, '');
}

const sidecarByFile = new Map<string, ExampleSidecar>();
for (const [globPath, sidecar] of [...Object.entries(visionSidecars), ...Object.entries(esp32Sidecars)]) {
  sidecarByFile.set(exampleFileOf(globPath), sidecar);
}

// ── 2. 차시 md에서 링크와 태그 뽑기 ───────────────────────────────────────────
const lessonEntries = (await getCollection('lessons')).filter((entry) => !entry.data.draft);
const summaries = new Map(publishedLessons(lessonEntries).map((lesson) => [lesson.id, lesson]));
const byFile: Record<string, GalleryLessonInfo> = {};
const bySlug: Record<string, GalleryLessonInfo> = {};
const wiringByFile: Record<string, WiringEntry[]> = {};
const warn = (text: string) => console.warn(`[예제 갤러리] ${text}`);
for (const entry of lessonEntries) {
  // 배선(차시 md의 examples[].parts)은 ESP32 실습실과 같은 규칙으로 읽는다 — 부품 태그가 실습실 보드 그림과 어긋나지 않게.
  for (const example of entry.data.examples) {
    if (example.parts.length > 0 && wiringByFile[example.file] === undefined) {
      const normalized = normalizeWiringSpecs(example.parts, `content/lessons/${entry.id}.md examples(${example.file})`);
      normalized.errors.forEach(warn);
      if (normalized.entries.length > 0) {
        wiringByFile[example.file] = normalized.entries;
      }
    }
  }
  const lesson = summaries.get(entry.id);
  if (!lesson) {
    continue;
  }
  const kindLabel = lesson.kind === 'supplement' ? `${KIND_LABELS.supplement} ` : '';
  const info: GalleryLessonInfo = {
    slug: lesson.slug,
    href: lesson.href,
    label: `${kindLabel}${lesson.label} ${lesson.title}`,
    unit: entry.data.unit,
    difficulty: entry.data.difficulty,
    virtualOk: entry.data.virtual_ok,
    comm: entry.data.comm,
    tags: entry.data.tags,
  };
  bySlug[info.slug] = info;
  for (const example of entry.data.examples) {
    byFile[example.file] ??= info;
  }
}
const lessonLinks = {
  byFile: Object.fromEntries(Object.entries(byFile).map(([file, info]) => [file, { href: info.href, label: info.label }])),
  bySlug: Object.fromEntries(Object.entries(bySlug).map(([slug, info]) => [slug, { href: info.href, label: info.label }])),
};

// ── 3. 실습실과 똑같은 방법으로 예제 목록 만들기 ──────────────────────────────
const visionExamples = visionExamplesFromFiles(visionFiles, visionSidecars, lessonLinks);
const esp32Examples = esp32ExamplesFromFiles(esp32Files, esp32Sidecars, lessonLinks, { wiringByFile, onWarning: warn });
const inputs: GalleryExampleInput[] = [
  ...visionExamples.map((example) => ({ lab: 'vision' as const, example, sidecar: sidecarByFile.get(example.file ?? '') ?? null })),
  ...esp32Examples.map((example) => ({ lab: 'esp32' as const, example, sidecar: sidecarByFile.get(example.file ?? '') ?? null })),
];

const partLabels: Record<string, string> = Object.fromEntries([...PART_DEFINITIONS].map(([id, definition]) => [id, definition.title]));
// 부품 칸의 블루투스는 "통신 방식 · 블루투스(BLE)"와 이름이 같아 어느 쪽을 골라야 할지 헷갈렸다 — 부품 쪽은 보드 그림의 부품임을 밝힌다
// (2026-09-25 Phase 4 검토 반영. 보드 그림의 이름표는 그대로 둔다).
if (partLabels['ble'] !== undefined) {
  partLabels['ble'] = '블루투스 부품(상태 LED)';
}
const gallery = buildGallery(inputs, { byFile, bySlug }, { partLabels, commLabels: EXAMPLE_COMM_LABELS, difficultyLabels: EXAMPLE_DIFFICULTY_LABELS });
gallery.notes.forEach(warn);
// 모든 예제가 하드웨어 없이 되면 카드마다 같은 딱지를 달지 않는다(거르기 칸 위 한 줄 안내로 충분하다)
const allVirtual = gallery.cards.length > 0 && gallery.virtualOkCount === gallery.cards.length;
---

<div class="gallery" data-gallery>
  {/*
    거르기 칸(GalleryFilters.astro 안에서 data-pagefind-ignore)과 아래 안내는 **조작 장치**라 사이트 검색 색인에서 뺀다.
    빼지 않으면 딱지 글자("시리얼(UART) 10개" 같은 개수까지)가 이 페이지 본문으로 색인돼, 부품 이름을 검색한 학생에게
    카드가 아니라 거르기 칸 글이 요약으로 보인다. 카드(제목 id가 있는 h3)는 그대로 색인돼 항목 단위 결과가 된다.
  */}
  <GalleryFilters groups={gallery.facetGroups} virtualOkCount={gallery.virtualOkCount} total={gallery.cards.length} />

  <span id="gallery-results" class="gallery__anchor" tabindex="-1"></span>
  <p class="gallery__empty" data-gallery-empty data-pagefind-ignore="all" hidden>
    고른 조건에 맞는 예제가 없어요. 조건을 하나 지우거나 [고른 것 모두 지우기]를 눌러 봐요.
  </p>

  {
    gallery.sections.map((section) => (
      <section class="gallery-section" data-gallery-section data-section-lab={section.lab}>
        <h2 class="gallery-section__title">
          <span class="gallery-section__lab">{section.labLabel}</span>
          <span class="gallery-section__name">{section.label}</span>
          <span class="gallery-section__count" data-gallery-section-count>{`${section.cards.length}개`}</span>
        </h2>
        <ul class="gallery-section__cards">
          {section.cards.map((card) => (
            <ExampleCard card={card} partLabels={partLabels} showVirtualTag={!allVirtual} />
          ))}
        </ul>
      </section>
    ))
  }

  <div class="gallery__teacher" data-pagefind-ignore>
    <Callout type="교사용" title="예제를 더하는 방법">
      <p>
        <code>examples/</code> 아래에 파이썬 파일(<code>.py</code>) 하나를 두면 이 갤러리와 실습실 [예제 불러오기]에 저절로 나타나요.
        영상처리 실습실은 <code>examples/vision/</code>과 <code>examples/desktop/</code>, ESP32 실습실은{' '}
        <code>examples/esp32/</code>를 읽어요.
      </p>
      <p>
        제목과 설명은 같은 이름의 사이드카(<code>&lt;이름&gt;.meta.yaml</code>)에 적어요. 카드의 태그도 같은 파일에서 와요 —{' '}
        <code>unit</code>(대단원 1~4), <code>difficulty</code>(난이도 1~3), <code>virtual_ok</code>(하드웨어 없이 되나),{' '}
        <code>comm</code>(통신 방식), <code>tags</code>(자유 낱말)이에요. 차시 md에 같은 값을 적으면 차시에 적은 값이 먼저예요.
      </p>
      <p>
        적지 않은 칸은 비워 둬요. 비어 있으면 "해당 없음"이 아니라 "아직 모름"으로 보아 그 거르기에서 빠져요. 다만 폴더가{' '}
        <code>u1</code>~<code>u4</code>면 대단원을, 코드가 통신 모듈을 불러오면 통신 방식을 사이트가 알아서 붙여요.
      </p>
    </Callout>
  </div>
</div>

<script>
  import { mountGallery } from '../../lab/gallery/gallery-page.ts';

  mountGallery(document.querySelector<HTMLElement>('[data-gallery]'));
</script>

<style>
  /*
   * 좁은 화면에서 넘치지 않게(2026-09-24 통합 — 리눅스 CI 375px에서 10px 넘침, 윈도에서는 재현되지 않음):
   * 글꼴마다 폭이 달라도 긴 낱말(숫자 구간·파일 이름·영문 이름)이 칸을 밀어내지 않도록 필요하면 낱말 안에서도 줄을 바꾼다.
   */
  .gallery {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* [결과 보기]가 건너오는 자리(첫 카드 묶음 바로 위) */
  .gallery__anchor {
    display: block;
  }

  .gallery__anchor:focus {
    outline: none;
  }

  .gallery__empty {
    padding: var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .gallery-section {
    margin-block-start: var(--space-8);
  }

  .gallery-section__title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    padding-block-end: var(--space-2);
    border-bottom: 2px solid var(--color-accent-border);
    color: var(--color-accent-hover);
    font-size: var(--text-xl);
  }

  .gallery-section__lab {
    padding: 0.0625rem var(--space-2);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .gallery-section__name {
    min-width: 0;
  }

  .gallery-section__count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .gallery-section__cards {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .gallery__teacher {
    margin-block-start: var(--space-12);
  }
</style>

<!--
  카드·딱지의 모양은 여기 한 곳에 둔다(전역). 카드가 100장이 넘고 카드마다 요소가 10개 남짓이라,
  ExampleCard.astro·GalleryTag.astro에 범위 스타일을 두면 Astro가 요소마다 붙이는 표시(data-astro-cid-…)만으로
  페이지가 50KB 넘게 커진다(P4-11에서 재 봄). 선택자는 모두 .gallery 안으로 묶어 다른 페이지에 새지 않게 한다.
-->
<style is:global>
  /*
   * 예제는 계속 늘어난다(지금 140장 남짓). 화면 밖 카드는 브라우저가 배치·그리기를 건너뛰게 해서
   * 목록이 길어져도 첫 화면이 느려지지 않게 한다(content-visibility). 값은 카드 한 장의 대략 높이다.
   */
  .gallery .gallery-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    content-visibility: auto;
    contain-intrinsic-size: auto 16rem;
  }

  .gallery .gallery-card__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    scroll-margin-top: var(--space-16);
  }

  .gallery .gallery-card__description {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .gallery .gallery-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery .gallery-card__facts {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .gallery .gallery-card__file {
    font-family: var(--font-mono);
  }

  .gallery .gallery-card__compare,
  .gallery .gallery-card__same {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .gallery .gallery-card__compare-label {
    margin: 0;
    color: var(--color-text-muted);
  }

  .gallery .gallery-card__compare-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
  }

  .gallery .gallery-card__compare-links a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  .gallery .gallery-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }

  .gallery .gallery-card__open,
  .gallery .gallery-card__lesson {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .gallery .gallery-card__open {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .gallery .gallery-card__open:hover {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .gallery .gallery-card__lesson {
    background: var(--color-bg);
    color: var(--color-accent-hover);
  }

  .gallery .gallery-card__lesson:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .gallery .gallery-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.0625rem var(--space-2);
    border: 1px solid var(--tag-border);
    border-radius: var(--radius-full);
    background: var(--tag-bg);
    color: var(--tag-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  .gallery .gallery-tag--lab,
  .gallery .gallery-tag--unit {
    --tag-bg: var(--color-accent-soft);
    --tag-border: var(--color-accent-border);
    --tag-text: var(--color-accent-hover);
  }

  .gallery .gallery-tag--comm {
    --tag-bg: var(--color-info-bg);
    --tag-border: var(--color-info-border);
    --tag-text: var(--color-info-text);
  }

  .gallery .gallery-tag--part {
    --tag-bg: var(--color-warning-bg);
    --tag-border: var(--color-warning-border);
    --tag-text: var(--color-warning-text);
  }

  .gallery .gallery-tag--virtual {
    --tag-bg: var(--color-success-bg);
    --tag-border: var(--color-success-border);
    --tag-text: var(--color-success-text);
  }

  .gallery .gallery-tag--meta,
  .gallery .gallery-tag--word {
    --tag-bg: var(--color-bg);
    --tag-border: var(--color-border);
    --tag-text: var(--color-text-muted);

    font-weight: var(--weight-medium);
  }
</style>
