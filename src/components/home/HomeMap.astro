---
/**
 * 홈 "배움 지도"(판 1.3.0): 대단원 4장이 화살표로 이어진 길. 넓은 화면은 가로, 좁은 화면은 세로로 이어진다.
 *
 * 카드 하나 = 단원 색 띠·아이콘·단원 이름·한 줄 설명·차시 수·진도(막대와 글)·[시작하기].
 *  - 카드를 어디 눌러도 대단원 쪽(차시 목록)으로 간다 — 제목 링크의 ::after 덮개(.card__link).
 *  - [시작하기]는 덮개 위에 따로 눌리는 링크로, 그 단원 첫 차시로 간다. 진도가 있으면 "이어서 하기"(안 본 첫 차시)로 바뀐다(home-resume.ts).
 *  - 단원 이름 위에 단계 칩(보고·판단 / 움직여요 / 잇기 / 합치기)이 있어, 첫 화면 흐름 그림의 단계와 이어진다(R1-025).
 *  - [시작하기]였던 단추는 "I단원 배우기"로 단원 이름이 눈에 보이는 글이다(머리글 메뉴 [시작하기]와 안 겹침, R1-027). 접근 이름도 같은 글이다.
 *  - 진도 막대는 화면 낭독기에서 숨긴다(aria-hidden) — 같은 말이 글(map__progress-text)로 이미 읽히기 때문이다(R1-032, 배우기 쪽과 같은 약속).
 *  - 진도 막대·글은 처음 온 사람에게 보이지 않는다(data-progress-empty). 자리는 남겨 쪽이 밀리지 않는다.
 * 차시 수·첫 차시는 공개 차시 목록에서 만든다(home-map.ts). 새 차시 md를 넣으면 코드를 고치지 않아도 따라온다.
 */
import { getCollection } from 'astro:content';
import { learnUnits } from '../../config/nav.ts';
import { withBase } from '../../lib/url.ts';
import Icon from '../common/Icon.astro';
import { publishedLessons } from '../lesson/lesson-data.ts';
import { homeMap } from './home-content.ts';
import { buildHomeMapUnits } from './home-map.ts';

const lessons = publishedLessons(await getCollection('lessons'));
const units = buildHomeMapUnits(learnUnits, lessons, homeMap.unitIcons);
const learnBase = withBase('learn/');
---

<section class="map" aria-labelledby="home-map-title" data-home-map data-learn-base={learnBase} data-start-label={homeMap.startLabel} data-resume-label={homeMap.resumeLabel} data-replay-label={homeMap.replayLabel}>
  <header class="map__header">
    <h2 id="home-map-title" class="map__title">{homeMap.heading}</h2>
    <p class="map__lead">{homeMap.lead}</p>
  </header>
  <ol class="map__path" role="list">
    {
      units.map((unit, index) => (
        <li class="map__step">
          <div
            class={`map__card card card--link card--u${unit.unit}`}
            data-home-unit
            data-progress-unit={unit.lessonIds.join(',')}
            data-progress-label={`${unit.numeral}단원`}
          >
            <div class="map__top">
              <span class={`card__icon card__icon--lg card__icon--u${unit.unit}`}>
                <Icon name={unit.icon} size="lg" />
              </span>
              <p class="map__count">{unit.count}차시</p>
            </div>
            <p class="map__stage">
              <span class="visually-hidden">큰 그림에서 맡은 단계: </span>{homeMap.stages[unit.unit]}
            </p>
            <h3 class="map__name">
              <a class="card__link" href={unit.href}>
                {unit.label}
              </a>
            </h3>
            <p class="map__description">{unit.description}</p>
            <div class="map__progress" aria-live="off">
              <p class="map__progress-text" data-progress-count></p>
              <div class="progress-bar" data-progress-bar aria-hidden="true"></div>
            </div>
            <a
              class="button button--secondary map__start"
              href={unit.first ? unit.first.href : unit.href}
              data-unit-start
              data-first-href={unit.first ? unit.first.href : unit.href}
              data-unit-name={`${unit.numeral}단원`}
            >
              <span data-unit-start-label>{`${unit.numeral}단원 ${homeMap.startLabel}`}</span>
              <Icon name="arrow-right" size="sm" />
            </a>
          </div>
          {index < units.length - 1 && (
            <span class="map__arrow" aria-hidden="true">
              <Icon name="arrow-right" size="sm" class="map__arrow-right" />
              <Icon name="chevron-down" size="sm" class="map__arrow-down" />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .map {
    margin-block-start: var(--space-12);
  }

  .map__header {
    margin-block-end: var(--space-6);
  }

  .map__title {
    font-size: var(--text-2xl);
  }

  .map__lead {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
  }

  /* 휴대폰: 세로 한 줄(화살표는 카드 사이 틈에 걸친다). 넓은 화면: 4칸 가로. */
  .map__path {
    --map-gap: var(--space-6);
    --map-arrow: 1.75rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--map-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .map__step {
    position: relative;
    display: grid;
    min-width: 0;
  }

  .map__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
  }

  .map__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .map__count {
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    background: var(--card-unit-soft);
    /* 단원 색 글자 + 같은 색 연한 바탕: 모두 4.5:1 이상(tokens.css 대비 주석) */
    color: var(--card-unit);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.75rem;
  }

  /* 단계 칩: 흐름 그림의 단계(보고·판단 / 움직여요 / 잇기 / 합치기). 색만이 아니라 글로 알린다. */
  .map__stage {
    align-self: flex-start;
    padding: 0 var(--space-3);
    border: 1px solid var(--card-unit);
    border-radius: var(--radius-full);
    color: var(--card-unit);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.625rem;
  }

  .map__name {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .map__description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* 진도: 본 차시가 없으면 글·막대가 안 보이지만(global.css) 자리는 남는다 */
  .map__progress {
    display: grid;
    gap: var(--space-1);
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }

  .map__progress-text {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.25rem;
  }

  .map__start {
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
  }

  /* 카드 사이 화살표: 눌리지 않는 꾸밈 */
  .map__arrow {
    position: absolute;
    z-index: 2;
    inset-inline-start: 50%;
    inset-block-end: calc(-0.5 * (var(--map-gap) + var(--map-arrow)));
    display: grid;
    place-items: center;
    width: var(--map-arrow);
    height: var(--map-arrow);
    translate: -50% 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text-muted);
    box-shadow: var(--shadow-sm);
    pointer-events: none;
  }

  .map__arrow :global(.map__arrow-right) {
    display: none;
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    /* 태블릿: 2×2. 화살표 없이 단원 번호(I~IV)와 단원 색으로 순서를 알린다. */
    .map__path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .map__arrow {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .map__path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-8);
    }

    .map__arrow {
      inset-block-end: auto;
      inset-block-start: 50%;
      inset-inline-start: auto;
      inset-inline-end: calc(-0.5 * (var(--space-8) + var(--map-arrow)));
      translate: 0 -50%;
    }

    .map__arrow :global(.map__arrow-right) {
      display: block;
    }

    .map__arrow :global(.map__arrow-down) {
      display: none;
    }
  }
</style>
