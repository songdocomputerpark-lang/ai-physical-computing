---
/**
 * 홈 첫 화면(PLAN §8.1 P1-05, SPEC §5): 제목, 한 문장 소개, 큰 버튼 3개, 흐름 그림.
 * 1366×768·375×812 화면에서 스크롤 없이 버튼 3개가 다 보이고 Tab 키만으로 닿아야 한다(tests/e2e/home.spec.ts).
 *
 * - 넓은 화면(64rem 이상): 왼쪽에 글과 버튼, 오른쪽에 흐름 그림.
 * - 좁은 화면: 글 → 버튼 → 그림 순서로 쌓는다. 키가 작은 휴대폰에서도 버튼이 먼저 보이게 하려는 것이다.
 * - 문서 순서도 글 → 버튼 → 그림이라 Tab 키 초점은 머리글 다음에 버튼 3개로 곧장 온다.
 * - 버튼 아래 한 줄: 처음 온 사람에게는 "처음이라면 첫 번째 단추부터…" 길잡이, 진도가 있는 돌아온 학생에게는 "지난번 이어서" 한 줄(R2-029).
 *   둘은 같은 높이의 칸이라 바뀌어도 아래가 밀리지 않고, 돌아온 학생은 스크롤 없이 이어서 하기를 본다. 채우는 곳은 home-resume.ts.
 * 글과 링크는 home-content.ts에 있다.
 */
import Icon from '../common/Icon.astro';
import FlowIllustration from './FlowIllustration.astro';
import { COMING_SOON_BADGE, homeActions, homeHero } from './home-content.ts';
---

<section class="hero" aria-labelledby="home-title">
  <div class="hero__intro">
    <h1 id="home-title" class="hero__title">
      {
        homeHero.titleLines.map((line, index) => (
          <Fragment>
            {index > 0 && ' '}
            <span class="hero__title-line">{line}</span>
          </Fragment>
        ))
      }
    </h1>
    <p class="hero__lead">{homeHero.lead}</p>
    <ul class="hero__actions" role="list">
      {
        homeActions.map((action) => (
          <li>
            <a class:list={['hero__action', `hero__action--${action.variant}`]} href={action.href} data-home-action={action.id}>
              <span class="hero__action-icon">
                <Icon name={action.icon} size="fill" />
              </span>
              <span class="hero__action-text">
                <span class="hero__action-title">
                  <span class="hero__action-label">{action.label}</span>
                  {/* 자리 페이지로 가는 버튼은 누르기 전에 알 수 있게 "준비 중"을 붙인다(2026-09-16 검토 반영). 이름·설명과 띄어 읽히게 공백을 글자로 넣는다. */}
                  {action.status === 'coming-soon' && ' '}
                  {action.status === 'coming-soon' && <span class="hero__action-badge">{COMING_SOON_BADGE}</span>}
                </span>{' '}
                <span class="hero__action-hint">{action.hint}</span>
              </span>
              <span class="hero__action-arrow">
                <Icon name="arrow-right" size="fill" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="hero__guide" data-hero-guide>{homeHero.guide}</p>
    {/* 돌아온 학생(진도가 있을 때만, home-resume.ts가 hidden을 뗀다): "처음이라면…" 길잡이 자리에 지난번 이어서 한 줄이 들어선다(R2-029). 채운 파랑이 아니라 연한 칸이라 주 단추는 여전히 하나다. */}
    <p class="hero__resume" data-hero-resume data-embed-hide data-present-hide hidden>
      <a class="hero__resume-link" href="#" data-hero-resume-link>
        <span class="hero__resume-kicker" data-hero-resume-kicker></span>{' '}
        <span class="hero__resume-name" data-hero-resume-name></span>
        <span class="hero__resume-arrow" aria-hidden="true">
          <Icon name="arrow-right" size="fill" />
        </span>
      </a>
    </p>
  </div>
  <div class="hero__figure">
    <FlowIllustration />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-2) var(--space-12);
  }

  .hero__intro,
  .hero__figure {
    min-width: 0;
  }

  .hero__figure {
    display: grid;
  }

  .hero__title {
    font-size: clamp(var(--text-2xl), 1.2rem + 2.2vw, calc(var(--text-2xl) * 1.45));
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
  }

  .hero__title-line {
    display: inline-block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .hero__actions {
    display: grid;
    gap: var(--space-3);
    max-width: 30rem;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  /* 버튼 아래 한 줄 길잡이(판 1.3.0): 어느 것부터 누를지. 작고 차분하게. */
  .hero__guide {
    display: flex;
    align-items: center;
    /* 길잡이 글과 돌아온 학생용 이어서 한 줄이 같은 높이라, 진도를 읽어 둘이 바뀌어도 아래 그림이 밀리지 않는다(R2-029) */
    min-height: var(--target-min);
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  /* 지난번 이어서 한 줄: 큰 버튼 열과 같은 폭, 연한 파랑 칸(채운 파랑은 [카메라로 바로 해 보기] 하나뿐). 글자는 accent-hover on accent-soft 6.7:1 */
  .hero__resume {
    max-width: 30rem;
    margin-block-start: var(--space-1);
  }

  .hero__guide[hidden],
  .hero__resume[hidden] {
    display: none;
  }

  .hero__resume-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .hero__resume-link:hover {
    border-color: var(--color-accent-hover);
    box-shadow: var(--shadow-sm);
  }

  .hero__resume-name {
    flex: 1 1 auto;
    min-width: 0;
    font-weight: var(--weight-bold);
  }

  .hero__resume-arrow {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-inline-start: auto;
  }

  /* 큰 버튼: 아이콘 + 이름 + 한 줄 설명 + 화살표. 누르는 곳은 높이 4rem 이상. */
  .hero__action {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4rem;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .hero__action--primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .hero__action--primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .hero__action--primary:active {
    border-color: var(--color-accent-active);
    background: var(--color-accent-active);
  }

  .hero__action--secondary {
    background: var(--color-bg);
    color: var(--color-accent-hover);
  }

  .hero__action--secondary:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .hero__action:hover {
    box-shadow: var(--shadow-md);
  }

  .hero__action-icon {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);
  }

  .hero__action--primary .hero__action-icon {
    background: var(--color-accent-hover);
  }

  .hero__action--secondary .hero__action-icon {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .hero__action-text {
    display: grid;
    flex: 1 1 auto;
    gap: 0.125rem;
    min-width: 0;
  }

  /* 이름과 "준비 중" 표시를 한 줄에 두고, 좁으면 표시만 다음 줄로 내린다. */
  .hero__action-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem var(--space-2);
  }

  .hero__action-label {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  /* "준비 중" 표시: 대비 — 파랑 버튼 위 흰 바탕에 accent-hover 글자 7.67, 흰 버튼 위 accent-soft 바탕에 accent-hover 글자 6.7 */
  .hero__action-badge {
    flex: none;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
    white-space: nowrap;
  }

  .hero__action--primary .hero__action-badge {
    background: var(--color-bg);
  }

  /* 파랑 바탕 위 설명 글자: accent-soft는 accent 위 5.25, accent-hover 위 6.7 대비 */
  .hero__action--primary .hero__action-hint {
    color: var(--color-accent-soft);
  }

  .hero__action--secondary .hero__action-hint {
    color: var(--color-text-muted);
  }

  .hero__action-hint {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .hero__action-arrow {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .hero__action:hover .hero__action-arrow {
    transform: translateX(0.1875rem);
  }

  /*
   * 아주 좁은 화면에서는 버튼 설명 줄을 숨겨 버튼 3개가 첫 화면에 들어가게 한다. 버튼 이름만으로도 갈 곳을 알 수 있다.
   * 근거(2026-09-16 측정, Pretendard 15px): 설명 칸 폭 = 화면 폭 − 160px, 가장 긴 설명 약 171px.
   * 21rem(기본 글자 크기에서 336px)보다 좁으면 두 줄로 넘친다. 글자를 크게 키운 브라우저에서는 rem 기준이라 더 넓은 화면에서 숨는다.
   * 설명 길이 한도는 tests/unit/home/home-content.test.ts가 같은 기준으로 검사한다.
   */
  @media (max-width: 20.99rem) {
    .hero__action-hint,
    .hero__action-badge {
      display: none;
    }

    /* 가장 긴 이름 "카메라로 바로 해 보기"가 320px 화면에서 두 줄로 넘치지 않게 한다(띄어쓰기 한 칸(약 4px)이 늘었지만 17px 기준 약 145px로 칸 160px 안이다, R1-033; 15px 측정값으로 환산: 20px일 때 약 166px > 칸 160px, 17px면 약 141px). */
    .hero__action-label {
      font-size: var(--text-base);
    }
  }

  @media (min-width: 48rem) {
    .hero__lead {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 64rem) {
    /* 오른쪽 그림을 조금 더 넓게: 왼쪽 제목 첫 줄(약 25rem)은 들어가고 그림 속 부품은 커진다. */
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      /* 왼쪽 글 칸과 오른쪽 그림 카드의 위·아래 선을 맞춘다(R2-030): 그림 카드가 글 칸 키만큼 늘고 안쪽은 가운데로 모인다(FlowIllustration의 .flow). */
      align-items: stretch;
      gap: var(--space-12);
      padding-block: var(--space-8) var(--space-16);
    }
  }
</style>
