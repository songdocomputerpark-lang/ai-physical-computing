---
/**
 * 홈 "바로 가기" 타일 9개(판 1.3.0, 네이버식 아이콘 칸): 아이콘이 위, 낱말이 아래. 타일 전체가 눌린다.
 * 실습실 4개는 I~IV단원 색을 따라 어느 단원 것인지 눈에 띄게 한다(색은 장식이고 이름이 글자로 있다).
 * 목록은 home-content.ts의 homeShortcuts. 휴대폰은 3열, 넓은 화면은 한 줄 9칸.
 */
import Icon from '../common/Icon.astro';
import { homeShortcuts } from './home-content.ts';
---

<section class="shortcuts" aria-labelledby="home-shortcuts-title">
  <h2 id="home-shortcuts-title" class="shortcuts__title">{homeShortcuts.heading}</h2>
  <ul class="shortcuts__grid" role="list">
    {
      homeShortcuts.items.map((item) => (
        <li class="shortcut card card--link">
          <span class:list={['card__icon', 'card__icon--lg', item.unit && `card__icon--u${item.unit}`]}>
            <Icon name={item.icon} size="lg" />
          </span>
          <a class="shortcut__link card__link" href={item.href}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .shortcuts {
    margin-block-start: var(--space-12);
  }

  .shortcuts__title {
    margin-block-end: var(--space-4);
    font-size: var(--text-2xl);
  }

  .shortcuts__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shortcut {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    text-align: center;
  }

  .shortcut__link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  @media (min-width: 40rem) {
    .shortcuts__grid {
      gap: var(--space-4);
    }

    .shortcut__link {
      font-size: var(--text-base);
    }
  }

  @media (min-width: 64rem) {
    /* 9칸이 한 줄에 들어간다: 칸 너비 약 7rem, 이름은 두 줄까지 */
    .shortcuts__grid {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .shortcut {
      padding-inline: var(--space-1);
    }

    .shortcut__link {
      font-size: var(--text-sm);
    }
  }
</style>
