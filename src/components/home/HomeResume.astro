---
/**
 * 홈 "이어서 하기" 띠(판 1.3.0). 지난번에 본 차시와 마지막으로 연 실습실로 한 번에 돌아가게 한다.
 *
 * - 처음 온 사람에게는 아무것도 보이지 않는다: 띠는 hidden으로 나가고, 저장된 진도가 있을 때만 home-resume.ts가 hidden을 뗀다.
 *   hero 바로 아래라 첫 화면 밖이고, 처음에 자리를 잡아 두지 않으므로 처음 온 사람의 쪽이 밀리지 않는다.
 * - 띠는 첫 화면 아래라 돌아온 학생이 놓치기 쉬워(R2-029), 같은 길(다음에 볼 차시 > 지난번 차시 > 실습실)로 가는 한 줄을 첫 화면 큰 버튼 아래에도 둔다(HomeHero의 data-hero-resume). 그 줄은 이 띠의 칸에서 주소·이름·머리글을 복사한다.
 * - 링크 주소·이름은 저장된 진도에서 와서 textContent·setAttribute로만 넣는다(마크업으로 해석되지 않음).
 * - 발표 모드·embed에서는 숨긴다(data-present-hide, data-embed-hide).
 * - 링크의 접근 이름은 "1-2-1 손 찾기 이어서 하기"처럼 이름 뒤에 동작이 붙는다.
 * - 지난번 차시를 이미 끝냈으면(R1-030) 그 칸의 동작은 "다시 보기"로 바뀌고, 같은 대단원에서 안 연 첫 차시가 "다음에 볼 차시" 칸으로 따로 나온다.
 * - 저장된 진도에 이제 없는 차시·실습실(옛 주소)이 있으면 그 칸을 숨긴다(R1-031). 맞는지 가릴 목록은 아래 JSON(data-home-index)으로 쪽에 실어 둔다:
 *   차시 [id, 번호, 제목]을 차례대로, 실습실 쪽 주소(base 포함). 글은 모두 빌드 때 정해지고 home-resume.ts가 읽는다.
 */
import { getCollection } from 'astro:content';
import { flattenPages } from '../../config/nav.ts';
import Icon from '../common/Icon.astro';
import { publishedLessons } from '../lesson/lesson-data.ts';
import { homeResume } from './home-content.ts';

const lessons = publishedLessons(await getCollection('lessons'));
const labPaths = flattenPages()
  .filter((page) => page.path.startsWith('/labs/') && page.path !== '/labs/')
  .map((page) => page.href);
// JSON 안의 "<"를 유니코드 이스케이프(백슬래시 u003c)로 바꿔, 글 속의 닫는 script 태그가 쪽을 끊지 못하게 한다.
const indexJson = JSON.stringify({ lessons: lessons.map((lesson) => [lesson.id, lesson.label, lesson.title]), labs: labPaths }).replace(/</gu, '\\u003c');
---

<section class="resume" aria-labelledby="home-resume-title" data-home-resume data-embed-hide data-present-hide hidden>
  <h2 id="home-resume-title" class="resume__title">{homeResume.heading}</h2>
  <script is:inline type="application/json" data-home-index set:html={indexJson} />
  <ul class="resume__list" role="list">
    <li class="resume__item card card--link" data-resume-lesson data-go-open={homeResume.lesson.go} data-go-done={homeResume.lesson.goDone} hidden>
      <span class="card__icon"><Icon name="book" /></span>
      <div class="resume__text">
        <p class="resume__kicker" data-resume-kicker>{homeResume.lesson.kicker}</p>
        <p class="resume__name">
          <a class="card__link" href="#" data-resume-link><span data-resume-name></span>{' '}<span class="resume__go" data-resume-go>{homeResume.lesson.go}</span></a>
        </p>
      </div>
      <span class="resume__arrow" aria-hidden="true"><Icon name="arrow-right" size="sm" /></span>
    </li>
    <li class="resume__item card card--link" data-resume-next hidden>
      <span class="card__icon"><Icon name="flag" /></span>
      <div class="resume__text">
        <p class="resume__kicker" data-resume-kicker>{homeResume.next.kicker}</p>
        <p class="resume__name">
          <a class="card__link" href="#" data-resume-link><span data-resume-name></span>{' '}<span class="resume__go">{homeResume.next.go}</span></a>
        </p>
      </div>
      <span class="resume__arrow" aria-hidden="true"><Icon name="arrow-right" size="sm" /></span>
    </li>
    <li class="resume__item card card--link" data-resume-lab hidden>
      <span class="card__icon"><Icon name="flask" /></span>
      <div class="resume__text">
        <p class="resume__kicker" data-resume-kicker>{homeResume.lab.kicker}</p>
        <p class="resume__name">
          <a class="card__link" href="#" data-resume-link><span data-resume-name></span>{' '}<span class="resume__go">{homeResume.lab.go}</span></a>
        </p>
      </div>
      <span class="resume__arrow" aria-hidden="true"><Icon name="arrow-right" size="sm" /></span>
    </li>
  </ul>
</section>

<style>
  .resume {
    margin-block-end: var(--space-10);
  }

  .resume[hidden] {
    display: none;
  }

  .resume__title {
    margin-block-end: var(--space-4);
    font-size: var(--text-xl);
  }

  .resume__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .resume__item[hidden] {
    display: none;
  }

  .resume__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .resume__kicker {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .resume__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  /* 동작 글("이어서 하기")은 이름 옆에 작게. 링크 안에 있어 접근 이름에 들어간다. */
  .resume__go {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .resume__arrow {
    display: flex;
    flex: none;
    color: var(--color-text-muted);
  }
</style>
