---
/**
 * [판 1.6.0부터 홈이 쓰지 않는 옛 차시 카드 목록(휴대폰 8,498px) — 단원 4장 카드(HomeUnits.astro)가 그 일을 하고 45편 전체 목록은 /learn/에 있다(DECISIONS C172). 지우지 않고 남겨 둔다.]
 * 홈 "차시 목록"(판 1.4.0, DECISIONS C132) — 단원 머리(단원 색 + "1단원" 글자) → 중단원 소제목 → 카드. 주소 #lessons.
 *
 * 카드 하나 = 절 하나(번호·제목·"교과서 a~b쪽"·매체 아이콘 + 글자). 카드 전체가 눌리고(공용 .card--link) **교과서 쪽(/book/<id>/)으로** 간다.
 *  - 교과서 쪽이 아직 없는 절은 짝 웹 차시(풀이·실습)로 가고, 카드에 "풀이·실습으로 가요"가 붙는다. 둘 다 없으면 링크 없이 이름만 보인다.
 *  - 책에 없고 사이트가 더한 보충 차시(V1~V5·P1·C1~C3·IV-프로젝트)는 "웹에서 더함" 알약 + 웹 차시 링크.
 *  - 매체 표시는 아이콘 + 글자(색·그림만으로 뜻을 전하지 않는다). 위쪽에 범례 한 줄. 보드는 "실제 보드 있으면 더 좋아요" — 가상 보드로 끝까지 할 수 있다.
 *  - 진도(다 했어요·열어 봤어요)는 카드 링크 밖의 [data-progress-badge]에 progress-paint.ts가 칠한다. 단원 머리의 "N차시 중 M차시를 다 했어요"와 막대도 같은 방법이다(HTML에 굽지 않는다).
 * 자료는 home-lessons.ts(buildHomeUnits)가 교과서 쪽·웹 차시에서 만든다 — 새 교과서 md를 넣으면 코드를 고치지 않아도 카드가 그 쪽으로 이어진다.
 * HTML 크기(서비스 워커 사전 캐시 한도 파일 하나 160KB): ① 이 부품의 <style>은 is:global이다(범위 스타일은 모든 요소에 data-astro-cid 속성을 붙여 약 18KB가 더 든다 — 클래스는 lessons__·hc·hl- 접두어라 겹치지 않는다)
 * ② 매체 아이콘은 쪽에 한 번만 그리는 스프라이트(<symbol>)를 <use>로 불러 쓴다(카드마다 <svg> 전체를 그리면 칩 하나가 약 490바이트).
 * ③ 카드는 꼭 필요한 요소·속성만 둔다(칩의 풀이 말풍선·진도 표시 감싸개·제목 칸 감싸개 등은 뺐고 클래스 이름은 짧게 — 칩의 뜻은 범례가 알린다).
 * 이 요소의 data-learn-base는 home-resume.ts가 차시 id로 웹 차시 주소를 만들 때 쓴다.
 * 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지우므로 글과 인라인 태그 사이에는 {' '}를 쓴다(CLAUDE.md).
 */
import { withBase } from '../../lib/url.ts';
import { BOOK_MEDIA_INFO, BOOK_MEDIA_ORDER } from '../book/book-media.ts';
import Icon from '../common/Icon.astro';
import { ICONS } from '../common/icons.ts';
import { unitCardClass, unitIcon } from '../lesson/unit-style.ts';
import { homeLessons } from './home-content.ts';
import type { HomeUnit } from './home-lessons.ts';

interface Props {
  units: readonly HomeUnit[];
}

const { units } = Astro.props;
const learnBase = withBase('learn/');
// 매체 아이콘 스프라이트(쪽에 한 번) — 범례와 카드 칩이 <use>로 쓴다
const spriteIcons = [...new Set(BOOK_MEDIA_ORDER.map((key) => BOOK_MEDIA_INFO[key].icon))];
---

<section id="lessons" class="lessons" aria-labelledby="home-lessons-title" data-home-lessons data-learn-base={learnBase}>
  <svg class="hl-sprite" width="0" height="0" aria-hidden="true" focusable="false">
    {
      spriteIcons.map((name) => (
        <symbol id={`hl-i-${name}`} viewBox="0 0 24 24">
          {(ICONS[name] ?? []).map((part) => (typeof part === 'string' ? <path d={part} /> : <path class="hl-i-solid" d={part.solid} />))}
        </symbol>
      ))
    }
  </svg>
  <header class="lessons__header">
    <h2 id="home-lessons-title" class="lessons__title">{homeLessons.heading}</h2>
    <p class="lessons__lead">{homeLessons.lead}</p>
    <p class="lessons__legend" data-home-legend>
      <span class="lessons__legend-label">{homeLessons.legendLabel}</span>
      {
        BOOK_MEDIA_ORDER.map((key) => (
          <span class="lessons__legend-item" title={BOOK_MEDIA_INFO[key].note}>
            <svg class="hl-i" aria-hidden="true"><use href={`#hl-i-${BOOK_MEDIA_INFO[key].icon}`} /></svg>
            <span>{BOOK_MEDIA_INFO[key].label}</span>
            {key === 'board' && <span class="lessons__legend-note">({homeLessons.legendBoard})</span>}
          </span>
        ))
      }
    </p>
  </header>

  {
    units.map((unit) => (
      <section class:list={['lessons__unit', unitCardClass(unit.unit)]} aria-labelledby={`home-unit-${unit.unit}-title`} data-home-lesson-unit={unit.unit}>
        <header class="lessons__unit-head" data-progress-unit={unit.progressIds.join(',')} data-progress-label={unit.name}>
          <h3 class="lessons__unit-title" id={`home-unit-${unit.unit}-title`}>
            <span class="lessons__unit-icon">
              <Icon name={unitIcon(unit.unit)} size="md" />
            </span>
            <span class="lessons__unit-no">{unit.name}</span>{' '}
            <span class="lessons__unit-name">{unit.title}</span>
          </h3>
          <div class="lessons__unit-progress" aria-live="off">
            <p class="lessons__unit-count" data-progress-count />
            <div class="progress-bar" data-progress-bar aria-hidden="true" />
          </div>
        </header>
        {unit.groups.map((group) => (
          <div class="lessons__group" data-home-group={group.key}>
            <h4 class="lessons__group-title">{group.title}</h4>
            {group.description && <p class="lessons__group-note">{group.description}</p>}
            <ul class="lessons__grid" role="list">
              {group.cards.map((card) => (
                <li
                  class:list={['hc', 'card', card.href && 'card--link', unitCardClass(unit.unit), !card.href && 'hc-none']}
                  data-home-card={card.label}
                  data-progress-lesson={card.progressId}
                >
                  {card.href ? (
                    <a class="card__link hc-head" href={card.href}>
                      <b class="hc-no">{card.label}</b> {card.title}
                    </a>
                  ) : (
                    <p class="hc-head">
                      <b class="hc-no">{card.label}</b> {card.title}
                    </p>
                  )}
                  <p class="hc-meta">
                    {card.webOnly && <span class="hc-badge">{homeLessons.webOnlyBadge}</span>}
                    {card.pagesLabel && <span>{card.pagesLabel}</span>}
                    {card.target === 'lesson' && card.kind === 'section' && <small>{homeLessons.lessonDest}</small>}
                    {card.target === 'none' && <small>{homeLessons.planned}</small>}
                    {card.media.map((key) => (
                      <span class="hc-chip">
                        <svg class="hl-i" aria-hidden="true"><use href={`#hl-i-${BOOK_MEDIA_INFO[key].icon}`} /></svg>
                        {BOOK_MEDIA_INFO[key].label}
                      </span>
                    ))}
                  </p>
                  {card.progressId && <span class="hc-state" data-progress-badge />}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</section>

<style is:global>
  .hl-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* 스프라이트를 쓰는 아이콘(공용 Icon.astro와 같은 크기·선 모양) */
  .hl-i {
    display: inline-block;
    flex: none;
    width: var(--icon-sm, 1.25rem);
    height: var(--icon-sm, 1.25rem);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: -0.125em;
  }

  .hl-i-solid {
    fill: currentColor;
  }

  .lessons {
    margin-block-start: var(--space-12);
    scroll-margin-block-start: var(--space-4);
  }

  .lessons__title {
    font-size: var(--text-2xl);
  }

  .lessons__lead {
    max-width: 44rem;
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
  }

  /* 범례 한 줄(좁으면 줄이 바뀐다) */
  .lessons__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .lessons__legend-label {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  .lessons__legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .lessons__unit {
    margin-block-start: var(--space-8);
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-border);
    border-inline-start: 6px solid var(--card-unit);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .lessons__unit-head {
    display: grid;
    gap: var(--space-2);
    align-items: center;
  }

  .lessons__unit-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-xl);
  }

  .lessons__unit-icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--card-unit-soft);
    color: var(--card-unit);
  }

  .lessons__unit-no {
    color: var(--card-unit);
  }

  .lessons__unit-progress {
    display: grid;
    gap: var(--space-1);
    max-width: 22rem;
  }

  .lessons__unit-count {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lessons__group {
    margin-block-start: var(--space-5);
  }

  .lessons__group-title {
    margin-block-end: var(--space-2);
    padding-block-end: var(--space-1);
    border-block-end: 1px solid var(--color-border);
    font-size: var(--text-lg);
  }

  .lessons__group-note {
    margin-block-end: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .lessons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── 카드(클래스 이름이 짧은 까닭: 홈 HTML 크기 — 위 머리말 ③) ── */
  .hc {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    min-height: 100%;
    padding: var(--space-4);
  }

  .hc-head {
    display: block;
    margin: 0;
    color: var(--color-text);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .hc-no {
    display: block;
    /* 오른쪽 위의 진도 표시와 겹치지 않게 번호 줄의 높이를 비워 둔다 */
    min-height: 1.5rem;
    color: var(--card-unit);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
  }

  .hc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hc-meta:empty {
    display: none;
  }

  .hc-meta small {
    font-size: var(--text-xs);
  }

  .hc-badge {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .hc-none {
    border-style: dashed;
    background: var(--color-bg-subtle);
  }

  .hc-none .hc-head {
    color: var(--color-text-muted);
  }

  /* 매체 칩: 아이콘 + 글자(색·그림만으로 뜻을 전하지 않는다) */
  .hc-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    line-height: 1.5rem;
  }

  /* 진도 표시: 카드 오른쪽 위(링크 밖). [data-progress-badge]의 공용 모양(알약)에 자리만 정한다 */
  .hc-state {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    pointer-events: none;
  }

  @media (min-width: 40rem) {
    .lessons__unit {
      padding: var(--space-6);
    }

    /* 단원 이름은 왼쪽, 진도(처음 온 사람에게는 비어 있음)는 오른쪽 — 진도 자리가 이름 아래에 빈 줄로 남지 않게 한다 */
    .lessons__unit-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-4);
    }
  }
</style>
