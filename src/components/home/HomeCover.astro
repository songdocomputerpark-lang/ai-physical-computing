---
/**
 * 홈 첫 화면 — 출판본 교과서의 표지(판 1.4.0, DECISIONS C132) + 사람별 큰 단추 셋(판 1.6.0, DECISIONS C172). 옛 HomeHero 자리.
 *
 * 위에서 아래(= 읽는 차례 = Tab 차례): 알약 "고등학교 · 교과서 원문 32절 · 따라 하기 45편" → 제목(h1) "인공지능과 피지컬 컴퓨팅" → 한 줄 소개 → 큰 단추 셋 → 표지 그림 + "누가 만들었나"(출판사·저자·부품 출처).
 *  - 큰 단추 셋은 사람으로 나눈다: [학생 처음부터 배우기](파랑 주 단추) · [선생님 수업 준비] · [키트가 있어요 보드 준비]. 작은 글자 줄(누구용)이 위, 큰 글자(할 일)가 아래다.
 *  - 넓은 화면(48rem 이상): 표지 그림이 왼쪽, 글이 오른쪽(그림은 CSS order로 앞으로 — 그림은 초점을 받지 않아 Tab 차례는 그대로다).
 *  - 좁은 화면: 글 → 단추 → 표지 순서로 쌓는다. 표지는 작은 그림 + 글을 가로로 놓아 "누가 만들었나"가 첫 화면에 들어온다.
 *    375×812에서 안심 띠(HomeTrust)·h1·소개·큰 단추 셋이 스크롤 없이 보여야 한다(C109·C172, tests/e2e/home.spec.ts).
 * 학생 단추는 진도가 있으면 home-resume.ts가 "이어서 하기 + 차시 이름"으로 바꾼다(마크업 약속은 그 파일 머리말 — data-cover-start 등). 채운 파랑은 이 단추 하나뿐이다(C114).
 * 학생 단추가 처음 가는 곳은 1단원 첫 절의 따라 하기 쪽(/learn/u1/1-1-1/ — 코드·실습이 있는 쪽, C173). 교과서 원문(/book/…)은 글만 있어 처음 온 학생이 막다른 길로 느꼈다.
 * 알약의 수는 글에 적지 않고 데이터에서 센다: 절 = 출판본 차례(src/config/book-outline.ts), 따라 하기 편 수 = 공개 웹 차시 목록.
 * 글·링크는 home-content.ts(homeCover)에 있다.
 * HTML 크기: 홈 HTML은 서비스 워커 사전 캐시 한도(파일 하나 160KB)에 바짝 붙어 있다 — 이 부품의 <style>은 is:global이다(Astro 범위 스타일은 모든 요소에 data-astro-cid 속성을 붙인다). 클래스 이름은 이 부품 고유(cover__ 접두어)라 겹치지 않는다.
 * 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지우므로 {' '}를 쓴다(CLAUDE.md).
 */
import { bookSectionCount } from '../../config/book-outline.ts';
import { withBase } from '../../lib/url.ts';
import Icon from '../common/Icon.astro';
import { homeCover, homeCoverActions, homeCoverPill } from './home-content.ts';
import { firstPracticeStart, firstStart, type HomeUnit } from './home-lessons.ts';

interface Props {
  units: readonly HomeUnit[];
  /** 공개된 웹 차시 수 */
  lessonCount: number;
}

const { units, lessonCount } = Astro.props;
// 학생 단추: 따라 하기 쪽(짝 웹 차시) → 없으면 교과서 쪽 → 없으면 따라 하기 목록
const start = firstPracticeStart(units) ?? firstStart(units);
const startHref = start?.href ?? units[0]?.href ?? withBase('learn/');
const actions = homeCoverActions(startHref);
const pill = homeCoverPill(bookSectionCount(), lessonCount);
---

<section class="cover" aria-labelledby="home-title">
  <div class="cover__intro">
    <p class="cover__pill">{pill}</p>
    <h1 id="home-title" class="cover__title">
      {
        homeCover.titleLines.map((line, index) => (
          <Fragment>
            {index > 0 && ' '}
            <span class="cover__title-line">{line}</span>
          </Fragment>
        ))
      }
    </h1>
    <p class="cover__lead">{homeCover.lead}</p>
    <ul class="cover__actions" role="list">
      {
        actions.map((action) =>
          action.id === 'start' ? (
            <li class="cover__action-item cover__action-item--start">
              <a
                class="cover__action cover__action--primary"
                href={action.href}
                data-home-action={action.id}
                data-cover-start
                data-first-href={action.href}
                data-start-label={homeCover.startLabel}
                data-resume-label={homeCover.resumeLabel}
              >
                <span class="cover__action-icon">
                  <Icon name={action.icon} size="fill" />
                </span>
                <span class="cover__action-text">
                  <span class="cover__action-who">{action.who}</span>{' '}
                  <span class="cover__action-label" data-cover-start-label>{action.label}</span>{' '}
                  <span class="cover__action-name" data-cover-start-name hidden />
                </span>
                <span class="cover__action-arrow">
                  <Icon name="arrow-right" size="fill" />
                </span>
              </a>
            </li>
          ) : (
            <li class="cover__action-item">
              <a class="cover__action cover__action--secondary" href={action.href} data-home-action={action.id}>
                <span class="cover__action-icon">
                  <Icon name={action.icon} size="fill" />
                </span>
                <span class="cover__action-text">
                  <span class="cover__action-who">{action.who}</span>{' '}
                  <span class="cover__action-label">{action.label}</span>
                </span>
                <span class="cover__action-arrow">
                  <Icon name="arrow-right" size="fill" />
                </span>
              </a>
            </li>
          ),
        )
      }
    </ul>
  </div>
  <figure class="cover__book">
    <img
      class="cover__image"
      src={withBase('images/book/cover.webp')}
      width="927"
      height="1213"
      alt={homeCover.coverAlt}
      decoding="async"
    />
    <figcaption class="cover__credit">
      <span class="cover__publisher">{homeCover.publisher}</span>{' '}
      <span class="cover__authors">{homeCover.authors.join('·')}</span>{' '}
      <span class="cover__parts" data-cover-parts>{homeCover.partsCredit}</span>
    </figcaption>
  </figure>
</section>

<style is:global>
  .cover {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .cover__intro,
  .cover__book {
    min-width: 0;
  }

  /* 단추 줄 모양은 이 글 칸의 폭으로 정한다(아래 @container — 판 1.9.0: 왼쪽 메뉴판이 생겨 화면 폭과 칸 폭이 달라졌다) */
  .cover__intro {
    container: cover-intro / inline-size;
  }

  .cover__pill {
    display: inline-block;
    margin: 0;
    padding: 0.125rem var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.6;
  }

  /* 휴대폰 폭에서는 한 단계 작게 — 판 1.9.0(C239)에서 --text-sm이 16px로 커지자 375에서 두 줄이 되어 큰 단추 아래 "누가 만들었나" 줄이 첫 화면 밖으로 밀렸다 */
  @media (max-width: 29.99rem) {
    .cover__pill {
      font-size: var(--text-xs);
    }
  }

  .cover__title {
    margin-block-start: var(--space-2);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    font-weight: var(--weight-extrabold);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .cover__title-line {
    display: inline-block;
  }

  .cover__lead {
    max-width: 34rem;
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .cover__actions {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  /* 큰 단추: 아이콘 + (누구용 작은 글자 / 할 일 큰 글자) + 화살표. 누르는 곳은 높이 3.5rem(56px) 이상 */
  .cover__action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .cover__action:hover {
    box-shadow: var(--shadow-md);
  }

  .cover__action--primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .cover__action--primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }

  .cover__action--primary:active {
    border-color: var(--color-accent-active);
    background: var(--color-accent-active);
  }

  .cover__action--secondary {
    background: var(--color-bg);
    color: var(--color-accent-hover);
  }

  .cover__action--secondary:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .cover__action-icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .cover__action-text {
    display: grid;
    flex: 1 1 auto;
    gap: 0.0625rem;
    min-width: 0;
  }

  /* 누구용인지: 작은 글자(파랑 바탕 위에서는 accent-soft — accent 위 5.25 대비) */
  .cover__action-who {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    opacity: 1;
  }

  .cover__action--primary .cover__action-who {
    color: var(--color-accent-soft);
  }

  .cover__action--secondary .cover__action-who {
    color: var(--color-text-muted);
  }

  .cover__action-label {
    font-size: var(--text-lg);
  }

  /* 이어서 할 때만 보이는 차시 이름. 파랑 바탕 위 글자: accent-soft는 accent 위 5.25 대비 */
  .cover__action-name {
    color: var(--color-accent-soft);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .cover__action-arrow {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .cover__action:hover .cover__action-arrow {
    transform: translateX(0.1875rem);
  }

  /* 표지: 좁은 화면은 작은 그림 + "누가 만들었나" 글을 가로로(첫 화면에 들어오게), 넓은 화면은 그림이 크고 글이 아래 */
  .cover__book {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .cover__image {
    flex: none;
    width: 4.5rem;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .cover__credit {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .cover__publisher {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  .cover__parts {
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .cover {
      gap: var(--space-6);
      padding: var(--space-8);
    }

    .cover__lead {
      font-size: var(--text-lg);
    }

    .cover__credit {
      font-size: var(--text-sm);
    }

    .cover__image {
      width: 6rem;
    }
  }

  /* 넓은 화면: 표지 그림이 왼쪽, 글이 오른쪽. 단추 셋은 한 줄에(첫 번째가 가장 넓다). */
  @media (min-width: 48rem) {
    .cover {
      grid-template-columns: minmax(11rem, 17rem) minmax(0, 1fr);
      gap: var(--space-8);
      padding: var(--space-8) var(--space-10);
    }

    .cover__book {
      display: grid;
      order: -1;
      justify-items: center;
      gap: var(--space-2);
    }

    .cover__image {
      width: 100%;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
    }

    .cover__credit {
      justify-items: center;
      text-align: center;
    }

    .cover__actions {
      grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }

  @media (min-width: 64rem) {
    .cover {
      grid-template-columns: minmax(13rem, 19rem) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  /*
   * 글 칸이 좁으면(44rem 미만 — 1366 화면에서 왼쪽 메뉴판이 펴져 있을 때 약 36rem) 단추 셋을 한 줄에 두지 않는다: 학생 단추는 한 줄 가득, 선생님·키트는
   * 아래에 나란히(판 1.9.0 C239 — 셋을 한 줄에 두자 "처음부터 / 배우기"·"수업 / 준비"처럼 낱말 사이에서 줄이 바뀌었다). 30rem 미만(휴대폰)은 한 줄에 하나씩.
   */
  @container cover-intro (max-width: 43.99rem) {
    .cover__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cover__action-item--start {
      grid-column: 1 / -1;
    }
  }

  @container cover-intro (max-width: 29.99rem) {
    .cover__actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 아주 좁은 화면(320px)에서도 가장 긴 글자가 넘치지 않게 글자를 조금 줄인다 */
  @media (max-width: 20.99rem) {
    .cover {
      padding: var(--space-3);
    }

    .cover__action {
      padding-inline: var(--space-3);
    }

    .cover__action-label {
      font-size: var(--text-base);
    }
  }
</style>
