---
/**
 * 도감 첫 쪽의 장치 카드 하나(판 1.5.0) — 사진 · 번호 · 이름 · 연결 방식 · 가상 보드 딱지. 카드 전체가 눌려 장치 쪽으로 간다(.card--link).
 * 공용 카드 모양(.card — src/styles/global.css)을 쓰고 이 컴포넌트 안의 스타일은 카드 속 배치만 다룬다. 단원 색은 2단원(피지컬 컴퓨팅, 초록).
 * 사진은 이름 글자 바로 옆에 있어서 대체 글을 비운다(꾸밈 — 이름이 읽히므로 "초음파 센서 사진" 같은 되풀이를 줄인다). 장치 쪽에서는 대체 글이 있다.
 * <li>를 그리므로 <ul> 안에서 쓴다. 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지운다(CLAUDE.md) — 글과 인라인 태그를 한 줄에 둔다.
 */
import type { PartEntry } from '../parts/parts-schema.ts';
import { partPhotoSrc } from '../parts/parts-schema.ts';
import KitVirtualBadge from './KitVirtualBadge.astro';
import type { KitDevice } from './kit-schema.ts';
import { connectionShort, kitDeviceHref } from './kit-view.ts';

interface Props {
  device: KitDevice;
  part: PartEntry;
  photo: { width: number; height: number };
}

const { device, part, photo } = Astro.props;
---

<li class="card card--link card--u2 kit-card" id={device.id} data-kit-card={device.id} data-kit-virtual-level={device.virtual}>
  <div class="kit-card__photo">
    <img src={partPhotoSrc(part)} alt="" width={photo.width} height={photo.height} loading="lazy" decoding="async" />
  </div>
  <h3 class="kit-card__name">
    <a class="card__link" href={kitDeviceHref(device.id)}><span class="kit-card__no">{device.number}</span>{' '}{device.name}</a>
  </h3>
  <p class="kit-card__connection">{connectionShort(device.interface)}</p>
  <KitVirtualBadge value={device.virtual} />
</li>

<style>
  .kit-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  /* 사진 칸: 늘 정사각형, 사진은 잘리지 않게 안에 맞춘다. 사진 바탕이 흰색이라 칸도 흰색(테두리로 구분). */
  .kit-card__photo {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .kit-card__photo img {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    inline-size: 100%;
    block-size: 100%;
    padding: var(--space-1);
    object-fit: contain;
  }

  .kit-card__name {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .kit-card__no {
    color: var(--card-unit);
    font-weight: var(--weight-bold);
  }

  .kit-card__connection {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
</style>
