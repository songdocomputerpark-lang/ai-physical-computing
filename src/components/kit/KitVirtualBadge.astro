---
/**
 * 가상 보드 표시 딱지(판 1.5.0) — "가상 보드로 바로 / 일부만 가상 / 실제 보드에서". 아이콘 + 글자라 색을 못 보는 사람도 읽을 수 있다.
 * 카드(KitDeviceCard)·장치 쪽 머리·코드 단계·범례(KitLegend)가 같은 모양을 쓴다. 이름과 풀이는 kit-view.ts의 KIT_VIRTUAL_INFO 한 곳.
 * 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지운다(CLAUDE.md) — 아이콘과 글자는 CSS gap으로 띄운다.
 */
import Icon from '../common/Icon.astro';
import { KIT_VIRTUAL_INFO } from './kit-view.ts';
import type { KitVirtual } from './kit-schema.ts';

interface Props {
  value: KitVirtual;
}

const { value } = Astro.props;
const info = KIT_VIRTUAL_INFO[value];
---

<span class:list={['kit-virtual', `kit-virtual--${value}`]} data-kit-virtual={value}>
  <Icon name={info.icon} size="sm" />
  <span>{info.label}</span>
</span>

<style>
  .kit-virtual {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    width: fit-content;
    max-width: 100%;
    padding: 0.0625rem var(--space-2);
    border: 1px solid var(--tag-border);
    border-radius: var(--radius-full);
    background: var(--tag-bg);
    color: var(--tag-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .kit-virtual--full {
    --tag-bg: var(--color-success-bg);
    --tag-border: var(--color-success-border);
    --tag-text: var(--color-success-text);
  }

  .kit-virtual--partial {
    --tag-bg: var(--color-warning-bg);
    --tag-border: var(--color-warning-border);
    --tag-text: var(--color-warning-text);
  }

  .kit-virtual--real-only {
    --tag-bg: var(--color-info-bg);
    --tag-border: var(--color-info-border);
    --tag-text: var(--color-info-text);
  }

  .kit-virtual :global(.icon) {
    flex: none;
  }
</style>
