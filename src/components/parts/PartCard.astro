---
/**
 * 부품 사전의 카드 하나(판 1.4.0, DECISIONS C136) — 사진 · 이름 · 영어 이름 · 연결 방식 · (교과서 키트 표시) · (가상 보드에서 해 보기) · (안내 한 줄).
 * 공용 카드 모양(.card — src/styles/global.css)을 쓰고 이 컴포넌트 안의 스타일은 카드 속 배치만 다룬다.
 * 카드가 통째로 눌리는 카드(.card--link)가 아니다 — 안의 링크(가상 보드에서 해 보기, 키트 장치 도감의 예제 보기)만 눌린다.
 * <li>를 그리므로 <ul> 안에서 쓴다. id="part-<부품 id>"는 키트 표의 사진·차시의 사진 줄이 이 카드로 오는 #위치다.
 * 줄바꿈이 든 글과 태그 사이 공백은 Astro가 지운다(CLAUDE.md) — 글과 인라인 태그를 한 줄에 둔다.
 */
import { deviceTitle, kitDeviceHref } from '../kit/kit-view.ts';
import { partPhotoSize } from './parts-data.ts';
import { PART_CARD_ID_PREFIX, partPhotoAlt, partPhotoSrc, type PartEntry } from './parts-schema.ts';

interface Props {
  part: PartEntry;
  /** 가상 보드 실습실(ESP32 실습실)의 링크 — 쪽이 사이트 지도에서 한 번 구해 넘긴다 */
  labHref: string;
  /** 이 사진을 쓰는 키트 장치(판 1.5.0 키트 장치 도감 — 장치 쪽의 코드·배선으로 이어진다). 없으면 빈 목록 */
  kitDevices?: readonly { readonly id: string; readonly number: string; readonly name: string }[];
}

const { part, labHref, kitDevices = [] } = Astro.props;
const size = partPhotoSize(part);
---

<li class="card parts-card" id={`${PART_CARD_ID_PREFIX}${part.id}`}>
  <div class="parts-card__photo">
    <img src={partPhotoSrc(part)} alt={partPhotoAlt(part)} width={size.width} height={size.height} loading="lazy" decoding="async" />
  </div>
  <h3 class="parts-card__name">{part.name}</h3>
  <p class="parts-card__en" lang="en">{part.nameEn}</p>
  <dl class="parts-card__facts">
    <dt>연결 방식</dt>
    <dd>{part.connection}</dd>
  </dl>
  {part.kitName !== undefined && <p class="parts-card__badge">교과서 키트 부품</p>}
  {
    part.siteParts.length > 0 && (
      <p class="parts-card__try">
        <a href={labHref} aria-label={`가상 보드에서 해 보기: ${part.name}`}>가상 보드에서 해 보기</a>
      </p>
    )
  }
  {
    kitDevices.length > 0 && (
      <p class="parts-card__kit">
        {kitDevices.map((device) => {
          // 보이는 글(예제 보기)을 낭독 이름의 맨 앞에 두어, 보이는 글과 이름이 어긋나지 않게 한다(WCAG 2.5.3)
          const text = kitDevices.length > 1 ? `${device.number} 예제 보기` : '예제 보기';
          return (
            <a href={kitDeviceHref(device.id)} aria-label={`${text}: ${deviceTitle(device)}, 키트 장치 도감`}>
              {text}
            </a>
          );
        })}
      </p>
    )
  }
  {part.note !== undefined && <p class="parts-card__note">{part.note}</p>}
</li>

<style>
  .parts-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  /* 사진 칸: 늘 정사각형, 사진은 잘리지 않게 안에 맞춘다(칸 크기에 기대지 않고 사진을 칸 안에 겹쳐 놓는다). 사진 바탕이 흰색이라 칸도 흰색(테두리로 구분). */
  .parts-card__photo {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .parts-card__photo img {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: var(--space-1);
    object-fit: contain;
  }

  .parts-card__name {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .parts-card__en {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .parts-card__facts {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .parts-card__facts dt {
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .parts-card__facts dd {
    margin: 0;
  }

  .parts-card__badge {
    width: fit-content;
    margin: 0;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .parts-card__try {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .parts-card__try a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  /* 키트 장치 도감의 [예제 보기](판 1.5.0) — 가상 보드 링크(.parts-card__try)와 같은 모양, 장치가 둘이면 나란히 */
  .parts-card__kit {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .parts-card__kit a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .parts-card__note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }
</style>
