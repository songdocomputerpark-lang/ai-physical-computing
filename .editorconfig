root = true

# 저장소는 줄 끝 LF만 받아요(.gitattributes eol=lf, PD-33). EditorConfig를 아는 편집기는 새 파일도 LF로 저장해요.
# Windows 메모장·VS Code의 기본값(CRLF)으로 저장한 예제는 npm run check:lessons -- --fix-eol 로 바꿀 수 있어요(MAINTENANCE.md 1-1).
# 글자 인코딩·마지막 줄바꿈은 정하지 않아요 — BOM이 있어야 하는 파일(고지 원문·오프라인판 안내)과 원문 그대로 옮긴 파일을 편집기가 바꾸지 않게.
[*]
end_of_line = lf
